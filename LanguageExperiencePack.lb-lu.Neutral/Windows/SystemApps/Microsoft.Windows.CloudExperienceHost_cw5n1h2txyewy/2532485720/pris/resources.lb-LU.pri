    Candidate Language=LB-LU: Knäppche fir %1 op %2.
  \oobeUpdateSettings\NextButtonText:
    Candidate Language=LB-LU: Acceptéieren
  \oobeUpdateSettings\LearnMoreTitle:
    Candidate Language=LB-LU: Méi Infoen iwwert dës Parameteren
