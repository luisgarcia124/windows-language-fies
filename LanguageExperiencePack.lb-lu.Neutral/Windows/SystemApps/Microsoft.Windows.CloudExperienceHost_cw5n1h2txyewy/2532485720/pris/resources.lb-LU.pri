  \deviceUser\Title:
    Candidate Language=LB-LU: E Kont dobäisetzen
  \deviceUser\PasswordPlaceholder:
    Candidate Language=LB-LU: Passwuert
  \deviceUser\NextButton:
    Candidate Language=LB-LU: &Weider
  \deviceUser\LeadText:
    Candidate Language=LB-LU: Ass dësen Apparat an engem gemeinsamen Aarbechtsberäich? Wann jo, gitt de Kont an, deen den Zougrëff op Apps wéi Microsoft Teams a Skype fir all d'Benotzer aktivéiere wäert.
  \deviceUser\Error_UsernameFormat:
    Candidate Language=LB-LU: Gitt w.e.g. Är E-Mail-Adress folgendermoossen an: someone@example.com
  \deviceUser\Error_PasswordExpired:
    Candidate Language=LB-LU: D'Passwuert fir dëse Kont ass ofgelaf.
