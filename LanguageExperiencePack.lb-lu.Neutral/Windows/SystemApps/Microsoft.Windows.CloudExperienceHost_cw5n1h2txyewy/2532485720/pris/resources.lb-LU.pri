  \oobeSettings\LearnMoreDescription:
    Candidate Language=LB-LU: Wielt <b>Méi Infoen</b> aus, fir méi iwwert d'Parameteren hei uewen, wéi Windows hëlleft, Iech virun onsécheren Appen a Webinhalt ze schützen an déi entspriechend Datentransferten a Benotzungsméiglechkeete gewuer ze ginn.
  \oobeSettings\LearnMoreButtonText:
    Candidate Language=LB-LU: Méi Infoen
  \oobeSettings\CustomizeVoiceOver:
