  \enterpriseNgcEnrollment\SpecialErrorInfo:
    Candidate Language=LB-LU: Weider Informatiounen iwwert Feeler bei der Konfiguratioun vun engem PIN fannt Die ënner: https://aka.ms/PINErrors
  \enterpriseNgcEnrollment\SetUpPinButton:
    Candidate Language=LB-LU: PIN konfiguréieren
  \enterpriseNgcEnrollment\PadlockTitle:
