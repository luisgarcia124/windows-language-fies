  \resources\Lockdown_SignOutWarningText:
    Candidate Language=LB-LU: Wann den ausgewielte Kont ugemellt ass, musst Dir Iech ofmellen an erëm umellen, fir d'Ännerungen unzewenden. E Kont mat zougewisenem Zougrëff, deen ugemellt ass, gëtt ofgemellt.
  \resources\LockdownUser_HeaderText:
    Candidate Language=LB-LU: E Kont wielen
  \resources\LockdownUser_EmptyListText:
    Candidate Language=LB-LU: Den eenzegen aktive Kont op dësem Apparat ass de momentan ageloggte Kont. Setzt e Kont dobäi oder schaaft een neien a probéiert dann nach eng Kéier.
  \resources\LockdownApp_HeaderText:
    Candidate Language=LB-LU: Eng App wielen
  \resources\LockdownApp_EmptyListText:
