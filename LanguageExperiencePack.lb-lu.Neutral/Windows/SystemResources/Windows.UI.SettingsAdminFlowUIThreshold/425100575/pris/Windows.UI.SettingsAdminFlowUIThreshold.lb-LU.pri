  \resources\JoinDomain_ERROR_ACCESS_DENIED:
    Candidate Language=LB-LU: Dir kënnt dem Domän net bäitrieden. Gitt sécher, dass Dir d’Erlaabnis hutt, dem Domän bäizetrieden, wielt dann en anere PC-Numm aus a probéiert nach eng Kéier.
  \resources\JoinDomain_DomainNameDescriptionText:
    Candidate Language=LB-LU: Domännumm
  \resources\JoinDomain_ConfirmBodyText:
    Candidate Language=LB-LU: Nodeems Dir Äre PC nei start, gëtt e bei folgenden Domän dobäigesat: 
  \resources\JoinDomain_CANNOT_JOIN_ERROR:
    Candidate Language=LB-LU: Dir kënnt dësem Domän net bäitrieden. Kontaktéiert Ären IT-Admin fir méi Infoen.
  \resources\JoinDomain_AuthHeaderText:
    Candidate Language=LB-LU: Op den Domän umellen
  \resources\JoinDomain_AuthBodyText:
    Candidate Language=LB-LU: Gitt Är Domänkontinfoen an, fir sécher ze goen, dass Dir d’Erlaabnis hutt, Iech mam Domän ze verbannen.
  \resources\JoinDomain_ADD_LOCAL_USER_FAILED:
    Candidate Language=LB-LU: Et ass e Feeler opgetrueden. Probéiert méi spéit nach eng Kéier.
