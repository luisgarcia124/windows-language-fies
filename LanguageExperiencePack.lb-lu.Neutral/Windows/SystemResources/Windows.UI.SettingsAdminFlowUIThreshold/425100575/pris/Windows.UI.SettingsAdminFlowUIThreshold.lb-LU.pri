  \resources\JoinDomain_AddDomainUserGroupText:
    Candidate Language=LB-LU: Konttyp
  \resources\JoinDomain_AddDomainUserBodyText:
    Candidate Language=LB-LU: Gitt d’Kontinfoe fir déi Persoun, déi dëse PC benotze wäert, an. Wann Dir dës Etape iwwersprangt, huet dës Persoun standardméisseg d’Autorisatioune fir den Domän.
  \resources\JoinDomain_AddDomainUserAccountText:
    Candidate Language=LB-LU: Benotzerkont
  \resources\InPlaceUpgrade_Title:
    Candidate Language=LB-LU: Verbessert Problemer mat Windows Update
