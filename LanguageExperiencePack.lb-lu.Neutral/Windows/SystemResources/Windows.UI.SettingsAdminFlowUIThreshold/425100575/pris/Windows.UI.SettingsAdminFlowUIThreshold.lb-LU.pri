  \resources\Uninstall_NewProfile_FormatMany:
    Candidate Language=LB-LU: Dir hutt %d Konte geschaaft:
  \resources\Uninstall_NewProfile_Desc\Text:
    Candidate Language=LB-LU: Éier eng viregt Versioun vu Windows ka restauréiert ginn, musst Dir all déi no Ärem rezentsten Upgrade dobäigesate Benotzerkonten ewechhuelen. D’Konte musse vollstänneg geläscht ginn, hir Profiller mat abegraff.
  \resources\Uninstall_MovedProfile_One:
