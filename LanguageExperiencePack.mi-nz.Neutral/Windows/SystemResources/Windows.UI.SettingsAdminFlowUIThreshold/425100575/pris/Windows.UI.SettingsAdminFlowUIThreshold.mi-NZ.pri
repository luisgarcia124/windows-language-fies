  \resources\Uninstall_NewProfile_One:
    Candidate Language=MI-NZ: Naū i hanga te pūkete kotahi:
  \resources\Uninstall_NewProfile_HowTo\Text:
    Candidate Language=MI-NZ: Haere ki Ngā Tautuhinga > Ngā Pūkete > Ētahi atu tāngata hei tango i ēnei pūkete, ka ngana anō ai.
  \resources\Uninstall_NewProfile_Header:
    Candidate Language=MI-NZ: Tango i ētahi pūkete hōu
  \resources\Uninstall_NewProfile_FormatMany:
    Candidate Language=MI-NZ: Nāu i hanga ngā pūkete %d:
  \resources\Uninstall_NewProfile_Desc\Text:
    Candidate Language=MI-NZ: I mua i tō āheinga kia hoki ki tētahi putanga tō mua o Windows, me mātua tango e koe ngā pūkete kaiwhakamahi nāu i tāpiri i mua i tō whakamohoatanga onātata nei. Me mātua tango rawa ngā pūkete, tae atu ki ō rātou kōtaha.
  \resources\Uninstall_MovedProfile_One:
    Candidate Language=MI-NZ: Nāu i neke te pūkete kotahi:
  \resources\Uninstall_MovedProfile_Header:
    Candidate Language=MI-NZ: Whakahoki i ngā pūkete
  \resources\Uninstall_MovedProfile_FormatMany:
    Candidate Language=MI-NZ: Nāu i neke ngā pūkete %d:
  \resources\Uninstall_MovedProfile_Desc\Text:
    Candidate Language=MI-NZ: I mua i tō āheinga kia hoki ki tētahi putanga tō mua o Windows, me mātua whakahoki e koe ngā pūkete kaiwhakamahi nāu i neke i mua i tō whakamohoatanga onātata nei ki tōna tauwāhi taketake.
  \resources\Uninstall_MissingExternal_Desc\Text:
    Candidate Language=MI-NZ: E kore e taea e mātou te whakahoki i a koe ki tō mua putanga o Windows nā te mea kua ngaro te puku kōhiko USB, tētahi atu puku whakawaho rānei i whakamahia i tō  whakamohoatanga onātata nei. Tēnā kuhuna te kōpae ka ngana anō ai.
  \resources\Uninstall_InsufficientSpace_Format:
    Candidate Language=MI-NZ: Hei hoki whakamuri me mātua whiwhi koe i tētahi mokowā wātea %ws i te puku i tāutatia ai a Windows.
  \resources\Uninstall_InsufficientSpace_Desc\Text:
    Candidate Language=MI-NZ: Whakawāteatia ētahi mokowā ka ngana anō ai.
  \resources\Uninstall_Information_Programs_Window7:
    Candidate Language=MI-NZ: •  Me mātua tāuta anō koe i ētahi taupānga.
  \resources\Uninstall_Information_LoseChanges_Windows10:
    Candidate Language=MI-NZ: •  Ka ngaro i a koe ngā huringa i mahia ki ngā tautuhinga i muri mai i te tāutanga o te hanganga onātata nei.
  \resources\Uninstall_Information_LoseChanges_Build:
    Candidate Language=MI-NZ: •  Ka ngaro i a koe ngā huringa i mahia ki ngā tautuhinga i muri mai i te tāutanga o te hanganga onātata nei.
  \resources\Uninstall_Information_LoseChanges:
    Candidate Language=MI-NZ: •  Ka ngaro ngā huringa i mahia e koe ki ngā tautuhinga i muri i te whakamohoa ki Windows 11.
  \resources\Uninstall_Information_ListDesc\Text:
    Candidate Language=MI-NZ: I muri i te hokinga atu:
  \resources\Uninstall_Information_Header:
    Candidate Language=MI-NZ: Ngā mea me mātua mōhio koe
  \resources\Uninstall_Information_Desc\Text:
    Candidate Language=MI-NZ: Ka haere pea tēnei mō tētahi wā, ā, e kore e taea tō whakakā i tō RW kia oti rā anō. Waiho tō RW kia mono mai ka whakakā anō ai.
  \resources\Uninstall_Information_BackupWarning\Text:
    Candidate Language=MI-NZ: I tāruatia ō kōnae? E kore pea tēnei e pā ki ēnei mea, engari he mea pai kia mataara.
  \resources\Uninstall_Information_AppsAndPrograms:
    Candidate Language=MI-NZ: •  Me mātua tāuta anō koe i ētahi taupānga me ētahi papatono.
  \resources\Uninstall_GoBack_WindowsBlue:
    Candidate Language=MI-NZ: Hoki atu ki Windows 8.1
  \resources\Uninstall_GoBack_Windows8:
    Candidate Language=MI-NZ: Hoki atu ki Windows 8
  \resources\Uninstall_GoBack_Windows7:
    Candidate Language=MI-NZ: Hoki atu ki Windows 7
  \resources\Uninstall_GoBack_Windows10:
    Candidate Language=MI-NZ: Me hoki ki Windows 10
  \resources\Uninstall_GoBack_Other:
    Candidate Language=MI-NZ: Hoki atu ki te hanganga o mua
  \resources\Uninstall_GoBack_Default:
    Candidate Language=MI-NZ: Hoki ki tō mua Windows
  \resources\Uninstall_Expired_Desc\Text:
    Candidate Language=MI-NZ: E kore e taea e mātou te whakahoki i a koe ki tō mua putanga o Windows nā te mea neke atu i te 10 rā kua hipa mai i te whakamohoatanga.
  \resources\Uninstall_Error_Header:
    Candidate Language=MI-NZ: E pouri ana mātou engari e kore e taea e koe te hoki whakamuri
  \resources\Uninstall_Error_Desc\Text:
    Candidate Language=MI-NZ: Kāore he huringa i mahia.
  \resources\Uninstall_Confirmation_Header:
    Candidate Language=MI-NZ: Ngā mihi mō te whakamātau i te Windows 11
  \resources\Uninstall_Confirmation_Desc\Text:
    Candidate Language=MI-NZ: Ki te matenui koe ki te rapunga, ki te haumarutanga me te tīmatanga pai ake, hoki mai ki Windows 11 ina pai koe.
  \resources\Uninstall_ConfirmationBuild_Header:
    Candidate Language=MI-NZ: Ngā mihi mōu i whakamātau i tēnei hanganga
  \resources\Uninstall_ConfirmationBuild_Desc\Text:
    Candidate Language=MI-NZ: Mā mātou e tāuta te hanganga arokite panuku ina wātea mai.
  \resources\Uninstall_CheckUpdates_Yes\Content:
    Candidate Language=MI-NZ: Kei te kimi i ngā whakahōunga
  \resources\Uninstall_CheckUpdates_No\Content:
    Candidate Language=MI-NZ: Kāo
  \resources\Uninstall_CheckUpdates_Header:
    Candidate Language=MI-NZ: Me kimi whakahōutanga?
  \resources\Uninstall_CheckUpdates_Desc\Text:
    Candidate Language=MI-NZ: I mua i tō hokinga, me tāuta ngā whakahōu hōu rawa. Mā konei e whakatikaia pea ō raruraru.
  \resources\Uninstall_CheckUpdatesError_Header:
    Candidate Language=MI-NZ: Kāore i taea te tiki mōhiotanga mō ngā whakahōutanga
  \resources\Uninstall_CheckUpdatesError_Desc\Text:
    Candidate Language=MI-NZ: Kia tiro mō ngā whakahōu, haere ki Ngā Tautuhinga me Windows Update, ka tīpako Taki mō ngā whakahōu.
  \resources\Uninstall_BitLockerOffToOn_Header:
    Candidate Language=MI-NZ: Me whakaweto te BitLocker
  \resources\Uninstall_BitLockerOffToOn_Desc\Text:
    Candidate Language=MI-NZ: I whakakāia te BitLocker i muri i te whakamohoa. Hei hoki whakamuri, me whakaweto te BitLocker.
  \resources\Uninstall_BatteryError_Desc\Text:
    Candidate Language=MI-NZ: E kore e taea e koe te hoki atu ki te kaha pūhiko anake. Monoa mai tō RW ka ngana anō ai.
  \resources\TroubleshootActivation_ReactivationLinkText:
    Candidate Language=MI-NZ: I hurihia e au ngā pūmārō i tēnei pūrere inakuanei
  \resources\TroubleshootActivation_OfflineText:
    Candidate Language=MI-NZ: E kore e taea e mātou tō tārua o Windows te whakahohe. Āta whakaritea kua tūhono koe ki te Ipurangi ka ngana anō ai.
  \resources\TroubleshootActivation_NoSolutionText:
    Candidate Language=MI-NZ: Kāore i taea e mātou te whakahohe i Windows i tēnei pūrere.
  \resources\TroubleshootActivation_NoSolutionNoStoreText:
    Candidate Language=MI-NZ: E kore e taea e mātou tō tārua o Windows te whakahohe. Āta whakaritea kua tūhono koe ki te Ipurangi ka ngana anō ai. Mēnā kua tūhono koe ki te Ipurangi me te kite tonu i tēnei raru, tēnā whakapā atu ki tō kaiwhakahaere pūnaha mō ētahi atu kōrero.
  \resources\TroubleshootActivation_MediaCreationText:
    Candidate Language=MI-NZ: Kua kitea e mātou tētahi raihana mamati %1 mō tēnei pūrere e whakahaere ana %2. Hei whakahohe i tēnei raihana mamati me tāuta e koe %1.
  \resources\TroubleshootActivation_LearnMoreText:
    Candidate Language=MI-NZ: Ako anō mō Whakahohenga Windows
  \resources\TroubleshootActivation_LaunchReactivationErrorText:
    Candidate Language=MI-NZ: E kore e taea te whakahohe anō i Windows i tēnei wā. Kia ngana anō ā kō ake nei.
  \resources\TroubleshootActivation_GoToStoreText:
    Candidate Language=MI-NZ: Ka taea e koe te whakahohe i tēnei pūrere mā te haere ki te Store me te hoko i tētahi tārua tūturu o Windows. 
  \resources\TroubleshootActivation_GetHelpText:
    Candidate Language=MI-NZ: Whakapā ki te kapa Tautoko kia Whiwhi Āwhina
  \resources\TroubleshootActivation_FinishedHeaderText:
    Candidate Language=MI-NZ: Kua oti te raparongoā
  \resources\TroubleshootActivation_Error_StoreErrors:
    Candidate Language=MI-NZ: I puta mai tētahi āhuatanga haukoti i tā mātou whakawhiti kōrero ki ā mātou tūmau whakahohe. Taihoa ka ngana anō ai. (0x%08x)
  \resources\TroubleshootActivation_Error_ServiceDisabled:
    Candidate Language=MI-NZ: Kāore i taea e mātou te toro atu ki tētahi ratonga Windows takenui. Āta whakaritea kua tūhono koe ki te Ipurangi, taihoa ake, ka ngana anō ai ki te whakahohe. (0x%08x)
  \resources\TroubleshootActivation_Error_HardwareChanged:
    Candidate Language=MI-NZ: Te āhua nei kua huri ngā pūmārō i tēnei pūrere. Āta whakaritea kua tūhono koe ki te Ipurangi ka ngana anō ai. (0x%08x)
  \resources\TroubleshootActivation_EditionUpgradeText:
    Candidate Language=MI-NZ: Kua kitea e mātou tētahi raihana mamati %1 mō tēnei pūrere e whakahaere ana %2. Hei whakahohe mā te whakamahi i tēnei raihana mamati, tīpakona whakamohoa i tō momo putanga o Windows.
  \resources\TroubleshootActivation_EditionUpgradeButtonText:
    Candidate Language=MI-NZ: Whakamohoa i tō momo putanga o Windows
  \resources\TroubleshootActivation_DiagnosisText:
    Candidate Language=MI-NZ: Kei te rapu i ngā raru whakahohenga...
  \resources\TroubleshootActivation_DiagnosisHeaderText:
    Candidate Language=MI-NZ: Te Whakahohenga Windows
  \resources\TroubleshootActivation_DiagnosisErrorText_Volume:
    Candidate Language=MI-NZ: I haukotia tā mātou raparongoā e tētahi āhuatanga. Āta whakaritea kua tūhono koe ki te Ipurangi, taihoa ake, ka ngana anō ai. Whakapā atu ki tō kaiwhakahaere pūnaha mō ētahi atu kōrero (0x%08x)
  \resources\TroubleshootActivation_DiagnosisErrorText:
    Candidate Language=MI-NZ: I haukotia tā mātou raparongoā e tētahi āhuatanga. Āta whakaritea kua tūhono koe ki te Ipurangi, taihoa ake, ka ngana anō ai. (0x%08x)
  \resources\TroubleshootActivation_ChannelChangeText:
    Candidate Language=MI-NZ: Kua kitea e mātou tētahi raihana mamati mō %1. Hei whakahohe i tēnei pūrere, tīpakona Whakahohe Windows.
  \resources\TroubleshootActivation_ChannelChangeButtonText:
    Candidate Language=MI-NZ: Whakahohe Windows
  \resources\TroubleshootActivation_ActivatedText:
    Candidate Language=MI-NZ: Kua oti tēnei tārua o Windows te whakahohe e mātou.
  \resources\SystemSettings_ViewWifiPassword_WindowHeaderTitle_Format:
    Candidate Language=MI-NZ: Kī haumarutanga %1
  \resources\SystemSettings_SurfaceHub_BitLocker_ExportRecoveryKey_Title:
