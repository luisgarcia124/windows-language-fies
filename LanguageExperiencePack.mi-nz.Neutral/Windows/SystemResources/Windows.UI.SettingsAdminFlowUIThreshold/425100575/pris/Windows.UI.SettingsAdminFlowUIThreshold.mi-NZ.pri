  \resources\SetSurfaceHubDeviceAccount_COMMON_GENERIC_ERROR_PERSIST_ACCOUNT_INFORMATION:
    Candidate Language=MI-NZ: Kāore e taea te mōhiohio pūkete te rokiroki
  \resources\SetSurfaceHubDeviceAccount_COMMON_GENERIC_ERROR:
