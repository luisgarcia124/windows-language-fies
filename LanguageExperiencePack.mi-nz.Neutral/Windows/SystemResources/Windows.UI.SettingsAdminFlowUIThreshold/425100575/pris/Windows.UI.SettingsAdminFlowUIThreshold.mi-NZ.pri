  \resources\SetSurfaceHubDeviceAccount_CalendarSyncEnabledText:
    Candidate Language=MI-NZ: Whakahohea ngā Ratonga Whakawhiti
  \resources\SetSurfaceHubDeviceAccount_activeSyncPoliciesWarning_Text8:
    Candidate Language=MI-NZ: •  Te tuku papamā mai i OneNote
  \resources\SetSurfaceHubDeviceAccount_activeSyncPoliciesWarning_Text7:
    Candidate Language=MI-NZ: •  Te tīmata hui mā Cortana
  \resources\SetSurfaceHubDeviceAccount_activeSyncPoliciesWarning_Text6:
    Candidate Language=MI-NZ: •  Te tīmata hui mai i te mata Maioha
  \resources\SetSurfaceHubDeviceAccount_activeSyncPoliciesWarning_Text5:
    Candidate Language=MI-NZ: •  Te whakaatu maramataka hui ki te mata Maioha
  \resources\SetSurfaceHubDeviceAccount_activeSyncPoliciesWarning_Text4:
    Candidate Language=MI-NZ: Ina haere tonu koe hāunga ia te whirihora anō i ngā kaupapahere, ka taupāhohea ēnei āhuahira:
  \resources\SetSurfaceHubDeviceAccount_activeSyncPoliciesWarning_Text3:
    Candidate Language=MI-NZ: Āta whakarite kua tautuhi ki Teka te kaupapahere PūrereKupuhipaHohe. Ka taea te whirihora anō i te kaupapahere me te ngana anō kia whakarite kua tatū pai ai te pūkete, kua āhei hoki koe te whakamahi i ngā ratonga Exchange.
  \resources\SetSurfaceHubDeviceAccount_activeSyncPoliciesWarning_Text2:
    Candidate Language=MI-NZ: •  Ngā kaupapahere ActiveSync kāore e tautokona e tēnei pūrere
  \resources\SetSurfaceHubDeviceAccount_activeSyncPoliciesWarning_Text1:
    Candidate Language=MI-NZ: Kua oti te pūkete i homai koe te whirihora mā:
  \resources\SetSurfaceHubDeviceAccount_activeSyncPoliciesWarning_HeaderText:
    Candidate Language=MI-NZ: He raru kei tēnei pūkete
  \resources\SetGeolocationMaster_DescriptionText:
    Candidate Language=MI-NZ: Tauwāhi mō tēnei pūrere
  \resources\SetFindMyDevice_DescriptionText:
    Candidate Language=MI-NZ: Tiakina ia wā, ia wā te tauwāhi o taku pūrere
  \resources\RetailDemoConfirm_ReconfigNextButtonText:
    Candidate Language=MI-NZ: Whirihora anō
  \resources\RetailDemoConfirm_ReconfigHeaderText:
    Candidate Language=MI-NZ: Whirihoratia Anō te Rorohiko Whakaatu
  \resources\RetailDemoConfirm_ReconfigBodyText:
    Candidate Language=MI-NZ: Mā te whirihora anō i te rorohiko ka tukuna koe kia huri i te Waehere Urunga Tauhokohoko o te pūrere kia whiwhi ki te ihirangi whakaatu ritenga.
  \resources\RetailDemoConfirm_NextButtonText:
    Candidate Language=MI-NZ: Huri
  \resources\RetailDemoConfirm_HeaderText:
    Candidate Language=MI-NZ: Huri ki te tauira hokohoko
  \resources\RetailDemoConfirm_CancelButtonText:
    Candidate Language=MI-NZ: Whakakore
  \resources\RetailDemoConfirm_BodyText2:
    Candidate Language=MI-NZ: Me tūhono rawa te rorohiko ki te Ipurangi. Otirā, mā te whakawhiti ki te aratau tauira hokohoko ka mukua ngā ihirangi whaiaro katoa, ka whakahokia te rorohiko ki ngā tautuhinga wheketere.
  \resources\RetailDemoConfirm_BodyText1:
    Candidate Language=MI-NZ: E anga ana koe te whakakā i te wheako tauira hokohoko, he tika noa tēnei mō te mahi tauhokohoko anake.
  \resources\RetailDemoConfirmError_ReconfigHeaderText:
    Candidate Language=MI-NZ: Kāore e taea te rorohiko whakaatu te whirihora anō
  \resources\RetailDemoConfirmError_ReconfigBodyText1:
    Candidate Language=MI-NZ: Kāore e taea te tūhono ki te Ipurangi, otirā ka hiahia tūhononga tō rorohiko kia whirihora anō i te aratau whakaatu tauhokohoko.
  \resources\RetailDemoConfirmError_HeaderText:
    Candidate Language=MI-NZ: Kāore e taea te huri te tauira hokohoko
  \resources\RetailDemoConfirmError_CancelButtonText:
    Candidate Language=MI-NZ: Kati
  \resources\RetailDemoConfirmError_BodyText2:
    Candidate Language=MI-NZ: Tirohia tō tūhononga ka ngana anō.
  \resources\RetailDemoConfirmError_BodyText1:
    Candidate Language=MI-NZ: Kāore e taea te tūhono ki te Ipurangi, ka hiahia tūhononga hoki tō rorohiko hei whakawhiti ki te aratau tauira hokohoko.
  \resources\RestartNow:
    Candidate Language=MI-NZ: Tīmata anō ināianei
  \resources\RestartLater:
    Candidate Language=MI-NZ: Tīmata anō ā muri ake
  \resources\RenamePC_SAME_COMPUTER_NAME_ErrorText:
    Candidate Language=MI-NZ: Kei te whakamahia kēhia tēnei ingoa rorohiko. Tāurua he ingoa kē.
  \resources\RenamePC_RENAME_FAIL_ErrorText:
    Candidate Language=MI-NZ: Ka aroha, kāore e taea te huri tō ingoa rorohiko.
  \resources\RenamePC_NON_RFC_COMPUTER_NAME_TITLE_ErrorText:
    Candidate Language=MI-NZ: He muhu te ingoa o te rorohiko.
  \resources\RenamePC_NON_RFC_COMPUTER_NAME_SYNTAX_ErrorText:
    Candidate Language=MI-NZ: He muhu te ingoa o te rorohiko.
  \resources\RenamePC_NextButtonText:
    Candidate Language=MI-NZ: Tiaki
  \resources\RenamePC_NewComputerNamePlaceholderText:
    Candidate Language=MI-NZ: Whakaingoatia tō pūrere
  \resources\RenamePC_HeaderText:
    Candidate Language=MI-NZ: Whakaingoatia anō tō rorohiko
  \resources\RenamePC_ERROR_BAD_CREDENTIALS:
    Candidate Language=MI-NZ: Kāore i whaihua taua mōhiohio pūkete. Tirohia tō ingoa pūkete me tō kupuhipa, ka ngana anō.
  \resources\RenamePC_EMPTY_NAME_ErrorText:
    Candidate Language=MI-NZ: Tāuru he ingoa hōu mō tō rorohiko.
  \resources\RenamePC_DUPLICATE_NAME_ErrorText:
    Candidate Language=MI-NZ: Kei te whakamahia kēhia tēnei ingoa rorohiko. Tāurua he ingoa kē.
  \resources\RenamePC_DIFFERENT_CANONICAL_NAME_ErrorText:
    Candidate Language=MI-NZ: Kāore i whaihua taua ingoa rorohiko. Tīpakotia tētahi kāore e tīmata ki te tau ka ngana anō.
  \resources\RenamePC_CurrentPCNameText:
    Candidate Language=MI-NZ: Ingoa rorohiko onāianei: %1
  \resources\RenamePC_ConfirmNextButtonText:
    Candidate Language=MI-NZ: Tīmata anō ināianei
  \resources\RenamePC_ConfirmHeaderText:
    Candidate Language=MI-NZ: Whakaingoatia anō tō rorohiko
  \resources\RenamePC_ConfirmCancelButtonText:
    Candidate Language=MI-NZ: Tīmata anō ā muri ake
  \resources\RenamePC_ConfirmBodyText:
    Candidate Language=MI-NZ: I muri i tō tīmata anō, ka huri tō ingoa rorohiko ki: 
  \resources\RenamePC_COMPUTER_NAME_TOO_LONG_ErrorText:
    Candidate Language=MI-NZ: He roa rawa te ingoa rorohiko kua tāuru koe.
  \resources\RenamePC_COMPUTER_NAME_SAME_AS_PC_NAME_ErrorText:
    Candidate Language=MI-NZ: Ko tēnei te ingoa rorohiko onāianei. Tāurua he ingoa kē.
  \resources\RenamePC_COMPUTER_NAME_NUMERIC_ErrorText:
    Candidate Language=MI-NZ: Kia kotahi te pūāhua i te itinga rawa me uru ki te ingoa rorohiko.
  \resources\RenamePC_COMPUTER_NAME_HAS_BAD_CHARS_ErrorText:
    Candidate Language=MI-NZ: Kaore e mahi tētahi, ētahi rānei o ngā pūāhua i patoa e koe. Whakamātauria he mea kē.
  \resources\RenamePC_COMPUTER_NAME_ALL_NUMBERS_ErrorText:
    Candidate Language=MI-NZ: Kia kotahi te pū i te itinga rawa i te ingoa rorohiko.
  \resources\RenamePC_CancelButtonText:
    Candidate Language=MI-NZ: Whakakore
  \resources\RenamePC_BodyText:
    Candidate Language=MI-NZ: Ka taea e koe te whakamahi he kōwhiringa o ngā pūāhua, tohuwehe, me ngā tau.
  \resources\RenamePC_BAD_COMPUTER_NAME_SYNTAX_ErrorText:
    Candidate Language=MI-NZ: He muhu te ingoa o te rorohiko.
  \resources\RenamePC_AuthBodyText:
    Candidate Language=MI-NZ: Tāurua ō mōhiohio pūkete rohe kia manatoko kua whiwhi whakaaetanga koe kia huri i te ingoa.
  \resources\RenamePC_ACCESS_DENIED_ErrorText:
    Candidate Language=MI-NZ: Kāore e taea te huri te ingoa rorohiko mā tēnei pūkete.
  \resources\RenamePC_AAD_UPDATE_FAIL_ErrorText:
    Candidate Language=MI-NZ: Kāore e taea te ingoa RW te whakahōutia i te Ratonga Rohe Whaiaronga Hohe Azure.
  \resources\RemoveUser_HeaderText:
    Candidate Language=MI-NZ: Me muku te pūkete, raraunga hoki?
  \resources\RemoveUser_GeneralErrorText:
    Candidate Language=MI-NZ: Kāore e taea te āta whakakore katoa te kaiwhakamahi kua tīpakohia. Ka noho tonu pea ētahi o ngā raraunga a te kaiwhakamahi ki te kōpae.
  \resources\RemoveUser_DeleteUserButtonText:
    Candidate Language=MI-NZ: Muku pūkete, raraunga hoki
  \resources\RemoveUser_BodyText:
    Candidate Language=MI-NZ: Ki te mukua te pūkete a tēnei tangata ka tangohia katoahia ana raraunga mai i tēnei rorohiko tae atu ki ngā tuemi kei tana papamahi, ngā tikiake, tuhinga, whakaahua, pūoro, me ētahi atu kōnae. Mēnā kāore anō kia pūruatia, kia tiakina rānei ngā raraunga ki tētahi atu tauwāhi, pēnei i tētahi atu rorohiko, ka ngaro.
  \resources\RemoveUserLoggedIn_HeaderText:
    Candidate Language=MI-NZ: Tē taea te pūkete te muku.
  \resources\RemoveUserLoggedIn_BodyText:
    Candidate Language=MI-NZ: Me takiputa tēnei tangata i mua i tō muku i tana pūkete. Ka taea anō e koe te tīmata anō tō rorohiko hei takiputa aunoa i a rātou.
  \resources\RemoveFamilyUser_HeaderText:
    Candidate Language=MI-NZ: Tango i tēnei mema whānau i tō pūrere
  \resources\RemoveFamilyUser_BodyText:
    Candidate Language=MI-NZ: Ki te tangohia tēnei mema whānau i tēnei pūrere, ka ū tonu e ia ki tō rōpū whānau. Ka tango noa e mātou i ā rātou raraunga i tēnei pūrere, nā reira me tiaki a rātou mea pērā i ngā tuemi papamahi, ngā tikiake, tuhinga, whakaahua, pūoro ki wāhi kē. Kāore e taea ngā mema whānau hōu te takiuru aunoa ki tēnei pūrere.
  \resources\RemoveExclusion_HeaderText:
    Candidate Language=MI-NZ: Tangohia te aukati
  \resources\RemoveExclusion_BodyText:
    Candidate Language=MI-NZ: Me tango rawa i tēnei aukati?
  \resources\RemoveDomainUser_HeaderText:
    Candidate Language=MI-NZ: Tangohia te pūkete
  \resources\RemoveDomainUser_DeleteUserButtonText:
    Candidate Language=MI-NZ: Tango
  \resources\RemoveDomainUser_BodyText:
    Candidate Language=MI-NZ: Ki te tango koe i te mana urunga o tēnei pūkete, kāore pea tēnā e taea te whakamahi e koe kia takiuru ki tēnei rorohiko.
  \resources\RemoteDesktop_WindowTitle:
    Candidate Language=MI-NZ: Tauranga Papamahi Mamao
  \resources\RemoteDesktop_RegistryError_HeaderText:
    Candidate Language=MI-NZ: Kei te tirotiro ki ō tautuhinga
  \resources\RemoteDesktop_RegistryError_BodyText:
    Candidate Language=MI-NZ: I puta mai tētahi raru i tā mātou ngananga ki te whakahōu i tō rēhita.
  \resources\RemoteDesktop_ProceedButtonText:
    Candidate Language=MI-NZ: Haere tonu ahakoa tēnei
  \resources\RemoteDesktop_NextButtonText:
    Candidate Language=MI-NZ: Whakaū
  \resources\RemoteDesktop_GenericError_HeaderText:
    Candidate Language=MI-NZ: Kua pā tētahi raru
  \resources\RemoteDesktop_GenericError_BodyText:
    Candidate Language=MI-NZ: Katia Ngā Tautuhinga, ka ngana anō ai.
  \resources\RemoteDesktop_EnableFirewallError_HeaderText:
    Candidate Language=MI-NZ: Kei te āraia a papamahi mamao e tō pātūahi
  \resources\RemoteDesktop_EnableFirewallError_BodyText:
    Candidate Language=MI-NZ: Huakina tauranga 3389 kia āhei a Papamahi Mamao te puta mā tō pātūahi.
  \resources\RemoteDesktop_DisableFirewallError_HeaderText:
    Candidate Language=MI-NZ: I puta mai tētahi raru i tō mātou ngananga ki te kati i te tauranga pātūahi Papamahi Mamao
  \resources\RemoteDesktop_DisableFirewallError_BodyText:
    Candidate Language=MI-NZ: Hei mono i Papamahi Mamao katingia tauranga 3389 i tō pātūahi.
  \resources\RemoteDesktop_CloseButtonText:
    Candidate Language=MI-NZ: Kati
  \resources\RemoteDesktop_CancelButtonText:
    Candidate Language=MI-NZ: Whakakore
  \resources\RDP_ProtectAccount_SignInButtonText:
    Candidate Language=MI-NZ: Haere ki ngā kōwhiringa Takiuru-mai
  \resources\RDP_ProtectAccount_HeaderText:
    Candidate Language=MI-NZ: Parea tō pūkete
  \resources\RDP_ProtectAccountDenied_BodyText:
    Candidate Language=MI-NZ: Me mātua tautuhi ngā whakaritenga motuhēhēnga (pēnei i Windows Hello, i tētahi kupuhipa, i tētahi PINE rānei) ō tēnei pūkete hei whakahohe i Papamahi Mamao.
  \resources\RDP_ProtectAccountAllowed_BodyText:
    Candidate Language=MI-NZ: Kāore tō pūkete i te hiahia ki te motuhēhētanga hei takiuru ki tēnei RW.  Ki te whakahohe koe i Papamahi Mamao kāore he motuhēhēnga, kei te whakawātea koe i tō rorohiko ki te tomokanga pokanga mamao.
  \resources\RDP_Enable_HeaderText:
    Candidate Language=MI-NZ: Whakahohe Papamahi Mamao?
  \resources\RDP_Enable_Firewall_Part2_BodyText:
    Candidate Language=MI-NZ: Ngā Tautuhinga Pātūahi Hōhonu
  \resources\RDP_Enable_Firewall_Part1_BodyText:
    Candidate Language=MI-NZ: Kei te whakatuwhera koe i te tauranga Papamahi Mamao i roto i tō pātūahi mō ngā hononga whatunga katoa i tēnei RW. Ki te hiahia koe ki te tepe i ngā hononga ki ngā whatunga i tīpakona ai, huakina  
  \resources\RDP_Enable_Firewall_Complete_BodyText:
    Candidate Language=MI-NZ: Kei te whakatuwhera koe i te tauranga Papamahi Mamao i roto i tō pātūahi mō ngā hononga whatunga katoa i tēnei RW. Ki te hiahia koe ki te tepe i ngā hononga ki ngā whatunga i tīpakona ai, huakina ngā Tautuhinga Pātūahi Hōhonu.
  \resources\RDP_Enable_BodyText:
    Candidate Language=MI-NZ: Ka taea e koutou ko ngā kaiwhakamahi i tīpakona i raro i ngā pūkete Kaiwhakamahi te tūhono mamao ki tēnei RW.
  \resources\RDP_Disable_HeaderText:
    Candidate Language=MI-NZ: Momo Papamahi Mamao?
  \resources\PBR_WipeData_DriveListLink\Content:
    Candidate Language=MI-NZ: Whakaaturia mai he rārangi o ngā puku tērā pea ka pākia
  \resources\PBR_UninstallWarning_Header:
    Candidate Language=MI-NZ: Whakahōu o nā noa nei
  \resources\PBR_UninstallWarning_Desc\Text:
    Candidate Language=MI-NZ: I whakahōuhia tēnei rorohiko i muri tata nei. Ki te haere tonu me te Tautuhia anō tēnei rorohiko, kāore e taea e koe te wete te whakahōu.
  \resources\PBR_Title:
    Candidate Language=MI-NZ: Tautuhi anō i tēnei RW
  \resources\PBR_SessionPreparation_Header:
    Candidate Language=MI-NZ: Kei te takatū i ngā āhuatanga
  \resources\PBR_SessionPreparation_Desc\Text:
    Candidate Language=MI-NZ: E kore tēnei e roa
  \resources\PBR_ResetTypeSelection_ResetOption_Desc:
    Candidate Language=MI-NZ: Ka tango tēnei i ō kōnae whaiaro, i ō taupānga me ngā tautuhinga.
  \resources\PBR_ResetTypeSelection_ResetOption:
    Candidate Language=MI-NZ: Tango i ngā mea katoa
  \resources\PBR_ResetTypeSelection_RefreshOption_Desc:
    Candidate Language=MI-NZ: Ka tango tēnei i ngā taupānga me ngā tautuhinga, engari ka puritia ō kōnae whaiaro.
  \resources\PBR_ResetTypeSelection_RefreshOption:
    Candidate Language=MI-NZ: Puritia aku kōnae
  \resources\PBR_ResetTypeSelection_Header:
    Candidate Language=MI-NZ: Kōwhiria he kōwhiringa
  \resources\PBR_ResetOptions_SummaryLine\Text:
    Candidate Language=MI-NZ: Ngā tautuhinga onāianei:
  \resources\PBR_ResetOptions_Header:
    Candidate Language=MI-NZ: Ngā tautuhinga tāpiri
  \resources\PBR_ResetOptions_AdvancedOptions:
    Candidate Language=MI-NZ: Hurihia ngā tautuhinga
  \resources\PBR_ResetCancellation_Header:
    Candidate Language=MI-NZ: Whakakore ana
  \resources\PBR_ResetCancellation_Desc\Text:
    Candidate Language=MI-NZ: Kāore tēnei e roa
  \resources\PBR_Reset:
    Candidate Language=MI-NZ: Tautuhi anō
  \resources\PBR_RemovedAppsList_Header:
    Candidate Language=MI-NZ: He rārangi taupānga hei tango
  \resources\PBR_RemovedAppsList_Desc\Text:
    Candidate Language=MI-NZ: Ka taea e koe te tāuta anō ngā taupānga maha mai i te Store, engari me tāuta anō i ngā taupānga e whai ake nei mai i te tukutuku, i ngā kōpae tāuta rānei. Ka tiakina ki te papamahi tēnei rārangi o ngā taupānga i muri i te Tautuhi Anō.
  \resources\PBR_Note\Text:
    Candidate Language=MI-NZ: Tuhipoka:
  \resources\PBR_MultipleUsersWarning_Header:
    Candidate Language=MI-NZ: Kua takiuru kē mai ētahi tāngata ki tēnei RW
  \resources\PBR_MultipleUsersWarning_Desc\Text:
    Candidate Language=MI-NZ: Kei te hiahia koe kia haere tonu? Mā konei ka ngaro i a rātou ā rātou raraunga kore tiaki.
  \resources\PBR_MeteredDataWarning_Format:
    Candidate Language=MI-NZ: Tikiake kapua whakamahi neke atu i te 4 KKP o te raraunga. Kei te inetia tō hononga ka pā pea ngā utu.
  \resources\PBR_LearnMore_Text\Text:
    Candidate Language=MI-NZ: Akona ētahi atu mea mō te tautuhi anō i tēnei rorohiko
  \resources\PBR_HelpToChoose\Content:
    Candidate Language=MI-NZ: Āwhinatia au kia kōwhiri
  \resources\PBR_FinalPreparation_Header:
    Candidate Language=MI-NZ: Whakarite ana ki te tautuhi anō
  \resources\PBR_FinalPreparation_Format:
    Candidate Language=MI-NZ: Tūnga: Whakarite Ana – %d%%
  \resources\PBR_FinalPreparation_Finalize:
    Candidate Language=MI-NZ: Kei te takatū ki te tīmata anō
  \resources\PBR_FinalPreparation_Desc\Text:
    Candidate Language=MI-NZ: Ka tīmataria aunoatia anō tēnei pūrere
  \resources\PBR_FinalPreparation_CloudFormat:
    Candidate Language=MI-NZ: Tūnga: Tikiake Ana – %d%%
  \resources\PBR_Error_Header:
    Candidate Language=MI-NZ: I puta tētahi raru i te tautuhinga anō i tō RW
  \resources\PBR_Error_Desc\Text:
    Candidate Language=MI-NZ: Kāore he huringa i mahia.
  \resources\PBR_ErrorWindowsToGo_Desc\Text:
    Candidate Language=MI-NZ: E kore e taea te tautuhi anō i tō RW nā te mea kei te whakahaere i Windows To Go.
  \resources\PBR_ErrorSafeMode_Header:
    Candidate Language=MI-NZ: Kāore tēnei āhuahira i te wātea i Aratau Haumaru
  \resources\PBR_ErrorSafeMode_Desc\Text:
    Candidate Language=MI-NZ: Hei tautuhi anō i tēnei RW, me tīmata pūnoa anō i Windows ka ngana anō ai, haere rānei ki Tīmata hōhonu ka tīpako ai i Raparongoā.
  \resources\PBR_ErrorRedirectedProfiles_Header:
    Candidate Language=MI-NZ: Kāore i taea te tautuhi anō i tēnei RW me te tiaki anō i ō kōnae
  \resources\PBR_ErrorRedirectedProfiles_Desc\Text:
    Candidate Language=MI-NZ: Hei tautuhi anō i tēnei RW me te pupuru i ō kōnae, me mātua noho ngā whirihora mō ngā Kaiwhakamahi, ngā Kōnae Papatono me Windows i te puku kotahi. Ka taea e koe te kōwhiri kia tautuhi anō i tēnei RW, me te tango kē i ngā mea katoa, engari me mātua tārua koe i ō kōnae whaiaro i te tuatahi.
  \resources\PBR_ErrorPayloadVersionMismatch_Desc\Text:
    Candidate Language=MI-NZ: He muhu te tikiake. Ngana anō ka tīpako i te kōwhiringa tāuta paetata.
  \resources\PBR_ErrorPayloadDownload_Desc\Text:
    Candidate Language=MI-NZ: I haukotia te tikiake. Tirohia tō tūhononga ka ngana anō, ka tīpako rānei te kōwhiringa tāuta paetata.
  \resources\PBR_ErrorPayloadConnection_Desc\Text:
    Candidate Language=MI-NZ: Kāore he tūhono ki te tūmau. Tirohia tō tūhononga ka ngana anō, ka tīpako rānei te kōwhiringa tāuta paetata.
  \resources\PBR_ErrorNotSupportedInEdition_Desc\Text:
    Candidate Language=MI-NZ: Kāore tēnei putanga e tautoko i te kōwhiringa whakaora tīpako. Ngana anō me tētahi kōwhiringa kē.
  \resources\PBR_ErrorNoRecoveryEnv_Header:
    Candidate Language=MI-NZ: Kāore i taea te kite te horopaki whakaora
  \resources\PBR_ErrorNoRecoveryEnv_Desc\Text:
    Candidate Language=MI-NZ: Kuhuna atu tō pāpāho tāuta Windows, whakaora rānei, kuhuna mai ka tīmata anō i te RW mai ki te pāpāho.
  \resources\PBR_ErrorNoPayload_Desc\Text:
    Candidate Language=MI-NZ: Kāore he tikiake wātea. Ngana anō ka tīpako i te kōwhiringa tāuta paetata.
  \resources\PBR_ErrorNoPayloadSupport_Desc\Text:
    Candidate Language=MI-NZ: Kāore e tautoko tēnei tauari whakaora i te kōwhiringa tikiake ā-kapua. Ngana anō ka tīpako i te kōwhiringa tāuta paetata.
  \resources\PBR_ErrorNoDeownlevelEnv_Desc\Text:
    Candidate Language=MI-NZ: Mēnā he pāpāho tāuta Windows, whakaora rānei, kuhuna mai ka tīmata anō i te RW mai i te pāpāho.
  \resources\PBR_ErrorInsufficientSpace_Line3\Text:
    Candidate Language=MI-NZ: • Wetetāuta papatono
  \resources\PBR_ErrorInsufficientSpace_Line2\Text:
    Candidate Language=MI-NZ: • Tāruatia ō kōnae ki tētahi pūrere ā-waho me te muku i tēnei rorohiko
  \resources\PBR_ErrorInsufficientSpace_Line1\Text:
    Candidate Language=MI-NZ: • Whakahaere Tahitahi Kōpae
  \resources\PBR_ErrorInsufficientSpace_Line0\Text:
    Candidate Language=MI-NZ: Hei whakawātea i ētahi mokowā puku, ka taea e koe te:
  \resources\PBR_ErrorInsufficientSpace_Header:
    Candidate Language=MI-NZ: Ngā mokowā kōpae e hiahiatia ana
  \resources\PBR_ErrorInsufficientSpace_Desc:
    Candidate Language=MI-NZ: Kei te hiahiatia tētahi %1!ws! mokowā puku wātea i (%2!ws!).
  \resources\PBR_ErrorFileNotTrust_Desc\Text:
    Candidate Language=MI-NZ: Kāore e whirinakitia ana ngā kōnae e hiahiatia ana. Kua mōnehu pea te tiwhikete o ngā kōnae, kua whakakētia rānei ngā kōnae e ētahi atu.
  \resources\PBR_ErrorDisabled_Desc\Text:
    Candidate Language=MI-NZ: Kāore e whakaaengia i raro i ngā kaupapahere o tō whakahaere. Mō ētahi atu kōrero, kōrero ki tō kaitautoko ki te tari IT rānei.
  \resources\PBR_ErrorCloud_Header:
    Candidate Language=MI-NZ: I raru te tikiake
  \resources\PBR_ErrorCant_Header:
    Candidate Language=MI-NZ: Kāore i taea e mātou tēnei RW te tautuhi anō
  \resources\PBR_DataWarning_Format:
    Candidate Language=MI-NZ: Tikiake kapua whakamahi neke atu i te 4 KKP o te raraunga.
  \resources\PBR_DataDriveList_Header:
    Candidate Language=MI-NZ: Ngā puku tērā pea ka pāngia
  \resources\PBR_DataDriveList_Desc\Text:
    Candidate Language=MI-NZ: KI te kōwhiri koe ki te tango i ngā kōnae mai i ngā puku katoa, ka pāngia ēnei puku e whai ake nei:
  \resources\PBR_ConfirmReset_NoApps\Text:
    Candidate Language=MI-NZ: • Tangohia ngā taupānga me ngā papatono katoa
  \resources\PBR_ConfirmReset_Line3\Text:
    Candidate Language=MI-NZ: • Tangohia ngā huringa i mahia ki ngā tautuhinga
  \resources\PBR_ConfirmReset_Line2\Text:
    Candidate Language=MI-NZ: • Tangohia ngā taupānga me ngā papatono katoa kāore i haere tahi mai me tēnei rorohiko
  \resources\PBR_ConfirmReset_Line1\Text:
    Candidate Language=MI-NZ: • Tangohia ngā kōnae whaiaro katoa me ngā pūkete kaiwhakamahi i tēnei rorohiko
  \resources\PBR_ConfirmReset_Line0\Text:
    Candidate Language=MI-NZ: Mā te tautuhi anō e:
  \resources\PBR_ConfirmRefresh_RemovedAppsList\Content:
    Candidate Language=MI-NZ: Tirohia ngā taupānga ka tangohia
  \resources\PBR_ConfirmRefresh_NoApps\Text:
    Candidate Language=MI-NZ: • Tangohia ngā taupānga me ngā papatono katoa
  \resources\PBR_ConfirmRefresh_Line3_Featured\Text:
    Candidate Language=MI-NZ: • Puritia ngā kōnae whaiaro
  \resources\PBR_ConfirmRefresh_Line2\Text:
    Candidate Language=MI-NZ: • Hurihia ngā tautuhinga ki ngā taunoa
  \resources\PBR_ConfirmRefresh_Line1\Text:
    Candidate Language=MI-NZ: • Tangohia ngā taupānga me ngā papatono katoa kāore i haere tahi mai me tēnei rorohiko
  \resources\PBR_ConfirmRefresh_Line0\Text:
    Candidate Language=MI-NZ: Mā te tautuhi anō e:
  \resources\PBR_ConfirmPage_MeteredDataWarning_Format:
    Candidate Language=MI-NZ: • Ka taea e ngā tikiake kapua te whakamahi neke atu i %ws o te raraunga. Kei te inehia tō hononga, ā, ka pā pea ngā utu.
  \resources\PBR_ConfirmPage_Header:
    Candidate Language=MI-NZ: Kua rite mō te tautuhi anō i tēnei RW
  \resources\PBR_ConfirmPage_Desc\Text:
    Candidate Language=MI-NZ: • Ka roa pea tēnei, ā, ka tīmata anō tō Rorohiko.
  \resources\PBR_ConfirmPage_DataWarning_Format:
    Candidate Language=MI-NZ: • Ka taea e ngā tikiake kapua te whakamahi neke atu i %ws o te raraunga.
  \resources\PBR_ConfirmPage_BitlockerSuspended\Text:
    Candidate Language=MI-NZ: • Ka whakatārewatia rangitahitia te whakamunatanga puku BitLocker te kia oti te tukanga.
  \resources\PBR_ConfirmPage_BitlockerOff\Text:
    Candidate Language=MI-NZ: • Ka whakawetohia te whakamunatanga puku BitLocker.
  \resources\PBR_BatteryError_Header:
    Candidate Language=MI-NZ: Mono mai i tō RW
  \resources\PBR_BatteryError_Desc\Text:
    Candidate Language=MI-NZ: E kore e taea e mātou te tautuhi anō i tō RW i a ia e haere ana i runga i te kahanga pūhiko.
  \resources\PBR_Advanced_Workplace_Text:
    Candidate Language=MI-NZ: Mukua ngā rauemi wāhi mahi?
  \resources\PBR_Advanced_Workplace_SelectionOn:
    Candidate Language=MI-NZ: • Mukua ngā mōkihi whakariterite mai i tō wāhi mahi
  \resources\PBR_Advanced_Workplace_SelectionOff:
    Candidate Language=MI-NZ: • Puritia ngā mōkī mai i tō wāhi mahi whakaratonga
  \resources\PBR_Advanced_Workplace_OnDesc:
    Candidate Language=MI-NZ: Mukua ngā mōkihi whakariterite mai i tō wāhi mahi
  \resources\PBR_Advanced_Workplace_OffDesc:
    Candidate Language=MI-NZ: Puritia ngā mōkī mai i tō wāhi mahi whakaratonga
  \resources\PBR_Advanced_WipeData_ToggleOn:
    Candidate Language=MI-NZ: Āe, ngā puku katoa
  \resources\PBR_Advanced_WipeData_ToggleOff:
    Candidate Language=MI-NZ: Kāo, puku Windows anake
  \resources\PBR_Advanced_WipeData_Text:
    Candidate Language=MI-NZ: Mukua ngā kōnae mai i ngā puku katoa?
  \resources\PBR_Advanced_WipeData_SelectionOn:
    Candidate Language=MI-NZ: • Mukua katoatia ngā kōnae mai i ngā puku katoa
  \resources\PBR_Advanced_WipeData_SelectionOff:
    Candidate Language=MI-NZ: • Mukua katoatia ngā kōnae mai i te puku Windows anake
  \resources\PBR_Advanced_WipeData_OnDesc:
    Candidate Language=MI-NZ: Mukua katoatia ngā kōnae mai i ngā puku katoa. Ka hoatu ngā kōwhiringa mā ngā raraunga ki ngā puku katoa
  \resources\PBR_Advanced_WipeData_OffDesc:
    Candidate Language=MI-NZ: Mukua katoatia ngā kōnae mai i te puku Windows anake
  \resources\PBR_Advanced_PreinstalledApps_Text:
    Candidate Language=MI-NZ: Whakaora ngā taupānga tāutu?
  \resources\PBR_Advanced_PreinstalledApps_SelectionOn:
    Candidate Language=MI-NZ: • Whakaorahia ngā taupānga me ngā tautuhinga i haere tahi me tēnei rorohiko
  \resources\PBR_Advanced_PreinstalledApps_SelectionOff:
    Candidate Language=MI-NZ: • Kaua e whakaora i ngā taupānga me ngā tautuhinga i haere tahi me tēnei rorohiko
  \resources\PBR_Advanced_PreinstalledApps_OnDesc:
    Candidate Language=MI-NZ: Whakaorahia ngā taupānga me ngā tautuhinga i haere tahi me tēnei rorohiko
  \resources\PBR_Advanced_PreinstalledApps_OffDesc:
    Candidate Language=MI-NZ: Kaua e whakaora i ngā taupānga me ngā tautuhinga i haere tahi me tēnei rorohiko
  \resources\PBR_Advanced_Header:
    Candidate Language=MI-NZ: Kōwhirihia ngā tautuhinga
  \resources\PBR_Advanced_Esim_Text:
    Candidate Language=MI-NZ: Mukua ngā kōtaha eSIM?
  \resources\PBR_Advanced_Esim_SelectionOn:
    Candidate Language=MI-NZ: • Mukua katoatia ngā kōtaha eSIM mō ngā raraunga pūkoro
  \resources\PBR_Advanced_Esim_SelectionOff:
    Candidate Language=MI-NZ: • Pupuri katoatia ngā kōtaha eSIM mō ngā raraunga pūkoro
  \resources\PBR_Advanced_Esim_OnDesc:
    Candidate Language=MI-NZ: Mukua katoatia ngā kōtaha eSIM mō ngā raraunga pūkoro
  \resources\PBR_Advanced_Esim_OffDesc:
    Candidate Language=MI-NZ: Pupuri katoatia ngā kōtaha eSIM mō ngā raraunga pūkoro
  \resources\PBR_Advanced_Erase_Text:
    Candidate Language=MI-NZ: Raraunga mā?
  \resources\PBR_Advanced_Erase_SelectionOn:
    Candidate Language=MI-NZ: • Tangohia ngā taupānga me ngā kōnae. Tahitahia te puku
  \resources\PBR_Advanced_Erase_SelectionOff:
    Candidate Language=MI-NZ: • Tangohia ngā taupānga me ngā kōnae. Kāore e tahitahia te puku
  \resources\PBR_Advanced_Erase_OnDesc:
    Candidate Language=MI-NZ: Tahitahia te puku. E hia ngā haora te roa pea o tēnei, engari ka uaua ake, ki te whakaora kōnae
  \resources\PBR_Advanced_Erase_OffDesc:
    Candidate Language=MI-NZ: Tango noatia ō kōnae. He hohoro atu, engari he iti iho te haumarutanga
  \resources\PBR_Advanced_Confirm\Content:
    Candidate Language=MI-NZ: Whakaū
  \resources\PBR_Advanced_CloudRecovery_Text:
    Candidate Language=MI-NZ: Tikiake Windows?
  \resources\PBR_Advanced_CloudRecovery_SelectionOn:
    Candidate Language=MI-NZ: • Tikiake me te tāuta anō i Windows
  \resources\PBR_Advanced_CloudRecovery_SelectionOff:
    Candidate Language=MI-NZ: • Tāutaia anō a Windows mai i tēnei pūrere
  \resources\PBR_Advanced_CloudRecovery_OnText:
    Candidate Language=MI-NZ: Tikiake kapua
  \resources\PBR_Advanced_CloudRecovery_OnDesc:
    Candidate Language=MI-NZ: Tikiake me te tāuta anō i Windows
  \resources\PBR_Advanced_CloudRecovery_OffText:
    Candidate Language=MI-NZ: Tāuta anō te paetata
  \resources\PBR_Advanced_CloudRecovery_OffDesc:
    Candidate Language=MI-NZ: Tāutatia anō a Windows mai i tēnei pūrere
  \resources\PBR_Advanced_CloudRecovery_Header:
    Candidate Language=MI-NZ: Me pēhea te tāuta anō i Windows?
  \resources\PBR_Advanced_CloudRecovery_DisabledDesc:
    Candidate Language=MI-NZ: Āta titiro kua tūhono ki te ipurangi ka ngana anō
  \resources\Password:
    Candidate Language=MI-NZ: Kupuhipa
  \resources\Ok:
    Candidate Language=MI-NZ: ĀE
  \resources\No_GoBack:
    Candidate Language=MI-NZ: Kāo, hoki atu
  \resources\No:
    Candidate Language=MI-NZ: Kāo
  \resources\NLA_Enable_HeaderText:
    Candidate Language=MI-NZ: Whakaaetia ngā hononga whai Motuhēhēnga Taumata Whatunga anake?
  \resources\NLA_Enable_BodyText:
    Candidate Language=MI-NZ: E manakotia ana tēnei.
  \resources\NLA_Disable_HeaderText:
    Candidate Language=MI-NZ: Whakaae ki ngā hononga kāore anō kia uru ki te Motuhēhēnga Taumata Whatunga?
  \resources\NLA_Disable_BodyText:
    Candidate Language=MI-NZ: Ki te whakaae koe ki ngā hohonga me te kore NLA, kei te hura koe i tō rorohiko kia tomokia e ngā mōrearea haumarutanga.
  \resources\Next:
    Candidate Language=MI-NZ: Panuku
  \resources\ManageExclusion_SAVE_FAIL_ErrorText:
    Candidate Language=MI-NZ: Ka aroha, kāore e taea te tiaki te Aukati.
  \resources\ManageExclusion_Process_ADD_FAIL_ErrorText:
    Candidate Language=MI-NZ: Kāore e taea ēnei pūāhua i roto i te ingoa tukanga: /"<>|?*
  \resources\ManageExclusion_Extension_ADD_FAIL_ErrorText:
    Candidate Language=MI-NZ: Kāore e taea ēnei pūāhua i roto i te toronga kōnae: \ /:"<>|?*
  \resources\ManageExclusion_BodyText:
    Candidate Language=MI-NZ: Tāurua he ingoa aukati hōu.
  \resources\ManageExclusion_AuthBodyText:
    Candidate Language=MI-NZ: Tāurua ō mōhiohio pūkete rohe hei whakatūturu he mana tōu ki te whakahaere aukati.
  \resources\ManageExclusion_ADD_FAIL_EmptyText:
    Candidate Language=MI-NZ: Kia kaua te aho putua hei toronga kōnae, te aho mokowā mā anake rānei
  \resources\Lockdown_SignOutWarningText:
    Candidate Language=MI-NZ: Mehemea kua takiurutia te pūkete i tīpakona, me mātua takiputa atu koe ka takiuru mai anō hei hoatu i ngā huringa. Ko ngā pūkete urunga kua takiurutia mai ka takiputatia atu.
  \resources\LockdownUser_HeaderText:
    Candidate Language=MI-NZ: Kōwhiria tētahi pūkete
  \resources\LockdownUser_EmptyListText:
    Candidate Language=MI-NZ: Ko te pūkete e takiurua ana ināianei ko te pūkete hohe anake kei tēnei pūrere. Tāpirihia, waihangahia rānei he pūkete hou ka ngana anō.
  \resources\LockdownApp_HeaderText:
    Candidate Language=MI-NZ: Kōwhiria he taupānga
  \resources\LockdownApp_EmptyListText:
    Candidate Language=MI-NZ: Kāore he taupānga o tēnei pūkete. Tāutahia kia kotahi te taupānga i te itinga rawa ki te pūkete kua tīpakohia ka ngana anō.
  \resources\LeaveDomain_RestartHeaderText:
    Candidate Language=MI-NZ: Tīmatahia anōtia tō rorohiko
  \resources\LeaveDomain_RestartBody_DomainUser_Text:
    Candidate Language=MI-NZ: I muri i te tīmata anō, kāore e honoa atu tō rorohiko ki %1. Me takiuru e koe mā tētahi pūkete kaiwhakamahi anō, pērā i tērā i tāurua e koe ki te whārangi i mua ake.
  \resources\LeaveDomain_RestartBodyText:
    Candidate Language=MI-NZ: I muri i te tīmata anō, kāore e honoa atu tō rorohiko ki %1.
  \resources\LeaveDomain_NonAdmin_Credentials:
    Candidate Language=MI-NZ: Kāore i whaihua taua mōhiohio pūkete. Āta titiro kei te tāuru mōhiohio koe mō tētahi pūkete kaiwhakahaere paetata, ka ngana anō.
  \resources\LeaveDomain_NERR_SetupNotJoined:
    Candidate Language=MI-NZ: He mea hono tēnei rorohiko ki tētahi rohe
  \resources\LeaveDomain_Leave_Domain_Failed:
    Candidate Language=MI-NZ: Kua puta he raruraru. Ngana anō ā muri ake.
  \resources\LeaveDomain_Incorrect_Password:
    Candidate Language=MI-NZ: Kāore taua kupuhipa i mahi. Āta takina ka ngana anō.
  \resources\LeaveDomain_ConfirmNextButtonText:
    Candidate Language=MI-NZ: Momotu
  \resources\LeaveDomain_ConfirmHeaderText:
    Candidate Language=MI-NZ: Motukia te whakahaere
  \resources\LeaveDomain_ConfirmBody_DomainUser_Text:
    Candidate Language=MI-NZ: 
      I mua i te momotu, me takiuru koe mā tētahi pūkete Kaiwhakahaere ehara nō tō whakahaere, pērā i tō pūkete Microsoft.

Ka wehe koe i te whakahaere, kāore e taea te takiuru mā ngā pūkete o tō whakahaere i runga i tēnei rorohiko.
    
  \resources\LeaveDomain_ConfirmBodyText:
    Candidate Language=MI-NZ: I muri i te motu i te tūhono, kua kore e taea e koe te takiuru anō ki tēnei rorohiko mā tō pūkete umanga.

Mēnā kei te tāuta me te mahi te BitLocker ki tēnei rorohiko, me mātua whakarite ka tiakina he tārua o te kī whakaora BitLocker ki tētahi wāhi i tua atu i tēnei rorohiko.
  \resources\LeaveDomain_AuthBodyTitle:
    Candidate Language=MI-NZ: Tāurua ngā taipitopito pūkete kē
  \resources\LeaveDomain_AuthBodyText:
    Candidate Language=MI-NZ: Kia taea e koe te takiuru ki tēnei rorohiko i muri mai i te momotu mai i tō umanga, tāurua ngā kōrero takiuru mō tētahi pūkete kaiwhakahaere paetata. Ka taea he pūkete Microsoft, he pūkete paetata rānei. Mēnā kāore i a koe tētahi, me waihanga mai e koe.
  \resources\JoinDomain_RPC_S_SERVER_UNAVAILABLE:
    Candidate Language=MI-NZ: Kāore e taea te hono ki te rohe i tēnei wā. Āta titiro kua tūhono koe ki tō whatunga mahi ka ngana anō.
  \resources\JoinDomain_RPC_S_CALL_IN_PROGRESS:
    Candidate Language=MI-NZ: E tūhono kē ana tēnei rorohiko ki te rohe. Tīmataria anō tō rorohiko ka ngana anō.
  \resources\JoinDomain_RestartPCHeaderText:
    Candidate Language=MI-NZ: Tīmatahia anōtia tō rorohiko
  \resources\JoinDomain_NERR_SetupAlreadyJoined:
    Candidate Language=MI-NZ: Kua tūhono kē tēnei rorohiko ki te rohe
  \resources\JoinDomain_HeaderText:
    Candidate Language=MI-NZ: Uru atu ki tētahi rohe
  \resources\JoinDomain_ERROR_NO_SUCH_MEMBER:
    Candidate Language=MI-NZ: Kāore i kitea taua pūkete rohe. Takina te ingoa pūkete ka ngana anō.
  \resources\JoinDomain_ERROR_MEMBER_IN_ALIAS:
    Candidate Language=MI-NZ: Kua oti tēnei pūkete te tatū ki tēnei rorohiko.
  \resources\JoinDomain_ERROR_INVALID_DOMAIN:
    Candidate Language=MI-NZ: Kāore i kitea taua rohe. Takina te ingoa rohe ka ngana anō.
  \resources\JoinDomain_ERROR_DUP_NAME:
    Candidate Language=MI-NZ: Kei te whakamahia kēhia tēnei ingoa rorohiko. Tīpako he ingoa rorohiko kē ka ngana anō.
  \resources\JoinDomain_ERROR_ACCESS_DENIED:
    Candidate Language=MI-NZ: Kāore e taea te uru ki te rohe. Whakarite kua whiwhi whakaaetanga koe kia uru ki te rohe, ka tīpako i tētahi ingoa rorohiko kē ka ngana anō.
  \resources\JoinDomain_DomainNameDescriptionText:
    Candidate Language=MI-NZ: Ingoa rohe
  \resources\JoinDomain_ConfirmBodyText:
    Candidate Language=MI-NZ: Ka oti te tīmata anō, ka tūhonoa tō rorohiko ki tēnei rohe: 
  \resources\JoinDomain_CANNOT_JOIN_ERROR:
    Candidate Language=MI-NZ: Kāore e taea te uru ki tēnei rohe. Whakapā ki tō kaiwhakahaere IT mō ētahi atu mōhiohio.
  \resources\JoinDomain_AuthHeaderText:
    Candidate Language=MI-NZ: Takiuru ki te rohe
  \resources\JoinDomain_AuthBodyText:
    Candidate Language=MI-NZ: Tāurua ō mōhiohio pūkete rohe ki te manatoko kua whiwhi whakaaetanga koe ki te tūhono ki te rohe.
  \resources\JoinDomain_ADD_LOCAL_USER_FAILED:
    Candidate Language=MI-NZ: Kua puta he raruraru. Ngana anō ā muri ake.
  \resources\JoinDomain_AddDomainUserHeaderText:
    Candidate Language=MI-NZ: Tāpirihia he pūkete
  \resources\JoinDomain_AddDomainUserGroupText:
    Candidate Language=MI-NZ: Momo pūkete
  \resources\JoinDomain_AddDomainUserBodyText:
    Candidate Language=MI-NZ: Tāurua te mōhiohio pūkete mō te tangata ka whakamahi i tēnei rorohiko. Ki te tīpoka koe i tēnei hipanga, ka whiwhi te tangata ki ngā whakaaetanga taunoa mō te rohe.
  \resources\JoinDomain_AddDomainUserAccountText:
    Candidate Language=MI-NZ: Pūkete kaiwhakamahi
  \resources\InPlaceUpgrade_Title:
    Candidate Language=MI-NZ: Whakatika raru mā te whakamahi i te Whakahou Windows
  \resources\InPlaceUpgrade_Header:
    Candidate Language=MI-NZ: Ka tapia e mātou he wae me ngā kōnae pūnaha
  \resources\InPlaceUpgrade_ExpeditedSessionCheckBox:
    Candidate Language=MI-NZ: Tīmata aunoa i taku rorohiko whaiaro, RW ina 15 meneti ake i muri i te tāutanga
  \resources\InPlaceUpgrade_BodyText2\Text:
    Candidate Language=MI-NZ: Me whakarite nei kei te kā tō RW me te tūhono ki te whatunga, ki te pūtake hiko hoki. Ā muri i te tāutanga, ka whakamōhiotia koe ina tae mai te wā ki te tīmata anō i tō RW kia oti ai te tapitapi.
  \resources\InPlaceUpgrade_BodyText1\Text:
    Candidate Language=MI-NZ: Ki te wātea he rongoā tapitapi, ka ngana mātou ki te tapi i te hāmatenga wae pūnaha mā te tāuta anō i te putanga onāianei o Windows. Ko ō taupānga, ō tuhinga me ō tautuhinga e ū tonu.
  \resources\HolographicUninstall_SucceededHeaderText:
    Candidate Language=MI-NZ: Kua tutuki te wetetāuta
  \resources\HolographicUninstall_SucceededBodyText:
    Candidate Language=MI-NZ: Kua oti te Windows Mixed Reality te tango.
  \resources\HolographicUninstall_RestartHeaderText:
    Candidate Language=MI-NZ: Kei te hiahiatia he tīmata anō
  \resources\HolographicUninstall_RestartBodyText:
    Candidate Language=MI-NZ: Tīmata anō i tō rorohiko hei whakaoti i te wetetāuta o Windows Mixed Reality.
  \resources\HolographicUninstall_LearnMoreText:
    Candidate Language=MI-NZ: Ako i ētahi atu mea
  \resources\HolographicUninstall_HeaderText:
    Candidate Language=MI-NZ: Wetetāuta Windows Mixed Reality
  \resources\HolographicUninstall_ErrorText:
    Candidate Language=MI-NZ: Kāore i taea e mātou te whakaoti i te tango o Windows Mixed Reality. Tērā pea kei tō rorohiko tonu ētahi kōnae, mōhiohio whai pānga.
  \resources\HolographicUninstall_BodyText:
    Candidate Language=MI-NZ: Mā tēnei e tango te Windows Mixed Reality.
  \resources\GetHelp:
    Candidate Language=MI-NZ: Kimi āwhina
  \resources\Finish:
    Candidate Language=MI-NZ: Mutu
  \resources\Exclusion_NameText:
    Candidate Language=MI-NZ: Ingoa aukati: 
  \resources\EulaContent\[using:Windows.UI.Xaml.Automation]AutomationProperties\Name:
    Candidate Language=MI-NZ: Ngā Ture Raihana Pūmanawa Microsoft
  \resources\EnterProductKey_UpgradeProgressText:
    Candidate Language=MI-NZ: %d%% kua oti
  \resources\EnterProductKey_UpgradeProgressInstructionsText:
    Candidate Language=MI-NZ: Ka roa pea te wā mō tēnei mahi. Tēnā, kaua e whakawetohia tō RW!
  \resources\EnterProductKey_UpgradeProgressHeaderText:
    Candidate Language=MI-NZ: Te whakarite ki te whakamohoa
  \resources\EnterProductKey_UpgradePageHeaderText:
    Candidate Language=MI-NZ: Whakamohoatia tō putanga o Windows
  \resources\EnterProductKey_UpgradeInstructions2Text:
    Candidate Language=MI-NZ: Ka roa pea te wā o te whakamohoa, ā, ka tīmata anō tēnei pūrere. Kāore e taea e koe te whakamahi tēnei pūrere kia mutu rā anō.
  \resources\EnterProductKey_UpgradeInstructions1Text:
    Candidate Language=MI-NZ: Mā te whakamohoa i tō putanga ka tāpirihia he āhuahira hōu tāpiri ki Windows. I mua i tō tīmata, me mātua tiaki i ō mahi me te kati i ngā taupānga.
  \resources\EnterProductKey_UpgradeGvlkWarningText:
    Candidate Language=MI-NZ: Hei whakahohe i tēnei kī hua, i muri i te whakamohoa i tō putanga o Windows, me tūhono tēnei pūrere ki te ratonga whakahohe a tō whakahaere.
  \resources\EnterProductKey_UpgradeErrorText:
    Candidate Language=MI-NZ: Tē taea te whakamohoa ki tō putanga Windows. Me ngana te whakamohoa anō i tō putanga Windows. (0x%08x)
  \resources\EnterProductKey_UpgradeErrorHeaderText:
    Candidate Language=MI-NZ: Tē taea te whakamohoa ki tō putanga
  \resources\EnterProductKey_UpgradeButtonText:
    Candidate Language=MI-NZ: Tīmata
  \resources\EnterProductKey_PlaceholderText:
    Candidate Language=MI-NZ: XXXXX-XXXXX-XXXXX-XXXXX-XXXXX
  \resources\EnterProductKey_LabelText:
    Candidate Language=MI-NZ: Kī hua
  \resources\EnterProductKey_InvalidKey:
    Candidate Language=MI-NZ: Kāore i mahi te kī hua i tāurua e koe. Tirohia te kī hua ka ngana anō, tāurua rānei he mea kē. (0x%08x)
  \resources\EnterProductKey_InvalidCharacters:
    Candidate Language=MI-NZ: Kāore e puta ake ētahi o ēnei pūāhua i roto i te kī hua.
  \resources\EnterProductKey_InstructionsText:
    Candidate Language=MI-NZ: Ko te tikanga kei roto tō kī hua i tētahi īmēra mai i te tangata nāna i hoko, whakarato rānei i a Windows ki a koe, kei te pouaka rānei i roto i te KAM Windows, USB rānei.
  \resources\EnterProductKey_HeaderText:
    Candidate Language=MI-NZ: Tāurua he kī hua
  \resources\EnterProductKey_GvlkWarningText:
    Candidate Language=MI-NZ: Hei whakahohe i tēnei kī hua, me tūhono tēnei pūrere ki te ratonga whakahohe a tō whakahaere.
  \resources\EnterProductKey_GoToStoreErrorText:
    Candidate Language=MI-NZ: Tē taea te huaki i te Store i tēnei wā tonu. Me ngana ā muri ake.
  \resources\EnterProductKey_GoToStoreDescriptionText:
    Candidate Language=MI-NZ: Ka taea anō e koe te whakahohe i tēnei pūrere mā te haere ki te Store ka hoko i tētahi tārua tūturu o Windows.
  \resources\EnterProductKey_GoToStoreButtonText:
    Candidate Language=MI-NZ: Haere ki te Store
  \resources\EnterProductKey_EulaLinkText:
    Candidate Language=MI-NZ: Pānuitia ngā Ture Raihana Pūmanawa Microsoft
  \resources\EnterProductKey_EulaErrorText:
    Candidate Language=MI-NZ: Tē taea e mātou te tāuta Ngā Whakaritenga Raihana Pūmanawa o Microsoft i tēnei wā tonu. Me ngana ā muri ake. (0x%08x)
  \resources\EnterProductKey_Error_WrongSku:
    Candidate Language=MI-NZ: Kei te whakahaere %WINDOWS_LONG% koe. Kāore e taea te kī hua i tāurua e koe hei whakahohe i tēnei putanga. (0x%08x)
  \resources\EnterProductKey_Error_UsedProductKey:
    Candidate Language=MI-NZ: Tē taea te whakahohe a Windows ki tēnei pūrere i te mea kua whakamahia kētia te kī hua i tāurua e koe. Tāurua he kī hua kē. (0x%08x)
  \resources\EnterProductKey_Error_ServiceDown:
    Candidate Language=MI-NZ: Kei te tino whakamā. Kua hinga tā mātou ratonga whakahohe. Kei te whakapau kaha ki te whakatika i te raru. (0x%08x)
  \resources\EnterProductKey_Error_ServerInvalidKey:
    Candidate Language=MI-NZ: Kāore i mahi te kī hua i tāurua e koe. Tirohia te kī hua ka ngana anō, tāurua rānei he mea kē. (0x%08x)
  \resources\EnterProductKey_Error_ServerBlockedKey:
    Candidate Language=MI-NZ: Tē taea a Windows te whakahohe me tēnei kī hua. Me whakamātau he kī kē. (0x%08x)
  \resources\EnterProductKey_Error_NotActivated:
    Candidate Language=MI-NZ: Tē taea a Windows te whakahohe me tēnei kī hua. Haere ki Ngā Tautuhinga mō ētahi atu mōhiohio. (0x%08x)
  \resources\EnterProductKey_Error_NoInternet:
    Candidate Language=MI-NZ: Tē taea te whakahohe a Windows i te mea kāore ā mātou tūmau whakahohe i te wātea i tēnei wā tonu. Me whakarite kei te tūhono koe ki te Ipurangi, ā, ka ngana aunoa mātou ki te whakahohe i a Windows ina wātea mai anō te ratonga. (0x%08x)
  \resources\EnterProductKey_Error_NoFreeUpgrade:
    Candidate Language=MI-NZ: Tē taea te whakahohe a Windows ki tēnei pūrere i te mea kua kore e mana te kī hua i tāurua e koe. Tāurua he kī hua kē. (0x%08x)
  \resources\EnterProductKey_Error_InvalidUpgrade:
    Candidate Language=MI-NZ: Kāore tēnei pūrere i te hohe. I rahua te whakamana kī hua mō te whakamohoa. (0x%08x)
  \resources\EnterProductKey_Error_CloudErrorFormat:
    Candidate Language=MI-NZ: %s (0x%08x)
  \resources\EnterProductKey_CloseButtonText:
    Candidate Language=MI-NZ: Kati
  \resources\EnterProductKey_ActivationErrorHeaderText:
