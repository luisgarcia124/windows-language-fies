  \resources\DisableUser_HeaderText:
    Candidate Language=MI-NZ: Me ārai rānei i tēnei tangata i te takiuru?
  \resources\DisableUser_GeneralErrorText:
    Candidate Language=MI-NZ: Kua puta he hapa.
  \resources\DisableUser_BodyText:
    Candidate Language=MI-NZ: Kua kore tonu e taea e rātou te takiuru me te whakamahi i tēnei rorohiko. Ka taea rātou te weteārai e koe ina hiahia koe.
  \resources\DevicePortalSetAuthentication_PromptText:
    Candidate Language=MI-NZ: Kei te tino hiahia koe ki te huri i tō ingoa kaiwhakamahi me tō kupuhipa mō te Tomokanga Pūrere?
  \resources\DevicePortalSetAuthentication_HeaderText:
    Candidate Language=MI-NZ: Whakaū huringa
  \resources\DevicePortalAuthentication_WarningText:
    Candidate Language=MI-NZ: Mā te whakaweto i te motuhēhēnga e taea e tētahi e pātata ana ki te whakahaere i tō pūrere me te pānui i ōna ihirangi.
  \resources\DevicePortalAuthentication_PromptText:
    Candidate Language=MI-NZ: Me whakaweto te motuhēhēnga?
  \resources\DevicePortalAuthentication_HeaderText:
    Candidate Language=MI-NZ: Motuhēhēnga Tomokanga Pūrere
  \resources\DeviceEncryption_TurnOffButtonText:
    Candidate Language=MI-NZ: Whakawetohia
  \resources\DeviceEncryption_HeaderText:
    Candidate Language=MI-NZ: Me whakaweto te whakamunatanga pūrere?
  \resources\DeviceEncryption_CancelButtonText:
    Candidate Language=MI-NZ: Whakakore
  \resources\DeviceEncryption_BodyText:
    Candidate Language=MI-NZ: Ki te pēnei koe, kāore ō kōnae e paparetia, ā, ka roa pea te whakamunatanga.
  \resources\DeviceDiscoveryUnpairAllDevices_WarningText:
    Candidate Language=MI-NZ: Mā tēnei e wewete i te takirua o ngā pūrere katoa kei te takiruatia ki tēnei ūnga.  Kia mōhio ka mau tonu ngā hononga pūrere tīari mā runga o SSH kia whakaarangia rā anō te pūnaha.
  \resources\DeviceDiscoveryUnpairAllDevices_PromptText:
    Candidate Language=MI-NZ: Me wetetakirua?
  \resources\DeviceDiscoveryUnpairAllDevices_HeaderText:
    Candidate Language=MI-NZ: Wetetakirua ngā pūrere katoa
  \resources\DeveloperMode_Unlock_PromptText:
    Candidate Language=MI-NZ: Whakakāhia te aratau kaiwhakawhanake?
  \resources\DeveloperMode_UnlockWarningText:
    Candidate Language=MI-NZ: Mā te whakakā i te aratau kaiwhakawhanake, tae atu ki te tāuta me te whakahaere i ngā taupānga mai i waho i te Microsoft Store ka wātea pea tō pūrere me ō raraunga whaiaro ki ngā mōrea haumarutanga, ka whara rānei tō pūrere.
  \resources\DeveloperMode_SurfaceHub_UnlockWarningText:
    Candidate Language=MI-NZ: Mā te whakakā i te aratau kaiwhakawhanake, tae atu ki te tāuta me te whakahaere i ngā taupānga mai i waho i te Microsoft Store ka wātea pea tō pūrere me ō raraunga whaiaro ki ngā mōrea haumarutanga, ka whara rānei tō pūrere. E kore te pūrere e horoi i ngā kai o roto, ngā taipitopito tuakiri rānei i roto i te aratau kaiwhakawhanake.
  \resources\DeveloperMode_SurfaceHub_ResetText:
    Candidate Language=MI-NZ: He uaua te puta atu i te aratau kaiwhakawhanake — me tino tautuhi anō e koe tēnei pūrere.
  \resources\DeveloperMode_LinkText:
    Candidate Language=MI-NZ: Ako atu anō.
