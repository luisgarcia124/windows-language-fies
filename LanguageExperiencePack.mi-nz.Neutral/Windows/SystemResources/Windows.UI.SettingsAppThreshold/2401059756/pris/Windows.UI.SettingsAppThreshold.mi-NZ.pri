  \SystemSettings\Resources\CorpDeviceManagementRemoveNotAllowedWorkFullWithAAD:
    Candidate Language=MI-NZ: Hei tango i te urunga mahi, haere ki Tō pūkete ka tango i tō pūkete mahi mai i reira.
  \SystemSettings\Resources\CorpDeviceManagementRemoveNotAllowedWorkDeviceWithAAD:
    Candidate Language=MI-NZ: Hei whakakore i te urunga mahi, tīpakohia Hono, wehe rānei i tētahi umanga i raro nei, ā, ka wehe i tō umanga.
  \SystemSettings\Resources\CorpDeviceManagementRemoveNotAllowedText:
    Candidate Language=MI-NZ: Kāore e taea tēnei mahi, kura rānei te tango e tētahi kaupapahere pūnaha.
  \SystemSettings\Resources\CorpDeviceManagementRemoveConsequencesText:
    Candidate Language=MI-NZ: Ki te tangohia te %1!s! ka mukua katoatia i tō pūrere te mōhiohio e pāhono ana ki tēnei pūkete.  Kei roto pea ko ngā taupānga umanga, ngā raraunga me ngā kōnae kua parea ki te hinonga, ngā whakaritenga kupuhipa, me ērā atu kaupapahere.
  \SystemSettings\Resources\CorpDeviceManagementRemoveButtonText:
