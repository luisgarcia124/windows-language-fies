  \SystemSettings\Resources\CorpDeviceManagementUntrustedCertMessage\Text:
    Candidate Language=MI-NZ: Kei te whakamahi tō whakahaere i tētahi tiwhikete kāore i te pono, kua mōnehu rānei.
  \SystemSettings\Resources\CorpDeviceManagementUntrustedCertContactMessage\Text:
    Candidate Language=MI-NZ: Tirohia kei te tika te rā me te wā i tō pūrere, ka ngana anō. Ki te whiwhi anō koe i tēnei karere, whakapā ki tō tangata tautoko mehemea ka tūmanakohia pea tēnei.
  \SystemSettings\Resources\CorpDeviceManagementSync\Content:
    Candidate Language=MI-NZ: Tukutahi
  \SystemSettings\Resources\CorpDeviceManagementRemove\Content:
