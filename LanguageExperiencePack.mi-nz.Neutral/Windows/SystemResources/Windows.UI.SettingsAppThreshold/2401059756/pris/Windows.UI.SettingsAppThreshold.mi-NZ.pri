  \SystemSettings\Resources\CorpDeviceManagementNotAnAdminText\Text:
    Candidate Language=MI-NZ: E āraia ana koe e ngā kaupapahere pūnaha mai i te tūhono i a koe ki tētahi pūkete mahi, kura rānei. Mō ētahi mōhiohio anō whakapā atu ki tō kaitautoko.
  \SystemSettings\Resources\CorpDeviceManagementJoinADomainHyperlink\Content:
