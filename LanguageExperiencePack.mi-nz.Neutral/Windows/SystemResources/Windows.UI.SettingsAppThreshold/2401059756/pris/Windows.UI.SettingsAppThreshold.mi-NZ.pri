  \SystemSettings\Resources\CorpDeviceManagementJoinAADHyperlink\Content:
    Candidate Language=MI-NZ: Hono atu, wehe Azure AD.
  \SystemSettings\Resources\CorpDeviceManagementInstructionsDescription\Text:
    Candidate Language=MI-NZ: Whakauru ki ngā rauemi a tō umanga (ngā mea pēnei i ngā taupānga, te whatunga, īmēra hoki) mā te kōwhiri i tētahi o ngā kōwhiringa e rua i raro nei. Ina tūhono atu koe, ka whakaū pea tō mahi, tō kura rānei i ētahi kaupapahere ki tō pūrere.
  \SystemSettings\Resources\CorpDeviceManagementInsecureRedirectMessage:
    Candidate Language=MI-NZ: Kāore tō mahi, tō kura rānei i te whakamahi i tētahi tūhononga haumaru (kei te tahurikē ki %1!s!).
  \SystemSettings\Resources\CorpDeviceManagementInsecureRedirectContactMessage\Text:
