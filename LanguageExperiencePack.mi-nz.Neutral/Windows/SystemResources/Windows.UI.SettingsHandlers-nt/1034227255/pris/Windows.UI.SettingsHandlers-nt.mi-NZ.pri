  \resources\SystemSettings_AdvancedGraphics_HighPerformanceGpuPreference:
    Candidate Language=MI-NZ: Mahinga Tiketike
  \resources\SystemSettings_AddAnother:
    Candidate Language=MI-NZ: Tāpiritia tētahi anō
  \resources\SystemSettings_Add:
    Candidate Language=MI-NZ: Tāpiri
  \resources\SystemSettings_Activation_VOLUME_SLP_CONTENT:
    Candidate Language=MI-NZ: Me tāuru koe i tētahi Kī Whakahohe Maha (MAK), he kī hua hokohoko rānei hei whakahohe i te Windows.
  \resources\SystemSettings_Activation_VOLUME_EXPIRATION:
    Candidate Language=MI-NZ: Taro ake ka mōnehu tō raihana Windows.
  \resources\SystemSettings_Activation_VOLUME_BINDING_CONTENT:
    Candidate Language=MI-NZ: Tē taea e Windows te whakahohe i tēnei wā. Ngana ki te whakahohe i a Windows ā muri ake. Ki te kore e pai, whakapā atu ki tō kaiwhakahaere pūnaha.
  \resources\SystemSettings_Activation_Volume_Activation:
    Candidate Language=MI-NZ: Whakahohea ai a Windows mā te ratonga whakahohenga a tō whakahaere.
  \resources\SystemSettings_Activation_USED_PRODUCT_KEY_CONTENT:
    Candidate Language=MI-NZ: Tē taea te Windows i tēnei pūrere te whakahohe nō te mea i whakamahia kētia te kī hua ki te pūrere kē. Ki te whakaaro koe kāore i whakamahia ki te pūrere kē, tīpakohia Raparongoā.
  \resources\SystemSettings_Activation_URL_WHY_REQUIRED:
    Candidate Language=MI-NZ: He aha rā i hiahiatia ai te whakahohenga?
  \resources\SystemSettings_Activation_URL_MANUFACTURER:
    Candidate Language=MI-NZ: Tirohia tuihonotia ngā mōhiohio whakapā a te kaiwhakanao
  \resources\SystemSettings_Activation_URL_LIST_ONLINE:
    Candidate Language=MI-NZ: Tirohia tuihonotia te rārangi hua mō ngā taipitopito kōrero
  \resources\SystemSettings_Activation_URL_LEARN_MORE:
    Candidate Language=MI-NZ: Ako atu anō
  \resources\SystemSettings_Activation_URL_LEARN_INVALID_PK:
    Candidate Language=MI-NZ: Ako kōrero anō mō ngā kī hua muhu
  \resources\SystemSettings_Activation_URL_LATEST:
    Candidate Language=MI-NZ: Tāutahia te putanga hōu rawa o Windows
  \resources\SystemSettings_Activation_URL_IA_HELP:
    Candidate Language=MI-NZ: Tirohia tuihonotia ngā mōhiohio mō te whakahohe mīhini mariko.
  \resources\SystemSettings_Activation_URL_GET_WINDOWS:
    Candidate Language=MI-NZ: Tiki Windows
  \resources\SystemSettings_Activation_URL_CSS_ONLINE:
    Candidate Language=MI-NZ: Tirohia tuihonotia ngā mōhiohio tautoko
  \resources\SystemSettings_Activation_URL_ADMIN_INFO:
    Candidate Language=MI-NZ: Tiki mōhiohio tuihono mai i tō kaiwhakahaere pūnaha
  \resources\SystemSettings_Activation_Upgrade_Title:
    Candidate Language=MI-NZ: Whakahōu Putanga Windows
  \resources\SystemSettings_Activation_Upgrade_Message2:
    Candidate Language=MI-NZ: He roa pea te wā o tēnei whakamohoa, ā, ka tīmata anō tō rorohiko. Kāore e taea e koe te whakamahi tō rorohiko kia oti tēnei.
  \resources\SystemSettings_Activation_Upgrade_Message1:
    Candidate Language=MI-NZ: Ka tāpirihia he āhuahira hōu ki Windows i te whakamohoatanga i tō putanga. I mua i tō tīmatanga, me mātua whakarite ka tiakina ō mahi me te kati i ngā taupānga katoa.
  \resources\SystemSettings_Activation_Upgrade_Button_Text:
    Candidate Language=MI-NZ: Tīmatahia te whakamohoa.
  \resources\SystemSettings_Activation_UNKNOWN_ERROR_CONTENT:
    Candidate Language=MI-NZ: Kāore e taea a Windows te whakahohe ki tēnei pūrere i tēnei wā. Me ngana anō ki te whakahohe ā muri ake, haere rānei ki te Store ki te hoko i te Windows pono.
  \resources\SystemSettings_Activation_UNACTIVATED_DOWNLEVEL_CONTENT:
    Candidate Language=MI-NZ: I whakamohoa mai tēnei putanga o Windows i tētahi putanga o Windows kāore i whakahohea. Me tāuru he kī hua whaimana, me haere rānei ki te Store kia hokona te Windows tūturu.
  \resources\SystemSettings_Activation_Troubleshooter_ActionDescription:
    Candidate Language=MI-NZ: Ina kei te raruraru te whakahohenga, me tīpako Raparongoā ki te ngana ki te tapi i te raru. 
  \resources\SystemSettings_Activation_TroubleshooterDescription:
    Candidate Language=MI-NZ: Raparongoā
  \resources\SystemSettings_Activation_TOKEN_ERROR:
    Candidate Language=MI-NZ: Kāore e kitea e Windows he tiwhikete mō te whakahohenga. Me tāuta e tō kaiwhakahaere tētahi tiwhikete whaimana hei whakahohe i a Windows. 
  \resources\SystemSettings_Activation_TokenErrorDescription:
    Candidate Language=MI-NZ: Kāore e kitea e Windows he tiwhikete mō te whakahohenga. Tāutahia he tiwhikete whaimana ki tēnei rorohiko, whakapā atu rānei ki tō kaiwhakahaere pūnaha.
  \resources\SystemSettings_Activation_TOKEN:
    Candidate Language=MI-NZ: Tē taea e Windows te whakahohe i tēnei wā. Me ngana ki te whakahohe ā muri ake. Ki te kore e pai, whakapā atu ki tō kaiwhakahaere pūnaha.
  \resources\SystemSettings_Activation_TIMEBOMB_EXPIRING_CONTENT:
    Candidate Language=MI-NZ: Taro ake ka mōnehu te raihana mō tēnei putanga arotake o Windows. Me tāuta koe i te putanga hōu o Windows me te whakahohe. Kia whakahohe rā anō koe, ka tīmata anō tēnei rorohiko ia rua haora, nā reira me tārua koe i ō raraunga.
  \resources\SystemSettings_Activation_TIMEBASED_EXPIRED_CONTENT:
    Candidate Language=MI-NZ: Kua mōnehu tēnei putanga o Windows. Tāutatia te putanga hōu rawa hei whakahohe.
  \resources\SystemSettings_Activation_SupportActivateInstructions_Description:
    Candidate Language=MI-NZ: Whakahohea ki te Tiki Āwhina, mā te waea rānei
  \resources\SystemSettings_Activation_SubscriptionExpiredRejuv:
    Candidate Language=MI-NZ: Kua mōnehu tō ohaurunga %1 — whakapā atu ki te kaiwhakahaere o tō umanga mō te āwhina.
  \resources\SystemSettings_Activation_SubscriptionExpired:
    Candidate Language=MI-NZ: He muhu te ohaurunga %1.
  \resources\SystemSettings_Activation_SubscriptionActive:
    Candidate Language=MI-NZ: Kei te hohe te ohaurunga %1
  \resources\SystemSettings_Activation_Store_Entitlement:
    Candidate Language=MI-NZ: Whakahohea ai a Windows mā te raihana mamati.
  \resources\SystemSettings_Activation_SOFTMOD_CONTENT:
    Candidate Language=MI-NZ: Kei tō rorohiko ētahi kōnae e ārai ana i te whakahohenga. Me hoko, me tāuta anō koe i tētahi putanga hōu o Windows.
  \resources\SystemSettings_Activation_SAFE_MODE_CONTENT:
    Candidate Language=MI-NZ: E whakahaere ana koe i te Windows i te aratau haumaru. Me tīmata noa anō i te Windows kia whiwhi ki ngā mea katoa e hiahia ana koe ki te whakahohe.
  \resources\SystemSettings_Activation_REBOOT_CONTENT:
    Candidate Language=MI-NZ: Kua kitea e Windows he huringa ki ngā kōnae pūnaha e ārai ana i te whakahohenga. Tīmataria anō te Windows ki te whakahohe.
  \resources\SystemSettings_Activation_PhoneActivate_ActionDescription:
    Candidate Language=MI-NZ: Waea mai kia whakahohea a Windows
  \resources\SystemSettings_Activation_PhoneActivateDescription:
    Candidate Language=MI-NZ: Whakahohe mā te waea
  \resources\SystemSettings_Activation_OpenResolutionURLDescription:
    Candidate Language=MI-NZ: Whakapā ki te kapa tautoko kiritaki
  \resources\SystemSettings_Activation_ONLINE_ERROR:
    Candidate Language=MI-NZ: Tē taea e Windows te whakahohe. Ngana anō ā muri ake.
  \resources\SystemSettings_Activation_OEM_SLP_CONTENT:
    Candidate Language=MI-NZ: Mēnā kua oti kē te Windows te tāuta, me whakapā koe ki te kaihanga, kaiwhakanao rānei o te pūnaha ki te whakahohe.
  \resources\SystemSettings_Activation_OEM_OOT_CONTENT:
    Candidate Language=MI-NZ: Kua rarua te whakahohenga. Whakapā atu ki te kaiwhakanao o tō rorohiko.
  \resources\SystemSettings_Activation_NO_PRODUCT_KEY_CONTENT:
    Candidate Language=MI-NZ: Tāurua tō kī hua hei whakahohe i te Windows.
  \resources\SystemSettings_Activation_NO_KEY_FOUND:
    Candidate Language=MI-NZ: I pūrongo Windows kāore i kitea he kī hua i tō pūrere.
  \resources\SystemSettings_Activation_NoPKeyFound:
    Candidate Language=MI-NZ: Kāore i kitea he kī hua
  \resources\SystemSettings_Activation_NEVER_ACTIVATED_CONTENT:
    Candidate Language=MI-NZ: Tāurua tō kī hua hei whakahohe i te Windows.
  \resources\SystemSettings_Activation_NETWORK_UNAVAILABLE_CONTENT:
    Candidate Language=MI-NZ: Kāore e taea a Windows te whakahohe ki tēnei pūrere i te mea kāore e wātea mai ā mātou tūmau whakahohe i tēnei wā. Āta tirohia kua tūhono koe ki te Ipurangi, ā, ka ngana aunoa mātou ki te whakahohe i te Windows ina wātea anō mai te ratonga.
  \resources\SystemSettings_Activation_LICENSE_EXPIRING_CONTENT:
    Candidate Language=MI-NZ: Taro ake tonu ka mutu tō raihana ki te whakamahi i te Windows.
  \resources\SystemSettings_Activation_LEARN_MORE:
    Candidate Language=MI-NZ: Tiki mōhiohio anō
  \resources\SystemSettings_Activation_LearnMore_AccessibleName:
    Candidate Language=MI-NZ: Ako anō mō te whakahohenga Windows
  \resources\SystemSettings_Activation_LaunchAltClient_NotDefined_ErrorMessage:
    Candidate Language=MI-NZ: I tautuhi te whakahohenga kiritaki. Tēnā whakapā atu ki te kaiwhakahaere pūnaha.
  \resources\SystemSettings_Activation_LaunchAltClient_LaunchFailed_ErrorMessage:
    Candidate Language=MI-NZ: I rahua te whakahohenga kiritaki ki te whakarewa. Tēnā whakapā atu ki te kaiwhakahaere pūnaha.
  \resources\SystemSettings_Activation_LaunchAltClient_ErrorMessage:
    Candidate Language=MI-NZ: I puta mai tētahi raru. Mea ake nā, whakamātauhia anōtia.
  \resources\SystemSettings_Activation_LaunchAltClient_Description:
    Candidate Language=MI-NZ: Whakatuwheratia te taupānga whakahohenga
  \resources\SystemSettings_Activation_LastKeyError:
    Candidate Language=MI-NZ: E kore e taea te whakamahi i tērā o ngā kī hua (ID%1) nāu i tāuru i tēnei tārua o Windows. (0x%2!X!)
  \resources\SystemSettings_Activation_KMS_NOT_FOUND:
    Candidate Language=MI-NZ: Kāore e taea a Windows te whakahohe ki tēnei pūrere i te mea kāore e taea e mātou te tūhono ki te tūmau whakahohe a tō whakahaere. Āta tirohia kua tūhono koe ki te whatunga o tō whakahaere, ka ngana anō. Ki te haere tonu ngā raru whakahohe, whakapā ki te tangata tautoko o tō whakahaere.
  \resources\SystemSettings_Activation_INVALID_PRODUCT_KEY_CONTENT:
    Candidate Language=MI-NZ: Kāore e taea a Windows te whakahohe ki tēnei pūrere, kāore hoki e whaimana te kī hua i tāuru koe. Haere ki te Store ki te hoko i te Windows pono.
  \resources\SystemSettings_Activation_IDS_TIMEBOMB_CONTENT:
    Candidate Language=MI-NZ: Kua mōnehu te raihana mō tēnei putanga arotake o Windows. Me tāuta koe i te putanga hōu rawa me te whakahohe. Kia whakahohe rā anō koe, ka tīmata anō tēnei rorohiko ia rua haora, nā reira me tārua koe i ō raraunga.
  \resources\SystemSettings_Activation_IDS_HARDWARE_OOT_CONTENT:
    Candidate Language=MI-NZ: Kāore e taea a Windows te whakahohe ki tēnei pūrere, i te mea kāore te kī hua i tāuru koe e ōrite ki te kōtaha pūmārō. Mēnā i tapitapihia e koe a Windows i mua tata nei, i tino hurihia rānei te pūmārō, i tēnei pūrere, me tīpako Raparongoā kia tapia ai te raru, haere rānei ki te Store kia hokona te Windows pono.
  \resources\SystemSettings_Activation_IA_HOST_NOT_ACTIVATED_CONTENT:
    Candidate Language=MI-NZ: Kāore e taea e Windows te whakahohe tēnei mīhini mariko. Āta titiro kua whakahohea te mīhini taurima ka ngana anō .
  \resources\SystemSettings_Activation_IA_GENERIC_CONTENT:
    Candidate Language=MI-NZ: Kāore e taea e Windows te whakahohe i tēnei mīhini mariko. Me ngana ki te whakamahi i tētahi kī hua rerekē. Ki te kore tēnei e mahi, me whakahōu pea e koe tō mīhini pūtaurima.
  \resources\SystemSettings_Activation_HARDWARE_ID_CHANGED:
    Candidate Language=MI-NZ: I pūrongo Windows ko ngā pūmārō o tō pūrere kua rerekē.
  \resources\SystemSettings_Activation_GetHelpActivate_Description:
    Candidate Language=MI-NZ: Tono Āwhina
  \resources\SystemSettings_Activation_GEO_BLOCKED_CONTENT:
    Candidate Language=MI-NZ: Kāore e taea te Windows te whakahohe ki tēnei pūrere, i te mea kāore te kī hua i tāuru koe e ōrite ki te whenua, te rohe rānei kei reira koe. Haere ki te Store ki te hoko i te Windows pono.
  \resources\SystemSettings_Activation_EXPIRING_VOLUME:
    Candidate Language=MI-NZ: . Whakapā atu ki tō kaiwhakahaere pūnaha kia riro mai he pātuhi hua.
  \resources\SystemSettings_Activation_EXPIRING_TBL:
    Candidate Language=MI-NZ: . I muri i tēnei rā, kāore e taea e koe te whakawhaiaro Windows.
  \resources\SystemSettings_Activation_EXPIRING_START:
    Candidate Language=MI-NZ: Ka mōnehu tō raihana Windows ā te
  \resources\SystemSettings_Activation_EXPIRING_PRERELEASE:
    Candidate Language=MI-NZ: . Mō te tiki i tētahi raihana hōu, me tāuta e koe te putanga hōu rawa o Windows. Ki te kore, ka tīmata anō tō rorohiko ia rua haora i muri i te mōnehutanga o tēnei raihana.
  \resources\SystemSettings_Activation_ErrorDescription:
    Candidate Language=MI-NZ: Whakaahuatanga hapa:
  \resources\SystemSettings_Activation_ErrorCode:
    Candidate Language=MI-NZ: Waehere hapa:
  \resources\SystemSettings_Activation_DOWNLEVEL_SETUPKEY:
    Candidate Language=MI-NZ: I pūrongo Windows he raru kei te kī hua o tō mua putanga o Windows.
  \resources\SystemSettings_Activation_DEFAULT_PRODUCT_KEY_CONTENT:
    Candidate Language=MI-NZ: Tē taea te Windows i tēnei pūrere te whakahohe nō te mea kāhore tāu raihana mamati whaimana, tāu kī hua rānei. Ki te whakaaro koe he raihana whaimana tāu, he kī rānei, tīpakohia Raparongoā.
  \resources\SystemSettings_Activation_CSS_TEXT:
    Candidate Language=MI-NZ: Mēnā kua tāuta anō koe i te Windows, i huri rānei i ō pūmārō ina tata nei, ka taea pea te whakamahi tō kī onāianei.
  \resources\SystemSettings_Activation_COA_CONTENT:
    Candidate Language=MI-NZ: Ka taea noa tēnei kī hua te whakamahi hei whakaora i te Windows ki ngā rorohiko kua oti kē te Windows te tāuta i mua. Ka taea e koe te whakahohe Windows mā te waea.
  \resources\SystemSettings_Activation_ChangePK_Volume_ActionDescription:
    Candidate Language=MI-NZ: Hei tiki i te Windows pono, tāurua he kī hua kē. Ki te kāhore i a koe tētahi, whakapā ki tō kaiwhakahaere pūnaha.
  \resources\SystemSettings_Activation_ChangePK_ActionDescription:
    Candidate Language=MI-NZ: Haere ki te Store ki te hoko i te Windows pono, tāurua rānei he kī hua.
  \resources\SystemSettings_Activation_ChangePKProfessionalSModeDescription:
    Candidate Language=MI-NZ: Haere ki te Store ki te whakawhiti ki %1.
  \resources\SystemSettings_Activation_ChangePKMessage:
    Candidate Language=MI-NZ: Hei whakamahi i tētahi kī hua kē i tēnei pūrere, tīpako Hurihia te kī hua.
  \resources\SystemSettings_Activation_ChangePKInstructions:
    Candidate Language=MI-NZ: Hei whakamahi i tētahi kī hua kē i tēnei pūrere, tīpako Hurihia te kī hua.
  \resources\SystemSettings_Activation_ChangePKDescription:
    Candidate Language=MI-NZ: Hurihia te kī hua
  \resources\SystemSettings_Activation_ChangePKCoreClientDescription:
    Candidate Language=MI-NZ: Haere ki te Store ki te hoko i te whakamohoa, tāurua rānei he kī hua.
  \resources\SystemSettings_Activation_CallSupport_ActionDescription:
    Candidate Language=MI-NZ: Whakapā ki te kapa tautoko mēnā kua tāuta Windows koe, kua mahia he huringa rānei ki tō pūmāro 
  \resources\SystemSettings_Activation_CallSupportDescription:
    Candidate Language=MI-NZ: Waea tautoko
  \resources\SystemSettings_Activation_BuyWindows_ActionDescription:
    Candidate Language=MI-NZ: 
  \resources\SystemSettings_Activation_BuyWindowsDescription:
    Candidate Language=MI-NZ: Haere ki te Store
  \resources\SystemSettings_Activation_BuyUpgrade_ActionDescription:
    Candidate Language=MI-NZ: Haere ki te Store Windows kia whakamohoa i tō putanga o Windows
  \resources\SystemSettings_Activation_BuyKey_ActionDescription:
    Candidate Language=MI-NZ: 
  \resources\SystemSettings_Activation_BuyKeyDescription:
    Candidate Language=MI-NZ: Haere ki te Store
  \resources\SystemSettings_Activation_BLOCKED_PRODUCT_KEY_CONTENT:
    Candidate Language=MI-NZ: Kāore te kī hua i whakamahia ki tēnei rorohiko i mahi pai me tēnei putanga o Windows. Me whakapā atu pea ki te toa, ki te kamupene rānei i hokona ai e koe te Windows, me tāuru he kī hua kē, me haere rānei ki te Store ka hoko i te Windows tūturu.
  \resources\SystemSettings_Activation_BIOS_KEY:
    Candidate Language=MI-NZ: I pūrongo Windows he raru kei tō kī hua OEM.
  \resources\SystemSettings_Activation_BenefitMessageDescription:
    Candidate Language=MI-NZ: Ka nui ake tō tūpono ki ngā wheori, ki ētahi atu tuma haumarutanga rānei i te whakahaere i tētahi tārua pono-kore o Windows.
  \resources\SystemSettings_Activation_AVS_ERROR_CONTENT:
    Candidate Language=MI-NZ: Kāore e taea a Windows te whakahohe ki tēnei pūrere i te mea kāore e wātea mai ā mātou tūmau whakahohe i tēnei wā. Āta tirohia kua tūhono koe ki te Ipurangi, ā, ka ngana aunoa mātou ki te whakahohe i te Windows ina wātea anō mai te ratonga.
  \resources\SystemSettings_Activation_AltInstructions_Description:
    Candidate Language=MI-NZ: Mō ngā mōhiohio anō e hāngai ana ki te whakahohenga a tō pūrere Windows, pāwhiria te hononga ki raro iho.
  \resources\SystemSettings_Activation_ACTIVATED_CONTENT:
    Candidate Language=MI-NZ: 
  \resources\SystemSettings_Activate_WORKSTATION_REQUIRED:
    Candidate Language=MI-NZ: Kāore e taea e tēnei momo putanga o Windows te haere i ngā pūmārō i whirihoratia mō tō pūrere. Haere ki te Store ki te hoko i tētahi momo putanga o Windows e tautokona ana.
  \resources\SystemSettings_Activate_NEVER_ACTIVATED_CONTENT:
    Candidate Language=MI-NZ: Whakahohea kia taea ai e koe te whakawhaiaro i te Windows.
  \resources\SystemSettings_Activate_INFO_TITLE:
    Candidate Language=MI-NZ: Ō mōhiohio kī hua
  \resources\SystemSettings_Activate_DOWNLEVEL_NOT_ACTIVATED:
    Candidate Language=MI-NZ: Tē taea te whakahohe i te Windows ki tēnei pūrere i te mea kāore i whakahohea te putanga tōmua o Windows i mua i te whakamohoa ki Windows 11. Haere ki te Store kia hokona te Windows pono.
  \resources\SystemSettings_Activate_CurrentKeyNotAvailable:
    Candidate Language=MI-NZ: Kī hua onāianei: Kāore i te Wātea
  \resources\SystemSettings_Activate_CurrentKey:
    Candidate Language=MI-NZ: Kī hua onāianei: *****-
