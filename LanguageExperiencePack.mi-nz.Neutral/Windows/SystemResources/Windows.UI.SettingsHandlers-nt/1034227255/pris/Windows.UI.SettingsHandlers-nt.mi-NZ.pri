  \resources\SystemSettings_Audio_Codec_ActionDescription:
    Candidate Language=MI-NZ: Kāore i tāutatia he Kōtēke ki te pūnaha.
  \resources\SystemSettings_Audio_BluetoothLauncher_Output_ActionDescription:
    Candidate Language=MI-NZ: Takiruatia tētahi pūrere tāputa hōu
  \resources\SystemSettings_Audio_BluetoothLauncher_Input_ActionDescription:
    Candidate Language=MI-NZ: Takiruatia tētahi pūrere tāuru hōu
  \resources\SystemSettings_AppControl_Preference_StoreOnly:
    Candidate Language=MI-NZ: Te Microsoft Store anake (E tūtohutia ana)
  \resources\SystemSettings_AppControl_Preference_Recommendations:
    Candidate Language=MI-NZ: Ahakoa te wāhi, engari whakamōhiotia mai au mehemea he taupānga ōrite i te Microsoft Store
  \resources\SystemSettings_AppControl_Preference_PreferStore:
    Candidate Language=MI-NZ: Ahakoa te wāhi, engari whakatūpatoria mai au i mua i te tāuta i tētahi taupānga kāore i tīkina atu i te Microsoft Store
  \resources\SystemSettings_AppControl_Preference_Anywhere:
    Candidate Language=MI-NZ: Ahakoa te wā
  \resources\SystemSettings_AppControl_Policy_Restriction:
    Candidate Language=MI-NZ: E whakahaeretia ana tēnei tautuhinga e tō whakahaere. Whakapā atu ki tō kaiwhakahaere mō ētahi mōhiohio.
  \resources\SystemSettings_AirplaneMode_Description:
    Candidate Language=MI-NZ: Aratau Rererangi
  \resources\SystemSettings_AdvancedGraphics_WindowsDefault:
    Candidate Language=MI-NZ: Mā Windows e kōwhiri
