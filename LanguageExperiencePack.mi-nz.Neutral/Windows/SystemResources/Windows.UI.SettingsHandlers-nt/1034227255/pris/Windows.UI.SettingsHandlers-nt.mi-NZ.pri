  \resources\SystemSettings_SurfaceHub_AlwaysEndSessionOption:
    Candidate Language=MI-NZ: Whakamutu i te wātū i ngā wā katoa
  \resources\SystemSettings_SurfaceHub_AllowResumeOption:
    Candidate Language=MI-NZ: Tuku i ngā kaiwhakamahi kia tīmata anō i te wātū
  \resources\SystemSettings_SurfaceHub_AdvancedResetOptionsDescription:
    Candidate Language=MI-NZ: Tīmata mai anō ināianei
  \resources\SystemSettings_SurfaceHub_AdvancedResetOptionsActionDescription:
    Candidate Language=MI-NZ: Tīmata anō i te pūrere hei uru ki te tīmata hōhonu. Kātahi ka tīpako i Whakaora mai i te kapua hei tāuta anō i Windows mai i te kaiwhakanao.
  \resources\SystemSettings_SurfaceHub_AddCert_ActionDescription:
    Candidate Language=MI-NZ: Ngā tiwhikete kawemai mō te kaiwhakamahi onāianei. Whakamahia ngā mōkī whakarite, he otinga whakahaerenga pūrere pūkoro (MDM) rānei hei kawemai tiwhikete mō te mīhini paetata.
