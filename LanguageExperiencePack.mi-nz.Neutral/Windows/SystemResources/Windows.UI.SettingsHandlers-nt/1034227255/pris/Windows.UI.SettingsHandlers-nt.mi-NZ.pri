    Candidate Language=MI-NZ: Tauākī Tūmataitinga
  \resources\SystemSettings_WindowsDefender_MpClientVersionDescription:
    Candidate Language=MI-NZ: Putanga kiritaki ārai pūmanawa kino:
  \resources\SystemSettings_WindowsDefender_Exclusions_ViewOnlyDescription:
