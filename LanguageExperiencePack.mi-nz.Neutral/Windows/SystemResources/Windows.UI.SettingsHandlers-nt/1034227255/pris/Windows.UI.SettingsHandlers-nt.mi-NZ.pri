  \resources\SystemSettings_Language_CHSPinyinIME_IsVModeEnabledDescription:
    Candidate Language=MI-NZ: Whakamahia te aratau-V hei tāuru hōputu Hainamana mō te tau, te rā me te wā, ērā mea. I te wā i roto i te aratau Pinihi Taurua, ka taea te aratau-V te whakaoho mā te "Shift + v"
  \resources\SystemSettings_Language_CHSPinyinIME_IsUModeEnabledDescription:
    Candidate Language=MI-NZ: Whakamahia te aratau-U hei tāuru pūāhua Hainamana i runga anō i tōna tāhoe, wae rānei, hei tāuru tohu rānei. I te wā i roto i te aratau Pinihi Taurua, ka taea te aratau-U te whakaoho mā te "Shift + u"
  \resources\SystemSettings_Language_CHSPinyinIME_IsSuperAbbreviatedPinyinEnabledDescription:
    Candidate Language=MI-NZ: Piniini whāiti rawa
  \resources\SystemSettings_Language_CHSPinyinIME_IsSmartSelfLearningEnabledDescription:
    Candidate Language=MI-NZ: Tango aunoa i ngā rerenga mai i ngā pukapuka kei te whakatikaina e koe, i whakatikainga rānei inakuanei (Ka whakamahia ēnei rerenga i tō tāurunga o nāianei anake hei whakapiki i te tika; e kore e tukua ki Microsoft.)
  \resources\SystemSettings_Language_CHSPinyinIME_IsSelfLearningEnabledDescription:
    Candidate Language=MI-NZ: Whakahohe/mono i te taumahi ako ā-kiri me te kawemai/kaweatu ngā rerenga ako ā-kiri (ka tautoko i te hōputu Microsoft whakaroto anake)
  \resources\SystemSettings_Language_CHSPinyinIME_IsReadingAutoCorrectionEnabledDescription:
    Candidate Language=MI-NZ: Whakatika pānuitanga aunoa
  \resources\SystemSettings_Language_CHSPinyinIME_IsPeopleNameTipEnabledDescription:
    Candidate Language=MI-NZ: Whakaaturia aunoatia te aki āhuahira tāuru ingoa tāngata
  \resources\SystemSettings_Language_CHSPinyinIME_IsPeopleNameEnabledDescription:
    Candidate Language=MI-NZ: I te whakamahinga tāurunga piniini, whakamahia "semicolon + r" hei uru ki te aratau tāuru ingoa tangata. Ina tomo koe ki piniini taurua, pēhia te pātuhi "Neke + kopipiko" me te pātuhi "r" hei uru ki te aratau tāuru ingoa tangata
  \resources\SystemSettings_Language_CHSPinyinIME_IsOutputCharsetSwitchKeyEnabledDescription:
