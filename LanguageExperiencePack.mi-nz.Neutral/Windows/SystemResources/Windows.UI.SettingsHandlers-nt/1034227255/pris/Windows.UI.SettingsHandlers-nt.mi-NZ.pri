  \resources\SystemSettings_Audio_Device_Disable_Last_Endpoint2:
    Candidate Language=MI-NZ: Kei te whakamahi koe i tēnei pūrere i tēnei wā, nō reira ki te tīpako koe i "Kaua e whakaae" ka mutu tō rongo ororongo.
  \resources\SystemSettings_Audio_Device_Disable_Last_Endpoint:
    Candidate Language=MI-NZ: Kāore e rangona te ororongo ki te mono e koe tēnei pūrere tāputa ororongo. Me tino mono rānei ia?
  \resources\SystemSettings_Audio_Device_Disable_Default2:
    Candidate Language=MI-NZ: Kei te whakamahi koe i tēnei pūrere i tēnei wā, nō reira ki te tīpako koe i "Kaua e whakaae" ka kore pea koe e rongo i tētahi ororongo.
  \resources\SystemSettings_Audio_Device_Disable_Default:
