  \resources\SystemSettings_Accounts_RemoveUserDescription:
    Candidate Language=MI-NZ: Pūkete me ngā raraunga
  \resources\SystemSettings_Accounts_RemoveUserButton:
    Candidate Language=MI-NZ: Tango
  \resources\SystemSettings_Accounts_PeopleOnDeviceDescription:
    Candidate Language=MI-NZ: Tāpiria tētahi tangata e taea te takiuru ki tēnei pūrere. Kāore ia e tāpiria ki tō rōpū whānau.
  \resources\SystemSettings_Accounts_OtherUsersDescription:
    Candidate Language=MI-NZ: Tukuna ngā tāngata ehara nō tō whānau kia takiuru mā ō rātou ake pūkete. Kāore rātou e tāpiritia ki tō whānau.
  \resources\SystemSettings_Accounts_MSAConnectButton2:
    Candidate Language=MI-NZ: Takiuru
  \resources\SystemSettings_Accounts_MSAConnectButton:
    Candidate Language=MI-NZ: Takiuru mā tētahi pūkete Microsoft
  \resources\SystemSettings_Accounts_LocalAccount:
    Candidate Language=MI-NZ: Pūkete paetata
  \resources\SystemSettings_Accounts_FamilyUsersNoMembersDescription:
    Candidate Language=MI-NZ: Tāpiritia tō whānau kia whiwhi te katoa ki tōna ake takiuru me tōna ake papamahi. Ka āwhina koe kia haumaru ngā tamariki mā ngā paetukutuku tōtika, ngā tepe wā, taupānga, kēmu anō hoki.
  \resources\SystemSettings_Accounts_FamilyUsersDescription2:
    Candidate Language=MI-NZ: Tukuna ngā mema whānau kia takiuru ki tēnei rorohiko — ka āwhina ngā kaiwhakahaere kia haumaru ake ngā mema i te ipurangi me ngā tautuhinga haumaru
  \resources\SystemSettings_Accounts_FamilyUsersDescription:
    Candidate Language=MI-NZ: Ka taea e koe tuku te whakaaetanga ki ngā mema o tōu whānau ki tēnei rorohiko. Ka taea ngā kaiwhakarite te whakahaere ngā tautuhinga-ā-whānau ki runga tuihono me kite rānei ngā haerenga kua mahia kia tiaki ai ngā tamariki.
  \resources\SystemSettings_Accounts_FamilySync_ConnectionErrorDescription2:
    Candidate Language=MI-NZ: Kāore i taea te tūhono ki Haumaru Whānau Microsoft āianei tonu, ā, kāore e tiaki pea ō huringa ki ngā tautuhinga whānau.
  \resources\SystemSettings_Accounts_FamilySync_ConnectionErrorDescription:
    Candidate Language=MI-NZ: Kāore i taea te tūhono atu ki te whānau Microsoft i tēnei wā tonu, nō reira kāore pea tō whānau i tēnei pūrere i te hōu rawa.
  \resources\SystemSettings_Accounts_FamilyOnlineButton2:
    Candidate Language=MI-NZ: Whakahaere tuihonotia ngā tautuhinga whānau, tangohia rānei he pūkete
  \resources\SystemSettings_Accounts_FamilyOnlineButton:
    Candidate Language=MI-NZ: Whakahaeretia tuihonotia ngā tautuhinga whānau
  \resources\SystemSettings_Accounts_FamilyMSAConnectDescription3:
    Candidate Language=MI-NZ: Takiuru mā tētahi pūkete Microsoft hei whakahaere i tō rōpū whānau
  \resources\SystemSettings_Accounts_FamilyMSAConnectDescription2:
    Candidate Language=MI-NZ: Takiuru mā tētahi pūkete Microsoft kia kite i tō whānau me te tāpiri mema
  \resources\SystemSettings_Accounts_FamilyMSAConnectDescription:
    Candidate Language=MI-NZ: Takiuru mā tētahi pūkete Microsoft kia kitea i konei tō whānau, ki te tāpiri mema hōu rānei ki tō whānau. Ka whiwhi ia mema o te whānau i tōna ake takiuru me tōna ake papamahi. Ka taea e koe te whakarite kia noho haumaru ō tamariki mā ngā paetukutuku tōtika, ngā tepe wā, ngā taupānga, me ngā kēmu.
  \resources\SystemSettings_Accounts_FamilyLearnMoreButton2:
    Candidate Language=MI-NZ: Akona ētahi atu mea mō te Haumaru Whānau
  \resources\SystemSettings_Accounts_FamilyLearnMoreButton:
    Candidate Language=MI-NZ: Ākona mai anō
  \resources\SystemSettings_Accounts_FamilyDevice_ToggleDescription2:
    Candidate Language=MI-NZ: Tāpiri aunoatia ngā mema whānau i tāpirihia mai i ētahi atu pūrere
  \resources\SystemSettings_Accounts_FamilyDevice_ToggleDescription:
    Candidate Language=MI-NZ: Hoatu ngā mema whānau katoa te āheitanga ki te takiuru ki te pūrere
