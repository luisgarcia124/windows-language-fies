  \resources\SystemSettings_SurfaceHub_SetLocalAdministratorActionDescription:
    Candidate Language=MI-NZ: I te mea ka taea tēnei pūrere te whakamahi e ngā kaiwhakamahi maha, ka maukatia ngā tautuhinga kia kore ai e huri mai i tētahi wāhanga ki tētahi. Ko ngā kaiwhakahaere anake e taea ana te whirihora tautuhinga ki te pūrere.
  \resources\SystemSettings_SurfaceHub_SessionTimeoutDescription:
    Candidate Language=MI-NZ: Ki te kore he tangata i konei, hoki ki te mata pōwhiri i muri i te
  \resources\SystemSettings_SurfaceHub_RotatePassword_Error_Generic:
