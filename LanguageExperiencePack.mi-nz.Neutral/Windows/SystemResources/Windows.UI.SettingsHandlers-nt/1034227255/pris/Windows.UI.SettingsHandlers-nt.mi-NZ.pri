  \resources\SystemSettings_SurfaceHub_CortanaSettingsActionDescription:
    Candidate Language=MI-NZ: Ka āwhina a Cortana i ngā tāngata kia tīmata wawe ai i ngā hui, kia kimi i te mōhiohio hāngai mā te tangata e ui reo nui atu i te hui.
  \resources\SystemSettings_SurfaceHub_ConfigureMOMAgentDescription:
    Candidate Language=MI-NZ: Whirihora Tautuhinga OMS
  \resources\SystemSettings_SurfaceHub_ConfigureMOMAgentActionDescription:
    Candidate Language=MI-NZ: 
      Hei āwhina i a koe te Operations Management Suite (OMS) nō Microsoft, kia takina e koe te hauora o āu pūrere, kia mātau hoki he pēhea ēnei i whakamahia ai.
    
  \resources\SystemSettings_SurfaceHub_CollectLogsDescription:
    Candidate Language=MI-NZ: Kohikohi rangitaki
  \resources\SystemSettings_SurfaceHub_CollectLogsActionDescription:
    Candidate Language=MI-NZ: Kōkuhua he puku USB, ka tīpako i ngā rangitaki Kohikohi. Kei roto pea i ēnei rangitaki te mōhiohio pēnei i ngā wāhitau īmēra o te hunga i whakamahi i tēnei pūrere, te mōhiohio mō tēnei pūrere, e tūhono pēhea hoki ia ki tō whatunga.
  \resources\SystemSettings_SurfaceHub_Cert_Import_Wizard_Title:
