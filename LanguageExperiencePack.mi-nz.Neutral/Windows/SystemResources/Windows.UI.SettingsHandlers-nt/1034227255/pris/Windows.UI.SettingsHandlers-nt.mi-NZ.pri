  \resources\SystemSettings_SurfaceHub_RotatePassword_Error_DirSync:
    Candidate Language=MI-NZ: Kāore e tautokona te huringa kupuhipa mō tēnei momo pūkete. Me tāuru te ingoa pūkete ki te hōputu Puni\Ingoa Kaiwhakamahi ka ngana anō
  \resources\SystemSettings_SurfaceHub_RotatePasswordDescription:
    Candidate Language=MI-NZ: Mēnā he māharahara ōu, whakakāhia tēnei kia taea e tēnei pūrere te tītaka aunoa i te kupuhipa pūkete o tēnei pūrere. Ka taea e koe te tautuhi anō i te kupuhipa ahakoa te wā mā te whakamahi i te Active Directory (Azure AD rānei).
  \resources\SystemSettings_SurfaceHub_ResetDeviceDescription:
    Candidate Language=MI-NZ: Hei tīmatatanga
  \resources\SystemSettings_SurfaceHub_ResetDeviceActionDescription:
    Candidate Language=MI-NZ: Mēnā kāore tēnei pūrere i te mahi tika, ka āwhina pea mēnā ka tautuhia anō. Ka tangohia e tēnei ō kōnae me te tāuta anō i a Windows. Me tautuhi anō e koe te pūrere i muri i te tāuta a Windows.
  \resources\SystemSettings_SurfaceHub_ProxySessionAuthSave:
