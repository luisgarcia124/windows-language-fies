  \hololensDiagnostics\TroubleshootingLink:
    Candidate Language=MI-NZ: Ruānuku Raparongoā
  \hololensDiagnostics\TitleTroubleshooting:
    Candidate Language=MI-NZ: Tiki mōhiohio tātaritanga
  \hololensDiagnostics\TitleSuccess:
    Candidate Language=MI-NZ: Tiakina ngā mōhiohio tātaritanga ki tō RW
  \hololensDiagnostics\TitleError:
    Candidate Language=MI-NZ: Kua puta mai he hapa
  \hololensDiagnostics\Title:
    Candidate Language=MI-NZ: Kua puta mai he hapa
  \hololensDiagnostics\RetryButton:
    Candidate Language=MI-NZ: Me ngana anō
  \hololensDiagnostics\ProgressDescription:
    Candidate Language=MI-NZ: Kei te tiki mōhiohio tātaritanga...
  \hololensDiagnostics\PrivacyStatementLink:
    Candidate Language=MI-NZ: Tauākī tūmataitinga
  \hololensDiagnostics\PrivacyHeadline:
    Candidate Language=MI-NZ: Tauākī Tūmataitinga
  \hololensDiagnostics\PrivacyBody:
    Candidate Language=MI-NZ: Ako i ētahi mea mō ā mātou kohikohinga mā te pato https://aka.ms/privacy ki te pae wāhitau o tētahi pūtirotiro i tētahi pūrere ahakoa he aha.
  \hololensDiagnostics\NextButton:
    Candidate Language=MI-NZ: Kohi mōhiohio
  \hololensDiagnostics\Instruction4:
    Candidate Language=MI-NZ: 4. Kia oti i a koe ngā kōnae te tiaki, hoki mai ki kōnae ka tīpako ai i Kua Oti. Mā tēnei e tango ngā kōnae i tō HoloLens.
  \hololensDiagnostics\Instruction3:
    Candidate Language=MI-NZ: 3. Tāruatia ngā kōnae tātaritanga HoloLens ki tō RW.
  \hololensDiagnostics\Instruction2:
    Candidate Language=MI-NZ: 2. I tō RW, whakaaetia ngā aki kia huaki i Pūtoro Kōnae.
  \hololensDiagnostics\Instruction1:
    Candidate Language=MI-NZ: 1. Honoa tō HoloLens ki tō RW.
  \hololensDiagnostics\Instruction0:
    Candidate Language=MI-NZ: Hei tiaki i ō mōhiohio tātaritanga ki tō RW:
  \hololensDiagnostics\ContinueButton:
    Candidate Language=MI-NZ: Kua tutuki
  \hololensDiagnostics\CancelButton:
    Candidate Language=MI-NZ: Whakakore
  \hololensDiagnostics\BodyTroubleshooting:
    Candidate Language=MI-NZ: Ka taea e ngā mōhiotanga tātaritanga te raparongoā tēnei raru takiuru. Kia oti tēnei te kohikohi, ka wātea ki ngā tāngata katoa kua whai urunga ki tēnei pūrere.  Ka whai wāhanga hoki koe ki te tiaki i te mōhiotanga ki tō RW kia taea e koe te tuku ki tō kaiwhakahaere, ki Microsoft rānei.
  \hololensDiagnostics\BodySuccess:
    Candidate Language=MI-NZ: Kia oti i a koe ngā mōhiohio te tiaki ki tō RW, tukua ki tō kaiawhakahaere, whakaurua atu rānei ina whakapā atu koe ki Tautoko.
  \hololensDiagnostics\BodyError:
    Candidate Language=MI-NZ: I rahua tā mātou taka, kohikohi hoki i ngā rangitaki tātaritanga. Tēnā whakamātauria he pūkete rerekē.
  \hololensDiagnostics\Body:
    Candidate Language=MI-NZ: Kia ngana anō, tīpako Whakakore rānei hei tatū i tō pūrere ā kō ake nei.
  \hololensDiagnostics\BackButton:
    Candidate Language=MI-NZ: Hoki
  \hololensAccount\UserPlaceholder:
    Candidate Language=MI-NZ: someone@example.com
  \hololensAccount\Title:
    Candidate Language=MI-NZ: Takiuru mai me tō pūkete mahi
  \hololensAccount\PasswordTitle:
    Candidate Language=MI-NZ: Tāurutia tō kupuhipa
  \hololensAccount\PasswordPlaceholder:
    Candidate Language=MI-NZ: Kupuhipa
  \hololensAccount\NextButton:
    Candidate Language=MI-NZ: Panuku
  \hololensAccount\LeadText:
    Candidate Language=MI-NZ: Takiuru i raro i te pūkete taurite ki tāu i  whakamahi ai mō Office 365, mō ētahi atu ratonga pakihi mai i Microsoft rānei. Tērā pea ka kohia he mōhiohio e tō whakahaere mōu, māna hoki e tāuta e tango taupānga rānei, e huri tautuhinga, e mono āhuahira, e muku ihirangi, e tautuhianō rānei i tō pūrere.
  \hololensAccount\Error_UsernameFormat:
    Candidate Language=MI-NZ: Te āhua nei ehara tēnei i te wāhitau īmēra ā-mahi, ā-kura rānei. Whakamahia tētahi atu wāhitau īmēra.
  \hololensAccount\Error_UserExists:
    Candidate Language=MI-NZ: Kei konei kē tētahi kaiwhakamahi ingoa pērā
  \hololensAccount\Error_NoUsername:
    Candidate Language=MI-NZ: Tāurutia i raro i tō ingoa kaiwhakamahi
  \hololensAccount\Error_Creating_Account_Warning:
    Candidate Language=MI-NZ: Kua puta mai he raru.
  \hololensAccount\BackButton:
    Candidate Language=MI-NZ: Hoki
  \hello\WindowsHelloAnimationAltText:
    Candidate Language=MI-NZ: Hākoritanga Windows Hello
  \hello\TitleFingerprint:
    Candidate Language=MI-NZ: Whakamahi i tō tapukara kia hohoro kia haumaru ai tō takiuru mai
  \hello\TitleFaceFingerprint:
    Candidate Language=MI-NZ: Kia hohoro kē atu kia haumaru kē atu te takiuru
  \hello\TitleFace:
    Candidate Language=MI-NZ: Whakamahi i tō tapukara kia hohoro kia haumaru ai tō takiuru mai
  \hello\SkipLink:
    Candidate Language=MI-NZ: Kāore, ā muri ake pea.
  \hello\LeadTextFingerprint:
    Candidate Language=MI-NZ: Tīpakona, kīa rānei <strong>Haere tonu</strong> hei tatū i Windows Hello.
  \hello\LeadTextFaceFingerprint:
    Candidate Language=MI-NZ: Kōwhiria ko tēhea tō huarahi takiuru ki Windows. Ka taea e koe te kī <strong>Kanohi</strong> <strong>Tapukara</strong> rānei hei tīmata i Windows Hello.
  \hello\LeadTextFace:
    Candidate Language=MI-NZ: Tīpakona, kīa rānei <strong>Haere tonu</strong> hei tatū i Windows Hello.
  \hello\FingerprintButton:
    Candidate Language=MI-NZ: Whakamahi he T&apukara
  \hello\FaceButton:
    Candidate Language=MI-NZ: Whakamahia taku K&anohi
  \hello\ContinueButton:
    Candidate Language=MI-NZ: &Haere tonu
  \hello\BodyTextFingerprint:
    Candidate Language=MI-NZ: He pūoko tapukara tō tāu pūrere ka mahi ngātahi me Windows Hello, e hua ai he tikanga kupuhipa-kore, ngāwari hoki hei manatoko i tō tuakiri.
  \hello\BodyTextFace:
    Candidate Language=MI-NZ: Ka mahi ngātahi tō kāmera me Windows Hello kia āhukahukatia koe, mā te hoatu i tētahi huarahi ngāwari, kupuhipa-kore hei manatoko i tō tuakiri.
  \hello\BodyFingerprintOptionCaption:
    Candidate Language=MI-NZ: Tapukara
  \hello\BodyFaceOptionCaption:
    Candidate Language=MI-NZ: Āhukahuka kanohi
