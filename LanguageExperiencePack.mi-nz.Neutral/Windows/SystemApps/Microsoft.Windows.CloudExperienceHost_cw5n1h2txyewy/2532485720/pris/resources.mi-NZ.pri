  \oobeHello\GoToSettingsBioDataSubtitle:
    Candidate Language=MI-NZ: Kawea mai ahau ki te wāhi e taea ai te tango kōwhiringa takiuru me te muku i ōku raraunga.
  \oobeHello\BioConsentTitle:
    Candidate Language=MI-NZ: Kōwhiri ahakoa kei te hiahia koe ki te takiuru tonu mā tō kanohi, tō tapukara rānei
  \oobeHello\BioConsentSubtitle:
    Candidate Language=MI-NZ: Kei te hiahia rānei koe ki te rokiroki tonu i tō kanohi, ō raraunga tapukara ki tēnei RW?
