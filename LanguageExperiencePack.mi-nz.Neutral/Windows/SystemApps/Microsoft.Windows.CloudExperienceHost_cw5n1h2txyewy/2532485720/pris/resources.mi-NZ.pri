  \oobeRetailDemoEntry\confirmedTitle:
    Candidate Language=MI-NZ: Kua whakakāngia e koe te wheako tauira hokohoko
  \oobeRetailDemoEntry\confirmedPrimaryCommandText:
    Candidate Language=MI-NZ: Haere tonu
  \oobeRetailDemoEntry\confirmedContent:
    Candidate Language=MI-NZ: Haere tonu kia whakaoti i te tatū. Mā mātou e tiki atu ngā ihirangi tauira me ngā taupānga hōu rawa māu.
  \oobeRetailDemoEntry\confirmContent:
    Candidate Language=MI-NZ: Hei whakamahi mō te hokohoko anake. Mēnā kāore koe i te whakamahi i tēnei rorohiko mō tētahi tauira pātaka, whakakorea, ka hoki anō ai ki te tatū pūnoa.
