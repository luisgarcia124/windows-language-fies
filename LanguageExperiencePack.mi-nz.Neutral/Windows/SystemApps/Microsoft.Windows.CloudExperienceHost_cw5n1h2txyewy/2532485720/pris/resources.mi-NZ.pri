  \oobeCortana\cortanaSubHeading_newUwp:
    Candidate Language=MI-NZ: Hei mahi i tēnei, me whai urunga a Cortana ki ētahi o ō mōhiohio whaiaro
  \oobeCortana\cortanaSubHeading_A:
    Candidate Language=MI-NZ: Te tikanga kia whai kaiāwhina whaiaro ngā tāngata katoa. Āe, he matihiko a Cortana engari hei aha.
  \oobeCortana\cortanaSubHeadingVoiceOver:
    Candidate Language=MI-NZ: Tēnā titiro, ko au tēnā Cortana! Ka whakaaetia ahau kia whakamahi i ngā mōhiohio hei mahi i āku mahi tino pai?
  \oobeCortana\cortanaSubHeading:
    Candidate Language=MI-NZ: Tēnā titiro, ko au tēnā Cortana! <br/>Ka āhei au kia whakaaetia kia whakamahi i ngā mōhiohio hei mahi i āku mahi tino pai?
  \oobeCortana\cortanaLogoAlt_globalConsent:
    Candidate Language=MI-NZ: Ka taea e Cortana te āwhina i a koe ki te whakahaere i tō wā, te whakaoti i ngā mahi me te noho honohono tonu. Whakamahia a Cortana ki te tiro atu ki tō maramataka, te whakarite whakamaharatanga, te whakatangi pūoro me te whiwhi whakautu ina ka hiahiatia.
  \oobeCortana\cortanaLogoAlt:
    Candidate Language=MI-NZ: moko cortana
  \oobeCortana\cortanaHeading_newUwp:
    Candidate Language=MI-NZ: Tuku kia āwhina a Cortana kia mahia ō mahi
  \oobeCortana\cortanaHeading_globalConsent:
    Candidate Language=MI-NZ: Whiwhi āwhina mai i tō kaiāwhina matihiko
  \oobeCortana\cortanaHeading_A:
    Candidate Language=MI-NZ: Tukua Cortana kia āwhina i a koe
  \oobeCortana\cortanaHeading:
    Candidate Language=MI-NZ: Whakarite kia noho ko Cortana tō kaiāwhina whaiaro?
  \oobeCortana\cortanaCaptionText:
    Candidate Language=MI-NZ: Kei te āwhina a Cortana i a koe ki te whakahaere i tō wā, te whakaoti i ngā mahi, me te honohono tonu
