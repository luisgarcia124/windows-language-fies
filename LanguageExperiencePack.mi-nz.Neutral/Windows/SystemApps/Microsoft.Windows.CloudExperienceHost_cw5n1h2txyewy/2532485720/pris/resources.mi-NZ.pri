  \errors\BlockedByPolicyMSATitle:
    Candidate Language=MI-NZ: Kāore e taea te takiuru mā tētahi pūkete Microsoft
  \errors\AccountText:
    Candidate Language=MI-NZ: Kāore e taea te takiuru i a koe i tēnei wā. Ngana anō, ka tīpako rānei i te Tīpoka kia takiuru mai ā muri ake.
  \enterpriseNgcEnrollment\TryAgainButton:
    Candidate Language=MI-NZ: Kia ngana anō
