  \personalDataExport\PrivacyTitle:
    Candidate Language=MI-NZ: Tauākī Tūmataitinga Microsoft
  \personalDataExport\PrivacyStatementUrl:
    Candidate Language=MI-NZ: https://go.microsoft.com/fwlink/?linkid=850749
  \personalDataExport\PrivacyLinkDisplayText:
    Candidate Language=MI-NZ: https://aka.ms/privacy
  \personalDataExport\Paragraph3:
    Candidate Language=MI-NZ: Ka tukatuka a Microsoft me te whakawhiti i ō raraunga e ai ki te Tauākī Tūmataitinga Microsoft.
  \personalDataExport\Paragraph2:
    Candidate Language=MI-NZ: Ki te kore koe e whakaae ki taua whakawhiti raraunga, ka taea te kōwhiri ki te kāti whakamahi i te hua. Tohutoro ki ngā ture whakamahi mō tō hua e pā ana ki te māraurau whakahoki moni.
  \personalDataExport\Paragraph1:
    Candidate Language=MI-NZ: Kia mahi ai tēnei hua e ai ki te tūmanakonga, me whakawhiti e Microsoft ō raraunga kia tukatukahia ki tētahi pokapū raraunga Microsoft i waho atu i tō whenua, i tō rohe rānei. Mā te whakamahi haere tonu i tēnei hua, e whakaae ana koe ki taua whakawhiti raraunga.
  \personalDataExport\PageTitle:
    Candidate Language=MI-NZ: Ka tukatukatia ō raraunga i waho atu i tō whenua, i tō rohe rānei
  \personalDataExport\NextButtonText:
    Candidate Language=MI-NZ: Panuku
  \personalDataExport\NavigationError:
    Candidate Language=MI-NZ: Te āhua nei kei te raruraru te tūhonotanga - e kore pea koe e tūhono ki te ipurangi, he raru rānei i tō mātou pito.<ul><li>Kia ākona atu anō he take mō te whakawhiti i ō raraunga mai i Haina ki te whenua atu kē ina whakamahia ana e koe tēnei hua Microsoft, patopatohia te https://aka.ms/productslist ki te pae wāhitau o tētahi pūtirotiro i tētahi pūrere.</li><br/><li>Mō ngā mōhiohio atu anō e pā ana ki te tūmataitinga me ngā hua Microsoft, tirohia te Tauākī Tūmataitinga Microsoft i https://aka.ms/privacy.</li></ul>
  \personalDataExport\LearnMoreLinkText:
    Candidate Language=MI-NZ: Ako atu anō mō ō kōwhiringa raraunga
  \personalDataExport\LearnMoreDataTransferUrl:
    Candidate Language=MI-NZ: https://go.microsoft.com/fwlink/?linkid=2214603
  \personalDataExport\LearnMoreButtonText:
    Candidate Language=MI-NZ: Ako atu anō
  \personalDataExport\ContinueButtonText:
    Candidate Language=MI-NZ: Haere tonu
