  \deviceUser\ErrorDialog:
    Candidate Language=MI-NZ: Kua puta he hapa: 0x
  \deviceUser\BackButton:
    Candidate Language=MI-NZ: &Hoki
  \cortana\setCortanaOptOut:
    Candidate Language=MI-NZ: Not now
  \cortana\privacyStatement:
    Candidate Language=MI-NZ: Privacy statement
  \cortana\learnMoreLink:
    Candidate Language=MI-NZ: Learn more
  \cortana\learnMoreHeadline:
    Candidate Language=MI-NZ: Cortana
  \cortana\learnMoreBody2:
    Candidate Language=MI-NZ: Learn more about Cortana in the Privacy Statement (https://aka.ms/privacy) and in the Cortana Learn more (https://aka.ms/cortanafaq).
  \cortana\learnMoreBody:
    Candidate Language=MI-NZ: Cortana is your personal assistant. Cortana works best when you sign in and let it learn about you and your activities by using data from your device, your personal Microsoft account, third-party services and other Microsoft services. To help Cortana to provide personalized experiences and relevant suggestions, you can let Microsoft collect and use various types of data, such as your device location, data from your calendar, the apps you use, data from your emails and text messages, who you call, your contacts and who you interact with on your device. When you are signed in, Cortana also learns about you by collecting data about how you use your device and other Microsoft services, such as your music, alarm settings, whether the lock screen is on, what you view and purchase, your browsing in Microsoft Edge and Bing search history, and more. You can manage what data Cortana uses, and what it knows about you in Cortana Settings, Notebook and Permissions. You can always sign out of Cortana, and when you do, Cortana will still be there to help, but your experiences will not be personalized.
  \cortana\cortanaPersonaText3:
    Candidate Language=MI-NZ: Arā, ko ahau tō kaiāwhina whaiaro me tō hoa haere.<br/>Ka reri koe ka reri ahau.
  \cortana\cortanaPersonaText2:
    Candidate Language=MI-NZ: I'm your searcher, finder, weather watcher, plan-aheader, note taker, reminder maker, and animal impersonator (if you ever need that).
  \cortana\cortanaPersonaText:
    Candidate Language=MI-NZ: Kia ora, ko Cortana ahau.<br/>Kei konei au kia māmā ake te haere, kia āwhina hoki i a koe kia oti ai ngā mahi.
  \cortana\cortanaNextButton:
    Candidate Language=MI-NZ: Use Cortana
  \cortana\cortanaIntro:
    Candidate Language=MI-NZ: Meet Cortana
  \cortana\cortanaContent:
    Candidate Language=MI-NZ: Ko Cortana tō hoa haere, rite tonu ki te āwhina ki tētahi mea e noho maitai ai koe, tuatangata ai, nahanaha noa ai rānei.<br/><br/>Kia mahi a Cortana i āna mahi pai rawa, ka kohia, ka whakamahia hoki e Microsoft ngā mōhiohio tae ki tō tauwāhi me tō hītori tauwāhi, ngā hoapā, tāurunga ā-reo, ngā tauira ā-reo, ā-ringatuhi hoki, te hītori patotanga, hītori rapu, ngā taipitopito maramataka, ihirangi me te hītori whakawhitiwhiti mai i ngā karere me ngā taupānga, me ētahi atu mōhiohio kei tō pūrere. I roto i Microsoft Edge, ka whakamahi a Cortana i tō hītori tirotiro. Ka taea tonutia e koe te rāwekeweke ngā mea e maumahara ana a Cortana i roto i te Pukatuhipoka me te whakaweto i a Cortana i roto i Microsoft Edge.
  \cloudDomainJoin\CredPromptTitle:
    Candidate Language=MI-NZ: Tāurua tō kupuhipa
  \cloudDomainJoin\CredPromptCaption:
    Candidate Language=MI-NZ: Mō te haumarutanga, me tāuru tō kupuhipa mō tētahi wā anō.
  \MicrosoftInternalMetadata\ContentChecksumValue:
    Candidate Language=MI-NZ: 2532485720
