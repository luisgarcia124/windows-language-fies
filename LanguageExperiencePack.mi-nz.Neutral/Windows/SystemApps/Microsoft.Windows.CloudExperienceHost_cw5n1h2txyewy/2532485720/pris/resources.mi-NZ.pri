  \localAccount\VoiceOver:
    Candidate Language=MI-NZ: He rite te māmā o te waihanga i te kaiwhakamahi paetata ki tā te tāuru i tō ingoa kaiwhakamahi me tō kupuhipa.
  \localAccount\UserReserved_Error:
