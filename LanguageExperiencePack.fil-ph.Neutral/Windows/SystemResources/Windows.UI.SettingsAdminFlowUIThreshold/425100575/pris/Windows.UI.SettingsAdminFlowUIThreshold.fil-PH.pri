  \resources\Uninstall_Information_LoseChanges_Build:
    Candidate Language=FIL-PH: •  Mawawala mo ang anumang pagbabagong ginawa sa mga setting pagkatapos i-install ang pinakabagong build.
  \resources\Uninstall_Information_LoseChanges:
