    Candidate Language=FIL-PH: Piliin kung aling mga app ang makakabasa ng mga mensahe
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Messaging_UsageHistory_Group\AdditionalDescription:
    Candidate Language=FIL-PH: Tingnan kung aling mga app ang nag-access sa iyong mga text message sa nakalipas na 7 araw 
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Messaging_SystemGlobal_Group\DisplayName:
    Candidate Language=FIL-PH: Payagan ang access sa messaging sa device na ito
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Messaging_SystemGlobal_Group\Description:
    Candidate Language=FIL-PH: Kung pinapayagan mo ang pag-access, ang mga taong gumagamit ng device na ito ay maaaring pumili kung ang kanilang mga app ay magkaka-access sa pagbabasa ang mga tekstong mensahe sa pamamagitan ng paggamit ng setting sa pahinang ito. Ang pagtanggi sa pag-access ay nagba-block ng apps mula sa pagbabasa ng mga mensahe.
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Messaging_SystemGlobal_Group2\DisplayName:
    Candidate Language=FIL-PH: Access sa messaging
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Messaging_SystemGlobal_Group2\AdditionalDescription:
    Candidate Language=FIL-PH: Ang sinumang gumagamit ng device na ito ay maaaring pumili kung ang kanilang mga app ay may access na magbasa ng mga text message na may isang cellular na koneksyon kapag ito ay naka-on
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Messaging_AppList_Group\DisplayName:
