    Candidate Language=FIL-PH: Gumamit ng pagkilala ng pananalita sa Windows Mixed Reality
  \SystemSettings\Resources\HolographicSpeechAndAudio_Speech2\DisplayName:
    Candidate Language=FIL-PH: Pagkilala sa pananalita para sa Windows Mixed Reality
