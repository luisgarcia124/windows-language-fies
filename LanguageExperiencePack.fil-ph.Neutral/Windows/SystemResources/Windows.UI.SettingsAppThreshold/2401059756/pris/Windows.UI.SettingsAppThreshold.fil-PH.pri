  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Messaging_UserGlobal_Group\Description:
    Candidate Language=FIL-PH: Kung pinapayagan mo ang pag-access, maaari mong piliin kung aling mga app ang maaaring magbasa ng mga mensahe sa text sa pamamagitan ng paggamit ng mga setting sa pahinang ito. Kung tatanggihan ang pag-acces, iba-block nito ang mga app sa pagbabasa ng mga text.
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Messaging_UserGlobal_Group2\DisplayName:
    Candidate Language=FIL-PH: Hayaan ang mga app na magbasa ng mga mensahe
