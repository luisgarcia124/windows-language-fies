  \SystemSettings\Resources\SystemSettings_CapabilityAccess_BackgroundSpatialPerception_UserGlobal_Group\DisplayName:
    Candidate Language=FIL-PH: Payagan ang pag-access sa background sa iyong mga paggalaw
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_BackgroundSpatialPerception_UserGlobal_Group\Description:
    Candidate Language=FIL-PH: Kung papayagan mo ang access, mapipili mo kung magkakaroon ng access ang iyong mga app sa paggalaw ng iyong ulo at mga kamay, motion controller, at iba pang bagay na sinusubaybayan, habang tumatakbo ang mga app sa background sa pamamagitan ng paggamit sa mga setting sa pahinang ito. Kapag tinanggihan ang access, maba-block ang mga app sa pag-access sa iyong mga paggalaw habang tumatakbo sa background ang mga app.
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_BackgroundSpatialPerception_SystemGlobal_Group\DisplayName:
    Candidate Language=FIL-PH: Payagan ang pag-access sa background sa mga paggalaw ng user
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_BackgroundSpatialPerception_SystemGlobal_Group\Description:
    Candidate Language=FIL-PH: Kung papayagan mo ang access, mapipili ng mga taong gumagamit sa device na ito kung magkakaroon ng access ang kanilang mga app sa paggalaw ng ulo at mga kamay ng user, motion controller, at iba pang bagay na sinusubaybayan, habang tumatakbo ang mga app sa background sa pamamagitan ng paggamit sa mga setting sa pahinang ito. Kapag tinanggihan ang access, maba-block ang mga app sa pag-access sa mga paggalaw ng sinuman habang tumatakbo sa background ang mga app.
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_BackgroundSpatialPerception_AppList_Group\DisplayName:
    Candidate Language=FIL-PH: Piliin kung aling mga app ang maaaring mag-access ng iyong galaw habang tumatakbo sa background
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_BackgroundSpatialPerception_AppList_Group\Description:
    Candidate Language=FIL-PH: Kailangan ng ilang app na i-access ang iyong mga paggalaw habang tumatakbo sa background para gumana gaya ng gusto. Kapag na-off ang isang app dito ay maaaring limitahan kung anong magagawa nito.
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_AppSilo_EmptyListDescription:
    Candidate Language=FIL-PH: Pagkatapos i-install ang mga nakahiwalay na application ng Win32, lalabas ang mga iyon dito
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_AppSilo_CompletedDescription:
