  \SystemSettings\Resources\SystemSettings_CapabilityAccess_MusicLibrary_UserGlobal_Group\DisplayName:
    Candidate Language=FIL-PH: Payagan ang mga app na i-access ang iyong library ng musika
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_MusicLibrary_UserGlobal_Group\Description:
    Candidate Language=FIL-PH: Kung papayagan mo ang pag-access, maaari kang pumili kung aling mga app ang maaaring mag-access sa iyong library ng musika sa pamamagitan ng paggamit ng mga setting sa pahinang ito. Kung tatanggihan mo ang pag-access, ang mga app na magagamit sa Microsoft Store sa Windows 11 ay maba-block mula sa pag-access sa iyong library ng musika.
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_MusicLibrary_SystemGlobal_Group\DisplayName:
