  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Motion_SystemGlobal_Group\DisplayName:
    Candidate Language=FIL-PH: Payagan ang access sa data ng paggalaw sa device na ito
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Motion_SystemGlobal_Group\Description:
    Candidate Language=FIL-PH: Kung papayagan mo ang pag-access, magagawa ng mga taong gumagamit sa device na ito na piliin kung magkakaroon ng access ang kanilang mga app sa kanilang data ng paggalaw sa pamamagitan ng paggamit sa mga setting sa pahinang ito. Kapag tinanggihan ang pag-access, iba-block nito ang mga app sa pag-access sa data ng paggalaw ng sinuman o pagkolekta sa kanilang kasaysayan ng paggalaw.
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Motion_PrivacyLearnMore\DisplayName:
