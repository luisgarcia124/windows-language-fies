  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Location_WindowsAndServicesGlobal_Group\DisplayName:
    Candidate Language=FIL-PH: Hayaan ang Mga Serbisyo ng Windows at App na i-access ang iyong lokasyon
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Location_WindowsAndServicesGlobal_Group\AdditionalDescription:
    Candidate Language=FIL-PH: Nakalista rito ang Mga Serbisyo ng Windows at App na nakaraang nag-access sa iyong lokasyon
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Location_UserGlobal_Group\DisplayName:
    Candidate Language=FIL-PH: Payagan ang mga app na i-access ang iyong lokasyon
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Location_UserGlobal_Group\Description:
    Candidate Language=FIL-PH: Kung papayagan mo ang access, maaari mong gamitin ang mga setting sa pahinang ito para piliin kung alin sa mga app ang maaaring mag-access sa tumpak na lokasyon at kasaysayan ng lokasyon ng iyong device para paganahin ang mga karanasang batay sa lokasyon gaya ng mga direksyon at lagay ng panahon. Kung naka-sign in ka sa isang account sa Microsoft sa device na ito, naka-save sa cloud ang iyong huling alam na lokasyon, at ibinabahagi sa iba pang device kung saan ka naka-sign in sa iyong account sa Microsoft. Kapag tinanggihan ang access, bina-block lang ang mga app na nakalista sa pahinang ito sa pag-access sa lokasyon mo.
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Location_UserGlobal2\DisplayName:
    Candidate Language=FIL-PH: Hayaan ang mga app na i-access ang iyong lokasyon
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Location_UserGlobal2\AdditionalDescription:
    Candidate Language=FIL-PH: Maa-access ng lahat ng app ang approximate location, ngunit maaari mong piliin kung aling mga app ang makaka-access sa iyong eksaktong lokasyon
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Location_UsageHistory_Group\AdditionalDescription:
    Candidate Language=FIL-PH: Tingnan kung aling mga app ang nag-access sa iyong lokasyon sa nakalipas na 7 araw 
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Location_SystemGlobal_Group\DisplayName:
    Candidate Language=FIL-PH: Payagan ang access sa lokasyon sa device na ito
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Location_SystemGlobal_Group\Description:
    Candidate Language=FIL-PH: Kung papayagan mo ang access, papahintulutan mo ang Windows na gamitin ang mga kakayahan ng iyong device para matukoy ang iyong lokasyon at gagamitin ng Microsoft ang iyong data ng lokasyon para mapahusay ang mga serbisyo ng lokasyon. Mapipili ng mga taong gumagamit sa device na ito kung magkakaroon ng access ang kanilang mga app sa lokasyon sa pamamagitan ng paggamit sa mga setting sa pahinang ito. Kapag tinanggihan ang access, iba-block ang Windows sa pagbibigay ng lokasyon sa mga tampok ng Windows, mga app sa Microsoft Store, at karamihan ng app sa desktop.
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Location_SystemGlobal_Group2_TurnOffButtonText:
    Candidate Language=FIL-PH: I-off
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Location_SystemGlobal_Group2_Link\Text:
    Candidate Language=FIL-PH: Alamin ang higit pa
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Location_SystemGlobal_Group2_Dialog_Title:
    Candidate Language=FIL-PH: I-off ang mga serbisyo ng lokasyon
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Location_SystemGlobal_Group2_Dialog_Description:
    Candidate Language=FIL-PH: I-o-off nito ang lokasyon para sa sinumang gumagamit ng device na ito. Hanapin ang aking device at magiging hindi available ang awtomatikong time zone. Hindi na makakahiling ng lokasyon o makakahanap ng kalapit na Wi-Fi o Bluetooth ang mga app at serbisyo.
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Location_SystemGlobal_Group2_CancelButtonText:
    Candidate Language=FIL-PH: Kanselahin
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Location_SystemGlobal_Group2_AdditionalDescription_On:
    Candidate Language=FIL-PH: Magiging available ang lokasyon sa Windows, at maaaring piliin ng sinumang gumagamit ng device na ito kung maaaring i-access ng mga app ang kanilang lokasyon
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Location_SystemGlobal_Group2_AdditionalDescription_Off:
    Candidate Language=FIL-PH: Naka-off ang lokasyon at hindi magagamit ng Windows at ng iba pang mga gumagamit ng device na ito ang lokasyon
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Location_SystemGlobal_Group2\DisplayName:
    Candidate Language=FIL-PH: Mga serbisyo ng lokasyon
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Location_SystemGlobal2\DisplayName:
    Candidate Language=FIL-PH: Payagan ang kontrol ng gumagamit
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Location_SystemGlobal2\AdditionalDescription:
    Candidate Language=FIL-PH: I-on o i-off ang lokasyon para sa lahat ng mga gumagamit sa mga serbisyo ng device at system
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Location_Spotlight_Group\AdditionalDescription:
    Candidate Language=FIL-PH: Ang Windows ay may mga paggamit ng lokasyon na maaaring hindi inaasahan para suriin mo
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Location_MainHeading\Description:
    Candidate Language=FIL-PH: Magagamit ng Windows ang mga kakayahan ng iyong device para matukoy ang iyong lokasyon. Maaaring gamitin ng Microsoft ang data ng lokasyon para pahusayin ang katumpakan ng mga serbisyo ng lokasyon nito.
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Location_ClassicAppList_Group\DisplayName:
    Candidate Language=FIL-PH: Payagan ang mga desktop app na i-access ang iyong eksaktong lokasyon
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Location_ClassicAppList_Group\Description:
    Candidate Language=FIL-PH: Kailangan ng ilang app at tampok ng Windows na i-access ang iyong lokasyon para gumana gaya ng inaasahan. Kapag na-off ang setting na ito rito, maaaring malimitahan kung anong magagawa ng mga desktop app at ng Windows.
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Location_ClassicAppList_Group2\DisplayName:
    Candidate Language=FIL-PH: Hayaan ang mga desktop app na i-access ang iyong lokasyon
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Location_ClassicAppList_Group2\AdditionalDescription:
    Candidate Language=FIL-PH: Nakalista rito ang mga desktop app na dati nang nag-access sa iyong lokasyon
