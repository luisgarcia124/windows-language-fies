  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Radios_AppList_Group\Description:
    Candidate Language=FIL-PH: Gumagamit ng mga radio ang ilang app—kagaya ng Bluetooth—sa iyong device para magpadala at tumanggap ng data. Minsan, kailangang i-on at i-off ng mga app ang mga radio na ito para gumana kagaya ng inaasahan.
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Pictures_UserGlobal_Group\DisplayName:
