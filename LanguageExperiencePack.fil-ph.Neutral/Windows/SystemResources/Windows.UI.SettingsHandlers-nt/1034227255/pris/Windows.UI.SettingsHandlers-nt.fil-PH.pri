  \resources\SystemSettings_Accounts_PeopleOnDeviceDescription:
    Candidate Language=FIL-PH: Magdagdag ng isang taong maaaring mag-sign in sa device na ito. Hindi siya idinagdag sa iyong pamilyang grupo.
  \resources\SystemSettings_Accounts_OtherUsersDescription:
    Candidate Language=FIL-PH: Payagan ang mga taong hindi bahagi ng iyong pamilya na mag-sign in gamit ang sarili nilang mga account. Hindi sila idadagdag sa iyong pamilya.
  \resources\SystemSettings_Accounts_MSAConnectButton2:
