  \oobeHello\HelloSetUpSpeechConstraint:
    Candidate Language=FIL-PH: Set up
  \oobeHello\HelloOptionTitleFingerprint:
    Candidate Language=FIL-PH: Gamitin ang iyong fingerprint
  \oobeHello\HelloOptionTitleFace:
    Candidate Language=FIL-PH: Gumamit ng pagkilala ng mukha
  \oobeHello\HelloOptionBodyFingerprint:
    Candidate Language=FIL-PH: Mayroon ding sensor ng fingerprint ang iyong device na gumagana sa Windows Hello kaya maaari kang mag-sign in nang ligtas gamit lang ang iyong daliri.
  \oobeHello\HelloMultiVoiceOver:
    Candidate Language=FIL-PH: Windows Hello gives you a couple of options for signing in speedily and securely. Would you prefer to use your fingerprint or your face?
  \oobeHello\HelloMultiListAccessibleName:
    Candidate Language=FIL-PH: Listahan ng mga sensor na tugma sa Windows Hello
  \oobeHello\HelloMultiFingerprint7SpeechConstraint:
    Candidate Language=FIL-PH: Use your fingerprint
  \oobeHello\HelloMultiFingerprint6SpeechConstraint:
    Candidate Language=FIL-PH: Use my fingerprint
  \oobeHello\HelloMultiFingerprint5SpeechConstraint:
    Candidate Language=FIL-PH: My fingerprint
  \oobeHello\HelloMultiFingerprint4SpeechConstraint:
    Candidate Language=FIL-PH: Use fingerprint
  \oobeHello\HelloMultiFingerprint3SpeechConstraint:
    Candidate Language=FIL-PH: Fingerprint recognition
  \oobeHello\HelloMultiFingerprint2SpeechConstraint:
    Candidate Language=FIL-PH: Fingerprint
  \oobeHello\HelloMultiFingerprint1SpeechConstraint:
    Candidate Language=FIL-PH: Finger
  \oobeHello\HelloMultiFace6SpeechConstraint:
