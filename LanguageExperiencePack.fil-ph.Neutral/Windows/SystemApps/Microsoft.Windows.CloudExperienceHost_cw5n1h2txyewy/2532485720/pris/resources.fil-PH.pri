  \shubOobeDeviceType\HuddleHeader:
    Candidate Language=FIL-PH: Pagtutulungan ng team
  \shubOobeDeviceType\HuddleDescription:
    Candidate Language=FIL-PH: Piliin ito para sa nakabahaging paggamit, whiteboarding, pagpapalitan ng ideya. Ino-on ang Windows Hello at nagse-save ng mga profile para sa mabilisang pag-sign in.
  \shubOobeDeviceType\DeviceTypeTitle:
    Candidate Language=FIL-PH: Paano mo gagamitin ang device na ito?
  \shubOobeDeviceType\DeviceTypeDescription:
    Candidate Language=FIL-PH: Itatakda namin ang mga bagay batay sa iyong pipiliin. Maaari kang gumawa ng nga pagbabago anumang oras sa Mga Setting.
  \shubOobeDeviceType\ConferenceHeader:
    Candidate Language=FIL-PH: Mga pulong at presentasyon
  \shubOobeDeviceType\ConferenceDescription:
    Candidate Language=FIL-PH: Piliin ito para sa mga conference room, nakaiskedyul na pulong, at presentation. Hindi io-on ang Windows Hello at matatanggal ang data pagkatapos ng bawat session.
  \roamingSettings\Title:
    Candidate Language=FIL-PH: I-sync ang iyong mga setting
  \roamingSettings\nextButton:
    Candidate Language=FIL-PH: Tapusin
  \roamingSettings\LeadText:
    Candidate Language=FIL-PH: Aling Mga Setting ng PC mula sa iyong account sa Microsoft ang gusto mong i-sync sa PC na ito?
  \retailDemo\useOfflineShutdownToggle:
    Candidate Language=FIL-PH: I-override ang mga online na setting
  \retailDemo\timeZoneText:
    Candidate Language=FIL-PH: Tiyaking tama ang time zone sa device na ito kapag napunta ka sa desktop. Kakailanganin mong gamitin ang Admin account para baguhin ang timezone.
  \retailDemo\timeoutLegend:
