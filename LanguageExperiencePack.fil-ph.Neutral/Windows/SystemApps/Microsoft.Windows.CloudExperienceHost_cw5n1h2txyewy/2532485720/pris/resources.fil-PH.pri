  \oobeCommon\AccountSection:
    Candidate Language=FIL-PH: Account
  \oobeAadcAgeConfirmation\Title:
    Candidate Language=FIL-PH: Para sa isang bata o isang teenager ba ang account na ito?
  \oobeAadcAgeConfirmation\Subtitle:
    Candidate Language=FIL-PH: Kung gayon, isaalang-alang ang pag-sign in gamit ang isang Account sa Microsoft. Kapag nag-log in ang mga mas batang miyembro ng pamilya gamit ang isang Microsoft account, magkakaroon sila ng mga proteksyon sa privacy na nakatuon sa kanilang edad. Ang mga magulang at tagapag-alaga ay maaari ring mag-set up ng isang grupo ng pamilya kasama ang Kaligtasan ng Pamilya sa Microsoft.
  \oobeAadcAgeConfirmation\Option2Text:
    Candidate Language=FIL-PH: Gumawa ng account sa device na ito gamit ang isang user name at password
  \oobeAadcAgeConfirmation\Option2Header:
    Candidate Language=FIL-PH: Huwag mag-sign in gamit ang Account sa Microsoft
  \oobeAadcAgeConfirmation\Option2Glyph:
    Candidate Language=FIL-PH: 
  \oobeAadcAgeConfirmation\Option1Text:
    Candidate Language=FIL-PH: Gumawa ng Account sa Microsoft para makakuha ng proteksyon sa privacy na nakatuon sa edad sa device na ito
  \oobeAadcAgeConfirmation\Option1Header:
    Candidate Language=FIL-PH: Mag-sign in gamit ang Account sa Microsoft
  \oobeAadcAgeConfirmation\Option1Glyph:
    Candidate Language=FIL-PH: 
  \oobeAadcAgeConfirmation\OobeeAadcAgeConfirmationLearnMoreButtonText:
    Candidate Language=FIL-PH: Matuto Pa
  \oobeAadcAgeConfirmation\OobeAadcAgeConfirmationYesButtonText:
    Candidate Language=FIL-PH: Oo
  \oobeAadcAgeConfirmation\OobeAadcAgeConfirmationTitle:
    Candidate Language=FIL-PH: Uri ng account
  \oobeAadcAgeConfirmation\OobeAadcAgeConfirmationNoButtonText:
    Candidate Language=FIL-PH: Hindi
  \oobeAadcAgeConfirmation\OobeAadcAgeConfirmationBodyText:
    Candidate Language=FIL-PH: Ang account bang ito ay para sa isang bata o teenager<br><br>Kapag nag-log in ang mga mas batang miyembro ng pamilya gamit ang Account sa Microsoft, magkakaroon sila ng mga proteksyon sa pagiging pribado na nakatuon sa kanilang edad. Maaari ding mag-set up ang mga magulang at tagapag-alaga ng grupo ng pamilya sa Kaligtasan ng Pamilya sa Microsoft. Ang pag-set up ng grupo ng pamilya ay nakakatulong sa lahat na manatiling ligtas online at sa tunay na buhay gamit ang mga limitasyon sa oras ng screen, mga filter ng nilalaman, pagbabahagi ng lokasyon, at higit pa.
  \oobeAadcAgeConfirmation\NextButtonText:
    Candidate Language=FIL-PH: Susunod
  \oobeAadcAgeConfirmation\NavigationError:
    Candidate Language=FIL-PH: Mukhang nagkakaroon kami ng ilang isyu sa pagkakakonekta - maaaring hindi ka nakakonekta sa internet, o may isyu sa aming panig. Maaari kang magbasa pa tungkol sa pag-sign in gamit ang Account sa Microsoft sa pamamagitan ng pagta-type ng https://go.microsoft.com/fwlink/?linkid=2162068 sa address bar ng anumang browser sa anumang device.
  \oobeAadcAgeConfirmation\LearnMoreTitle:
    Candidate Language=FIL-PH: Alamin pa ang tungkol sa pag-sign in gamit ang isang Account sa Microsoft
  \oobeAadcAgeConfirmation\LearnMoreButtonText:
    Candidate Language=FIL-PH: Alamin pa
  \oobeAadcAgeConfirmation\ContinueButtonText:
    Candidate Language=FIL-PH: Magpatuloy
  \oemRegistration\VoiceOver:
    Candidate Language=FIL-PH: Para sa tulong sa PC na ito sa hinaharap, ipasok ang iyong email address.
  \oemRegistration\skipButton:
    Candidate Language=FIL-PH: &Laktawan
  \oemRegistration\regionDefaultOption:
    Candidate Language=FIL-PH: Bansa/Rehiyon
  \oemRegistration\prepopulatedInfoLabel:
    Candidate Language=FIL-PH: Gumamit kami ng ilang impormasyon mula sa iyong Account sa Microsoft.
