  \retailDemo\nextButton:
    Candidate Language=FIL-PH: Susunod
  \retailDemo\msaTitle:
    Candidate Language=FIL-PH: Oras na para gumawa ng demo na account sa Microsoft
  \retailDemo\msaText:
    Candidate Language=FIL-PH: Kailangan mo ng demo na account sa Microsoft para paganahin ang mga demo na karanasan tulad ng Microsoft Store. I-click ang 'Tapusin' para awtomatikong gumawa ng Account sa Microsoft.
