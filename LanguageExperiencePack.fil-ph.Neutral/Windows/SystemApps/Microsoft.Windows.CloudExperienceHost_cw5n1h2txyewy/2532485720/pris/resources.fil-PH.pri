  \retailDemo\signInLink:
    Candidate Language=FIL-PH: Mag-sign in sa isang umiiral nang account sa Microsoft
  \retailDemo\shutdownTextOnline:
    Candidate Language=FIL-PH: Nakakompigura ang mga oras ng pag-shut down para sa device na ito sa pamamagitan ng serbisyo sa cloud ng karanasan sa retail na demo
  \retailDemo\shutdownText:
    Candidate Language=FIL-PH: Piliin ang mga oras ng pag-shut down para sa device na ito
  \retailDemo\shutdownsTitle:
    Candidate Language=FIL-PH: Awtomatikong pag-shutdown
  \retailDemo\shutdownsInfo:
    Candidate Language=FIL-PH: Itakda ang mga oras ng awtomatikong pag-shut down para sa device na ito.
  \retailDemo\securityTitle:
    Candidate Language=FIL-PH: mga setting ng admin ng RDX
  \retailDemo\securityText:
    Candidate Language=FIL-PH: Piliin kung gaano katagal mo gustong gumana ang RDX bago matanggal ang access sa admin account. Kapag natanggal na ang access, hindi mo na magagawang magpagana ng mga script o gumawa ng anupamang mga gawain ng tagapangasiwa. Kung gusto mong panatilihin ang access ng admin sa loob ng hindi nakatakdang panahon, maaari kang gumawa ng custom na password ng tagapangasiwa. Pakitiyak na ang iyong custom na password ay ligtas hangga't maaari.
  \retailDemo\retypePassword:
    Candidate Language=FIL-PH: Muling i-type ang password
  \retailDemo\removeRdxTitle:
    Candidate Language=FIL-PH: Tanggalin ang RDX
  \retailDemo\removeRdxText:
    Candidate Language=FIL-PH: Tanggalin
  \retailDemo\removeRdxInfo:
    Candidate Language=FIL-PH: Tanggalin ang RDX sa device na ito at ibabalik ito sa mga factory setting.
  \retailDemo\rdxTitle:
    Candidate Language=FIL-PH: Setup ng demo
  \retailDemo\rdamTitle:
    Candidate Language=FIL-PH: Kunin ang pinakabagong demo na nilalaman at mga app
  \retailDemo\rdamText:
    Candidate Language=FIL-PH: Ang pagpapasok sa impormasyong ito (opsyonal) ay makakatulong sa aming ibigay sa iyo ang pinakabagong nilalamang maipapakita sa Windows device na ito.
  \retailDemo\racLegend:
    Candidate Language=FIL-PH: Retail Access Code (RAC)
  \retailDemo\passwordSuggestion:
    Candidate Language=FIL-PH: Password
  \retailDemo\passwordManagmentLegend:
    Candidate Language=FIL-PH: Awtomatikong permanentang tanggalin ang access ng admin pagkatapos ng tinukoy na oras
