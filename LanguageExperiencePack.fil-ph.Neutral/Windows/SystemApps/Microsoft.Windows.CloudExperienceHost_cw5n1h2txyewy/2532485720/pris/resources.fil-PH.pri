  \oobeLocalAccount\UseOnlineAccountButtonText:
    Candidate Language=FIL-PH: O kaya, mas magandang gumamit ng isang online account
  \oobeLocalAccount\UseMSAAccountText:
    Candidate Language=FIL-PH: Para makapag-sign in sa halip gamit ang device na ito, piliin ang gumamit ng online na account
  \oobeLocalAccount\SQSA_Error:
    Candidate Language=FIL-PH: Kailangan ang field na ito.
  \oobeLocalAccount\SQSATitle:
    Candidate Language=FIL-PH: Ngayon, magdagdag ng tanong na panseguridad
  \oobeLocalAccount\SQSALeadHtml:
    Candidate Language=FIL-PH: Kung sakaling makalimutan mo ang password mo, pumili ng 3 tanong na panseguridad. Tiyaking hindi madaling makalimutan ang iyong mga sagot.
  \oobeLocalAccount\SQSAErrorVoiceOver:
    Candidate Language=FIL-PH: You’ll need to finish entering your security questions before you can continue.
  \oobeLocalAccount\SQSA3VoiceOver:
    Candidate Language=FIL-PH: Third one's a charm. Choose your last question, type the answer, and you're good to go.
  \oobeLocalAccount\SQSA2VoiceOver:
    Candidate Language=FIL-PH: Now for the second one. Same drill.
  \oobeLocalAccount\SQSA1VoiceOver:
    Candidate Language=FIL-PH: Now you can set up 3 security questions to help you reset your password if you forget it. Choose the first question and type your answer.
  \oobeLocalAccount\SecurityQuestionPlaceholder3:
    Candidate Language=FIL-PH: Tanong sa seguridad (3 ng 3)
  \oobeLocalAccount\SecurityQuestionPlaceholder2:
    Candidate Language=FIL-PH: Tanong sa seguridad (2 of 3)
  \oobeLocalAccount\SecurityQuestionPlaceholder1:
    Candidate Language=FIL-PH: Tanong sa seguridad (1 ng 3)
  \oobeLocalAccount\SecurityQuestion6:
    Candidate Language=FIL-PH: Anong pangalan ng unang paaralang pinasukan mo?
  \oobeLocalAccount\SecurityQuestion5:
    Candidate Language=FIL-PH: Ano ang pangalan ng pinakamatanda mong pinsan?
  \oobeLocalAccount\SecurityQuestion4:
    Candidate Language=FIL-PH: Saang lungsod nagkakilala ang iyong mga magulang?
  \oobeLocalAccount\SecurityQuestion3:
    Candidate Language=FIL-PH: Ano ang iyong palayaw noong bata ka pa?
  \oobeLocalAccount\SecurityQuestion2:
    Candidate Language=FIL-PH: Saang lungsod ka ipinanganak?
  \oobeLocalAccount\SecurityQuestion1:
    Candidate Language=FIL-PH: Ano ang pangalan ng iyong unang alaga?
  \oobeLocalAccount\SecurityAnswerPlaceholder:
    Candidate Language=FIL-PH: Iyong sagot
  \oobeLocalAccount\PasswordVoiceOver:
    Candidate Language=FIL-PH: Ok, now type a password for your account.
  \oobeLocalAccount\PasswordTitle:
    Candidate Language=FIL-PH: Gumawa ng hinding-hindi malilimutang password
  \oobeLocalAccount\PasswordReqErrorVoiceOver:
    Candidate Language=FIL-PH: Looks like you didn't meet all the password requirements. Let's try this again.
  \oobeLocalAccount\PasswordPolicy_Error:
    Candidate Language=FIL-PH: Ang password na ipinasok mo ay hindi nakakatugon sa mga kinakailangan sa pagiging mahirap hulaan ng password na itinakda ng administrator para sa iyong network o grupo. Kunin ang mga kinakailangan sa iyong administrator, at pagkatapos ay mag-type ng bagong password.
  \oobeLocalAccount\PasswordPlaceHolder:
    Candidate Language=FIL-PH: Password
  \oobeLocalAccount\PasswordLeadHtml:
    Candidate Language=FIL-PH: Tiyaking pumili ng isang bagay na talagang matatandaan mo.
  \oobeLocalAccount\PasswordLabelText:
    Candidate Language=FIL-PH: Maglagay ng password
  \oobeLocalAccount\PasswordHint_Invalid_Error:
    Candidate Language=FIL-PH: Hindi maaaring maging laman ng iyong hint ng password ang iyong password.
  \oobeLocalAccount\PasswordHint_Empty_Error:
    Candidate Language=FIL-PH: Kailangan ng hint. Tiyaking makakatulong ito sa iyo na tandaan ang iyong password.
  \oobeLocalAccount\PasswordHintVoiceOver:
    Candidate Language=FIL-PH: Great. Now. With an offline account, if you forget your password, the only way to retrieve it is with a hint, so make sure it's memorable.
  \oobeLocalAccount\PasswordHintTitle:
    Candidate Language=FIL-PH: Magdagdag ng hint para sa iyong password
  \oobeLocalAccount\PasswordHintPlaceHolder:
    Candidate Language=FIL-PH: Hint sa password
  \oobeLocalAccount\PasswordHintLeadText:
    Candidate Language=FIL-PH: Baka nakalimutan mo. Muli, gawin itong hindi malilimutan hangga't maaari.
  \oobeLocalAccount\PasswordHintErrorVoiceOver:
    Candidate Language=FIL-PH: It's important that your password hint doesn't contain your password. That kind of defeats the purpose, really. Go ahead and pick another hint.
  \oobeLocalAccount\PasswordEmpty_Error:
    Candidate Language=FIL-PH: Magpasok ng password.
  \oobeLocalAccount\PasswordConfirm_Error:
    Candidate Language=FIL-PH: Hindi tumutugma ang password na ito. Subukang i-type itong muli.
  \oobeLocalAccount\PasswordConfirmVoiceOver:
    Candidate Language=FIL-PH: And one more time to make sure we've got it right…
  \oobeLocalAccount\PasswordConfirmTitle:
    Candidate Language=FIL-PH: Kumpirmahin ang iyong password
  \oobeLocalAccount\PasswordConfirmPlaceHolder:
    Candidate Language=FIL-PH: Kumpirmahin ang password
  \oobeLocalAccount\PasswordConfirmLeadText:
    Candidate Language=FIL-PH: I-type ang password mo nang isa pang beses.
  \oobeLocalAccount\PasswordConfirmLabelText:
    Candidate Language=FIL-PH: Pagkumpirma sa password
  \oobeLocalAccount\PasswordConfErrorVoiceOver:
    Candidate Language=FIL-PH: Those passwords didn't match. Let's try this again. Type your password.
  \oobeLocalAccount\NextButtonText:
    Candidate Language=FIL-PH: Susunod
  \oobeLocalAccount\LocalUser_NoUsername_Error:
    Candidate Language=FIL-PH: I-type ang iyong user name.
  \oobeLocalAccount\Error_Creating_Account_Warning:
    Candidate Language=FIL-PH: May nangyaring mali.
  \oobeLocalAccount\AgeConfirmationTitle:
    Candidate Language=FIL-PH: Para sa isang bata o isang teenager ba ang account na ito?
  \oobeLocalAccount\AgeConfirmationSubtitle:
    Candidate Language=FIL-PH: Kung gayon, isaalang-alang ang pag-sign in gamit ang isang Account sa Microsoft. Kapag nag-log in ang mga mas batang miyembro ng pamilya gamit ang isang Microsoft account, magkakaroon sila ng mga proteksyon sa privacy na nakatuon sa kanilang edad. Ang mga magulang at tagapag-alaga ay maaari ring mag-set up ng isang grupo ng pamilya kasama ang Kaligtasan ng Pamilya sa Microsoft.
  \oobeLocalAccount\AgeConfirmationOffline:
    Candidate Language=FIL-PH: Para sa higit pang impormasyon, gumamit ng ibang device at bisitahin ang aka.ms/accounttype.
  \oobeLocalAccount\AgeConfirmationNavigationError:
    Candidate Language=FIL-PH: Mukhang nagkakaroon kami ng ilang isyu sa pagkakakonekta - maaaring hindi ka nakakonekta sa internet, o may isyu sa aming panig. Maaari kang magbasa pa ng tungkol sa pag-sign in gamit ang Account sa Microsoft sa pamamagitan ng pagta-type ng aka.ms/accounttype sa address bar ng anumang browser sa anumang device.
  \oobeLocalAccount\AgeConfirmationLearnMoreTitle:
    Candidate Language=FIL-PH: Alamin pa ang tungkol sa pag-sign in gamit ang isang Account sa Microsoft
  \oobeLocalAccount\AgeConfirmationLearnMoreButtonText:
    Candidate Language=FIL-PH: Alamin pa
  \oobeLocalAccount\AgeConfirmationContinueButtonText:
