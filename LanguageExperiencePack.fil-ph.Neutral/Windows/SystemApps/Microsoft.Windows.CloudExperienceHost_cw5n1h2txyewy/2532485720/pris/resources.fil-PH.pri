  \oobeHello\LearnMoreButtonText:
    Candidate Language=FIL-PH: Alamin pa
  \oobeHello\KeepBioDataTitle:
    Candidate Language=FIL-PH: Oo, mag-sign in gamit ang aking mukha o fingerprint
  \oobeHello\KeepBioDataSubtitle:
    Candidate Language=FIL-PH: Patuloy na mag-store ng aking data para makapag-sign in ako sa PC na ito gamit ang pagkilala ng mukha o ng fingerprint ng Windows Hello.
  \oobeHello\HelloTitleMulti:
    Candidate Language=FIL-PH: Gusto mo bang i-set up ang Windows Hello para makapag-sign in nang mas mabilis at mas sigurado?
  \oobeHello\HelloTitleFingerprint:
    Candidate Language=FIL-PH: Gusto mo bang gamitin ang fingerprint mo para makapag-sign in nang mas mabilis at mas sigurado?
  \oobeHello\HelloTitleFace:
    Candidate Language=FIL-PH: Gusto mo bang gamitin ang muka mo para makapag-sign in nang mas mabilis at mas sigurado?
  \oobeHello\HelloSwitchFingerprintToFace:
    Candidate Language=FIL-PH: Gamitin na lang ang pagkilala ng mukha
  \oobeHello\HelloSwitchFaceToFingerprint:
    Candidate Language=FIL-PH: Gamitin na lang ang iyong fingerprint
  \oobeHello\HelloSkipLink:
