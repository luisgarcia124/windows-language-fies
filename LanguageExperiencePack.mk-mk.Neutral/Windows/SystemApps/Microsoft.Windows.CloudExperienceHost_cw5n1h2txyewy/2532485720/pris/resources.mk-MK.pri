  \oemRegistration\emailInvalidError:
    Candidate Language=MK-MK: Адресата на е-пошта не е правилно форматирана или напишана. Користете го следниот формат: someone@contoso.com
  \localNgc\TryAgainButton:
    Candidate Language=MK-MK: &Постави ПИН
  \localNgc\TitleTryAgain:
    Candidate Language=MK-MK: Чекајте, ова е важно
  \localNgc\Title:
    Candidate Language=MK-MK: Постави ПИН
  \localNgc\SkipButton:
    Candidate Language=MK-MK: Не, благодарам, можеби подоцна
  \localNgc\NextButton:
    Candidate Language=MK-MK: &Следно
  \localNgc\LearnMoreButton:
    Candidate Language=MK-MK: Дознајте повеќе
  \localNgc\BodyTryAgain:
    Candidate Language=MK-MK: Треба да поставите ПИН за да користите Windows Hello. Ќе ви одземе само момент.
  \localNgc\Body:
    Candidate Language=MK-MK: Поставете ПИН што ќе го користите наместо Windows Hello. Може никогаш да не ви затреба, но ќе ви служи како резервна копија за секој случај.
  \localAccount\VoiceOver:
    Candidate Language=MK-MK: Создавањето локален корисник е едноставно како внесувањето на корисничкото име и лозинката.
  \localAccount\UserReserved_Error:
    Candidate Language=MK-MK: Може да го користите кое било име... само не користете ги овие зборови: CON, PRN, AUX, NUL, COM1, COM2, COM3, COM4, COM5, COM6, COM7, COM8, COM9, LPT1, LPT2, LPT3, LPT4, LPT5, LPT6, LPT7, LPT8 или LPT
  \localAccount\UserPlaceholder:
    Candidate Language=MK-MK: Корисничко име
  \localAccount\Username_Too_Long:
