  \hololensDiagnostics\TroubleshootingLink:
    Candidate Language=MK-MK: Решавање проблеми
  \hololensDiagnostics\TitleTroubleshooting:
    Candidate Language=MK-MK: Добијте дијагностички информации
  \hololensDiagnostics\TitleSuccess:
    Candidate Language=MK-MK: Зачувај ги дијагностичките информации на компјутерот
  \hololensDiagnostics\TitleError:
    Candidate Language=MK-MK: Нешто не е во ред
  \hololensDiagnostics\Title:
    Candidate Language=MK-MK: Нешто не е во ред
  \hololensDiagnostics\RetryButton:
    Candidate Language=MK-MK: Обиди се повторно
  \hololensDiagnostics\ProgressDescription:
