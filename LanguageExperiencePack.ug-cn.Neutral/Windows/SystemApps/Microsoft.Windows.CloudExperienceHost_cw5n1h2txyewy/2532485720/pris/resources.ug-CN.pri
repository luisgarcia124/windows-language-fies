  \oobeCortana\returnToMain:
    Candidate Language=UG-CN: ماقۇل
  \oobeCortana\legalText_globalConsent:
    Candidate Language=UG-CN: Cortana نىڭ خاس تەسىرات ۋە مۇناسىۋەتلىك تەۋسىيە بېرىشىگە ياردەملىشىش ئۈچۈن Microsoft سىزدىن ئورۇن، ئورۇن تارىخى، ئالاقىداش، ئاۋازلىق كىرگۈزۈش، نۇتۇق ۋە قوليازما شەكىللىرى، يېزىش تارىخى، ئىزدەش تارىخى، كالېندار تەپسىلاتى، Microsoft مۇلازىمەتلىرىدىكى مەزمۇن ۋە ئالاقە تارىخى، ئۇچۇر ۋە ئەپ دېگەندەك ئۇچۇرلارنى توپلاپ ئىشلىتىدۇ. Microsoft Edge دە Cortana يەنە تور كۆرۈش تارىخىڭىزنى ئىشلىتىدۇ. بۇ تاللانمىلارنى Microsoft Edge دە خاتىرە دېگەن ئورۇندىن ئۆزگەرتەلەيسىز ۋە Cortana نى ئېتىپ قويالايسىز.
  \oobeCortana\legalText_A:
    Candidate Language=UG-CN: ‏Cortana نىڭ خاس تەسىرات ۋە مۇناسىۋەتلىك تەۋسىيەلەرنى بېرەلىشى ئۈچۈن ئۈسكۈنىڭىز قۇلۇپلاق ھالەتتىمۇ، Microsoft ئورۇن، ئورۇن تارىخى، ئالاقىداش، ئاۋازلىق كىرگۈزگەن مەزمۇن، نۇتۇق شەكىللىرى، ئىزدەش تارىخى، مۇناسىۋەت، كالېندار ئۇچۇرلىرى، تورخەت، قىسقا ئۇچۇرلاردىكى مەزمۇن ۋە ئالاقە تارىخى، مۇڭداشقۇ ۋە ئەپلەردىكى مەزمۇن ۋە ئۈسكۈنىدىكى باشقا مەلۇماتلار قاتارلىق ئۇچۇرلىرىڭىزنى توپلاپ ئىشلىتىدۇ. Microsoftدە Cortana تور كۆرۈش تارىخىنى ئىشلىتىدۇ.<br/><br/>خاتىرىدە Cortana نىڭ نېمىلەرنى ئەستە تۇتىدىغانلىقىنى ھەر ۋاقىت ئۆزگەرتەلەيسىز.
  \oobeCortana\legalText:
    Candidate Language=UG-CN: ‏Cortana نىڭ خاس تەسىرات ۋە مۇناسىۋەتلىك تەۋسىيەلەرنى بېرەلىشى ئۈچۈن ئۈسكۈنىڭىز قۇلۇپلاق ھالەتتىمۇ، Microsoft ئورۇن، ئورۇن تارىخى، ئالاقىداش، ئاۋازلىق كىرگۈزگەن مەزمۇن، نۇتۇق شەكىللىرى، ئىزدەش تارىخى، مۇناسىۋەت، كالېندار ئۇچۇرلىرى، تورخەت، قىسقا ئۇچۇرلاردىكى مەزمۇن ۋە ئالاقە تارىخى، مۇڭداشقۇ ۋە ئەپلەردىكى مەزمۇن ۋە ئۈسكۈنىدىكى باشقا مەلۇماتلار قاتارلىق ئۇچۇرلىرىڭىزنى توپلاپ ئىشلىتىدۇ. Microsoft Edge دە Cortana تور كۆرۈش تارىخىنى ئىشلىتىدۇ.<br/><br/>خاتىرىدە Cortana نىڭ نېمىلەرنى ئەستە تۇتىدىغانلىقىنى ھەر ۋاقىت تىزگىنلىيەلەيسىز ۋە Microsoft Edge دە Cortana نى چەكلىيەلەيسىز.
  \oobeCortana\learnMoreLink:
    Candidate Language=UG-CN: تەپسىلاتى
  \oobeCortana\learnMoreHeadline:
    Candidate Language=UG-CN: Cortana
  \oobeCortana\learnMoreBody_A:
    Candidate Language=UG-CN: ‏Cortana شەخسىي ياردەمچىڭىز. تىزىملاپ كىرىپ، ئۈسكۈنىڭىزدىكى مەلۇماتلار، شەخسىي Microsoft ھېساباتىڭىز، ئۈچىنچى تەرەپ مۇلازىمەتلىرى ۋە Microsoft نىڭ باشقا مۇلازىمەتلىرىدىكى مەلۇماتلار ئارقىلىق سىز ۋە مەشغۇلاتلىرىڭىزنى چۈشىنىشىگە رۇخسەت قىلسىڭىز، Cortana ئەڭ ئۈنۈملۈك ئىشلەيدۇ. Cortana نىڭ خاسلاشتۇرما مەشغۇلات ۋە مۇناسىۋەتلىك تەۋسىيەلەرنى بېرەلىشى ئۈچۈن، Microsoft نىڭ ئۈسكۈنە ئورنى، كالېندارىڭىزدىكى ئۇچۇرلار، سىز ئىشلىتىدىغان ئەپلەر، تورخەت ۋە ئۇچۇرلىرىڭىزدىكى مەلۇماتلار، ئۈسكۈنىڭىزدىكى سىز تېلېفون قىلىدىغان ۋە ئالاقە قىلىدىغان ئالاقىداشلار دېگەندەك ھەرخىل مەلۇماتلارنى توپلىشىغا رۇخسەت قىلسىڭىز بولىدۇ. تىزىملاپ كىرسىڭىز، Microsoft مۇلازىمەتلىرى Cortana ناخشا-مۇزىكا، ئەسكەرتمە تەڭشەكلىرى، قۇلۇپ ئېكرانىنىڭ ھالىتى، سىز توردا كۆرگەن ۋە سېتىۋالغان نەرسىلەر، تور كۆرۈش ۋە Bing دىكى ئىزدەش تارىخى قاتارلىق ئۇچۇرلارنى ئىشلىتىپ، سىزنى چۈشىنىدۇ. Cortana نىڭ قانداق ئۇچۇرلارنى ئىشلىتىشى ۋە سىز ھەققىدە نېمىلەرنى بىلىشىنى Cortana تەڭشەكلىرى، خاتىرە ۋە ئىجازەت دېگەن ئورۇندىن باشقۇرالايسىز. Cortana دىن خالىغان ۋاقىتتا چېكىنسىڭىز بولىدۇ، تىزىملاپ كىرمىسىڭىز، Cortana يەنىلا ياردەم بېرەلەيدۇ، ئەمما مەشغۇلاتلىرىڭىزنى خاسلاشتۇرالمايدۇ.
  \oobeCortana\learnMoreBody2:
    Candidate Language=UG-CN: مەخپىيەتلىك باياناتى (https://aka.ms/privacy) ۋە Cortana ھەققىدىكى تەپسىلاتلار (https://aka.ms/cortanafaq) دىن Cortana ھەققىدىكى ئۇچۇرلارنى كۆرۈڭ.
  \oobeCortana\learnMoreBody:
    Candidate Language=UG-CN: ‏Cortana شەخسىي ياردەمچىڭىز. تىزىملاپ كىرىپ، ئۈسكۈنىڭىزدىكى مەلۇماتلار، شەخسىي Microsoft ھېساباتىڭىز، ئۈچىنچى تەرەپ مۇلازىمەتلىرى ۋە Microsoft نىڭ باشقا مۇلازىمەتلىرىدىكى مەلۇماتلار ئارقىلىق سىز ۋە مەشغۇلاتلىرىڭىزنى چۈشىنىشىگە رۇخسەت قىلسىڭىز، Cortana ئەڭ ئۈنۈملۈك ئىشلەيدۇ. Cortana نىڭ خاسلاشتۇرما مەشغۇلات ۋە مۇناسىۋەتلىك تەۋسىيەلەرنى بېرەلىشى ئۈچۈن، Microsoft نىڭ ئۈسكۈنە ئورنى، كالېندارىڭىزدىكى ئۇچۇرلار، سىز ئىشلىتىدىغان ئەپلەر، تورخەت ۋە ئۇچۇرلىرىڭىزدىكى مەلۇماتلار، ئۈسكۈنىڭىزدىكى سىز تېلېفون قىلىدىغان ۋە ئالاقە قىلىدىغان ئالاقىداشلار دېگەندەك ھەرخىل مەلۇماتلارنى توپلىشىغا رۇخسەت قىلسىڭىز بولىدۇ. تىزىملاپ كىرسىڭىز، Cortana ناخشا-مۇزىكا، ئەسكەرتمە تەڭشەكلىرى، قۇلۇپ ئېكرانىنىڭ ھالىتى، سىز توردا كۆرگەن ۋە سېتىۋالغان نەرسىلەر، Microsoft Edge دىكى تور كۆرۈش ۋە Bing دىكى ئىزدەش تارىخى قاتارلىق ئۇچۇرلارنى ئىشلىتىپ، سىزنى چۈشىنىدۇ. Cortana نىڭ قانداق ئۇچۇرلارنى ئىشلىتىشى ۋە سىز ھەققىدە نېمىلەرنى بىلىشىنى Cortana تەڭشەكلىرى، خاتىرە ۋە ئىجازەت دېگەن ئورۇندىن باشقۇرالايسىز. Cortana دىن خالىغان ۋاقىتتا چېكىنسىڭىز بولىدۇ، تىزىملاپ كىرمىسىڭىز، Cortana يەنىلا ياردەم بېرەلەيدۇ، ئەمما مەشغۇلاتلىرىڭىزنى خاسلاشتۇرالمايدۇ.
  \oobeCortana\heyCortanaCheckboxTextUsesMoreBattery:
    Candidate Language=UG-CN: Cortana نىڭ ھەي «Hey Cortana» غا ئىنكاس قايتۇرۇشىغا رۇخسەت. بۇ ئوچۇق بولسا، Cortana توكنى كۆپرەك ئىشلىتىدۇ.
  \oobeCortana\heyCortanaCheckboxTextPluggedOnly:
    Candidate Language=UG-CN: ‏Cortana نىڭ ھەي «Hey Cortana» غا ئىنكاس قايتۇرۇشىغا رۇخسەت. بۇ ئوچۇق بولسا، Cortana توكنى كۆپرەك ئىشلىتىدۇ. ئۈسكۈنىڭىز توكقا چېتىق بولسىلا ئۇخلاق ھالەتتىمۇ، Cortana ئىنكاس قايتۇرالايدۇ.
  \oobeCortana\heyCortanaCheckboxText:
    Candidate Language=UG-CN: Cortana نىڭ ھەي «Hey Cortana» غا ئىنكاس قايتۇرۇشىغا رۇخسەت
