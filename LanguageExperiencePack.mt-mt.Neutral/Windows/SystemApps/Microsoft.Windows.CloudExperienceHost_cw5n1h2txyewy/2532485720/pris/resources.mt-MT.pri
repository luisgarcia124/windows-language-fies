  \localNgc\Body:
    Candidate Language=MT-MT: Ikkonfigura PIN li tista’ tuża minflok Windows Hello. Jista’ jkun li qatt ma teħtieġu, iżda jservi  bħala backup għal li jista’ jkun.
  \localAccount\VoiceOver:
    Candidate Language=MT-MT: Li joħloq l-utent lokali huwa sempliċiment li ddaħħal isem l-utent u l-password tiegħek.
  \localAccount\UserReserved_Error:
    Candidate Language=MT-MT: Tista’ tuża kwalunkwe isem li tixtieq... sakemm ma tużax ebda minn dawn il-kliem: CON, PRN, AUX, NUL, COM1, COM2, COM3, COM4, COM5, COM6, COM7, COM8, COM9, LPT1, LPT2, LPT3, LPT4, LPT5, LPT6, LPT7, LPT8, u LPT
  \localAccount\UserPlaceholder:
    Candidate Language=MT-MT: Isem l-utent
  \localAccount\Username_Too_Long:
    Candidate Language=MT-MT: Isem l-utent ma jistax ikollu aktar minn 20 karattru
  \localAccount\Username_Error:
