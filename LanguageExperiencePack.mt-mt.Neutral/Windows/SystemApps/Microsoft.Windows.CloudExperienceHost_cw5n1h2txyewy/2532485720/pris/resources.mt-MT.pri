  \localAccount\ReenterPlaceholder:
    Candidate Language=MT-MT: Erġa’ daħħal il-password
  \localAccount\PasswordPolicy_Error:
    Candidate Language=MT-MT: Il-password li ttajpjajt ma tissodisfax ir-rekwiżiti tal-kumplessità tal-password issettjati mill-amministratur għan-netwerk jew il-grupp tiegħek. Ikseb ir-rekwiżiti mill-amministratur tiegħek, u mbagħad ittajpja password ġdida.
  \localAccount\PasswordPlaceholder:
    Candidate Language=MT-MT: Daħħal il-password
  \localAccount\PasswordLegend:
    Candidate Language=MT-MT: Agħmlu sigur.
  \localAccount\PasswordHint_Invalid_Error:
    Candidate Language=MT-MT: Il-ħjiel tal-password tiegħek ma jistax ikun fih il-password tiegħek.
  \localAccount\PasswordHint_Empty_Error:
    Candidate Language=MT-MT: Meħtieġ ħjiel. Żgura li jgħinek tiftakar il-password tiegħek.
  \localAccount\PasswordConfirm_Error:
