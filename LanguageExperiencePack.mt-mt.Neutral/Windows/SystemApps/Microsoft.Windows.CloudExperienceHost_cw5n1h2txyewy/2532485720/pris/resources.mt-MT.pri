  \oobeHello\HelloSetUpSpeechConstraint:
    Candidate Language=MT-MT: Set up
  \oobeHello\HelloOptionTitleFingerprint:
    Candidate Language=MT-MT: Uża l-marka tal-iswaba’ tiegħek
  \oobeHello\HelloOptionTitleFace:
    Candidate Language=MT-MT: Uża l-għarfien tal-wiċċ
  \oobeHello\HelloOptionBodyFingerprint:
    Candidate Language=MT-MT: It-tagħmir tiegħek għandu wkoll senser tal-marki tas-swaba' li jaħdem ma' Windows Hello biex tkun tista’ tidħol b’mod sigur b’subgħajk biss.
  \oobeHello\HelloMultiVoiceOver:
    Candidate Language=MT-MT: Windows Hello gives you a couple of options for signing in speedily and securely. Would you prefer to use your fingerprint or your face?
  \oobeHello\HelloMultiListAccessibleName:
    Candidate Language=MT-MT: Lista ta' sensers kompatibbli ta' Windows Hello
  \oobeHello\HelloMultiFingerprint7SpeechConstraint:
    Candidate Language=MT-MT: Use your fingerprint
  \oobeHello\HelloMultiFingerprint6SpeechConstraint:
    Candidate Language=MT-MT: Use my fingerprint
  \oobeHello\HelloMultiFingerprint5SpeechConstraint:
