  \localAccount\UserNameLegend:
    Candidate Language=MT-MT: Min se juża dan il-PC?
  \localAccount\UsernameContainsAt_Error:
    Candidate Language=MT-MT: Isem l-utent ma jistax ikollu s-simbolu @.
  \localAccount\UserIsComputer_Error_Title:
    Candidate Language=MT-MT: Agħżel isem ta’ utent differenti (ma jistax ikun l-istess bħall-isem tal-PC).
  \localAccount\UserExists_Error:
