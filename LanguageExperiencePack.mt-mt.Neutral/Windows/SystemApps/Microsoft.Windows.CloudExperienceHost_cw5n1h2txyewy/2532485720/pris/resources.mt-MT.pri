  \oobeCortana\cortanaSubHeading_newUwp:
    Candidate Language=MT-MT: Biex tagħmel dan, Cortana teħtieġ l-aċċess għal xi informazzjoni personali tiegħek
  \oobeCortana\cortanaSubHeading_A:
    Candidate Language=MT-MT: Kulħadd jistħoqlu assistent personali. Cortana inzertat li hija diġitali.
  \oobeCortana\cortanaSubHeadingVoiceOver:
    Candidate Language=MT-MT: Ara Cortana, dak jien! Jista' jkolli permess biex nuża l-informazzjoni li neħtieġ biex nagħmel xogħli mill-aħjar li nista?
  \oobeCortana\cortanaSubHeading:
    Candidate Language=MT-MT: Ara Cortana, dak jien! <br/>Jista' jkolli permess biex nuża l-informazzjoni li neħtieġ biex nagħmel xogħli mill-aħjar li nista?
  \oobeCortana\cortanaLogoAlt_globalConsent:
    Candidate Language=MT-MT: Cortana tista' tgħinek timmaniġġja l-ħin tiegħek, tlesti l-affarijiet u tibqa' mqabbad. Uża Cortana biex tiċċekkja l-kalendarju tiegħek, tissettja tfakkiriet, taqra l-mużika u tikseb tweġibiet meta teħtieġhom.
  \oobeCortana\cortanaLogoAlt:
    Candidate Language=MT-MT: logo ta’ cortana
  \oobeCortana\cortanaHeading_newUwp:
    Candidate Language=MT-MT: Ħalli lil Cortana tgħinek tlesti l-affarijiet
  \oobeCortana\cortanaHeading_globalConsent:
    Candidate Language=MT-MT: Ikseb għajnuna mill-assistent diġitali tiegħek
  \oobeCortana\cortanaHeading_A:
    Candidate Language=MT-MT: Ħalli lil Cortana tgħinek
  \oobeCortana\cortanaHeading:
    Candidate Language=MT-MT: Trid tagħmel lil Cortana l-assistenta personali tiegħek?
  \oobeCortana\cortanaCaptionText:
    Candidate Language=MT-MT: Cortana tista' tgħinek timmaniġġja l-ħin tiegħek, tlesti l-affarijiet u tibqa' mqabbad.
