  \cortana\setCortanaOptOut:
    Candidate Language=MT-MT: Not now
  \cortana\privacyStatement:
    Candidate Language=MT-MT: Privacy statement
  \cortana\learnMoreLink:
    Candidate Language=MT-MT: Learn more
  \cortana\learnMoreHeadline:
    Candidate Language=MT-MT: Cortana
  \cortana\learnMoreBody2:
    Candidate Language=MT-MT: Learn more about Cortana in the Privacy Statement (https://aka.ms/privacy) and in the Cortana Learn more (https://aka.ms/cortanafaq).
  \cortana\learnMoreBody:
    Candidate Language=MT-MT: Cortana is your personal assistant. Cortana works best when you sign in and let it learn about you and your activities by using data from your device, your personal Microsoft account, third-party services and other Microsoft services. To help Cortana to provide personalized experiences and relevant suggestions, you can let Microsoft collect and use various types of data, such as your device location, data from your calendar, the apps you use, data from your emails and text messages, who you call, your contacts and who you interact with on your device. When you are signed in, Cortana also learns about you by collecting data about how you use your device and other Microsoft services, such as your music, alarm settings, whether the lock screen is on, what you view and purchase, your browsing in Microsoft Edge and Bing search history, and more. You can manage what data Cortana uses, and what it knows about you in Cortana Settings, Notebook and Permissions. You can always sign out of Cortana, and when you do, Cortana will still be there to help, but your experiences will not be personalized.
  \cortana\cortanaPersonaText3:
    Candidate Language=MT-MT: Fil-qosor, jien l-assistenta u s-sieħba personali tiegħek.<br/>Lesta meta inti lest.
  \cortana\cortanaPersonaText2:
    Candidate Language=MT-MT: I'm your searcher, finder, weather watcher, plan-aheader, note taker, reminder maker, and animal impersonator (if you ever need that).
  \cortana\cortanaPersonaText:
    Candidate Language=MT-MT: Ħelow, jien Cortana.<br/>Jien hawn biex niffaċilitaw l-affarijiet u ngħinuk tlesti l-affarijiet.
  \cortana\cortanaNextButton:
    Candidate Language=MT-MT: Use Cortana
  \cortana\cortanaIntro:
    Candidate Language=MT-MT: Meet Cortana
  \cortana\cortanaContent:
    Candidate Language=MT-MT: Cortana hija s-sieħba tiegħek, lesta biex tgħinek bi kwalunkwe ħaġa li żżommok super, erojku, jew fil-ħin biss.<br/><br/>Biex tippermetti lil Cortana tipprovdi esperjenzi personalizzati u suġġerimenti rilevanti, Microsoft tiġbor u tuża informazzjoni inkluż il-lokalità tiegħek u l-kronoloġija tal-lokalità, il-kuntatti, l-input tal-vuċi, il-mudelli tat-taħdit u l-kaligrafija, il-kronoloġija tal-ittajpjar, il-kronoloġija tat-tiftix, id-dettalji tal-kalendarju, il-kronoloġija tal-kontenut u l-komunikazzjoni mill-messaġġi u l-applikazzjonijiet, u informazzjoni oħra dwar it-tagħmir tiegħek. F’Microsoft Edge, Cortana tuża l-kronoloġija tal-ibbrawżjar tiegħek. Dejjem tista’ tbagħbas b’dak li tiftakar Cortana fin-Notebook u tiddiżattiva Cortana f’Microsoft Edge.
  \cloudDomainJoin\CredPromptTitle:
    Candidate Language=MT-MT: Daħħal il-password tiegħek
  \cloudDomainJoin\CredPromptCaption:
    Candidate Language=MT-MT: Għas-sigurtà, daħħal il-password tiegħek darba waħda oħra.
  \MicrosoftInternalMetadata\ContentChecksumValue:
    Candidate Language=MT-MT: 2532485720
