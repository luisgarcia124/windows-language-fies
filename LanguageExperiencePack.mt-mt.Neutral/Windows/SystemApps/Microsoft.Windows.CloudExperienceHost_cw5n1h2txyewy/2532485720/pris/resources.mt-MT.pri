  \retailDemo\shutdownTextOnline:
    Candidate Language=MT-MT: Il-ħinijiet ta’ shutdown għal dan l-apparat huma konfigurati permezz ta’ dimostrazzjoni għall-klijent tal-esperjenza tas-servizz tal-cloud
  \retailDemo\shutdownText:
