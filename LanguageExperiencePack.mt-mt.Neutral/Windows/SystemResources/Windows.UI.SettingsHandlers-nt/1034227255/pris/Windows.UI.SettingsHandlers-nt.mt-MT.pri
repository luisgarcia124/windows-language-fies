  \resources\SystemSettings_Activation_VOLUME_SLP_CONTENT:
    Candidate Language=MT-MT: Jeħtieġ iddaħħal Kodiċi ta’ Attivazzjoni Multipla (MAK) jew kodiċi tal-prodott tal-bejgħ biex tattiva Windows.
  \resources\SystemSettings_Activation_VOLUME_EXPIRATION:
    Candidate Language=MT-MT: Il-liċenzja tiegħek ta’ Windows se tiskadi dalwaqt.
  \resources\SystemSettings_Activation_VOLUME_BINDING_CONTENT:
    Candidate Language=MT-MT: Windows ma jistax jattiva bħalissa. Ipprova attiva Windows aktar tard. Jekk dak ma jaħdimx, ikkuntattja lill-amministratur tas-sistema tiegħek.
  \resources\SystemSettings_Activation_Volume_Activation:
    Candidate Language=MT-MT: Windows huwa attivat permezz tas-servizz tal-attivazzjoni tal-organizzazzjoni tiegħek.
  \resources\SystemSettings_Activation_USED_PRODUCT_KEY_CONTENT:
    Candidate Language=MT-MT: Ma nistgħux nattivaw Windows fuq dan it-tagħmir għaliex il-kodiċi tal-prodott diġà ntuża fuq tagħmir ieħor. Jekk taħseb li ma ntużax fuq tagħmirvieħor, agħżel Solvi l-Problema.
  \resources\SystemSettings_Activation_URL_WHY_REQUIRED:
