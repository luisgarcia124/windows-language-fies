  \resources\EnterProductKey_LabelText:
    Candidate Language=MT-MT: Kodiċi tal-prodott
  \resources\EnterProductKey_InvalidKey:
    Candidate Language=MT-MT: Il-kodiċi tal-prodott li daħħalt ma ħadimx. Iċċekkja l-kodiċi tal-prodott u erġa' pprova, jew daħħol kodiċi differenti. (0x%08x)
  \resources\EnterProductKey_InvalidCharacters:
    Candidate Language=MT-MT: Uħud minn dawn il-karattri ma jistgħux jidhru fil-kodiċi tal-prodott.
  \resources\EnterProductKey_InstructionsText:
    Candidate Language=MT-MT: Il-kodiċi tal-prodott tiegħek għandu jkun f'indirizz elettroniku mill-post li minnu xtrajt jew ġie distribwit Windows lilek, jew fuq il-kaxxa ġie fih id-DVD jew USB ta' Windows.
  \resources\EnterProductKey_HeaderText:
    Candidate Language=MT-MT: Daħħal kodiċi tal-prodott
  \resources\EnterProductKey_GvlkWarningText:
    Candidate Language=MT-MT: Biex tattiva b'dan il-kodiċi tal-prodott, dan it-tagħmir ser jeħtieġ li jaqbad mas-servizz tal-attivazzjoni tal-organizzazzjoni tiegħek.
  \resources\EnterProductKey_GoToStoreErrorText:
    Candidate Language=MT-MT: Ma nistgħux niftħu Microsoft Store bħalissa. Erġa' pprova aktar tard.
  \resources\EnterProductKey_GoToStoreDescriptionText:
    Candidate Language=MT-MT: Tista' tattiva dan it-tagħmir ukoll billi tmur f'Microsoft Store u tixtri kopja ġenwina ta' Windows.
