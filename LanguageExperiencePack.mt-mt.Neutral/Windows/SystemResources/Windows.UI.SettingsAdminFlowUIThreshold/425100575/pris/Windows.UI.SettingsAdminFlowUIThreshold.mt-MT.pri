  \resources\SetFindMyDevice_DescriptionText:
    Candidate Language=MT-MT: Issejvja perjodikament il-lokalità tat-tagħmir tiegħi
  \resources\RetailDemoConfirm_ReconfigNextButtonText:
    Candidate Language=MT-MT: Erġa’ kkonfigura
  \resources\RetailDemoConfirm_ReconfigHeaderText:
    Candidate Language=MT-MT: Erġa’ kkonfigura l-PC tad-Dimostrazzjoni
  \resources\RetailDemoConfirm_ReconfigBodyText:
    Candidate Language=MT-MT: Meta terġa’ tikkonfigura l-PC tkun tista’ tibdel il-Kodiċi tal-Aċċess tal-Bejgħ (RAC) tat-tagħmir biex tikseb kontenut personalizzat tad-dimostrazzjoni.
  \resources\RetailDemoConfirm_NextButtonText:
    Candidate Language=MT-MT: Ibdel
  \resources\RetailDemoConfirm_HeaderText:
    Candidate Language=MT-MT: Ibdel għad-dimostrazzjoni tal-ħanut
  \resources\RetailDemoConfirm_CancelButtonText:
    Candidate Language=MT-MT: Ikkanċella
  \resources\RetailDemoConfirm_BodyText2:
    Candidate Language=MT-MT: Il-PC irid ikun imqabbad mal-Internet. U meta taqleb għall-modalità tad-dimostrazzjoni tal-ħanut, tħassar il-kontenut personali kollu u tirrestawra l-PC għas-settings tal-fabbrika.
  \resources\RetailDemoConfirm_BodyText1:
    Candidate Language=MT-MT: Se tixgħel l-esperjenza tad-dimostrazzjoni tal-ħanut, li hija mfassla biss għall-użu fil-ħanut.
  \resources\RetailDemoConfirmError_ReconfigHeaderText:
    Candidate Language=MT-MT: Ma jistax jerġa’ jikkonfigura l-PC tad-dimostrazzjoni
  \resources\RetailDemoConfirmError_ReconfigBodyText1:
    Candidate Language=MT-MT: Ma nistgħux naqbdu mal-Internet, u l-PC tiegħek jeħtieġ kumnikazzjoni biex jerġa’ jikkonfigura l-modalità tad-dimostrazzjoni tal-bejgħ.
  \resources\RetailDemoConfirmError_HeaderText:
    Candidate Language=MT-MT: Ma jistax jibdel għad-dimostrazzjoni tal-ħanut
  \resources\RetailDemoConfirmError_CancelButtonText:
    Candidate Language=MT-MT: Agħlaq
  \resources\RetailDemoConfirmError_BodyText2:
    Candidate Language=MT-MT: Iċċekkja l-kumnikazzjoni tiegħek u erġa’ pprova.
  \resources\RetailDemoConfirmError_BodyText1:
    Candidate Language=MT-MT: Ma nistgħux naqbdu mal-Internet, u l-PC tiegħek jeħtieġ kumnikazzjoni biex jaqleb għall-modalità tad-dimostrazzjoni tal-ħanut.
  \resources\RestartNow:
    Candidate Language=MT-MT: Irristartja issa
  \resources\RestartLater:
    Candidate Language=MT-MT: Irristartja aktar tard
  \resources\RenamePC_SAME_COMPUTER_NAME_ErrorText:
    Candidate Language=MT-MT: Dan l-isem tal-PC diġà qed jintuża. Daħħal isem differenti.
  \resources\RenamePC_RENAME_FAIL_ErrorText:
    Candidate Language=MT-MT: Jiddispjaċina, l-isem tal-PC tiegħek ma jistax jiġi mibdul.
  \resources\RenamePC_NON_RFC_COMPUTER_NAME_TITLE_ErrorText:
    Candidate Language=MT-MT: L-isem tal-PC huwa invalidu.
  \resources\RenamePC_NON_RFC_COMPUTER_NAME_SYNTAX_ErrorText:
    Candidate Language=MT-MT: L-isem tal-PC huwa invalidu.
  \resources\RenamePC_NextButtonText:
    Candidate Language=MT-MT: Issejvja
  \resources\RenamePC_NewComputerNamePlaceholderText:
    Candidate Language=MT-MT: Semmi t-tagħmir tiegħek:
  \resources\RenamePC_HeaderText:
    Candidate Language=MT-MT: Erġa’ semmi l-PC tiegħek
  \resources\RenamePC_ERROR_BAD_CREDENTIALS:
    Candidate Language=MT-MT: Dik l-informazzjoni tal-kont ma ħadmitx. Iċċekkja l-isem tal-kont u l-password tiegħek u erġa’ pprova.
  \resources\RenamePC_EMPTY_NAME_ErrorText:
    Candidate Language=MT-MT: Daħħal isem għall-PC tiegħek.
  \resources\RenamePC_DUPLICATE_NAME_ErrorText:
    Candidate Language=MT-MT: Dan l-isem tal-PC diġà qed jintuża. Daħħal isem differenti.
  \resources\RenamePC_DIFFERENT_CANONICAL_NAME_ErrorText:
    Candidate Language=MT-MT: Dak l-isem tal-PC mhux se jaħdem. Agħżel wieħed li ma jibdiex b’numru u erġa’ pprova.
  \resources\RenamePC_CurrentPCNameText:
    Candidate Language=MT-MT: L-isem attwali tal-PC: %1
  \resources\RenamePC_ConfirmNextButtonText:
    Candidate Language=MT-MT: Irristartja issa
  \resources\RenamePC_ConfirmHeaderText:
    Candidate Language=MT-MT: Erġa’ semmi l-PC tiegħek
  \resources\RenamePC_ConfirmCancelButtonText:
    Candidate Language=MT-MT: Irristartja aktar tard
  \resources\RenamePC_ConfirmBodyText:
    Candidate Language=MT-MT: Wara li tirristartja, l-isem tal-PC tiegħek se jinbidel għal: 
  \resources\RenamePC_COMPUTER_NAME_TOO_LONG_ErrorText:
    Candidate Language=MT-MT: L-isem tal-PC li daħħalt huwa twil wisq.
  \resources\RenamePC_COMPUTER_NAME_SAME_AS_PC_NAME_ErrorText:
    Candidate Language=MT-MT: Dan hu l-isem attwali tal-PC. Daħħal isem differenti.
  \resources\RenamePC_COMPUTER_NAME_NUMERIC_ErrorText:
    Candidate Language=MT-MT: L-isem tal-PC irid ikollu tal-inqas ittra waħda.
  \resources\RenamePC_COMPUTER_NAME_HAS_BAD_CHARS_ErrorText:
    Candidate Language=MT-MT: Karattru wieħed jew aktar li ttajpjajt mhux se jaħdem. Ipprova xi ħaġa differenti.
  \resources\RenamePC_COMPUTER_NAME_ALL_NUMBERS_ErrorText:
    Candidate Language=MT-MT: L-isem tal-PC tiegħek irid ikollu tal-anqas ittra waħda.
  \resources\RenamePC_CancelButtonText:
    Candidate Language=MT-MT: Ikkanċella
  \resources\RenamePC_BodyText:
    Candidate Language=MT-MT: Uża kombinazzjoni ta’ ittri, singijiet, u numri.
  \resources\RenamePC_BAD_COMPUTER_NAME_SYNTAX_ErrorText:
    Candidate Language=MT-MT: L-isem tal-PC huwa invalidu.
  \resources\RenamePC_AuthBodyText:
    Candidate Language=MT-MT: Daħħal l-informazzjoni tal-kont tad-dominju tiegħek biex tiżgura li għandek permess tibdel l-isem.
  \resources\RenamePC_ACCESS_DENIED_ErrorText:
    Candidate Language=MT-MT: Ma tistax tibdel l-isem tal-PC permezz ta’ dan il-kont.
  \resources\RenamePC_AAD_UPDATE_FAIL_ErrorText:
    Candidate Language=MT-MT: L-isem tal-PC ma jistax jiġi aġġornat fis-Servizzi tad-Dominju Active Directory.
  \resources\RemoveUser_HeaderText:
    Candidate Language=MT-MT: Tħassar il-kont u d-dejta?
  \resources\RemoveUser_GeneralErrorText:
    Candidate Language=MT-MT: Ma jistax ineħħi l-utent magħżul kompletament. Xi ftit mid-dejta tal-utent jista’ jkun li għadha fuq id-diska.
  \resources\RemoveUser_DeleteUserButtonText:
    Candidate Language=MT-MT: Ħassar il-kont u d-dejta
  \resources\RemoveUser_BodyText:
    Candidate Language=MT-MT: Jekk tħassar il-kont ta’ din il-persuna titneħħa d-dejta kollha tagħha minn fuq dan il-PC, inklużi items fuq id-desktop tagħha, downloads, dokumenti, ritratti, mużika, u fajls oħra. Jekk ma sarx backup ta’ din id-dejta jew jekk ma ġietx issejvjata f’post ieħor, bħal PC ieħor, din se tintilef.
  \resources\RemoveUserLoggedIn_HeaderText:
    Candidate Language=MT-MT: Ma jistax iħassar il-kont
  \resources\RemoveUserLoggedIn_BodyText:
    Candidate Language=MT-MT: Din il-persuna jeħtieġ li toħroġ qabel ma tkun tista’ tħassar il-kont tagħha. Tista’ wkoll tirristartja l-PC tiegħek biex toħroġha awtomatikament.
  \resources\RemoveFamilyUser_HeaderText:
    Candidate Language=MT-MT: Neħħi dan il-membru tal-familja mit-tagħmir tiegħek
  \resources\RemoveFamilyUser_BodyText:
    Candidate Language=MT-MT: Jekk tneħħi dan il-membru tal-familja minn dan it-tagħmir, xorta jkunu fil-grupp tal-familja tiegħek. Aħna sempliċiment ineħħu d-dejta tagħhom minn dan it-tagħmir, għalhekk żgura li affarijiet bħall-items fuq id-desktop, downloads, dokumenti, ritratti u mużika qed issirilhom backup f'post ieħor. Membri tal-familja miżjuda riċentement ma jkunux jistgħu jibqgħu jidħlu f'dan it-tagħmir awtomatikament.
  \resources\RemoveExclusion_HeaderText:
    Candidate Language=MT-MT: Neħħi l-esklużjoni
  \resources\RemoveExclusion_BodyText:
    Candidate Language=MT-MT: Żgur li tixtieq tneħħi din l-esklużjoni?
  \resources\RemoveDomainUser_HeaderText:
    Candidate Language=MT-MT: Neħħi l-kont
  \resources\RemoveDomainUser_DeleteUserButtonText:
    Candidate Language=MT-MT: Neħħi
  \resources\RemoveDomainUser_BodyText:
    Candidate Language=MT-MT: Jekk tneħħi l-aċċess ta’ dan il-kont, jista’ jkun li ma tkunx tista’ tużah biex tidħol f’dan il-PC.
  \resources\RemoteDesktop_WindowTitle:
    Candidate Language=MT-MT: Settings tad-Desktop Remot
  \resources\RemoteDesktop_RegistryError_HeaderText:
    Candidate Language=MT-MT: Iċċekkja s-settings tar-reġistru
  \resources\RemoteDesktop_RegistryError_BodyText:
    Candidate Language=MT-MT: Ġrat xi ħaġa ħażina meta pprovajna naġġornaw ir-reġistru tiegħek.
  \resources\RemoteDesktop_ProceedButtonText:
    Candidate Language=MT-MT: Kompli xorta waħda
  \resources\RemoteDesktop_NextButtonText:
    Candidate Language=MT-MT: Kkonferma
  \resources\RemoteDesktop_GenericError_HeaderText:
    Candidate Language=MT-MT: Ġrat xi ħaġa ħażina
  \resources\RemoteDesktop_GenericError_BodyText:
    Candidate Language=MT-MT: Agħlaq is-Settings u erġa' pprova.
  \resources\RemoteDesktop_EnableFirewallError_HeaderText:
    Candidate Language=MT-MT: Id-Desktop Remot imblokkat mill-fajerwol tiegħek
  \resources\RemoteDesktop_EnableFirewallError_BodyText:
    Candidate Language=MT-MT: Iftaħ il-port 3389 biex tippermetti lid-Desktop Remot jgħaddi mill-fajerwol.
  \resources\RemoteDesktop_DisableFirewallError_HeaderText:
    Candidate Language=MT-MT: Ġrat xi ħaġa ħażina meta pprovajna nagħlqu l-port tal-fajerwol tad-Desktop Remot
  \resources\RemoteDesktop_DisableFirewallError_BodyText:
    Candidate Language=MT-MT: Biex tiddiżattiva d-Desktop Remot agħlaq il-port 3389 fuq il-fajerwol tiegħek.
  \resources\RemoteDesktop_CloseButtonText:
    Candidate Language=MT-MT: Agħlaq
  \resources\RemoteDesktop_CancelButtonText:
    Candidate Language=MT-MT: Kkanċella
  \resources\RDP_ProtectAccount_SignInButtonText:
    Candidate Language=MT-MT: Mur fl-għażliet tad-Dħul
  \resources\RDP_ProtectAccount_HeaderText:
    Candidate Language=MT-MT: Ipproteġi l-kont tiegħek
  \resources\RDP_ProtectAccountDenied_BodyText:
    Candidate Language=MT-MT: Jeħtieġ tissettja ħtiġijiet ta' awtentikazzjoni (bħal Windows Hello, password jew PIN) għal dan il-kont biex tattiva d-Desktop Remot.
  \resources\RDP_ProtectAccountAllowed_BodyText:
    Candidate Language=MT-MT: Il-kont tiegħek ma jeħtieġx awtentikazzjoni biex tidħol f'dan il-PC. Jekk tattiva d-Desktop Remot mingħajr ma jkollok bżonn awtentikazzjoni, qed tiftaħ il-kompjuter tiegħek għal aċċess remot mhux awtorizzat.
  \resources\RDP_Enable_HeaderText:
    Candidate Language=MT-MT: Tattiva d-Desktop Remot?
  \resources\RDP_Enable_Firewall_Part2_BodyText:
    Candidate Language=MT-MT: Settings Avvanzati tal-Fajerwol
  \resources\RDP_Enable_Firewall_Part1_BodyText:
    Candidate Language=MT-MT: Qed tiftaħ il-port tad-Desktop Remot fil-fajerwol tiegħek għall-konnessjonijiet kollha tan-netwerk fuq dan il-PC. Jekk tixtieq tillimita l-konnessjonijiet għal netwerks magħżula, iftaħ  
  \resources\RDP_Enable_Firewall_Complete_BodyText:
    Candidate Language=MT-MT: Qed tiftaħ il-port tad-Desktop Remot fil-fajerwol tiegħek għall-konnessjonijiet kollha tan-netwerk fuq dan il-PC. Jekk tixtieq tillimita l-konnessjonijiet lil netwerks magħżula, iftaħ is-Settings Avvanzati tal-Fajerwol.
  \resources\RDP_Enable_BodyText:
    Candidate Language=MT-MT: Inti u utenti magħżula taħt kontijiet tal-Utenti tkunu tistgħu tikkonnettjaw ma' dan il-PC b'mod remot.
  \resources\RDP_Disable_HeaderText:
    Candidate Language=MT-MT: Tiddiżattiva d-Desktop Remot?
  \resources\PBR_WipeData_DriveListLink\Content:
    Candidate Language=MT-MT: Urini l-lista tad-drajvs li jkunu affettwati
  \resources\PBR_UninstallWarning_Header:
    Candidate Language=MT-MT: Aġġornament reċenti
  \resources\PBR_UninstallWarning_Desc\Text:
    Candidate Language=MT-MT: Dan il-PC ġie aġġornat riċentement. Jekk tkompli b’Irrisettja dan il-PC, ma tkunx tista’ treġġa’ l-aġġornament lura.
  \resources\PBR_Title:
    Candidate Language=MT-MT: Irrisettja dan il-PC
  \resources\PBR_SessionPreparation_Header:
    Candidate Language=MT-MT: Qed ilesti l-affarijiet
  \resources\PBR_SessionPreparation_Desc\Text:
    Candidate Language=MT-MT: Dan ma jdumx wisq
  \resources\PBR_ResetTypeSelection_ResetOption_Desc:
    Candidate Language=MT-MT: Ineħħi fajls personali, l-applikazzjonijiet u s-settings kollha tiegħek.
  \resources\PBR_ResetTypeSelection_ResetOption:
    Candidate Language=MT-MT: Neħħi kollox
  \resources\PBR_ResetTypeSelection_RefreshOption_Desc:
    Candidate Language=MT-MT: Ineħħi l-applikazzjonijiet u s-settings, imma jżomm il-fajls personali tiegħek.
  \resources\PBR_ResetTypeSelection_RefreshOption:
    Candidate Language=MT-MT: Żomm il-fajls tiegħi
  \resources\PBR_ResetTypeSelection_Header:
    Candidate Language=MT-MT: Agħmel għażla
  \resources\PBR_ResetOptions_SummaryLine\Text:
