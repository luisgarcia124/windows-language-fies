  \resources\PBR_ResetOptions_AdvancedOptions:
    Candidate Language=MT-MT: Ibdel is-settings
  \resources\PBR_ResetCancellation_Header:
    Candidate Language=MT-MT: Qed jikkanċella
  \resources\PBR_ResetCancellation_Desc\Text:
    Candidate Language=MT-MT: Dan mhux se jdum wisq
  \resources\PBR_Reset:
    Candidate Language=MT-MT: Irrisettja
  \resources\PBR_RemovedAppsList_Header:
    Candidate Language=MT-MT: Lista tal-applikazzjonijiet biex jitneħħew
  \resources\PBR_RemovedAppsList_Desc\Text:
    Candidate Language=MT-MT: Tista' terġa' tinstalla ħafna applikazzjonijiet mill-Istore, iżda tkun teħtieġ tinstalla l-applikazzjonijiet li ġejjin mill-web jew mid-diski tal-installazzjoni. Din il-lista tal-applikazzjonijiet tiġi ssejvjati fuq id-desktop wara l-Irrisettjar.
  \resources\PBR_Note\Text:
    Candidate Language=MT-MT: Nota:
  \resources\PBR_MultipleUsersWarning_Header:
    Candidate Language=MT-MT: Hemm nies oħra lloggjati f’dan il-PC
  \resources\PBR_MultipleUsersWarning_Desc\Text:
    Candidate Language=MT-MT: Tixtieq tkompli? Dan jikkawżahom jitilfu dejta mhux issejvjata.
  \resources\PBR_MeteredDataWarning_Format:
    Candidate Language=MT-MT: It-tniżżil mill-cloud jista' juża aktar minn 4 GB ta' dejta. Il-konnessjoni tiegħek hija bil-miter u jistgħu japplikaw tariffi.
  \resources\PBR_LearnMore_Text\Text:
    Candidate Language=MT-MT: Sir af aktar dwar ir-risettjar ta’ dan il-PC
  \resources\PBR_HelpToChoose\Content:
    Candidate Language=MT-MT: Għinni nagħżel
  \resources\PBR_FinalPreparation_Header:
    Candidate Language=MT-MT: Qed jipprepara biex jirrisettja
  \resources\PBR_FinalPreparation_Format:
    Candidate Language=MT-MT: Status: Qed jipprepara – %d%%
  \resources\PBR_FinalPreparation_Finalize:
    Candidate Language=MT-MT: Qed jipprepara biex jirristartja
  \resources\PBR_FinalPreparation_Desc\Text:
    Candidate Language=MT-MT: Dan it-tagħmir se jirristartja awtomatikament
  \resources\PBR_FinalPreparation_CloudFormat:
    Candidate Language=MT-MT: Status: Qed iniżżel – %d%%
  \resources\PBR_Error_Header:
    Candidate Language=MT-MT: Kien hemm problema fir-risettjar tal-PC tiegħek
  \resources\PBR_Error_Desc\Text:
    Candidate Language=MT-MT: Ma saru ebda tibdiliet.
  \resources\PBR_ErrorWindowsToGo_Desc\Text:
    Candidate Language=MT-MT: Il-PC tiegħek ma jistax jiġi rrisettjat għax qed iħaddem Windows To Go.
  \resources\PBR_ErrorSafeMode_Header:
    Candidate Language=MT-MT: Din il-karatteristika mhijiex disponibbli f’Modalità Sigura
  \resources\PBR_ErrorSafeMode_Desc\Text:
    Candidate Language=MT-MT: Biex tirrisettja dan il-PC, irristartja Windows normali, u erġa’ pprova, jew mur fuq ftuħ Avvanzat u agħżel Solvi l-Problema.
  \resources\PBR_ErrorRedirectedProfiles_Header:
    Candidate Language=MT-MT: Ma jistax jirrisettja dan il-PC u jżomm il-fajls tiegħek
  \resources\PBR_ErrorRedirectedProfiles_Desc\Text:
    Candidate Language=MT-MT: Biex tirrisettja dan il-PC u żżomm il-fajls tiegħek, l-Utenti, il-Fajls tal-Programmi, u d-direttorji ta’ Windows għandhom ikunu fuq l-istess drajv. tista’ tagħżel li tirrisettja dan il-PC u tneħħi kollox minflok, iżda l-ewwel għandek tagħmel backup tal-fajls personali tiegħek.
  \resources\PBR_ErrorPayloadVersionMismatch_Desc\Text:
    Candidate Language=MT-MT: It-tniżżil huwa invalidu. Erġa’ pprova u agħżel l-għażla tal-installazzjoni lokali mill-ġdid.
  \resources\PBR_ErrorPayloadDownload_Desc\Text:
    Candidate Language=MT-MT: It-tniżżil ġie interrott. Iċċekkja l-konnessjoni tiegħek u erġa’ pprova, jew agħżel l-għażla tal-installazzjoni lokali mill-ġdid.
  \resources\PBR_ErrorPayloadConnection_Desc\Text:
    Candidate Language=MT-MT: Ma jistax jikkonnettja mas-server. Iċċekkja l-konnessjoni tiegħek u erġa’ pprova, jew agħżel l-għażla tal-installazzjoni lokali mill-ġdid.
  \resources\PBR_ErrorNotSupportedInEdition_Desc\Text:
    Candidate Language=MT-MT: Din l-edizzjoni ma tappoġġjax l-għażla tal-irkupru magħżula. Erġa’ pprova b’għażla differenti.
  \resources\PBR_ErrorNoRecoveryEnv_Header:
    Candidate Language=MT-MT: Ma setax isib l-ambjent tal-irkupru
  \resources\PBR_ErrorNoRecoveryEnv_Desc\Text:
    Candidate Language=MT-MT: Daħħal l-installazzjoni jew il-midja ta’ rkupru ta’ Windows, u rristartja l-PC tiegħek bil-midja.
  \resources\PBR_ErrorNoPayload_Desc\Text:
