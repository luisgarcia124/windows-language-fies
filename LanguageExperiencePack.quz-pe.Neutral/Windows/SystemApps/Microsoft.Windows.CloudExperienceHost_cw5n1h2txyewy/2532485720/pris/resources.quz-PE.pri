  \oobeAadcAgeConfirmation\Title:
    Candidate Language=QUZ-PE: Huk warmapaqchu utaq maqtasipaspaqchu kay yupay?
  \oobeAadcAgeConfirmation\Subtitle:
    Candidate Language=QUZ-PE: Chayhina kaptin, huk Microsoft yupaypi llamkayta qallariwaq. Sullka ayllu masikuna Microsoft yupaypi llamkayta qallariqtin, paykuna watanmanta sapallanpaq harkasqa kanqaku. Taytamamakunapas uywaqkunapas huk ayllu huñuta takyachinman Microsoft Warmakuna Harkaqwan.
  \oobeAadcAgeConfirmation\Option2Text:
    Candidate Language=QUZ-PE: Kay dispositivopi huk yupayta paqarichiy huk ruwaqpa sutinwan kichanawanpas
  \oobeAadcAgeConfirmation\Option2Header:
    Candidate Language=QUZ-PE: Huk Microsoft yupaywan ama llamkayta qallariychu
  \oobeAadcAgeConfirmation\Option2Glyph:
    Candidate Language=QUZ-PE: 
  \oobeAadcAgeConfirmation\Option1Text:
    Candidate Language=QUZ-PE: Huk Microsoft yupayta paqarichiy kay dispositivopi warmakunapaq sapanchasqa harkaynin kanapaq
  \oobeAadcAgeConfirmation\Option1Header:
    Candidate Language=QUZ-PE: Microsoft yupaywan llamkayta qallariy
  \oobeAadcAgeConfirmation\Option1Glyph:
    Candidate Language=QUZ-PE: 
  \oobeAadcAgeConfirmation\OobeeAadcAgeConfirmationLearnMoreButtonText:
    Candidate Language=QUZ-PE: Aswan Willakuy
  \oobeAadcAgeConfirmation\OobeAadcAgeConfirmationYesButtonText:
