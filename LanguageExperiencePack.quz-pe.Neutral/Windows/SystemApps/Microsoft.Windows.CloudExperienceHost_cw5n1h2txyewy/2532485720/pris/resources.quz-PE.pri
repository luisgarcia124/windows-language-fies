  \oobeCortana\cortanaSubHeading_newUwp:
    Candidate Language=QUZ-PE: Kayta ruwaypaq, Cortana yaykunata wakin sapanchasqa willakuyta munan
  \oobeCortana\cortanaSubHeading_A:
    Candidate Language=QUZ-PE: Llapa sapalla yanapakuypi munan. Cortana rawkanasqa yupayta ruwanlla.
  \oobeCortana\cortanaSubHeadingVoiceOver:
    Candidate Language=QUZ-PE: ¡Imaynalla, nuqa kanan, Cortana! ¿Mañaku tiyani ruwaypaq willayta allin llamkaypaq munani ruwaypaq atikunichu?
  \oobeCortana\cortanaSubHeading:
    Candidate Language=QUZ-PE: ¡Imaynalla, nuqa kanan, Cortana! <br/>¿Mañaku tiyani ruwaypaq willayta allin llamkaypaq munani ruwaypaq atikunichu?
  \oobeCortana\cortanaLogoAlt_globalConsent:
    Candidate Language=QUZ-PE: Cortana pacha kamachiy yanapasunki, imakuna tariypaq chaymanta tinkisqa. Cortana intiwatanata chiqaqchaypaq ruway, yuyarinapaq takyachiy, takiy purichiy chaymanta tapunakuna tariy mayk'aq kaykuna munanki.
