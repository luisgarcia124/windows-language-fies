  \hololensDiagnostics\Instruction4:
    Candidate Language=QUZ-PE: 4. Chanta kipukuna waqaychasqanki, kaypi kutimuy chaymanta Yastaña akllay. Kayta kipukuna HoloLens kaqniykimanta qichunqa.
  \hololensDiagnostics\Instruction3:
