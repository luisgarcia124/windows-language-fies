  \personalDataExport\PrivacyTitle:
    Candidate Language=QUZ-PE: Microsoft Sapanchasqa Willakuy
  \personalDataExport\PrivacyStatementUrl:
    Candidate Language=QUZ-PE: https://go.microsoft.com/fwlink/?linkid=850749
  \personalDataExport\PrivacyLinkDisplayText:
    Candidate Language=QUZ-PE: https://aka.ms/privacy
  \personalDataExport\Paragraph3:
    Candidate Language=QUZ-PE: Microsoft kaqqa ruwaykunqa hinaspa willakuyniykikunata apachikamunqa Microsoft Sapanchasqa Willakuy kasqanmanhina.
  \personalDataExport\Paragraph2:
    Candidate Language=QUZ-PE: Sichus mana uyakunkichu kay willakuykuna quykuywan, manaña llamkachinaykipaq chay imata akllaykuywaq. Imaykipa llamkachikunanpaq qati-qatinkunata qawapaykuy qullqi kutichipuymanta allinta yachaykunaykipaq.
  \personalDataExport\Paragraph1:
    Candidate Language=QUZ-PE: Kay llamkanaqa suyakusqanmanhina llamkaykunanpaq, Microsoft willakuyniykikunata apachimunan llamkachikunanpaq huk Microsoft wasiman, kayqa suyuykipa, llaqtaykipa hawanpi kakun. Sichus kay llamkanata llamkachiyta qatiykuspaqa, llapan willakuykuna apachikamunakunata uyakuy.
  \personalDataExport\PageTitle:
    Candidate Language=QUZ-PE: Ruwasqa kanqa uchuy willakuymikikuna qatun llaqtayki qawapi utaq suyuyki qawapipas
  \personalDataExport\NextButtonText:
    Candidate Language=QUZ-PE: Qatiqnin
  \personalDataExport\NavigationError:
    Candidate Language=QUZ-PE: Wakin tinkunachiy sasachakuykunachusmi kachkan - ichapas internet kaqman mana tinkisqachu kanki, utaq sasachakuyniyku kanman.<ul><li>Willakuyniyki imanasqa China llaqtamanta huk suyuman astakunanmanta Microsoft rurukunata hapiptiyki aswan willakuypaq, qillqay https://aka.ms/productslist kaqta tarikusqan siqipi mayqin maskanapi, mayqin dispositivopipas.</li><br/><li>Microsoft rurukunamanta sapanchasqamantapas aswan willakuyaq, Microsoft Sapanchasqa Willakuy kaqta watukuy kaypi https://aka.ms/privacy.</li></ul>
  \personalDataExport\LearnMoreLinkText:
    Candidate Language=QUZ-PE: Aswan willakuyta tariy uchuy willakuy akllaynikikunamanta
  \personalDataExport\LearnMoreDataTransferUrl:
    Candidate Language=QUZ-PE: https://go.microsoft.com/fwlink/?linkid=2214603
  \personalDataExport\LearnMoreButtonText:
    Candidate Language=QUZ-PE: Aswan willakuy
  \personalDataExport\ContinueButtonText:
    Candidate Language=QUZ-PE: Qatiy
