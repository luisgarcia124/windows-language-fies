  \retailDemo\rdxTitle:
    Candidate Language=QUZ-PE: Qawarinapaq tupachiy
  \retailDemo\rdamTitle:
    Candidate Language=QUZ-PE: Mallinapaq winay chaymanta llamkana qipa tupachiyta hatalliy
