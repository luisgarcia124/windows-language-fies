  \enterpriseNgcEnrollment\BodyTpmError:
    Candidate Language=QUZ-PE: Iñisqa Plataforma Modulu, chayta PIN kaqniyki harkayta ruwasqan kunan pacha mana hapirinalla kanchu. Wakin pacha watiqmanta ruwayta yanapakun utaq kunan saqiyta atikunki chaymanta aswan qhipaman ruwanki.
  \enterpriseNgcEnrollment\BodySuccess:
    Candidate Language=QUZ-PE: Kunan PIN kaqniykiwan llamkayta qallariy atikunki.
  \enterpriseNgcEnrollment\BodyServerError:
    Candidate Language=QUZ-PE: Kunanpuni mañakusqayki qarakuqman PIN kaqniyki takyachiypaq mana tinkichiyta atinikuchu. Watiqmanta ruwapay atikunki utaq saqiyta atikunki chaymanta aswan qhipaman ruwanki.
  \enterpriseNgcEnrollment\BodyHelloCancel:
    Candidate Language=QUZ-PE: Huk PIN takyachiyta munanki ruwaypaq Windows Hello. Pisi chinini ruwanlla.
  \enterpriseNgcEnrollment\BodyHello:
    Candidate Language=QUZ-PE: Huk PIN takyachiy tarikuqpi Windows Hello kaqmanta ruwayta atikunki. Kayta mana haykaq munanki, ichaqa waqaychay hina kanqa.
  \enterpriseNgcEnrollment\BodyError:
    Candidate Language=QUZ-PE: PIN kaqniyki takyachiypaq mana atikuykuchu. Watiqmanta pachata watiqmanta ruwaypaq utaq kunanlla saqiyta atikunki chaymanta kayta aswan qhipaman ruwanki.
  \enterpriseNgcEnrollment\BodyCancel:
    Candidate Language=QUZ-PE: Huk PIN takyachiyta munanki ruwaypaq kay dispositivota. Pisi chinini ruwanlla.
  \enterpriseNgcEnrollment\Body:
    Candidate Language=QUZ-PE: Huk kichana sasa suwasqa atikun, Windows Hello qamta tupaq iskay factorkunawan dispositivoykimanta yapa kawsay tupuqwan utaq PIN kichanawan qun llamkayta qallariypaq dispositivoykiman, llamkanakunaykiman chaymanta yanapakuykunaykiman.
