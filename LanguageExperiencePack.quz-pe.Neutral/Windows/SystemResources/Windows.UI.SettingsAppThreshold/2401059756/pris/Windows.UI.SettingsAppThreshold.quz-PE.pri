  \SystemSettings\Resources\SystemSettings_Privacy_Personalization_Personalization_On_Confirmation:
    Candidate Language=QUZ-PE: Sichus kayta wañichinki, Cortana kaqwan mana aswan pacha parlayta atikunkicu, chaymanta tukuy simipirwa Windows ruwanakunamanta chinkachisqanku allichaypaq willaykuna makiwan qillqanawan chaymanta qillqaspawan qusqanku.
  \SystemSettings\Resources\SystemSettings_Privacy_Personalization_Personalization_On_ActionDescription:
