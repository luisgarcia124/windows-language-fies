  \SystemSettings\Resources\HolographicStartupAndDesktop_DesktopView_Group_Description\DisplayName:
    Candidate Language=QUZ-PE: Uyarinata hapiptiykiqa, Windows willariynin hanparapi llamkanakunaman suchuqta musyanmanmi. Kay tupachiy akllasqan kaptinqa, Windows kikillanmantam Hampara llamkanata chaqrusqa sullullta qampaq qallarichinqa.
  \SystemSettings\Resources\HolographicStartupAndDesktop_DesktopView_Group_DescriptionLabel\Text:
    Candidate Language=QUZ-PE: Uyarinata hapiptiyki, Windows nisqaqa kanchariy kuyuptin musyayqmi hanparaykipi llamkankunaman hinaspa qanpaq Hanpara qaway llamkanata kikillanmanta qallarichinman.
  \SystemSettings\Resources\HolographicStartupAndDesktop_DesktopView_Group\DisplayName:
    Candidate Language=QUZ-PE: Hanpara qaway
  \SystemSettings\Resources\HolographicStartupAndDesktop_DesktopViewAutoLaunch\DisplayName:
