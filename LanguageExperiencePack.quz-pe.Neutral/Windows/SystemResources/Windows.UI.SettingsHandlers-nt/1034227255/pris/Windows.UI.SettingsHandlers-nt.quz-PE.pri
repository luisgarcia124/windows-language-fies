  \resources\SystemSettings_Activation_IA_HOST_NOT_ACTIVATED_CONTENT:
    Candidate Language=QUZ-PE: Windows manam kawsarichiyta atikunchu virtual maquinapi. Host nisqa maquina kawsarichisqa kasqanta qawapay hinaspa musuqmanta ruwapay.
  \resources\SystemSettings_Activation_IA_GENERIC_CONTENT:
