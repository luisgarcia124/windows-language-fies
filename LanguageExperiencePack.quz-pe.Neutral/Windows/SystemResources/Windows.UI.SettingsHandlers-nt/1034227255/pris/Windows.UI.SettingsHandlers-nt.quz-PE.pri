  \resources\SystemSettings_Activation_INVALID_PRODUCT_KEY_CONTENT:
    Candidate Language=QUZ-PE: Kunanpuni Windows manam kay dispositivopi kawsarichiyta atikuykuchu chayta ruruman haykunahina mana puriq yaykusqanki. Store kaqman riy rantiypaq kaq Windows.
  \resources\SystemSettings_Activation_IDS_TIMEBOMB_CONTENT:
