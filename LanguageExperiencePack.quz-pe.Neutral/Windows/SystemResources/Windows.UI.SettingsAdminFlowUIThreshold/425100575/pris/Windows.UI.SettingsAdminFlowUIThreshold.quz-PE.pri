  \resources\PBR_ErrorSafeMode_Desc\Text:
    Candidate Language=QUZ-PE: Kay PC kaqta kawsarichiypaq, Windows qallariy chaymanta watiqmanta ruway, utaq Llallirisqa qallariyta riy chaymanta Sasachakuy akllay.
  \resources\PBR_ErrorRedirectedProfiles_Header:
    Candidate Language=QUZ-PE: Mana kay PC kawsarichiy atikunchu chaymanta kipukunayki takyachiy
  \resources\PBR_ErrorRedirectedProfiles_Desc\Text:
    Candidate Language=QUZ-PE: Kay PC kawsarichiypaq chaymanta kipukunayki, Ruwaqkuna, Programa Kipukuna chaymanta Windows directoriokuna kikin muyuqpi kayta munanku. Kawsarichiypaq kay PC chikllayta atikunki chaymanta llapa imata qichuy, ichaqa spalla kipukunayki waqaychayta atikunki.
  \resources\PBR_ErrorPayloadVersionMismatch_Desc\Text:
    Candidate Language=QUZ-PE: Uraykachiyqa mana chaniyuqmi. Musuqmanta ruwapay hinaspa kaylla churapayta akllay.
  \resources\PBR_ErrorPayloadDownload_Desc\Text:
    Candidate Language=QUZ-PE: Uraykachiyqa tatichisqam. Tinkisqata chiqaqchay chaymanta musuqmanta churayta ruwapay.
  \resources\PBR_ErrorPayloadConnection_Desc\Text:
    Candidate Language=QUZ-PE: Aypukuqwan tinkiyta mana atikunchu. Tinkisqata chiqaqchay chaymanta musuqmanta churayta ruwapay.
  \resources\PBR_ErrorNotSupportedInEdition_Desc\Text:
    Candidate Language=QUZ-PE: Kay ruwapayqa kurichiy akllana akllasqawan mana tupaqmi. Huk akllanawan musuqmanta malliy.
  \resources\PBR_ErrorNoRecoveryEnv_Header:
    Candidate Language=QUZ-PE: Kawsarichiy patata mana tariyta atikunchu
  \resources\PBR_ErrorNoRecoveryEnv_Desc\Text:
    Candidate Language=QUZ-PE: Churanayki sapakamata winay utaq Windows Kawsarichinata hinaspa PCniykita sapakamawan musuqmanta kawsaricihiy.
  \resources\PBR_ErrorNoPayload_Desc\Text:
    Candidate Language=QUZ-PE: Hapirinalla uraykachiy manam kanchu. Musuqmanta ruwapay hinaspa kaylla churapayta akllay.
  \resources\PBR_ErrorNoPayloadSupport_Desc\Text:
    Candidate Language=QUZ-PE: Kayna kutirichiyqa puyumanrta uraykachiyta manam uyakunchu. Musuqmanta ruwapay hinaspa kaylla churapayta akllay.
  \resources\PBR_ErrorNoDeownlevelEnv_Desc\Text:
    Candidate Language=QUZ-PE: Windows churana utaq kawsarichina muyuqniyuq kaspaqa, winaspa computadoraykita muyuqwan musuqmanta qallarichiy.
