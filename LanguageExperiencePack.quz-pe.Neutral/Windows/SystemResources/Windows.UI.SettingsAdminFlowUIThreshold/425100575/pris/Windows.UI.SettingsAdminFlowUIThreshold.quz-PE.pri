  \resources\Lockdown_SignOutWarningText:
    Candidate Language=QUZ-PE: Sichus akllasqa yupayta t'inkisqa kachkan, llamkay wichq'ay chaymanta watiqmanta llamkayta qallariyta tikraykuna ruwaypaq. Huk yaykuna yupayta qusqan kay  yaykuna qallarisqanta kanqa wichqanaykipaqña.
  \resources\LockdownUser_HeaderText:
    Candidate Language=QUZ-PE: Yupay akllay
  \resources\LockdownUser_EmptyListText:
    Candidate Language=QUZ-PE: Kay hukkaq kawsachiyqa yupayqa kay dispositivupiqa kan kay thaskichkan huk yupayman t'inkisqa. Huk musuq yupayta yapay utaq paqarichiy chaymanta watiqmanta ruway.
  \resources\LockdownApp_HeaderText:
    Candidate Language=QUZ-PE: Huk llamkanata akllay
  \resources\LockdownApp_EmptyListText:
    Candidate Language=QUZ-PE: Kunan yupayqa mana llamkanayuqkunam. Huk llamkanallatapas churay akllasqa yupaypi hinaspa musuqmanta ruwapay.
  \resources\LeaveDomain_RestartHeaderText:
    Candidate Language=QUZ-PE: PC kaqniyki kawsarichiy
  \resources\LeaveDomain_RestartBody_DomainUser_Text:
    Candidate Language=QUZ-PE: Sichus kawsarichichkan, PC kaqniyki mana %1 kaqman huñusqanchu. Wak ruwaq yupaywan llamkayta qallariy munanki, kay yupay hina qampaq qillqasqanki ñawpaq rapipi.
  \resources\LeaveDomain_RestartBodyText:
    Candidate Language=QUZ-PE: Sichus kawsarichichkan, PC kaqniyki mana %1 kaqman huñusqanchu
  \resources\LeaveDomain_NonAdmin_Credentials:
    Candidate Language=QUZ-PE: Kay yupay willakuyqa manam llamkanchu. Kaylla kamachiq yupaypaq willakuy qillqasqaykita qawapay, hinaspa musuqmanta ruwapay.
  \resources\LeaveDomain_NERR_SetupNotJoined:
    Candidate Language=QUZ-PE: Kay PCqa kamachinanman manam taqrukunchu.
  \resources\LeaveDomain_Leave_Domain_Failed:
    Candidate Language=QUZ-PE: Sasachakuymi karun. Chaymantaña musuqmanta ruwapay.
  \resources\LeaveDomain_Incorrect_Password:
    Candidate Language=QUZ-PE: Kay kichanaqa manam allinchu. Qawapay, hinaspa musuqmanta ruwapay.
  \resources\LeaveDomain_ConfirmNextButtonText:
    Candidate Language=QUZ-PE: Tukuchiy
  \resources\LeaveDomain_ConfirmHeaderText:
    Candidate Language=QUZ-PE: Kamachinan tukuchiy
  \resources\LeaveDomain_ConfirmBody_DomainUser_Text:
    Candidate Language=QUZ-PE: 
      Ñawpaq lluqsichkan, huk Kamachiq yupaywan llamkayta qallarinki mana hatun llamkanaykipaq, Microsoft yupayniyki hina.

      Sichus hatun llamkanata lluqsinki, mana hatun llamkana yupaykunawan kay PC kaqpi llamkayta qallariy atikunkichu.
    
  \resources\LeaveDomain_ConfirmBodyText:
    Candidate Language=QUZ-PE: Chanta tukuchkan, mana kay PCman hatun llamkaypa yupayniykiwan llamkayta qallariypaq kankichu.

Sichus kay PC BitLocker churasqan chaymanta purichkan, chiqaqchay sichus huk mirachinata BitLocker kutichinapaq kichana maypipas wak PC hina waqaychanki.
  \resources\LeaveDomain_AuthBodyTitle:
    Candidate Language=QUZ-PE: Mitasqa yupay willayta yaykuy
  \resources\LeaveDomain_AuthBodyText:
    Candidate Language=QUZ-PE: Chiqaqchaypaq kay PC kaqman llamkayta qallariy atikunki chanta sayachichkan hatun llamkanamanta, willay local kamachiq yupaypaq llamkayta qallariyta yaykuy. Kay huk Microsoft yupayta utaq local yupayta atikun. Sichus mana hukta tiyankichu, huk paqarichiypaq munanki.
  \resources\JoinDomain_RPC_S_SERVER_UNAVAILABLE:
    Candidate Language=QUZ-PE: Kunanpuni kamachinanman tinkichiyta manam atikunchu. Llamkana computadorakunapura huñunaman tinkichisqa kasqaykita qawapay hinaspa musuqmanta ruwapay.
  \resources\JoinDomain_RPC_S_CALL_IN_PROGRESS:
    Candidate Language=QUZ-PE: Kay PCqa ñam kamachinanman tinkichisqaña. PCta musuqmanta qallarichiy hinaspa ruwapay.
  \resources\JoinDomain_RestartPCHeaderText:
    Candidate Language=QUZ-PE: PCniyki musuqmanta qallarichiy
  \resources\JoinDomain_NERR_SetupAlreadyJoined:
    Candidate Language=QUZ-PE: Kay PCqa ñam kamachinanman taqrukurunña.
  \resources\JoinDomain_HeaderText:
    Candidate Language=QUZ-PE: Kamachinanman taqrukuy
  \resources\JoinDomain_ERROR_NO_SUCH_MEMBER:
    Candidate Language=QUZ-PE: Chay kamachinan yupayta mana tarikunchu. Yupaypa sutinta qawapay, hinaspa musuqmanta ruwapay.
  \resources\JoinDomain_ERROR_MEMBER_IN_ALIAS:
    Candidate Language=QUZ-PE: Kay yupayqa ñam kay PCpi tupachisqaña.
  \resources\JoinDomain_ERROR_INVALID_DOMAIN:
    Candidate Language=QUZ-PE: Chay kamachinanta mana tarikunchu. Kamachinanpa sutinta qawapay, hinaspa musuqmanta ruwapay.
  \resources\JoinDomain_ERROR_DUP_NAME:
    Candidate Language=QUZ-PE: Kay PCpa sutinqa hapikuchkanñam. Huk sutita akllaspa, musuqmanta ruwapay.
  \resources\JoinDomain_ERROR_ACCESS_DENIED:
    Candidate Language=QUZ-PE: Kamachinaman manam taqruyta atinkichu. Chayman taqrukunapaq uyakusqa kasqaykita qawapay, PCpaq huk sutita akllay hinaspa musuqmanta ruwapay.
  \resources\JoinDomain_DomainNameDescriptionText:
    Candidate Language=QUZ-PE: Kamachinanpa sutin
  \resources\JoinDomain_ConfirmBodyText:
    Candidate Language=QUZ-PE: Musuqmanta qallarichispaqa, PCniyki kay kamachinanman taqrukunqa:
  \resources\JoinDomain_CANNOT_JOIN_ERROR:
    Candidate Language=QUZ-PE: Kamachinaman manam taqruyta atinkichu. TI nisqa kamachiqwan tupanakuy aswan yanapay hatallinaykipaq.
  \resources\JoinDomain_AuthHeaderText:
    Candidate Language=QUZ-PE: Kamachinanpi llamkay qallariy
  \resources\JoinDomain_AuthBodyText:
    Candidate Language=QUZ-PE: Kamachinan yupay willakuyta qillqay kamachinanman tinkichinapaq uyakusqa kasqayki chiqaqchanapaq.
  \resources\JoinDomain_ADD_LOCAL_USER_FAILED:
    Candidate Language=QUZ-PE: Sasachakuymi karun. Chaymantaña musuqmanta ruwapay.
  \resources\JoinDomain_AddDomainUserHeaderText:
    Candidate Language=QUZ-PE: Yupay yapay
  \resources\JoinDomain_AddDomainUserGroupText:
    Candidate Language=QUZ-PE: Yupay laya
  \resources\JoinDomain_AddDomainUserBodyText:
    Candidate Language=QUZ-PE: Yupay willakuyta qillqay kay PC hapiq runapaq. Kay mana ruwaspaqa, chay runam kamachinanpaq ñawpaqchasqa uyakuyniyuq kanqa.
  \resources\JoinDomain_AddDomainUserAccountText:
    Candidate Language=QUZ-PE: Ruwaq yupay
  \resources\InPlaceUpgrade_Title:
    Candidate Language=QUZ-PE: Sasachakuyta allichay Windows Update kaqta hapispa
  \resources\InPlaceUpgrade_Header:
    Candidate Language=QUZ-PE: Kaqninkunata musuqyachiniku chaymanta sistemapa kipunkunatapas
  \resources\InPlaceUpgrade_ExpeditedSessionCheckBox:
    Candidate Language=QUZ-PE: PC kaqniyta kikillanmanta qallarichiy churasqaykimanta 15 minutos qipanpi
  \resources\InPlaceUpgrade_BodyText2\Text:
    Candidate Language=QUZ-PE: PC kaqniki kawsirichisqa kasqanta chiqapcahy chaymanta llikaman cahymanta kallpachaqman tupachisqa kasqantapas. Churasqa pachamanta kasqanmanta yachachimusqaykiku haykapi PC kaqniki qallarichina kananta allichay tukukunapaq.
  \resources\InPlaceUpgrade_BodyText1\Text:
    Candidate Language=QUZ-PE: Huk hapirinalla allichay kachkanmi, allichapamusqakum kaqninkunapa mana allinyayninta Windowspa kunan churapasqa sistema kaq. Llamkanaykikuna, qillqa willakuqkuna, chaymanta tupachiykuna waqaychasqa kanqaku.
  \resources\HolographicUninstall_SucceededHeaderText:
    Candidate Language=QUZ-PE: Allichasqa urquy
  \resources\HolographicUninstall_SucceededBodyText:
    Candidate Language=QUZ-PE: Windows Mixed Reality qichusqan.
  \resources\HolographicUninstall_RestartHeaderText:
