  \resources\EnterProductKey_LabelText:
    Candidate Language=QUZ-PE: Ruruman haykuna
  \resources\EnterProductKey_InvalidKey:
    Candidate Language=QUZ-PE: Kay ruruman haykuna mana llamkayta qillqasqankichu. Ruruman haykunata chiqaqchay chaymanta hukta qillqay. (0x%08x)
  \resources\EnterProductKey_InvalidCharacters:
    Candidate Language=QUZ-PE: Wakin sananpakunamanta mana ruruman haykunapi riqsiyta atikunkuchu.
  \resources\EnterProductKey_InstructionsText:
    Candidate Language=QUZ-PE: Ruruman haykunayki huk correo electronicopi kanan chanta qampaq rantisqa utaq churasqa Windows kaqmanta kanan utaq tawak'uchupi Windows DVD utaq USB kaqpi hamusqan.
  \resources\EnterProductKey_HeaderText:
    Candidate Language=QUZ-PE: Huk ruruman haykunata qillqay
  \resources\EnterProductKey_GvlkWarningText:
    Candidate Language=QUZ-PE: Kausachiypaq kay ruruman haykunawan, kay dispositivota hatun llamkaypa kawsarichiynin yanapakuyniykiman tinkiyta munan.
  \resources\EnterProductKey_GoToStoreErrorText:
    Candidate Language=QUZ-PE: Mana kunan pacha Store kaqta kichay atikuykuchu. Aswan qhipaman watiqmanta ruway.
  \resources\EnterProductKey_GoToStoreDescriptionText:
    Candidate Language=QUZ-PE: Kay dispositivo kausachiypaq atikunkipas sichus Store kaqman richkan chaymanta kikin mirachina Windows kaqmanta rantichkan.
