  \personalDataExport\PrivacyStatementUrl:
    Candidate Language=KM-KH: https://go.microsoft.com/fwlink/?linkid=850749
  \personalDataExport\PrivacyLinkDisplayText:
    Candidate Language=KM-KH: https://aka.ms/privacy
  \personalDataExport\Paragraph3:
    Candidate Language=KM-KH: Microsoft នឹងដំណើរការ និងបញ្ជូនទិន្នន័យរបស់អ្នកដោយអនុលោមតាមសេចក្ដីថ្លែងការណ៍ឯកជនភាព Microsoft។
  \personalDataExport\Paragraph2:
    Candidate Language=KM-KH: ប្រសិនបើអ្នកមិនយល់ព្រមចំពោះការបញ្ជូនទិន្នន័យនេះទេ អ្នកអាចជ្រើសរើសឈប់ប្រើប្រាស់ផលិតផលនេះ។ សូមយោង​ទៅ​តាម​លក្ខខណ្ឌ​​នៃការប្រើ​ផលិតផល​របស់​អ្នក​សម្រាប់​សិទ្ធិ​ទទួលបានប្រាក់បង្វិលវិញ។
  \personalDataExport\Paragraph1:
    Candidate Language=KM-KH: ដើម្បីឱ្យផលិតផលនេះដំណើរការដូចការរំពឹងទុក Microsoft ត្រូវតែបញ្ជូនទិន្នន័យរបស់អ្នកសម្រាប់ដំណើរការទៅកាន់មជ្ឈមណ្ឌលទិន្នន័យ Microsoft ដែលមានទីតាំងនៅខាងក្រៅប្រទេស ឬតំបន់របស់អ្នក។ តាមរយៈការបន្តប្រើផលិតផលនេះ អ្នកយល់ព្រមបញ្ជូនទិន្នន័យនេះ។
  \personalDataExport\PageTitle:
    Candidate Language=KM-KH: ទិន្នន័យរបស់អ្នកនឹងត្រូវបានដំណើរការនៅខាងក្រៅប្រទេស ឬតំបន់របស់អ្នក។
  \personalDataExport\NextButtonText:
    Candidate Language=KM-KH: បន្ទាប់
  \personalDataExport\NavigationError:
    Candidate Language=KM-KH: យើងហាក់ដូចជាកំពុងមានបញ្ហាតភ្ជាប់មួយចំនួន - អ្នកប្រហែលជាមិនត្រូវបានភ្ជាប់ទៅអ៊ីនធឺណិត ឬមានបញ្ហានៅខាងយើង។<ul><li>ដើម្បីស្វែងយល់បន្ថែមអំពីមូលហេតុដែលទិន្នន័យរបស់អ្នកត្រូវការបញ្ជូនពីប្រទេសចិនទៅប្រទេសមួយផ្សេងទៀត នៅពេលអ្នកប្រើផលិតផល Microsoft នេះ សូមវាយបញ្ចូល https://aka.ms/productslist ទៅក្នុងរបារអាសយដ្ឋាននៃកម្មវិធីរុករកវិបណាមួយនៅលើឧបករណ៍ណាមួយក៏បាន។</li><br/><li>សម្រាប់ព័ត៌មានបន្ថែមអំពីឯកជនភាព និង ផលិតផលរបស់ Microsoft សូមមើលសេចក្តីថ្លែងការណ៍ឯកជនភាព Microsoft នៅ https://aka.ms/privacy.</li></ul>
