  \cortana\setCortanaOptOut:
    Candidate Language=KM-KH: Not now
  \cortana\privacyStatement:
    Candidate Language=KM-KH: Privacy statement
  \cortana\learnMoreLink:
    Candidate Language=KM-KH: Learn more
  \cortana\learnMoreHeadline:
    Candidate Language=KM-KH: Cortana
  \cortana\learnMoreBody2:
    Candidate Language=KM-KH: Learn more about Cortana in the Privacy Statement (https://aka.ms/privacy) and in the Cortana Learn more (https://aka.ms/cortanafaq).
  \cortana\learnMoreBody:
    Candidate Language=KM-KH: Cortana is your personal assistant. Cortana works best when you sign in and let it learn about you and your activities by using data from your device, your personal Microsoft account, third-party services and other Microsoft services. To help Cortana to provide personalized experiences and relevant suggestions, you can let Microsoft collect and use various types of data, such as your device location, data from your calendar, the apps you use, data from your emails and text messages, who you call, your contacts and who you interact with on your device. When you are signed in, Cortana also learns about you by collecting data about how you use your device and other Microsoft services, such as your music, alarm settings, whether the lock screen is on, what you view and purchase, your browsing in Microsoft Edge and Bing search history, and more. You can manage what data Cortana uses, and what it knows about you in Cortana Settings, Notebook and Permissions. You can always sign out of Cortana, and when you do, Cortana will still be there to help, but your experiences will not be personalized.
  \cortana\cortanaPersonaText3:
    Candidate Language=KM-KH: ក្នុងពេលខ្លី ខ្ញុំជាជំនួយការផ្ទាល់ខ្លួនរបស់អ្នក និងជាគូកនជិតស្និទ្ធិ។<br/>ត្រៀមខ្លួន នៅពេលអ្នករួចរាល់។
  \cortana\cortanaPersonaText2:
    Candidate Language=KM-KH: I'm your searcher, finder, weather watcher, plan-aheader, note taker, reminder maker, and animal impersonator (if you ever need that).
  \cortana\cortanaPersonaText:
    Candidate Language=KM-KH: សួស្ដី ខ្ញុំគឺជា Cortana។ <br/>ខ្ញុំមកទីនេះដើម្បីធ្វើឱ្យវាកាន់តែងាយស្រួល និងជួយអ្នកធ្វើអ្វីៗឱ្យរួចរាល់។
  \cortana\cortanaNextButton:
    Candidate Language=KM-KH: Use Cortana
  \cortana\cortanaIntro:
    Candidate Language=KM-KH: Meet Cortana
  \cortana\cortanaContent:
    Candidate Language=KM-KH: Cortana គឺ​ជា​គូកន​ជិត​ស្និទ្ធិ​របស់​អ្នក ត្រៀម​ចាំ​ជួយ​ជាមួយ​អ្វី​ដែល​រក្សា​ឱ្យ​អ្នក​ស្ថិត​នៅ​កំពូល ធ្វើ​ជា​វីរៈ​ជន ឬ​គ្រាន់តែ​គោរព​ពេល​វេលា។<br/><br/>ដើម្បី​ឱ្យ Cortana ផ្ដល់​បទ​ពិសោធន៍​ដែល​តម្រូវ​តាម​បុគ្គល និង​សេចក្ដី​ណែនាំ​ដែល​ពាក់ព័ន្ធ Microsoft ប្រមូល និង​ប្រើប្រាស់​ព័ត៌មាន ដែល​រាប់​បញ្ចូល​ទីតាំង និង​ប្រវត្តិ​ទីតាំង​របស់​អ្នក ឈ្មោះ​ទំនាក់​ទំនង ការ​បញ្ចូល​ជា​សំឡេង គំរូ​នៃ​ការ​និយាយ និង​ការ​សរសេរ ប្រវត្តិ​វាយ​បញ្ចូល ប្រវត្តិ​ស្វែង​រក ព័ត៌មាន​ប្រតិទិន​លម្អិត ប្រវត្តិ​ខ្លឹមសារ និង​ការ​ប្រាស្រ័យ​ទាក់ទង​ពី​សារ និង​កម្មវិធី​នានា រួម​ជាមួយ​ព័ត៌មាន​ផ្សេង​ទៀត​លើ​ឧបករណ៍​របស់​អ្នក។ ក្នុង Microsoft Edge, Cortana ប្រើ​ប្រវត្តិ​នៃ​ការ​ចូល​ទំព័រ​វិប​របស់​អ្នក។ អ្នក​តែងតែ​អាច​កែ​តម្រូវ​នូវ​អ្វី​ដែល Cortana ចង​ចាំ​ក្នុង​សៀវភៅ​កត់ត្រា និង​បិទ​លទ្ធភាព Cortana ក្នុង Microsoft Edge បាន។
  \cloudDomainJoin\CredPromptTitle:
    Candidate Language=KM-KH: បញ្ចូល​ពាក្យ​សម្ងាត់​របស់​អ្នក។
  \cloudDomainJoin\CredPromptCaption:
