  \resources\SetSurfaceHubLocalAdministrator_NewPassword2HolderText:
    Candidate Language=KM-KH: បញ្ចូលពាក្យសម្ងាត់ម្តងទៀត
  \resources\SetSurfaceHubLocalAdministrator_HeaderText:
    Candidate Language=KM-KH: ផ្លាស់ប្តូរគណនីអ្នកគ្រប់គ្រង
  \resources\SetSurfaceHubLocalAdministrator_ExplanationText:
    Candidate Language=KM-KH: សូមបញ្ចូលព័ត៌មានសម្រាប់គណនីអ្នកគ្រប់គ្រងមួយ។ នៅពេលអ្នកទៅកាន់ ‘ការកំណត់’ អ្នកនឹងត្រូវបានស្នើឱ្យចូលប្រព័ន្ធជាមួយគណនីនេះ។
  \resources\SetSurfaceHubLocalAdministrator_ErrorUseNotFound:
    Candidate Language=KM-KH: ឈ្មោះអ្នកប្រើមិនអាចត្រូវបានរកឃើញ។
  \resources\SetSurfaceHubLocalAdministrator_ErrorPasswordTooShort:
    Candidate Language=KM-KH: ពាក្យសម្ងាត់គឺខ្លីជាងអ្វីដែលតម្រូវ។ (ពាក្យសម្ងាត់ក៏អាចវែងពេក ថ្មីៗពេកក្នុងប្រវត្តិផ្លាស់ប្តូររបស់វាផងដែរ មិនមានតួអក្សរប្លែកគេគ្រប់គ្រាន់ ឬមិនបំពេញបានតាមតម្រូវការគោលការណ៍ពាក្យសម្ងាត់មួយផ្សេង។)
  \resources\SetSurfaceHubLocalAdministrator_ErrorNotPrimary:
    Candidate Language=KM-KH: ប្រតិបត្តិការត្រូវបានអនុញ្ញាតតែលើអង្គបញ្ជាដូមែនចម្បងនៃដូមែននេះប៉ុណ្ណោះ។
  \resources\SetSurfaceHubLocalAdministrator_ErrorNewPasswordsDoesntMatch:
    Candidate Language=KM-KH: ពាក្យសម្ងាត់មិនផ្គូរផ្គង
  \resources\SetSurfaceHubLocalAdministrator_ErrorInvalidPassword:
    Candidate Language=KM-KH: ពាក្យសម្ងាត់ចាស់គឺមិនត្រឹមត្រូវ។
  \resources\SetSurfaceHubLocalAdministrator_ErrorInvalidComputer:
    Candidate Language=KM-KH: ឈ្មោះកុំព្យូទ័រគឺមិនត្រឹមត្រូវ។
  \resources\SetSurfaceHubLocalAdministrator_ErrorGeneral:
    Candidate Language=KM-KH: ពាក្យសម្ងាត់មិនអាចត្រូវបានផ្លាស់ប្តូរ។ សូមប្រមូលទិន្នន័យដោះស្រាយបញ្ហា ហើយទាក់ទងផ្នែកគាំទ្រ។
  \resources\SetSurfaceHubLocalAdministrator_ErrorAccessDenied:
    Candidate Language=KM-KH: អ្នកប្រើមិនមានការចូលប្រើទៅព័ត៌មានដែលបានស្នើសុំឡើយ។
  \resources\SetSurfaceHubLocalAdministrator_CompleteHeaderText:
    Candidate Language=KM-KH: បានផ្លាស់ប្តូរគណនីអ្នកគ្រប់គ្រងដោយជោគជ័យ
  \resources\SetSurfaceHubLocalAdministrator_CompleteDoneButtonText:
