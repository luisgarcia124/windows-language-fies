  \resources\Uninstall_PasswordWarning_Desc_Default:
    Candidate Language=KM-KH: ប្រសិនបើអ្នកបានប្រើពាក្យសម្ងាត់ដើម្បីចូលប្រព័ន្ធទៅកំណែ Windows មុន ត្រូវប្រាកដថាអ្នកស្គាល់វា។
  \resources\Uninstall_PasswordWarning_Desc_Build:
    Candidate Language=KM-KH: ប្រសិនបើអ្នកបានប្រើពាក្យសម្ងាត់ ដើម្បីចុះឈ្មោះចូលកំណែបង្កើតមុនរបស់អ្នក សូមប្រាកដថា អ្នកស្គាល់ពាក្យសម្ងាត់នោះ។
  \resources\Uninstall_NewProfile_One:
    Candidate Language=KM-KH: អ្នក​បាន​បង្កើតមួយ​គណនីមួយ ៖
  \resources\Uninstall_NewProfile_HowTo\Text:
    Candidate Language=KM-KH: ទៅ​កាន់​ការ​កំណត់ > គណនី > មនុស្ស​ផ្សេង​ទៀត ដើម្បី​យក​គណនី​ទាំង​នេះ​ចេញ រួច​ហើយ​ព្យាយាម​ម្តង​ទៀត។
  \resources\Uninstall_NewProfile_Header:
    Candidate Language=KM-KH: យកចេញគណនីថ្មីៗ
  \resources\Uninstall_NewProfile_FormatMany:
    Candidate Language=KM-KH: អ្នកបាន​បង្កើត​គណនី %d ៖
  \resources\Uninstall_NewProfile_Desc\Text:
    Candidate Language=KM-KH: មុនពេលអ្នកអាចត្រឡប់ក្រោយ​កំណែ Windows មុន អ្នកនឹងត្រូវ​លុបគណនី​អ្នកប្រើប្រាស់ ដែលអ្នកបាន​បន្ថែមក្រោយ​ពេលដំឡើង​ជំនាន់ថ្មីបំផុត ។ គណនីទាំងនេះ​ត្រូវលុបចោល​ទាំងស្រុង រួមទាំងទម្រង់របស់ពួកគេ។
  \resources\Uninstall_MovedProfile_One:
    Candidate Language=KM-KH: អ្នក​បាន​ផ្លាស់ទីតាំង​មួយ​គណនី៖
  \resources\Uninstall_MovedProfile_Header:
    Candidate Language=KM-KH: យក​គណនី​មក​វិញ
  \resources\Uninstall_MovedProfile_FormatMany:
    Candidate Language=KM-KH: អ្នកបាន​ប្ដូរ​ទីតាំងគណនី %d ៖
  \resources\Uninstall_MovedProfile_Desc\Text:
    Candidate Language=KM-KH: មុនពេលអ្នកអាចត្រឡប់​ក្រោយកំណែ Windows មុន អ្នកនឹង ត្រូវការយកគណនី​អ្នកប្រើប្រាស់​ទាំងអស់ ដែលអ្នកបានផ្លាស់​ទីតាំងក្រោយ​ពេលដំឡើង​ជំនាន់ថ្មី​បំផុតមក​កន្លែង​ដើមវិញ។
  \resources\Uninstall_MissingExternal_Desc\Text:
    Candidate Language=KM-KH: យើងមិន​អាច​នាំអ្នកត្រឡប់​ទៅកំណែ​ Windows មុន បានទេ ព្រោះឧបករណ៍ផ្ទុក USB ឬដ្រាយ​ពីខាង​ក្រៅផ្សេងទៀត ដែលត្រូវបានប្រើកំឡុង​ពេលអាប់ក្រេត​ថ្មីបំផុតរបស់អ្នកបានបាត់។ សូមបញ្ចូលថាស និង​ព្យាយាមម្ដងទៀត។
  \resources\Uninstall_InsufficientSpace_Format:
    Candidate Language=KM-KH: ដើម្បីត្រឡប់ក្រោយ អ្នកនឹងត្រូវការ %ws នៃទំហំទំនេរលើដ្រាយដែល Windows ត្រូវបានដំឡើង។
  \resources\Uninstall_InsufficientSpace_Desc\Text:
    Candidate Language=KM-KH: ធ្វើឱ្យទំនេរទំហំខ្លះ ហើយព្យាយាមម្ដងទៀត។
  \resources\Uninstall_Information_Programs_Window7:
    Candidate Language=KM-KH: •  អ្នកនឹងត្រូវតែដំឡើងកម្មវិធីខ្លះឡើងវិញ។
  \resources\Uninstall_Information_LoseChanges_Windows10:
    Candidate Language=KM-KH: •  អ្នកនឹងបាត់បង់ការផ្លាស់ប្ដូរណាមួយដែលបានធ្វើទៅលើការកំណត់ បន្ទាប់ពីដំឡើងកំណែបង្កើតចុងក្រោយបំផុត។
  \resources\Uninstall_Information_LoseChanges_Build:
    Candidate Language=KM-KH: •  អ្នកនឹងបាត់បង់ការផ្លាស់ប្ដូរណាមួយដែលបានធ្វើទៅលើការកំណត់ បន្ទាប់ពីដំឡើងកំណែបង្កើតចុងក្រោយបំផុត។
  \resources\Uninstall_Information_LoseChanges:
    Candidate Language=KM-KH: •  អ្នកនឹងបាត់បង់ការផ្លាស់ប្ដូរណាមួយដែលបានធ្វើចំពោះការកំណត់ បន្ទាប់ពីអាប់ក្រេតទៅ Windows 11។
  \resources\Uninstall_Information_ListDesc\Text:
    Candidate Language=KM-KH: បន្ទាប់ពីត្រលប់ក្រោយវិញ៖
  \resources\Uninstall_Information_Header:
    Candidate Language=KM-KH: អ្វីដែលអ្នកត្រូវដឹង
  \resources\Uninstall_Information_Desc\Text:
    Candidate Language=KM-KH: នេះ​ប្រហែល​ជា​ចំណាយ​ពេល​មួយ​រយៈ ហើយ​អ្នក​នឹង​មិន​អាច​ប្រើ PC របស់​អ្នក​ទេ រហូត​ទាល់​តែ​ធ្វើ​រួច។ ទុក PC របស់​អ្នក​ដោត​ជាប់ និង​បើក​ចោល។
  \resources\Uninstall_Information_BackupWarning\Text:
    Candidate Language=KM-KH: តើឯកសាររបស់អ្នកត្រូវបានបម្រុងទុក? ការនេះគួរតែមិនប៉ះពាល់ដល់ពួកវាឡើយ ប៉ុន្ដែវាជាជម្រើសដ៏ល្អបំផុតដែលត្រូវបានរៀបចំ។
  \resources\Uninstall_Information_AppsAndPrograms:
    Candidate Language=KM-KH: •  អ្នកនឹងត្រូវតែដំឡើងកម្មវិធី និងកម្មវិធីខ្លះឡើងវិញ។
  \resources\Uninstall_GoBack_WindowsBlue:
    Candidate Language=KM-KH: ត្រឡប់ទៅ Windows 8.1 វិញ
  \resources\Uninstall_GoBack_Windows8:
    Candidate Language=KM-KH: ត្រឡប់ក្រោយ Windows 8 វិញ
  \resources\Uninstall_GoBack_Windows7:
    Candidate Language=KM-KH: ត្រឡប់ក្រោយ Windows 7 វិញ
  \resources\Uninstall_GoBack_Windows10:
    Candidate Language=KM-KH: ត្រឡប់ទៅ Windows 10 វិញ
  \resources\Uninstall_GoBack_Other:
    Candidate Language=KM-KH: ត្រឡប់ទៅកំណែបង្កើតមុននេះវិញ
  \resources\Uninstall_GoBack_Default:
    Candidate Language=KM-KH: ត្រឡប់ទៅកំណែ Windows មុនវិញ
  \resources\Uninstall_Expired_Desc\Text:
    Candidate Language=KM-KH: យើងមិនអាច​នាំអ្នកត្រឡប់​ទៅកំណែ Windows មុនបានទេ ពីព្រោះវាច្រើនជាង 10 ថ្ងៃ តាំងពីពេលដំឡើងជំនាន់។
  \resources\Uninstall_Error_Header:
    Candidate Language=KM-KH: យើងសោកស្ដាយ ប៉ុន្តែ​អ្នកមិន​អាច​ត្រឡប់ក្រោយ​បានទេ
  \resources\Uninstall_Error_Desc\Text:
    Candidate Language=KM-KH: ពុំបានធ្វើការផ្លាស់ប្ដូរឡើយ។
  \resources\Uninstall_Confirmation_Header:
    Candidate Language=KM-KH: សូមអរគុណ​ចំពោះការ​សាកល្បងប្រើ Windows 11
  \resources\Uninstall_Confirmation_Desc\Text:
    Candidate Language=KM-KH: ប្រសិនបើអ្នកនឹកការស្វែងរក សុវត្ថិភាព និងការចាប់ផ្ដើមដែលបានកែលម្អ អ្នកអាចត្រឡប់មក Windows 11 វិញបានគ្រប់ពេល។
  \resources\Uninstall_ConfirmationBuild_Header:
    Candidate Language=KM-KH: អរគុណ​សម្រាប់ការសាកល្បង​ប្រើកំណែបង្កើតនេះ
  \resources\Uninstall_ConfirmationBuild_Desc\Text:
    Candidate Language=KM-KH: យើងនឹងដំឡើងកំណែបង្កើតមើលមុនបន្ទាប់ នៅពេលវាអាចរកបាន។
  \resources\Uninstall_CheckUpdates_Yes\Content:
    Candidate Language=KM-KH: ពិនិត្យរក​អាប់ដេត
  \resources\Uninstall_CheckUpdates_No\Content:
    Candidate Language=KM-KH: ទេ សូម​អរគុណ
  \resources\Uninstall_CheckUpdates_Header:
    Candidate Language=KM-KH: ពិនិត្យរក​អាប់ដេត?
  \resources\Uninstall_CheckUpdates_Desc\Text:
    Candidate Language=KM-KH: មុន​ពេល​អ្នក​ត្រឡប់​ក្រោយ សូមសាក​ល្បង​ដំឡើង​កំណែចុង​ក្រោយ​បំផុត។ សកម្មភាពនេះ​អាច​នឹង​ដោះ​ស្រាយ​បញ្ហា​ដែល​អ្នក​កំពុង​មាន។
  \resources\Uninstall_CheckUpdatesError_Header:
    Candidate Language=KM-KH: មិន​អាច​ទទួល​ព័ត៌មាន​ស្ដីពី​អាប់ដេត​ទេ
  \resources\Uninstall_CheckUpdatesError_Desc\Text:
    Candidate Language=KM-KH: ដើម្បីពិនិត្យរកមើលកំណែថ្មីៗ សូមចូលទៅកាន់ការកំណត់ > Windows Update រួចជ្រើសរើសពិនិត្យរកមើលកំណែថ្មីៗ។
  \resources\Uninstall_BitLockerOffToOn_Header:
    Candidate Language=KM-KH: បិទ BitLocker
  \resources\Uninstall_BitLockerOffToOn_Desc\Text:
    Candidate Language=KM-KH: BitLocker ត្រូវបានបើកបន្ទាប់ពីអាប់ក្រេត។ ដើម្បីត្រឡប់ក្រោយ អ្នកនឹងត្រូវបិទ BitLocker ។
  \resources\Uninstall_BatteryError_Desc\Text:
    Candidate Language=KM-KH: អ្នកមិនអាចត្រលប់ក្រោយ​លើថាមពលថ្មតែឯងឡើយ។ សូមដោតសាក PC របស់អ្នក រួចហើយព្យាយាមម្ដងទៀត។
  \resources\TroubleshootActivation_ReactivationLinkText:
    Candidate Language=KM-KH: ខ្ញុំបានប្ដូរហាតវែរនៅលើឧបករណ៍នេះ កាលពីពេលថ្មីៗ
  \resources\TroubleshootActivation_OfflineText:
    Candidate Language=KM-KH: យើងមិនអាចធ្វើអោយដំណើរការការចំលង Windows របស់អ្នកបានទេ។ ប្រាកដថា អ្នកបានភ្ជាប់ទៅបណ្តាញអ៊ីនធឺណិត ហើយព្យាយា​ម្តងទៀត។
  \resources\TroubleshootActivation_NoSolutionText:
    Candidate Language=KM-KH: យើងមិនអាចធ្វើឱ្យដំណើរការ Windows នៅលើឧបករណ៍របស់អ្នក។
  \resources\TroubleshootActivation_NoSolutionNoStoreText:
    Candidate Language=KM-KH: យើង​មិន​អាច​ធ្វើ​អោយដំណើរការការចំលង Windows របស់អ្នកបានទេ។ ប្រាកដ​ថា អ្នក​បាន​ភ្ជាប់​ទៅ​បណ្ដាញអ៊ីនធឺណិត និងព្យាយាមម្ដងទៀត។ បើសិនអ្នកបានភ្ជាប់ទៅអ៊ីនធឺណិត និងបន្ដមើលឃើញបញ្ហានេះ សូមទាក់ទងនអ្នកគ្រប់គ្រ​ង​ប្រព័ន្ធ​សម្រាប់ព័ត៌មានបន្ថែម។
  \resources\TroubleshootActivation_MediaCreationText:
    Candidate Language=KM-KH: យើងបានរកឃើញអាជ្ញាប័ណ្ណឌីជីថល %1 សម្រាប់ឧបករណ៍នេះដែលប្រតិបត្តិ %2។ ដើម្បីធ្វើអោយដំណើរការដោយប្រើអាជ្ញាប័ណ្ឌឌីជីថលនេះ អ្នកត្រូវការដំឡើង %1។
  \resources\TroubleshootActivation_LearnMoreText:
    Candidate Language=KM-KH: ស្វែង​យល់​បន្ថែម​អំពី​ការ​ធ្វើ​ឱ្យ​មាន​ដំណើរការ Windows
  \resources\TroubleshootActivation_LaunchReactivationErrorText:
    Candidate Language=KM-KH: យើងមិនអាចធ្វើអោយដំណើរការ Windows ម្ដងទៀតឥឡូវនេះទេ។ ព្យាយាមម្តងទៀតនៅពេលក្រោយ។
  \resources\TroubleshootActivation_GoToStoreText:
    Candidate Language=KM-KH: អ្នកអាចធ្វើអោយដំណើរការឧបករណ៍នេះ ដោយទៅកាន់ Store និងទិញច្បាប់ចម្លងសុទ្ធមួយរបស់ Windows ។
  \resources\TroubleshootActivation_GetHelpText:
    Candidate Language=KM-KH: ទាក់ទងផ្នែកជំនួយ ដើម្បីទទួលយកជំនួយ
  \resources\TroubleshootActivation_FinishedHeaderText:
    Candidate Language=KM-KH: ការដោះស្រាយបញ្ហាបានបញ្ចប់
  \resources\TroubleshootActivation_Error_StoreErrors:
    Candidate Language=KM-KH: អ្វី​មួយ​បាន​រារាំង​យើង​ពី​ការ​ទំនាក់ទំនង​ជាមួយ​ម៉ាស៊ីនមេ​ធ្វើឱ្យ​ដំណើរការ​របស់​យើង។ សូម​រង់ចាំ​ពីរ ឬ​បី​នាទី បន្ទាប់មក​ព្យាយាម​ម្តងទៀត។ (0x%08x)
  \resources\TroubleshootActivation_Error_ServiceDisabled:
    Candidate Language=KM-KH: យើង​មិន​អាច​ភ្ជាប់ សេវាកម្ម Windows សំខាន់​បាន​ឡើយ។ ត្រូវ​ប្រាកដ​ថា អ្នក​បាន​តភ្ជាប់​ទៅ​អ៊ីនធឺណិត និង​រង់ចាំ​ពីរ ឬ​បីនាទី ហើយ​ព្យាយាម​ធ្វើ​ឱ្យ​សកម្ម​ម្តងទៀត​នៅ​ពេលក្រោយ។ (0x%08x)
  \resources\TroubleshootActivation_Error_HardwareChanged:
    Candidate Language=KM-KH: វា​ហាក់​ដូច​ជា​ហាដវែរ​នៅ​លើ​ឧបករណ៍​នេះ​បាន​ផ្លាស់ប្តូរ។ ត្រូវ​ប្រាកដ​ថា អ្នក​បាន​ភ្ជាប់​ទៅ​អ៊ីនធឺណិត រួច​ហើយ​ព្យាយាម​ម្តង​ទៀត​នៅពេល​ក្រោយ។ (0x%08x)
  \resources\TroubleshootActivation_EditionUpgradeText:
    Candidate Language=KM-KH: យើងបានរកឃើញអាជ្ញាប័ណ្ណឌីជីថល %1 សម្រាប់ឧបករណ៍នេះដែលប្រតិបត្តិ %2។ ដើម្បីធ្វើអោយដំណើរការដោយប្រើអាជ្ញាប័ណ្ឌឌីជីថលនេះ សូមជ្រើសរើសដំឡើងជំនាន់ Windows របស់អ្នក.
  \resources\TroubleshootActivation_EditionUpgradeButtonText:
    Candidate Language=KM-KH: ដំឡើងជំនាន់ Windows របស់​អ្នក
  \resources\TroubleshootActivation_DiagnosisText:
    Candidate Language=KM-KH: កំពុងរកបញ្ហាក្នុងការធ្វើអោយមានដំណើរការ...
  \resources\TroubleshootActivation_DiagnosisHeaderText:
    Candidate Language=KM-KH: ការដាក់ដំណើរការ Windows
  \resources\TroubleshootActivation_DiagnosisErrorText_Volume:
    Candidate Language=KM-KH: មាន​អ្វី​មួយ​រំខាន​ដល់​ការដោះស្រាយបញ្ហា​របស់យើង សូមប្រាកដថា អ្នក​បាន​តភ្ជាប់​ទៅ​អ៊ីនធឺណិត សូមរង់ចាំ​ពីរ ឬ​បីនាទី ហើយ​ព្យាយាម​ម្តងទៀត។ ទំនាក់ទំនង​ទៅ​អ្នកគ្រប់គ្រង​ប្រព័ន្ធ​របស់អ្នក​សម្រាប់​ព័ត៌មាន​បន្ថែម។ (0x%08x)
  \resources\TroubleshootActivation_DiagnosisErrorText:
    Candidate Language=KM-KH: មាន​អ្វី​មួយ​រំខាន​ដល់​ការដោះស្រាយបញ្ហា​របស់យើង សូមប្រាកដថា អ្នក​បាន​តភ្ជាប់​ទៅ​អ៊ីនធឺណិត សូមរង់ចាំ​ពីរ ឬ​បីនាទី ហើយ​ព្យាយាម​ម្តងទៀត។ (0x%08x)
  \resources\TroubleshootActivation_ChannelChangeText:
    Candidate Language=KM-KH: យើងបានរកឃើញអាជ្ញាប័ណ្ណឌីជីថលសម្រាប់ %1។ ដើម្បីធ្វើអោយដំណើរការឧបករណ៍នេះ សូមជ្រើសរើស ធ្វើអោយដំណើរការ Windows។
  \resources\TroubleshootActivation_ChannelChangeButtonText:
    Candidate Language=KM-KH: ធ្វើអោយដំណើរការ Windows
  \resources\TroubleshootActivation_ActivatedText:
    Candidate Language=KM-KH: យើង​បាន​ធ្វើ​អោយដំណើរការការ​ចំលង Windows នេះ​។
  \resources\SystemSettings_ViewWifiPassword_WindowHeaderTitle_Format:
    Candidate Language=KM-KH: ឃីសុវត្ថិភាព %1
  \resources\SystemSettings_SurfaceHub_BitLocker_ExportRecoveryKey_Title:
    Candidate Language=KM-KH: រក្សា​ទុក​គន្លឹះស្ដារ BitLocker ឡើង​វិញ
  \resources\SystemSettings_SurfaceHub_BitLocker_ExportRecoveryKey_Succeeded:
    Candidate Language=KM-KH: គន្លឹះ​ស្ដារ​ឡើង​វិញ​ត្រូវ​បាន​រក្សា​ទុក​ចូល %ws ជា​ស្ថាពរ។
  \resources\SystemSettings_SurfaceHub_BitLocker_ExportRecoveryKey_Saving:
    Candidate Language=KM-KH: កំពុង​រក្សា​ទុក​ចូល USBដ្រាយ
  \resources\SystemSettings_SurfaceHub_BitLocker_ExportRecoveryKey_Error_NoDrive:
    Candidate Language=KM-KH: ដើម្បី​រក្សា​ទុក​គន្លឹះ​ស្ដារ BitLocker ឡើង​វិញ ស៊ក​បញ្ចូល USB ដ្រាយ​មួយ​ចូល​ឧបករណ៍​ជាមុន​សិន។
  \resources\SystemSettings_SurfaceHub_BitLocker_ExportRecoveryKey_Error_Header:
    Candidate Language=KM-KH: មិន​អាច​រក្សា​ទុក​គន្លឹះ​ស្ដារ BitLocker ឡើង​វិញ​ទេ។
  \resources\SystemSettings_SurfaceHub_BitLocker_ExportRecoveryKey_Error_Generic:
    Candidate Language=KM-KH: យើង​បាន​ព្យាយាម​រក្សា​ទុក​គន្លឹះ​ស្ដារ BitLocker ឡើង​វិញ តែ​មាន​កំហុស​មួយ (កូដ​កំហុស 0x%08X)។ សូម​ព្យាយាម​ម្ដង​ទៀត។
  \resources\SystemSettings_CapabilityAccess_webcam_SystemGlobal:
    Candidate Language=KM-KH: ការចូលប្រើកាមេរ៉ាសម្រាប់ឧបករណ៍នេះ
  \resources\SystemSettings_CapabilityAccess_videosLibrary_SystemGlobal:
    Candidate Language=KM-KH: ការចូលប្រើបណ្ណាល័យវីដេអូសម្រាប់ឧបករណ៍នេះ
  \resources\SystemSettings_CapabilityAccess_userNotificationListener_SystemGlobal:
    Candidate Language=KM-KH: ការចូលប្រើការជូនដំណឹងសម្រាប់អ្នកប្រើប្រាស់សម្រាប់ឧបករណ៍នេះ
  \resources\SystemSettings_CapabilityAccess_userDataTasks_SystemGlobal:
    Candidate Language=KM-KH: ការចូលប្រើការងារសម្រាប់ឧបករណ៍នេះ
  \resources\SystemSettings_CapabilityAccess_userAccountInformation_SystemGlobal:
    Candidate Language=KM-KH: ការចូលប្រើព័ត៌មានគណនីសម្រាប់ឧបករណ៍នេះ
  \resources\SystemSettings_CapabilityAccess_radios_SystemGlobal:
    Candidate Language=KM-KH: ចូលប្រើ ដើម្បីគ្រប់គ្រងវិទ្យុនៅលើឧបករណ៍នេះ
  \resources\SystemSettings_CapabilityAccess_picturesLibrary_SystemGlobal:
    Candidate Language=KM-KH: ការចូលប្រើបណ្ណាល័យរូបភាពសម្រាប់ឧបករណ៍នេះ
  \resources\SystemSettings_CapabilityAccess_phoneCall_SystemGlobal:
