  \resources\SetSurfaceHubWSUSServer_useServerPlaceHolderText:
    Candidate Language=KM-KH: ប្រើម៉ាស៊ីនមេ WSUS ដើម្បីទាញយកការអាប់ដេត
  \resources\SetSurfaceHubWSUSServer_UrlHasToHasHttpPrefixText:
