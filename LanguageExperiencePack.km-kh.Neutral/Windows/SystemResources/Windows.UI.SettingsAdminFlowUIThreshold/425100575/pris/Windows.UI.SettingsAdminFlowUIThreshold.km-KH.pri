  \resources\SetSurfaceHubWSUSServer_HeaderText:
    Candidate Language=KM-KH: កំណត់រចនាសម្ព័ន្ធម៉ាស៊ីមេ WSUS
  \resources\SetSurfaceHubWSUSServer_CompleteHeaderText:
