  \resources\RemoteDesktop_GenericError_BodyText:
    Candidate Language=KM-KH: បិទការ​កំណត់ ហើយព្យាយាមម្ដងទៀត។
  \resources\RemoteDesktop_EnableFirewallError_HeaderText:
    Candidate Language=KM-KH: ដែសថបពីចម្ងាយ ត្រូវ​បាន​បង្ឃាំងដោយជញ្ជាំងភ្លើង​របស់អ្នក។
  \resources\RemoteDesktop_EnableFirewallError_BodyText:
    Candidate Language=KM-KH: បើក​រន្ធ 3389 ដើម្បី​អនុញ្ញាត​ដែសថបពីចម្ងាយ ឆ្លងកាត់​ជញ្ជាំង។
  \resources\RemoteDesktop_DisableFirewallError_HeaderText:
    Candidate Language=KM-KH: មាន​កំហុស​កើតឡើងនៅពេល​យើង​ព្យាយាម​បិទ​រន្ធ​ជញ្ជាំង​ភ្លើង​ដែសថបពីចម្ងាយ
  \resources\RemoteDesktop_DisableFirewallError_BodyText:
    Candidate Language=KM-KH: ដើម្បី​បិទ​ដែសថបពីចម្ងាយ សូមបិទរន្ធ 3389 នៅលើ​ជញ្ជាំង​ភ្លើង។
  \resources\RemoteDesktop_CloseButtonText:
    Candidate Language=KM-KH: បិទ
  \resources\RemoteDesktop_CancelButtonText:
    Candidate Language=KM-KH: បោះបង់
  \resources\RDP_ProtectAccount_SignInButtonText:
    Candidate Language=KM-KH: ទៅ​ជម្រើសចុះឈ្មោះចូល
  \resources\RDP_ProtectAccount_HeaderText:
    Candidate Language=KM-KH: ការពារគណនីរបស់អ្នក
  \resources\RDP_ProtectAccountDenied_BodyText:
    Candidate Language=KM-KH: អ្នកត្រូវ​ដាក់​លក្ខខណ្ឌ​នៃការផ្ទៀងផ្ទាត់ភាពត្រឹមត្រូវ (ដូចជា Windows Hello, ពាក្យ​សម្ងាត់ ឬ PIN) សម្រាប់​គណនី​នេះ​ដើម្បី​អនុញ្ញាត​ដែសថបពីចម្ងាយ។
  \resources\RDP_ProtectAccountAllowed_BodyText:
    Candidate Language=KM-KH: គណនី​របស់អ្នក​មិន​តម្រូវ​ឲ្យមាន​ការផ្ទៀងផ្ទាត់ភាពត្រឹមត្រូវ​ដើម្បី​ចុះ​ឈ្មោះ​ចូល PC នេះទេ។ ប្រសិនបើ​អ្នក​បើក​ដែសថបពីចម្ងាយ ដោយ​មិនមាន​ការផ្ទៀងផ្ទាត់​ភាពត្រឹមត្រូវ មានន័យថា អ្នកកំពុង​បើក​កុំព្យូទ័រ​របស់អ្នក​សម្រាប់​ការប្រើប្រាស់​ពីចម្ងាយ​ដោយ​មិនមានការ​អនុញ្ញាត។
  \resources\RDP_Enable_HeaderText:
    Candidate Language=KM-KH: អនុញ្ញាត​ដែសថបពីចម្ងាយ?
  \resources\RDP_Enable_Firewall_Part2_BodyText:
    Candidate Language=KM-KH: ការ​កំណត់​ជញ្ជាំង​ភ្លើង​កម្រិត​ខ្ពស់
  \resources\RDP_Enable_Firewall_Part1_BodyText:
    Candidate Language=KM-KH: អ្នក​កំពុងបើក​រន្ធដែសថបពីចម្ងាយ​នៅក្នុង​ជញ្ជាំង​ភ្លើងសម្រាប់​ការ​ភ្ជាប់បណ្ដាញ​នៅលើ PC នេះ។ ប្រសិនបើ​អ្នក​ចង់​រឹតត្បិត​ការ​តភ្ជាប់​នេះ​ទៅលើ​បណ្ដាញ​ដែលបាន​ជ្រើសរើស សូមបើក  
  \resources\RDP_Enable_Firewall_Complete_BodyText:
    Candidate Language=KM-KH: អ្នក​កំពុងបើក​រន្ធដែសថបពីចម្ងាយ​នៅក្នុង​ជញ្ជាំង​ភ្លើងសម្រាប់​ការ​ភ្ជាប់បណ្ដាញ​នៅលើ PC នេះ។ ប្រសិនបើ​អ្នក​ចង់​រឹតត្បិត​ការ​តភ្ជាប់​នេះ​ទៅលើ​បណ្ដាញ​ដែលបាន​ជ្រើសរើស សូមបើក​ការ​កំណត់​ជញ្ជាំង​ភ្លើង​កម្រិត​ខ្ពស់។
  \resources\RDP_Enable_BodyText:
    Candidate Language=KM-KH: អ្នក​និង អ្នកប្រើប្រាស់ដែលបានជ្រើសរើសនៅក្នុងគណនីអ្នកប្រើ នឹងអាច​ភ្ជាប់មកកាន់ PC នេះ​ពីចម្ងាយ​បាន។
  \resources\RDP_Disable_HeaderText:
    Candidate Language=KM-KH: បិទការអនុញ្ញាត​ដែសថបពីចម្ងាយ?
  \resources\PBR_WipeData_DriveListLink\Content:
    Candidate Language=KM-KH: សូមបង្ហាញខ្ញុំបញ្ជីនៃដ្រាយ ដែលនឹងប៉ះពាល់
  \resources\PBR_UninstallWarning_Header:
    Candidate Language=KM-KH: ការធ្វើបច្ចុប្បន្នភាពថ្មីៗ
  \resources\PBR_UninstallWarning_Desc\Text:
    Candidate Language=KM-KH: កុំព្យូទ័រនេះត្រូវបានធ្វើបច្ចុប្បន្នភាពថ្មីៗនេះ។ ប្រសិនបើអ្នកបន្តកំណត់កុំព្យូទ័រនេះឡើងវិញ អ្នកនឹងមិនអាចធ្វើបច្ចុប្បន្នភាពឡើងវិញបានទេ។
  \resources\PBR_Title:
    Candidate Language=KM-KH: កំណត់ PC នេះ ឡើងវិញ
  \resources\PBR_SessionPreparation_Header:
    Candidate Language=KM-KH: កំពុងធ្វើឱ្យរួចរាល់វត្ថុនានា
  \resources\PBR_SessionPreparation_Desc\Text:
    Candidate Language=KM-KH: នេះនឹងមិន​ចំណាយពេលច្រើនទេ
  \resources\PBR_ResetTypeSelection_ResetOption_Desc:
    Candidate Language=KM-KH: ដក​ចេញកម្មវិធី​និងការ​កំណត់​ទាំងអស់ ប៉ុន្តែ​រក្សាទុក​ឯកសារ​ផ្ទាល់ខ្លួន កម្មវិធី និង​ការ​កំណត់។
  \resources\PBR_ResetTypeSelection_ResetOption:
    Candidate Language=KM-KH: ដកចេញ​ទាំងអស់
  \resources\PBR_ResetTypeSelection_RefreshOption_Desc:
    Candidate Language=KM-KH: ដក​កម្មវិធី​និងការ​កំណត់ ប៉ុន្តែ​រក្សាទុក​ឯកសារ​ផ្ទាល់ខ្លួន​របស់​អ្នក។
  \resources\PBR_ResetTypeSelection_RefreshOption:
    Candidate Language=KM-KH: ទុកឯកសារ​របស់ខ្ញុំ
  \resources\PBR_ResetTypeSelection_Header:
    Candidate Language=KM-KH: ជ្រើសជម្រើសមួយ
  \resources\PBR_ResetOptions_SummaryLine\Text:
    Candidate Language=KM-KH: ការកំណត់បច្ចុប្បន្ន៖
  \resources\PBR_ResetOptions_Header:
    Candidate Language=KM-KH: ការកំណត់បន្ថែម
  \resources\PBR_ResetOptions_AdvancedOptions:
    Candidate Language=KM-KH: ផ្លាស់ប្ដូរការកំណត់
  \resources\PBR_ResetCancellation_Header:
    Candidate Language=KM-KH: កំពុងបោះបង់
  \resources\PBR_ResetCancellation_Desc\Text:
    Candidate Language=KM-KH: នេះនឹងមិនចំណាយពេលច្រើនទេ
  \resources\PBR_Reset:
    Candidate Language=KM-KH: កំណត់ឡើងវិញ
  \resources\PBR_RemovedAppsList_Header:
    Candidate Language=KM-KH: បញ្ជីកូនកម្មវិធីដែលត្រូវដកចេញ
  \resources\PBR_RemovedAppsList_Desc\Text:
    Candidate Language=KM-KH: អ្នកអាចដំឡើងកូនកម្មវិធីជាច្រើនឡើងវិញបាន ពី Microsoft Store ប៉ុន្តែអ្នកនឹងត្រូវដំឡើងកូនកម្មវិធីខាងក្រោមឡើងវិញពីវិប ឬឌីសសម្រាប់ដំឡើង។ បញ្ជីកូនកម្មវិធីនេះនឹងត្រូវបានរក្សាទុកចូលដែសថបបន្ទាប់ពីកំណត់ឡើងវិញ។
  \resources\PBR_Note\Text:
    Candidate Language=KM-KH: ចំណាំ៖
  \resources\PBR_MultipleUsersWarning_Header:
    Candidate Language=KM-KH: អ្នកផ្សេងទៀតបានចូលក្នុងប្រព័ន្ធ PC នេះ
  \resources\PBR_MultipleUsersWarning_Desc\Text:
    Candidate Language=KM-KH: តើអ្នកចង់បន្តទៀតទេ? វានឹងបណ្ដាលឱ្យពួក​វាបាត់បង់ទិន្នន័យ​ដែលមិនបានរក្សាទុក។
  \resources\PBR_MeteredDataWarning_Format:
    Candidate Language=KM-KH: ការទាញយកបណ្ដាញសមូហកម្មអាចប្រើទិន្នន័យច្រើនជាង 4 GB ។ ការភ្ជាប់របស់អ្នកត្រូវបានវាស់វែង ហើយអាចនឹងមានការគិតថ្លៃ។
  \resources\PBR_LearnMore_Text\Text:
    Candidate Language=KM-KH: ស្វែងយល់បន្ថែមអំពីការកំណត់ PC នេះឡើងវិញ
  \resources\PBR_HelpToChoose\Content:
    Candidate Language=KM-KH: ជួយខ្ញុំក្នុងការជ្រើសរើស
  \resources\PBR_FinalPreparation_Header:
    Candidate Language=KM-KH: រៀបចំដើម្បីកំណត់ឡើងវិញ
  \resources\PBR_FinalPreparation_Format:
    Candidate Language=KM-KH: ស្ថានភាព៖ រៀបចំ - %d%%
  \resources\PBR_FinalPreparation_Finalize:
    Candidate Language=KM-KH: ការ​រៀបចំ​ដើម្បី​ចាប់​ផ្ដើម​ឡើង​វិញ
  \resources\PBR_FinalPreparation_Desc\Text:
    Candidate Language=KM-KH: ឧបករណ៍នេះនឹងចាប់ផ្តើមឡើងវិញដោយស្វ័យប្រវត្តិ
  \resources\PBR_FinalPreparation_CloudFormat:
    Candidate Language=KM-KH: ស្ថានភាព៖ ទាញយក - %d%%
  \resources\PBR_Error_Header:
    Candidate Language=KM-KH: មានបញ្ហាមួយបានកើតឡើងក្នុងការកំណត់កុំព្យូទ័ររបស់អ្នកឡើងវិញ
  \resources\PBR_Error_Desc\Text:
    Candidate Language=KM-KH: ពុំបានធ្វើការផ្លាស់ប្ដូរឡើយ។
  \resources\PBR_ErrorWindowsToGo_Desc\Text:
    Candidate Language=KM-KH: PC របស់អ្នកមិនអាចកំណត់ឡើងវិញបានទេ ព្រោះវាកំពុងដំណើរការ Windows To Go។
  \resources\PBR_ErrorSafeMode_Header:
    Candidate Language=KM-KH: លក្ខណៈ​ពិសេស​នេះ​មិន​អាច​ប្រើ​ក្នុង​ម៉ូដ​សុវត្ថិភាព​បាន​ទេ
  \resources\PBR_ErrorSafeMode_Desc\Text:
    Candidate Language=KM-KH: ដើម្បី​កំណត់ PC នេះ​ឡើង​វិញ ចាប់​ផ្ដើម Windows ជា​ប្រក្រតី ហើយ​ព្យាយាម​ម្ដង​ទៀត ឬ​ក៏​ទៅ​កាន់​ការ​ចាប់​ផ្ដើម​កម្រិតខ្ពស់ ហើយ​ជ្រើស​អង្គ​ដោះ​ស្រាយ​បញ្ហា។
  \resources\PBR_ErrorRedirectedProfiles_Header:
    Candidate Language=KM-KH: មិនអាចកំណត់កុំព្យូទ័រនេះឡើងវិញ និងមិនអាចរក្សាឯកសាររបស់អ្នក
  \resources\PBR_ErrorRedirectedProfiles_Desc\Text:
    Candidate Language=KM-KH: ដើម្បីកំណត់ PC ឡើងវិញ និងរក្យាឯកសាររបស់អ្នក, អ្នកប្រើ, ឯកសារកម្មវិធី, និងសឺមី Windows ត្រូវនៅលើ​ដ្រាយដូចគ្នា។ អ្នកអាច​កំណត់  PC នេះឡើងវិញ និងយកចេញអ្វីគ្រប់យ៉ាង ប៉ុន្ដែអ្នកគួរតែបម្រុង​ទុកឯកសារ​ផ្ទាល់ខ្លួនរបស់អ្នកជាមុន។
  \resources\PBR_ErrorPayloadVersionMismatch_Desc\Text:
    Candidate Language=KM-KH: ការទាញយកមិនត្រឹមត្រូវទេ។ សូមព្យាយាមម្តងទៀត រួចជ្រើសរើសជម្រើសដំឡើងមូលដ្ឋានឡើងវិញ។
  \resources\PBR_ErrorPayloadDownload_Desc\Text:
    Candidate Language=KM-KH: ការទាញយកត្រូវបានបង្អាក់។ សូមពិនិត្យមើលការតភ្ជាប់របស់អ្នក រួចព្យាយាមម្តងទៀត ឬជ្រើសរើសជម្រើសដំឡើងឡើងវិញក្នុងមូលដ្ឋាន។
  \resources\PBR_ErrorPayloadConnection_Desc\Text:
    Candidate Language=KM-KH: មិនអាចភ្ជាប់ទៅម៉ាស៊ីនមេបានទេ។ សូមពិនិត្យមើលការតភ្ជាប់របស់អ្នក រួចព្យាយាមម្តងទៀត ឬជ្រើសរើសជម្រើសដំឡើងមូលដ្ឋានឡើងវិញ។
  \resources\PBR_ErrorNotSupportedInEdition_Desc\Text:
    Candidate Language=KM-KH: ជំនាន់នេះមិនគាំទ្រជម្រើសស្តារដែលបានជ្រើសរើសទេ។ សូមព្យាយាមម្តងទៀតជាមួយជម្រើសផ្សេង។
  \resources\PBR_ErrorNoRecoveryEnv_Header:
    Candidate Language=KM-KH: មិនអាចរកឃើញ​បរិយាកាស​ស្តារឡើងវិញទេ
  \resources\PBR_ErrorNoRecoveryEnv_Desc\Text:
    Candidate Language=KM-KH: សូមស៊កមេឌៀដំឡើង ឬស្តារ Windows ឡើងវិញចូល ហើយចាប់ផ្ដើម PC របស់អ្នកឡើងវិញជាមួយនឹងមេឌៀនេះ។
  \resources\PBR_ErrorNoPayload_Desc\Text:
    Candidate Language=KM-KH: មិនមានការទាញយកទេ។ សូមព្យាយាមម្តងទៀត រួចជ្រើសរើសជម្រើសដំឡើងមូលដ្ឋានឡើងវិញ។
  \resources\PBR_ErrorNoPayloadSupport_Desc\Text:
    Candidate Language=KM-KH: សេណារីយ៉ូស្តារឡើងវិញនេះមិនគាំទ្រជម្រើសទាញយកបណ្តាញសមូហកម្មទេ។ សូមព្យាយាមម្តងទៀត រួចជ្រើសរើសជម្រើសដំឡើងមូលដ្ឋានឡើងវិញ។
  \resources\PBR_ErrorNoDeownlevelEnv_Desc\Text:
    Candidate Language=KM-KH: ប្រសិនបើ​អ្នកបាន​ដំឡើង Windows ឬ មេឌៀ​ស្ដារឡើងវិញ សូម​ស៊កវា ហើយ​ចាប់ផ្ដើម PC ឡើងវិញ ពីមេឌៀ។
  \resources\PBR_ErrorInsufficientSpace_Line3\Text:
    Candidate Language=KM-KH: • លុបកម្មវិធី
  \resources\PBR_ErrorInsufficientSpace_Line2\Text:
    Candidate Language=KM-KH: • ចម្លងឯកសាររបស់អ្នកទៅឧបករណ៍ខាងក្រៅមួយ និងលុបពួកវាចេញពី PC នេះ
  \resources\PBR_ErrorInsufficientSpace_Line1\Text:
    Candidate Language=KM-KH: • ដំណើរការកម្មវិធីសម្អាតថាស
  \resources\PBR_ErrorInsufficientSpace_Line0\Text:
    Candidate Language=KM-KH: ដើម្បីសម្អាតថាសឱ្យមានទំហំទំនេរបន្ថែម អ្នកអាច៖
  \resources\PBR_ErrorInsufficientSpace_Header:
    Candidate Language=KM-KH: ត្រូវការ​ទំហំថាស​បន្ថែមទៀត
  \resources\PBR_ErrorInsufficientSpace_Desc:
    Candidate Language=KM-KH: ត្រូវការ​ទំហំឌីសទំនេរបន្ថែមចំនួន។ %1!ws! នៅលើ (%2!ws!)។
  \resources\PBR_ErrorFileNotTrust_Desc\Text:
    Candidate Language=KM-KH: ឯកសារដែលត្រូវការមិនគួរទុកចិត្តទេ។ វិញ្ញាបនប័ត្ររបស់ឯកសារអាចអស់សុពលភាព ឬឯកសារអាចត្រូវបានអ្នកដទៃកែប្រែ។
  \resources\PBR_ErrorDisabled_Desc\Text:
    Candidate Language=KM-KH: គោលការណ៍​អង្គភាព​របស់​អ្នក​មិន​អនុញ្ញាត​ការ​ធ្វើ​បែប​នេះ​ទេ។ សម្រាប់​ព័ត៌មាន​បន្ថែម ពិភាក្សា​ជាមួយ​អ្នក​ផ្ដល់​ជំនួយ ឬ​ផ្នែក IT របស់​អ្នក។
  \resources\PBR_ErrorCloud_Header:
    Candidate Language=KM-KH: មានបញ្ហាក្នុងការទាញយក
  \resources\PBR_ErrorCant_Header:
    Candidate Language=KM-KH: យើង​មិន​អាច​កំណត់ PC នេះ​ឡើង​វិញ​បាន​ទេ
  \resources\PBR_DataWarning_Format:
    Candidate Language=KM-KH: ការទាញយកបណ្ដាញសមូហកម្មអាចប្រើទិន្នន័យច្រើនជាង 4 GB ។
  \resources\PBR_DataDriveList_Header:
    Candidate Language=KM-KH: ដ្រាយ​ដែល​នឹង​រងការប៉ះពាល់
  \resources\PBR_DataDriveList_Desc\Text:
    Candidate Language=KM-KH: ប្រសិនបើអ្នកលុបឯកសារចេញពីគ្រប់ដ្រាយទាំងអស់ ដ្រាយទាំងនេះនឹង​រងការប៉ះពាល់៖
  \resources\PBR_ConfirmReset_NoApps\Text:
    Candidate Language=KM-KH: • ដកកូនកម្មវិធី និងកម្មវិធីទាំងអស់ចេញ
  \resources\PBR_ConfirmReset_Line3\Text:
    Candidate Language=KM-KH: • ដកការផ្លាស់ប្តូរណាមួយ ដែលបានធ្វើទៅលើការកំណត់ចេញ
  \resources\PBR_ConfirmReset_Line2\Text:
    Candidate Language=KM-KH: • ដកកូនកម្មវិធី និងកម្មវិធីណាមួយដែលមិនមានមកជាមួយ PC នេះចេញ
  \resources\PBR_ConfirmReset_Line1\Text:
    Candidate Language=KM-KH: • ដកឯកសារផ្ទាល់ខ្លួន និងគណនីអ្នកប្រើទាំងអស់នៅលើ PC នេះចេញ
  \resources\PBR_ConfirmReset_Line0\Text:
    Candidate Language=KM-KH: ការកំណត់ឡើងវិញនឹង៖
  \resources\PBR_ConfirmRefresh_RemovedAppsList\Content:
    Candidate Language=KM-KH: មើលកម្មវិធីដែលនឹងត្រូវយកចេញ
  \resources\PBR_ConfirmRefresh_NoApps\Text:
    Candidate Language=KM-KH: • ដកកូនកម្មវិធី និងកម្មវិធីទាំងអស់ចេញ
  \resources\PBR_ConfirmRefresh_Line3_Featured\Text:
    Candidate Language=KM-KH: • រក្សាឯកសារផ្ទាល់ខ្លួន
  \resources\PBR_ConfirmRefresh_Line2\Text:
    Candidate Language=KM-KH: • ផ្លាស់ប្ដូរការកំណត់ត្រឡប់ទៅលំនាំដើមវិញ
  \resources\PBR_ConfirmRefresh_Line1\Text:
    Candidate Language=KM-KH: • ដកកូនកម្មវិធី និងកម្មវិធីទាំងអស់ដែលមិនមានមកជាមួយ PC នេះចេញ
  \resources\PBR_ConfirmRefresh_Line0\Text:
    Candidate Language=KM-KH: ការ​កំណត់ឡើងវិញ នឹង ៖
  \resources\PBR_ConfirmPage_MeteredDataWarning_Format:
    Candidate Language=KM-KH: •  ការទាញយកបណ្ដាញសមូហកម្មអាចប្រើទិន្នន័យច្រើនជាង %ws ។ ការតភ្ជាប់របស់អ្នកត្រូវបានវាស់វែង ហើយអាចមានការគិតថ្លៃបណ្តាញ។
  \resources\PBR_ConfirmPage_Header:
    Candidate Language=KM-KH: ត្រៀមរួចសម្រាប់​កំណត់ PC នេះ​ឡើងវិញ
  \resources\PBR_ConfirmPage_Desc\Text:
    Candidate Language=KM-KH: •  វានឹងចំណាយពេលមួយសន្ទុះ ហើយ PC របស់អ្នកនឹងចាប់ផ្ដើមឡើងវិញ។
  \resources\PBR_ConfirmPage_DataWarning_Format:
    Candidate Language=KM-KH: •  ការទាញយកបណ្ដាញសមូហកម្មអាចប្រើទិន្នន័យច្រើនជាង %ws ។
  \resources\PBR_ConfirmPage_BitlockerSuspended\Text:
    Candidate Language=KM-KH: •  ការបំលែង​កូដ​ដ្រាយ BitLocker នឹងត្រូវផ្អាកមួយរយៈ រហូតដល់ដំណើរការបានរួចរាល់។
  \resources\PBR_ConfirmPage_BitlockerOff\Text:
    Candidate Language=KM-KH: •  ការបំលែង​កូដ​ដ្រាយ BitLocker នឹងត្រូវបានបិទ។
  \resources\PBR_BatteryError_Header:
    Candidate Language=KM-KH: ដោតភ្លើងសម្រាប់ PC របស់អ្នក
  \resources\PBR_BatteryError_Desc\Text:
    Candidate Language=KM-KH: យើងមិន​អាចកំណត់ PC របស់អ្នកឡើងវិញបានទេ ខណៈដែលវាកំពុង​ដំណើរការ​តាមថាមពលថ្ម។
  \resources\PBR_Advanced_Workplace_Text:
    Candidate Language=KM-KH: លុបធនធាននៅកន្លែងធ្វើការឬ?
  \resources\PBR_Advanced_Workplace_SelectionOn:
    Candidate Language=KM-KH: •  លុបកញ្ចប់នៃការផ្ដល់ឱ្យចេញពីកន្លែងការងាររបស់អ្នក
  \resources\PBR_Advanced_Workplace_SelectionOff:
    Candidate Language=KM-KH: •  រក្សាកញ្ចប់នៃការផ្ដល់ឲ្យចេញពីកន្លែងការងាររបស់អ្នក
  \resources\PBR_Advanced_Workplace_OnDesc:
    Candidate Language=KM-KH: លុបកញ្ចប់នៃការផ្ដល់ឱ្យចេញពីកន្លែងការងាររបស់អ្នក
  \resources\PBR_Advanced_Workplace_OffDesc:
    Candidate Language=KM-KH: រក្សាកញ្ចប់នៃការផ្ដល់ឲ្យចេញពីកន្លែងការងាររបស់អ្នក
  \resources\PBR_Advanced_WipeData_ToggleOn:
    Candidate Language=KM-KH: បាទ/ចាស ដ្រាយទាំងអស់
  \resources\PBR_Advanced_WipeData_ToggleOff:
    Candidate Language=KM-KH: ទេ តែដ្រាយ Windows ប៉ុណ្ណោះ
  \resources\PBR_Advanced_WipeData_Text:
    Candidate Language=KM-KH: លុបឯកសារចេញពីដ្រាយទាំងអស់ឬ?
  \resources\PBR_Advanced_WipeData_SelectionOn:
    Candidate Language=KM-KH: •  លុបឯកសារទាំងអស់ពីដ្រាយទាំងអស់
  \resources\PBR_Advanced_WipeData_SelectionOff:
    Candidate Language=KM-KH: •  លុបឯកសារទាំងអស់តែពីដ្រាយ Windows ប៉ុណ្ណោះ
  \resources\PBR_Advanced_WipeData_OnDesc:
    Candidate Language=KM-KH: លុបឯកសារទាំងអស់ពីដ្រាយទាំងអស់។ ការលុបជម្រើសទិន្នន័យនឹងអនុវត្តចំពោះដ្រាយទាំងអស់
  \resources\PBR_Advanced_WipeData_OffDesc:
    Candidate Language=KM-KH: លុបឯកសារទាំងអស់តែពីដ្រាយ Windows ប៉ុណ្ណោះ
  \resources\PBR_Advanced_PreinstalledApps_Text:
    Candidate Language=KM-KH: ស្ដារកម្មវិធីដែលបានដំឡើងជាមុនឬ?
  \resources\PBR_Advanced_PreinstalledApps_SelectionOn:
    Candidate Language=KM-KH: • ស្ដារឡើងវិញនូវកូនកម្មវិធី និងការកំណត់ដែលមានមកជាមួយ PC នេះ
  \resources\PBR_Advanced_PreinstalledApps_SelectionOff:
    Candidate Language=KM-KH: • មិនស្ដារឡើងវិញនូវកូនកម្មវិធី និងការកំណត់ដែលមានមកជាមួយ PC នេះទេ
  \resources\PBR_Advanced_PreinstalledApps_OnDesc:
    Candidate Language=KM-KH: ស្ដារឡើងវិញនូវកូនកម្មវិធី និងការកំណត់ដែលមានមកជាមួយ PC នេះ
  \resources\PBR_Advanced_PreinstalledApps_OffDesc:
    Candidate Language=KM-KH: មិនស្ដារឡើងវិញនូវកូនកម្មវិធី និងការកំណត់ដែលមានមកជាមួយ PC នេះទេ
  \resources\PBR_Advanced_Header:
    Candidate Language=KM-KH: ជ្រើសរើសការកំណត់
  \resources\PBR_Advanced_Esim_Text:
    Candidate Language=KM-KH: លុបប្រវត្តិរូប eSIM ឬ?
  \resources\PBR_Advanced_Esim_SelectionOn:
    Candidate Language=KM-KH: •  លុបប្រវត្តិរូប eSIM ទាំងអស់សម្រាប់ទិន្នន័យចល័ត
  \resources\PBR_Advanced_Esim_SelectionOff:
    Candidate Language=KM-KH: •  រក្សាប្រវត្តិរូប eSIM ទាំងអស់សម្រាប់ទិន្នន័យចល័ត
  \resources\PBR_Advanced_Esim_OnDesc:
    Candidate Language=KM-KH: លុបប្រវត្តិរូប eSIM ទាំងអស់សម្រាប់ទិន្នន័យចល័ត
  \resources\PBR_Advanced_Esim_OffDesc:
    Candidate Language=KM-KH: រក្សាប្រវត្តិរូប eSIM ទាំងអស់សម្រាប់ទិន្នន័យចល័ត
  \resources\PBR_Advanced_Erase_Text:
    Candidate Language=KM-KH: សម្អាតទិន្នន័យឬ?
  \resources\PBR_Advanced_Erase_SelectionOn:
    Candidate Language=KM-KH: •  លុបកម្មវិធី និងឯកសារចេញ។ សម្អាតដ្រាយ
  \resources\PBR_Advanced_Erase_SelectionOff:
    Candidate Language=KM-KH: •  លុបកម្មវិធី និងឯកសារចេញ។ កុំសម្អាតដ្រាយ
  \resources\PBR_Advanced_Erase_OnDesc:
    Candidate Language=KM-KH: សម្អាតដ្រាយ។ វាអាចនឹងចំណាយពេលច្រើនម៉ោង ប៉ុន្តែនឹងធ្វើឲ្យវាកាន់តែពិបាកក្នុងការសង្រ្គោះឯកសារ
  \resources\PBR_Advanced_Erase_OffDesc:
    Candidate Language=KM-KH: គ្រាន់តែដកឯកសាររបស់អ្នកចេញ។ វារហ័សជាង ប៉ុន្តែមិនសូវមានសុវត្ថិភាព
  \resources\PBR_Advanced_Confirm\Content:
    Candidate Language=KM-KH: បញ្ជាក់
  \resources\PBR_Advanced_CloudRecovery_Text:
    Candidate Language=KM-KH: ទាញយក Windows ឬ?
  \resources\PBR_Advanced_CloudRecovery_SelectionOn:
    Candidate Language=KM-KH: •  ទាញយក និងដំឡើង Windows ឡើងវិញ
  \resources\PBR_Advanced_CloudRecovery_SelectionOff:
    Candidate Language=KM-KH: • ដំឡើង Windows ពីឧបករណ៍នេះឡើងវិញ
  \resources\PBR_Advanced_CloudRecovery_OnText:
    Candidate Language=KM-KH: ទាញយកបណ្ដាញសមូហកម្ម
  \resources\PBR_Advanced_CloudRecovery_OnDesc:
    Candidate Language=KM-KH: ទាញយក និងដំឡើង Windows ឡើងវិញ
  \resources\PBR_Advanced_CloudRecovery_OffText:
    Candidate Language=KM-KH: ការដំឡើងឡើងវិញជាមូលដ្ឋាន
  \resources\PBR_Advanced_CloudRecovery_OffDesc:
    Candidate Language=KM-KH: ដំឡើង Windows ពីឧបករណ៍នេះឡើងវិញ
  \resources\PBR_Advanced_CloudRecovery_Header:
    Candidate Language=KM-KH: តើអ្នកចង់ដំឡើង Windows ឡើងវិញដោយរបៀបណា?
  \resources\PBR_Advanced_CloudRecovery_DisabledDesc:
