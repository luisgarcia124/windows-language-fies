  \resources\InPlaceUpgrade_ExpeditedSessionCheckBox:
    Candidate Language=KM-KH: ចាប់ផ្តើម PC របស់ខ្ញុំឡើងវិញ 15 នាទីទៀតដោយស្វ័យប្រវត្តិបន្ទាប់ពីការដំឡើង
  \resources\InPlaceUpgrade_BodyText2\Text:
    Candidate Language=KM-KH: សូមប្រាកដថា PC របស់អ្នកបើក និងភ្ជាប់ទៅបណ្តាញ ព្រមទាំងប្រភពថាមពល។ បន្ទាប់ពីដំឡើងរួច យើងនឹងប្រាប់អ្នកនៅពេលវាដល់ពេលចាប់ផ្តើម PC របស់អ្នកឡើងវិញ ដើម្បីបញ្ចប់ការជួសជុល។
  \resources\InPlaceUpgrade_BodyText1\Text:
    Candidate Language=KM-KH: ប្រសិនបើមានដំណោះស្រាយជួសជុល យើងនឹងព្យាយាមជួសជុលសមាសភាគដែលខូចរបស់ប្រព័ន្ធ ដោយដំឡើងកំណែបច្ចុប្បន្នរបស់ Windows ឡើងវិញ។ កម្មវិធី ឯកសារ និងការកំណត់របស់អ្នកនឹងត្រូវបានរក្សាទុក។
  \resources\HolographicUninstall_SucceededHeaderText:
    Candidate Language=KM-KH: លុបកម្មវិធី​បានជោគជ័យ
  \resources\HolographicUninstall_SucceededBodyText:
    Candidate Language=KM-KH: Windows Mixed Reality ត្រូវបានយកចេញ។
  \resources\HolographicUninstall_RestartHeaderText:
    Candidate Language=KM-KH: តម្រូវឱ្យ​មានការចាប់ផ្តើមឡើងវិញ
  \resources\HolographicUninstall_RestartBodyText:
    Candidate Language=KM-KH: ចាប់ផ្តើមដំណើរការកុំព្យូទ័ររបស់អ្នកដើម្បីបញ្ចប់ការមិនដំឡើង Windows Mixed Reality.
  \resources\HolographicUninstall_LearnMoreText:
    Candidate Language=KM-KH: ស្វែងយល់​បន្ថែម
  \resources\HolographicUninstall_HeaderText:
    Candidate Language=KM-KH: មិនដំឡើងត Windows Mixed Reality
  \resources\HolographicUninstall_ErrorText:
