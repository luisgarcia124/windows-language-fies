  \resources\SystemSettings_Language_CHSPinyinIME_LexiconSubHeaderDescription:
    Candidate Language=KM-KH: ចំណាត់ថ្នាក់ថាមវ័ន្ត ស្វ័យសិក្សា ឃ្លាដែលអ្នកប្រើបានកំណត់ ជម្រើសពីបណ្តាញសមូហកម្ម វាក្យស័ព្ទដូមែន
  \resources\SystemSettings_Language_CHSPinyinIME_LexiconPageTitleDescription:
    Candidate Language=KM-KH: វាក្យសព្ទ និង​ស្វ័យ​សិក្សា
  \resources\SystemSettings_Language_CHSPinyinIME_LexiconHeaderDescription:
    Candidate Language=KM-KH: វាក្យសព្ទ និង​ស្វ័យ​សិក្សា
  \resources\SystemSettings_Language_CHSPinyinIME_KeysSubHeaderDescription:
    Candidate Language=KM-KH: ការ​ប្ដូរ​ម៉ូដ, ការ​រុករក​ជម្រើស, ឃី​កាត់
  \resources\SystemSettings_Language_CHSPinyinIME_KeysPageTitleDescription:
    Candidate Language=KM-KH: ឃី
  \resources\SystemSettings_Language_CHSPinyinIME_KeysHeaderDescription:
    Candidate Language=KM-KH: ឃី
  \resources\SystemSettings_Language_CHSPinyinIME_IsVModeEnabledDescription:
    Candidate Language=KM-KH: ប្រើ​ម៉ូដ V ដើម្បី​បញ្ចូល​លេខ កាល​បរិច្ឆេទ និង​ពេល​វេលា -ល- ជា​ទម្រង់​ភាសា​ចិន។ នៅ​ពេល​ស្ថិត​ក្នុង​ម៉ូដ​ភីនអ៊ីន​ទ្វេ ម៉ូដ V អាច​ត្រូវ​បាន​ជំរុញ​ដោយ "Shift + v"
  \resources\SystemSettings_Language_CHSPinyinIME_IsUModeEnabledDescription:
    Candidate Language=KM-KH: ប្រើ​ម៉ូដ U ដើម្បី​បញ្ចូល​តួ​អក្សរ​ចិន​ផ្អែក​តាម​គំនូស ឬ​បង្គុំ​របស់​អក្សរ ឬ​ក៏​ដើម្បី​បញ្ចូលសញ្ញា។ នៅ​ពេល​ស្ថិត​ក្នុង​ម៉ូដ​ភីនអ៊ីន​ទ្វេ ម៉ូដ U អាច​ត្រូវ​បាន​ជំរុញ​ដោយ "Shift + u"
  \resources\SystemSettings_Language_CHSPinyinIME_IsSuperAbbreviatedPinyinEnabledDescription:
    Candidate Language=KM-KH: ភីនអ៊ីនដែលកាត់ខ្លីបំផុត
  \resources\SystemSettings_Language_CHSPinyinIME_IsSmartSelfLearningEnabledDescription:
    Candidate Language=KM-KH: ទាញឃ្លាចេញ​ដោយស្វ័យប្រវត្តិ​ពីឯកសារ​ដែលអ្នកកំពុងកែសម្រួល និងទើបតែបានកែសម្រួលរួចរាល់ (ឃ្លាទាំងនេះ​នឹងប្រើតែ​នៅក្នុងការបញ្ចូល​បច្ចុប្បន្នរបស់​អ្នកប៉ុណ្ណោះ​ដើម្បីកែលម្អ​ភាពត្រឹមត្រូវ។ វា​នឹង​មិនត្រូវបាន​ផ្ញើ​ទៅកាន់ Microsoft ឡើយ។)
  \resources\SystemSettings_Language_CHSPinyinIME_IsSelfLearningEnabledDescription:
    Candidate Language=KM-KH: បើក/បិទមុខងារស្វ័យសិក្សា ហើយនាំចូល/នាំចេញឃ្លាស្វ័យសិក្សា (ប្រើបានតែទម្រង់ខាងក្នុង Microsoft ប៉ុណ្ណោះ)
  \resources\SystemSettings_Language_CHSPinyinIME_IsReadingAutoCorrectionEnabledDescription:
    Candidate Language=KM-KH: អានស្វ័យកំណែរ
  \resources\SystemSettings_Language_CHSPinyinIME_IsPeopleNameTipEnabledDescription:
    Candidate Language=KM-KH: បង្ហាញ​សេចក្ដី​ណែនាំ​ខ្លីៗ​នៃ​លក្ខណៈ​ពិសេស​បញ្ចូល​ឈ្មោះ​មនុស្ស​ដោយ​ស្វ័យ​ប្រវត្តិ
  \resources\SystemSettings_Language_CHSPinyinIME_IsPeopleNameEnabledDescription:
    Candidate Language=KM-KH: ក្នុងពេលបញ្ចូលភីនអ៊ីន សូមប្រើ "semicolon + r" ដើម្បីចូលម៉ូដបញ្ចូលឈ្មោះមនុស្ស។ នៅពេលស្ថិតក្នុងម៉ូដភីនអ៊ីនទ្វេ ចុចឃី "Shift + semicolon" បន្ទាប់មកឃី "r" ដើម្បីចូលម៉ូដបញ្ចូលឈ្មោះមនុស្ស
  \resources\SystemSettings_Language_CHSPinyinIME_IsOutputCharsetSwitchKeyEnabledDescription:
    Candidate Language=KM-KH: ប្ដូរ​ការ​បញ្ចូល​ជា​ចិន​សាមញ្ញ/បុរាណ
  \resources\SystemSettings_Language_CHSPinyinIME_IsOpenEmoticonSymbolViewKeyEnabledDescription:
    Candidate Language=KM-KH: បើកផ្ទាំងសញ្ញាអារម្មណ៍និងនិមិត្តសញ្ញា
  \resources\SystemSettings_Language_CHSPinyinIME_IsNumPadInputEnabledDescription:
    Candidate Language=KM-KH: ឃី​លេខ៖ ការ​បញ្ចូល​លេខ​ដោយ​ផ្ទាល់​ជាជាង​ជ្រើស​ជម្រើស
  \resources\SystemSettings_Language_CHSPinyinIME_IsLiveStickerEnabledDescription:
    Candidate Language=KM-KH: ទទួលរូបបិទពីបណ្តាញសមូហកម្ម (វានឹងបញ្ជូនការបញ្ចូលក្ដារចុចរបស់អ្នកទៅ Microsoft)
  \resources\SystemSettings_Language_CHSPinyinIME_IsIntelligentPunctuationAdjustmentEnabledDescription:
    Candidate Language=KM-KH: លៃ​តម្រូវ​សញ្ញា​ក្បៀស ចុច និង​ចុច​ពីរ​ដោយ​ស្វ័យ​ប្រវត្តិ នៅ​ពេល​បញ្ចូល​ពួក​វា​ក្នុង​សំណុំ​អក្សរ​ជា​លេខ​មួយ
  \resources\SystemSettings_Language_CHSPinyinIME_IsHotkeySwitchCharSetEnabledDescription:
    Candidate Language=KM-KH: ប្រើ Ctrl+Shift+F ដើម្បី​ប្ដូរ​លទ្ធផល​ចេញ​មក​ជា​ចិន​សាមញ្ញ និង​ចិន​បុរាណ
  \resources\SystemSettings_Language_CHSPinyinIME_IsHotAndPopularWordSearchEnabledDescription:
    Candidate Language=KM-KH: បង្ហាញ​សេចក្ដី​ណែនាំ​ខ្លីៗ​សម្រាប់​ការ​ស្វែង​រក​ពាក្យ​ប្រើ​ច្រើន និង​ពេញ​និយម
  \resources\SystemSettings_Language_CHSPinyinIME_IsHapEnabledDescription:
    Candidate Language=KM-KH: ការបង្ហាញពាក្យថ្មីៗនិងពេញនិយមនៅក្នុងបង្អួចកំពុងធ្វើការ
  \resources\SystemSettings_Language_CHSPinyinIME_IsEUDPEnabledDescription:
    Candidate Language=KM-KH: ចាប់ផ្ដើមប្រើឃ្លាដែលអ្នកប្រើបានកំណត់
  \resources\SystemSettings_Language_CHSPinyinIME_IsDynamicCandidateRankingEnabledDescription:
