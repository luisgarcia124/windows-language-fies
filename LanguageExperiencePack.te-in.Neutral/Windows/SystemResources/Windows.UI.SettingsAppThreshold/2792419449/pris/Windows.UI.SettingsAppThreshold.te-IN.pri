  \SystemSettings\Resources\CorpDeviceManagementDialogDomainUserBox\PlaceholderText:
    Candidate Language=TE-IN: డొమైన్ మరియు వినియోగదారు పేరు
  \SystemSettings\Resources\CorpDeviceManagementDialogCancelButton\Content:
    Candidate Language=TE-IN: రద్దు చేయి
  \SystemSettings\Resources\CorpDeviceManagementDialogBackButton\Content:
    Candidate Language=TE-IN: వెనుకకు
  \SystemSettings\Resources\CorpDeviceManagementActionDescription\Text:
