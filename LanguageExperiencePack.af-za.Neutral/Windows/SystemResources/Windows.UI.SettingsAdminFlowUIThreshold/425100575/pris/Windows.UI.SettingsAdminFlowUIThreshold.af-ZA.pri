  \resources\PBR_DataDriveList_Desc\Text:
    Candidate Language=AF-ZA: As jy kies om lêers van alle aandrywers te verwyder, sal hierdie aandrywers geraak word:
  \resources\PBR_ConfirmReset_NoApps\Text:
    Candidate Language=AF-ZA: • Verwyder alle toepassings en programme
  \resources\PBR_ConfirmReset_Line3\Text:
