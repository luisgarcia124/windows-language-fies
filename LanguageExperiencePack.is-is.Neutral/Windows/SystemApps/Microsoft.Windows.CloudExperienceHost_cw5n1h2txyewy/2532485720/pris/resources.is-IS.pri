  \hello\TitleFingerprint:
    Candidate Language=IS-IS: Notaðu fingrafarið þitt til að skrá þig inn á hraðari og öruggari máta
  \hello\TitleFaceFingerprint:
    Candidate Language=IS-IS: Skráðu þig inn á hraðari og öruggari máta
  \hello\TitleFace:
