  \resources\PBR_FinalPreparation_CloudFormat:
    Candidate Language=IS-IS: Staða: Hleður niður – %d%%
  \resources\PBR_Error_Header:
    Candidate Language=IS-IS: Vandamál kom upp við að endurstilla tölvuna
  \resources\PBR_Error_Desc\Text:
    Candidate Language=IS-IS: Engar breytingar voru gerðar.
  \resources\PBR_ErrorWindowsToGo_Desc\Text:
    Candidate Language=IS-IS: Ekki er hægt að endurstilla tölvuna vegna þess að hún keyrir Windows To Go.
  \resources\PBR_ErrorSafeMode_Header:
    Candidate Language=IS-IS: Þessi eiginleiki er ekki í boði í öryggisstillingu
  \resources\PBR_ErrorSafeMode_Desc\Text:
    Candidate Language=IS-IS: Til að endurstilla tölvuna þá skaltu ræsa Windows eins og vanalega og reyna aftur, eða fara í ítarlega ræsingu og velja úrræðaleit.
  \resources\PBR_ErrorRedirectedProfiles_Header:
    Candidate Language=IS-IS: Ekki er hægt að endurstilla þessa tölvu og halda skránum þínum
  \resources\PBR_ErrorRedirectedProfiles_Desc\Text:
    Candidate Language=IS-IS: Til að hægt sé að endurstilla tölvuna þurfa möppurnar „Notendur“, „Forritsskrár“ og „Windows“ að vera á sama drifi. Þú getur valið að endurstilla þessa tölvu og fjarlægja allar skrár, en fyrst ættir þú að taka öryggisafrit af öllum einkaskrám.
  \resources\PBR_ErrorPayloadVersionMismatch_Desc\Text:
    Candidate Language=IS-IS: Niðurhalið er ógilt. Reyndu aftur og veldu staðbundna enduruppsetningu.
  \resources\PBR_ErrorPayloadDownload_Desc\Text:
    Candidate Language=IS-IS: Niðurhalið var truflað. Athugaðu tenginguna og reyndu aftur eða veldu staðbundna enduruppsetningu.
  \resources\PBR_ErrorPayloadConnection_Desc\Text:
    Candidate Language=IS-IS: Ekki er hægt að tengjast þjóninum. Athugaðu tenginguna og reyndu aftur eða veldu staðbundna enduruppsetningu.
  \resources\PBR_ErrorNotSupportedInEdition_Desc\Text:
    Candidate Language=IS-IS: Þessi útgáfa styður ekki valinn endurheimtarvalkost. Reyndu aftur með öðrum valkosti.
  \resources\PBR_ErrorNoRecoveryEnv_Header:
    Candidate Language=IS-IS: Endurheimt fannst ekki
  \resources\PBR_ErrorNoRecoveryEnv_Desc\Text:
    Candidate Language=IS-IS: Settu geymslumiðilinn fyrir uppsetningu eða endurheimt Windows í og endurræstu tölvuna af geymslumiðlinum.
  \resources\PBR_ErrorNoPayload_Desc\Text:
    Candidate Language=IS-IS: Ekkert niðurhal tiltækt. Reyndu aftur og veldu staðbundna enduruppsetningu.
  \resources\PBR_ErrorNoPayloadSupport_Desc\Text:
    Candidate Language=IS-IS: Þessar endurheimtaraðstæður styðja ekki niðurhalsvalkost í skýinu. Reyndu aftur og veldu staðbundna enduruppsetningu.
  \resources\PBR_ErrorNoDeownlevelEnv_Desc\Text:
    Candidate Language=IS-IS: Ef þú ert með geymslumiðil fyrir uppsetningu eða endurheimt Windows skaltu setja hann í og endurræsa tölvuna af geymslumiðlinum.
  \resources\PBR_ErrorInsufficientSpace_Line3\Text:
    Candidate Language=IS-IS: •  Forrit eru fjarlægð
  \resources\PBR_ErrorInsufficientSpace_Line2\Text:
    Candidate Language=IS-IS: •  Afrita skrár yfir á annað tæki og eyða þeim af þessari tölvu
  \resources\PBR_ErrorInsufficientSpace_Line1\Text:
    Candidate Language=IS-IS: •  Disktiltekt er keyrð
  \resources\PBR_ErrorInsufficientSpace_Line0\Text:
    Candidate Language=IS-IS: Til að losa diskpláss er hægt að:
  \resources\PBR_ErrorInsufficientSpace_Header:
    Candidate Language=IS-IS: Diskrými vantar
  \resources\PBR_ErrorInsufficientSpace_Desc:
    Candidate Language=IS-IS: %1!ws! af lausu diskplássi þarf til viðbótar á (%2!ws!).
  \resources\PBR_ErrorFileNotTrust_Desc\Text:
    Candidate Language=IS-IS: Umbeðnar skrár eru ekki traustar. Vottorð skránna gæti verið útrunnið eða einhver annar gæti hafa breytt skránum.
  \resources\PBR_ErrorDisabled_Desc\Text:
    Candidate Language=IS-IS: Regla stofnunarinnar/fyrirtækisins þíns leyfir þetta ekki. Leitaðu nánari upplýsinga hjá stuðningsaðila eða tölvudeildinni.
  \resources\PBR_ErrorCloud_Header:
    Candidate Language=IS-IS: Vandamál kom upp við að hlaða niður
  \resources\PBR_ErrorCant_Header:
    Candidate Language=IS-IS: Ekki er hægt að endurstilla þessa tölvu
  \resources\PBR_DataWarning_Format:
    Candidate Language=IS-IS: Niðurhal úr skýi getur notað meira en 4 GB af gögnum.
