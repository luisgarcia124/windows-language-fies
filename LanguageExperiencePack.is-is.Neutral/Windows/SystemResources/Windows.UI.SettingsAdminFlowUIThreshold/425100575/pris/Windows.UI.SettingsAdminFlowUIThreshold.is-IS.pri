    Candidate Language=IS-IS: Þetta tekur ekki langan tíma
  \resources\PBR_Reset:
    Candidate Language=IS-IS: Endurstilla
  \resources\PBR_RemovedAppsList_Header:
    Candidate Language=IS-IS: Listi yfir forrit sem verða fjarlægð
  \resources\PBR_RemovedAppsList_Desc\Text:
    Candidate Language=IS-IS: Þú getur sett mörg forrit upp aftur beint úr Microsoft Store en eftirfarandi forrit þarftu að setja upp af vefnum eða af uppsetningardiskum. Þessi forritalisti verður vistaður á skjáborðinu eftir endurstillingu.
  \resources\PBR_Note\Text:
    Candidate Language=IS-IS: Athugaðu:
  \resources\PBR_MultipleUsersWarning_Header:
    Candidate Language=IS-IS: Aðrir eru skráðir inn á þessa tölvu
  \resources\PBR_MultipleUsersWarning_Desc\Text:
    Candidate Language=IS-IS: Viltu halda áfram? Aðrir gætu glatað óvistuðum gögnum.
  \resources\PBR_MeteredDataWarning_Format:
    Candidate Language=IS-IS: Niðurhal úr skýi getur notað meira en 4 GB af gögnum. Tengingin þín er mæld og gjöld kunna að vera innheimt.
  \resources\PBR_LearnMore_Text\Text:
