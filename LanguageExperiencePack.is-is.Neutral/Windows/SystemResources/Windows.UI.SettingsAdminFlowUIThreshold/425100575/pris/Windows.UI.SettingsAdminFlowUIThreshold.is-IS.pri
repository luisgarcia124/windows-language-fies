    Candidate Language=IS-IS: Heiti útilokunar: 
  \resources\EulaContent\[using:Windows.UI.Xaml.Automation]AutomationProperties\Name:
    Candidate Language=IS-IS: Leyfisskilmálar Microsoft-hugbúnaðar
  \resources\EnterProductKey_UpgradeProgressText:
    Candidate Language=IS-IS: %d%% lokið
  \resources\EnterProductKey_UpgradeProgressInstructionsText:
    Candidate Language=IS-IS: Þetta getur tekið dálitla stund. Ekki slökkva á tölvunni.
  \resources\EnterProductKey_UpgradeProgressHeaderText:
    Candidate Language=IS-IS: Undirbýr uppfærslu
  \resources\EnterProductKey_UpgradePageHeaderText:
    Candidate Language=IS-IS: Uppfæra þína útgáfu af Windows
  \resources\EnterProductKey_UpgradeInstructions2Text:
    Candidate Language=IS-IS: Þessi uppfærsla gæti tekið nokkra stund og tækið verður endurræst. Þú getur ekki notað tækið fyrr en að þessu loknu.
  \resources\EnterProductKey_UpgradeInstructions1Text:
    Candidate Language=IS-IS: Uppfærslan á Windows mun bæta nokkrum eiginleikum við stýrikerfið. Áður en þú hefst handa skaltu gæta þess að vista skjöl og loka öllum forritum.
  \resources\EnterProductKey_UpgradeGvlkWarningText:
    Candidate Language=IS-IS: Til að virkja þennan virkjunarlykil eftir að þú uppfærir þína útgáfu af Windows þarf að tengja þetta tæki við virkjunarþjónustu stofnunarinnar/fyrirtækisins.
  \resources\EnterProductKey_UpgradeErrorText:
    Candidate Language=IS-IS: Ekki tókst að uppfæra þína útgáfu af Windows. Reyndu aftur að uppfæra þína útgáfu af Windows. (0x%08x)
  \resources\EnterProductKey_UpgradeErrorHeaderText:
    Candidate Language=IS-IS: Ekki er hægt að uppfæra útgáfuna þína
  \resources\EnterProductKey_UpgradeButtonText:
    Candidate Language=IS-IS: Byrja
  \resources\EnterProductKey_PlaceholderText:
    Candidate Language=IS-IS: XXXXX-XXXXX-XXXXX-XXXXX-XXXXX
  \resources\EnterProductKey_LabelText:
    Candidate Language=IS-IS: Virkjunarlykill
  \resources\EnterProductKey_InvalidKey:
    Candidate Language=IS-IS: Virkjunarlykillinn sem þú slóst inn virkaði ekki. Athugaðu virkjunarlykilinn og reyndu aftur eða sláðu inn annan lykil. (0x%08x)
  \resources\EnterProductKey_InvalidCharacters:
    Candidate Language=IS-IS: Sumir þessara stafa mega ekki vera í virkjunarlyklinum.
  \resources\EnterProductKey_InstructionsText:
    Candidate Language=IS-IS: Virkjunarlykillinn ætti að vera í tölvupósti frá þeim sem seldi þér Windows eða dreifði því til þín, eða á kassanum sem DVD-diskurinn eða USB-lykilinn fyrir Windows kom í.
  \resources\EnterProductKey_HeaderText:
    Candidate Language=IS-IS: Slá inn virkjunarlykil
  \resources\EnterProductKey_GvlkWarningText:
    Candidate Language=IS-IS: Til að virkja þennan virkjunarlykil þarf að tengja þetta tæki við virkjunarþjónustu stofnunarinnar/fyrirtækisins.
  \resources\EnterProductKey_GoToStoreErrorText:
    Candidate Language=IS-IS: Ekki er hægt að opna Microsoft Store eins og er. Reyndu aftur síðar.
  \resources\EnterProductKey_GoToStoreDescriptionText:
    Candidate Language=IS-IS: Einnig er hægt að virkja þetta tæki með því að fara í Microsoft Store og kaupa ósvikið eintak af Windows.
  \resources\EnterProductKey_GoToStoreButtonText:
    Candidate Language=IS-IS: Fara í Microsoft Store
  \resources\EnterProductKey_EulaLinkText:
    Candidate Language=IS-IS: Lesa leyfisskilmála Microsoft-hugbúnaðar
  \resources\EnterProductKey_EulaErrorText:
    Candidate Language=IS-IS: Ekki er hægt að hlaða inn leyfisskilmálum Microsoft-hugbúnaðar sem stendur. Reyndu aftur síðar. (0x%08x)
  \resources\EnterProductKey_Error_WrongSku:
    Candidate Language=IS-IS: Þú ert að nota %WINDOWS_LONG%. Ekki er hægt að nota virkjunarlykilinn sem þú slóst inn til að virkja þessa útgáfu. (0x%08x)
  \resources\EnterProductKey_Error_UsedProductKey:
    Candidate Language=IS-IS: Ekki er hægt að virkja Windows í þessu tæki vegna þess að virkjunarlykillinn sem þú slóst inn hefur þegar verið notaður í öðru tæki. Sláðu inn annan virkjunarlykil. (0x%08x)
  \resources\EnterProductKey_Error_ServiceDown:
