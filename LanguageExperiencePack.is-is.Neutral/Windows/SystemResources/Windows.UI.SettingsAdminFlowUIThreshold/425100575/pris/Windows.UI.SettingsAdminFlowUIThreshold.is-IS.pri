  \resources\RenamePC_AAD_UPDATE_FAIL_ErrorText:
    Candidate Language=IS-IS: Ekki er hægt að uppfæra heiti tölvunnar í Azure Active Directory.
  \resources\RemoveUser_HeaderText:
    Candidate Language=IS-IS: Eyða reikningi og gögnum?
  \resources\RemoveUser_GeneralErrorText:
    Candidate Language=IS-IS: Ekki er hægt að fjarlægja valinn notanda að fullu. Viss gögn frá notandanum kunna enn að vera á diskinum.
  \resources\RemoveUser_DeleteUserButtonText:
    Candidate Language=IS-IS: Eyða reikningi og gögnum
  \resources\RemoveUser_BodyText:
    Candidate Language=IS-IS: Ef þú eyðir reikningi þessa notanda verða öll gögn hans á þessari tölvu fjarlægð, þar á meðal atriði á skjáborðinu, sótt efni, skjöl, myndir, tónlist og aðrar skrár. Þessi gögn glatast ef ekki hefur verið tekið öryggisafrit af þeim eða þau vistuð á öðrum stað, svo sem á annarri tölvu.
  \resources\RemoveUserLoggedIn_HeaderText:
    Candidate Language=IS-IS: Ekki er hægt að eyða reikningnum
  \resources\RemoveUserLoggedIn_BodyText:
    Candidate Language=IS-IS: Þessi notandi þarf að skrá sig út áður en hægt er að eyða reikningi hans. Einnig er hægt að endurræsa tölvuna til að skrá hann út sjálfkrafa.
  \resources\RemoveFamilyUser_HeaderText:
    Candidate Language=IS-IS: Fjarlægja þennan fjölskyldumeðlim úr tækinu
  \resources\RemoveFamilyUser_BodyText:
    Candidate Language=IS-IS: Ef þú fjarlægir þennan fjölskyldumeðlim úr þessu tæki verður viðkomandi áfram í fjölskylduhópnum þínum. Gögn viðkomandi verða aðeins fjarlægð úr þessu tæki. Því skaltu tryggja að afrit af hlutum á borð við skjáborðsatriði, niðurhal, skjöl, myndir og tónlist séu til á öðrum stað. Nýir fjölskyldumeðlimir munu ekki lengur geta skráð sig sjálfkrafa inn í tækið.
  \resources\RemoveExclusion_HeaderText:
    Candidate Language=IS-IS: Fjarlægja útilokun
  \resources\RemoveExclusion_BodyText:
    Candidate Language=IS-IS: Viltu örugglega fjarlægja þessa útilokun?
  \resources\RemoveDomainUser_HeaderText:
    Candidate Language=IS-IS: Fjarlægja reikning
  \resources\RemoveDomainUser_DeleteUserButtonText:
    Candidate Language=IS-IS: Fjarlægja
  \resources\RemoveDomainUser_BodyText:
    Candidate Language=IS-IS: Ef þú fjarlægir aðgang þessa reiknings geturðu hugsanlega ekki notað hann til að skrá þig inn á þessa tölvu.
  \resources\RemoteDesktop_WindowTitle:
    Candidate Language=IS-IS: Stillingar fjartengds skjáborðs
  \resources\RemoteDesktop_RegistryError_HeaderText:
