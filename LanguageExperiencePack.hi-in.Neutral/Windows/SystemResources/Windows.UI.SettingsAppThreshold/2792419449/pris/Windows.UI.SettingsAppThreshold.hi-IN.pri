  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_DataRoamingWarning:
    Candidate Language=HI-IN: आपके सेवा अनुबंध के आधार पर, आपका डिवाइस रोमिंग में होने के दौरान आपको ईमेल करने, त्वरित संदेश भेजने, पाठ संदेश में फ़ाइलें भेजने या वेब ब्राउज़ करने के लिए अधिक भुगतान करना पड़ सकता है.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_DataRoamingEnabledLabelDescription:
    Candidate Language=HI-IN: रोमिंग क्षेत्र में प्रवेश करने पर, आपका डेटा कनेक्शन बंद हो जाएगा.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_DataRoamingEnabledLabelATTSpecificedDescription:
    Candidate Language=HI-IN: संयुक्त राज्य, प्यूर्टो रिको और यूनाइटेड स्टेट्‍स वर्जिन आइलैंड्स के बाहर डेटा के उपयोग पर अंतर्राष्ट्रीय डेटा रोमिंग शुल्क लागू होते हैं. अंतर्राष्ट्रीय डेटा रोमिंग शुल्क से बचने के लिए रोमिंग की अनुमति न दें.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_DataRoamingEnabledDescription:
    Candidate Language=HI-IN: डेटा रोमिंग
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_DataRoamingDescription:
