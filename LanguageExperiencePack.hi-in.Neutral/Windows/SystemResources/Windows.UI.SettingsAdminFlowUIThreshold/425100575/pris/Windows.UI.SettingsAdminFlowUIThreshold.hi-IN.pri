  \resources\Uninstall_NewProfile_Header:
    Candidate Language=HI-IN: नए खाते हटाएँ
  \resources\Uninstall_NewProfile_FormatMany:
    Candidate Language=HI-IN: आपने %d खाते बनाए:
  \resources\Uninstall_NewProfile_Desc\Text:
    Candidate Language=HI-IN: इससे पहले कि आप Windows के पिछले संस्करण पर वापस जा सकें, आपको अपने सबसे हाल ही के नवीनीकरण के बाद आपके द्वारा जोड़े गए सभी उपयोगकर्ता खातों को निकालना होगा. खातों को उनकी प्रोफ़ाइल सहित पूरी तरह से निकालना होगा.
  \resources\Uninstall_MovedProfile_One:
    Candidate Language=HI-IN: आपके द्वारा एक खाता ले जाया गया:
  \resources\Uninstall_MovedProfile_Header:
    Candidate Language=HI-IN: खातों को वापस ले जाएँ
  \resources\Uninstall_MovedProfile_FormatMany:
    Candidate Language=HI-IN: आपके द्वारा %d खाते ले जाए गए:
  \resources\Uninstall_MovedProfile_Desc\Text:
    Candidate Language=HI-IN: इससे पहले कि आप Windows के किसी पिछले संस्करण पर वापस जा सकें, आपको अपने सबसे हाल ही के नवीनीकरण के बाद ले जाए गए किसी भी उपयोगकर्ता खाते को उसके मूल स्थान पर रखना होगा.
  \resources\Uninstall_MissingExternal_Desc\Text:
    Candidate Language=HI-IN: हम आपको Windows के पिछले संस्करण में वापस नहीं ले जा सकते क्योंकि आपके सबसे हाल ही के नवीनीकरण को दौरान प्रयुक्त USB फ़्लैश या अन्य बाहरी ड्राइव अनुपलब्ध है. कृपया डिस्क सम्मिलित करें और दुबारा कोशिश करें.
  \resources\Uninstall_InsufficientSpace_Format:
    Candidate Language=HI-IN: वापस जाने के लिए, आपको उस ड्राइव पर %ws रिक्त स्थान की आवश्यकता है जहाँ Windows स्थापित है.
  \resources\Uninstall_InsufficientSpace_Desc\Text:
    Candidate Language=HI-IN: कुछ स्थान रिक्त करें और दुबारा कोशिश करें.
