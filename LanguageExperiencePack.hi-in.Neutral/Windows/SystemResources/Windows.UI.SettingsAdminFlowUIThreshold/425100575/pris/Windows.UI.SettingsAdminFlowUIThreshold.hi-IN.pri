  \resources\Lockdown_SignOutWarningText:
    Candidate Language=HI-IN: यदि चयनित खाते में साइन इन किया गया है, तो परिवर्तनों को लागू करने के लिए आपको साइन आउट करके और फिर से साइन इन करना होगा. असाइन की गई पहुँच वाला साइन इन किया गया खाता साइन आउट हो जाएगा.
  \resources\LockdownUser_HeaderText:
    Candidate Language=HI-IN: कोई खाता चुनें
  \resources\LockdownUser_EmptyListText:
