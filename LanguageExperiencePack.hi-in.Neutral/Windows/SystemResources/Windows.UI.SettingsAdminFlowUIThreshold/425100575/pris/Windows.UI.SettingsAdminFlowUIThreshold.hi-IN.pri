  \resources\RemoveUser_DeleteUserButtonText:
    Candidate Language=HI-IN: खाता और डेटा हटाएँ
  \resources\RemoveUser_BodyText:
    Candidate Language=HI-IN: इस व्यक्ति का खाता हटाने से इस PC से उनके डेस्कटॉप के आइटम्स, डाउनलोड्स, दस्तावेज़, फ़ोटोज़, संगीत, और अन्य फ़ाइल्स सहित उनका संपूर्ण डेटा निकल जाएगा. यदि इस डेटा का बैक अप नहीं लिए जाने या अन्‍य स्‍थान जैसे अन्‍य PC पर नहीं सहेजे जाने पर, यह गुम हो जाएगा.
  \resources\RemoveUserLoggedIn_HeaderText:
