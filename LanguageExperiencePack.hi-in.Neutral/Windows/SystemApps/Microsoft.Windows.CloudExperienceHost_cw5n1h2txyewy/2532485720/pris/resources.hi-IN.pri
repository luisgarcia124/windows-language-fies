  \personalDataExport\PrivacyTitle:
    Candidate Language=HI-IN: Microsoft गोपनीयता कथन
  \personalDataExport\PrivacyStatementUrl:
    Candidate Language=HI-IN: https://go.microsoft.com/fwlink/?linkid=850749
  \personalDataExport\PrivacyLinkDisplayText:
    Candidate Language=HI-IN: https://aka.ms/privacy
  \personalDataExport\Paragraph3:
    Candidate Language=HI-IN: Microsoft, Microsoft गोपनीयता कथन के अनुसार आपके डेटा को संसाधित और स्थानांतरित करेगा.
  \personalDataExport\Paragraph2:
    Candidate Language=HI-IN: अगर आप इस डेटा स्थानांतरण से सहमत नहीं हैं, तो आप उत्पाद का उपयोग बंद करना चुन सकते हैं. रिफ़ंड योग्यता के लिए अपने उत्पाद के उपयोग की शर्तें देखें.
  \personalDataExport\Paragraph1:
    Candidate Language=HI-IN: इस उत्पाद के अपेक्षानुसार कार्य करने के लिए, Microsoft को संसाधन के लिए आपके डेटा को आपके देश या क्षेत्र के बाहर स्थित Microsoft डेटा केंद्र में स्थानांतरित करना होगा. इस उत्पाद का उपयोग जारी रखकर, आप इस डेटा स्थानांतरण के लिए सहमत हैं.
  \personalDataExport\PageTitle:
    Candidate Language=HI-IN: आपका डेटा आपके देश या क्षेत्र के बाहर संसाधित किया जाएगा
  \personalDataExport\NextButtonText:
    Candidate Language=HI-IN: अगला
  \personalDataExport\NavigationError:
    Candidate Language=HI-IN: ऐसा लगता है कि हमें कुछ कनेक्टिविटी संबंधी समस्याएँ आ रही हैं - हो सकता है कि आप इंटरनेट से कनेक्ट न हों, या हमारी ओर से कोई समस्या है.<ul><li>इस बारे में अधिक जानने के लिए कि चीन से इस Microsoft उत्पाद का उपयोग करने पर आपके डेटा को क्यों किसी अन्य देश में स्थानांतरित करने की आवश्यकता है, किसी भी डिवाइस पर किसी भी ब्राउज़र के एड्रैस बार में https://aka.ms/productslist लिखें.</li><br/><li>गोपनीयता और Microsoft उत्पादों के बारे में अधिक जानकारी के लिए, https://aka.ms/privacy पर Microsoft गोपनीयता कथन देखें.</li></ul>
