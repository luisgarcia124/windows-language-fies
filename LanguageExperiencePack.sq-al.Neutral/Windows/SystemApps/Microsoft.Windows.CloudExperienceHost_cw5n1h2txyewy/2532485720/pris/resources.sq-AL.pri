  \hololensDiagnostics\PrivacyStatementLink:
    Candidate Language=SQ-AL: Deklarata e privatësisë
  \hololensDiagnostics\PrivacyHeadline:
    Candidate Language=SQ-AL: Deklarata e privatësisë
  \hololensDiagnostics\PrivacyBody:
    Candidate Language=SQ-AL: Mëso më shumë se çfarë mbledhim duke shtypur https://aka.ms/privacy në shiritin e adresës së çdo shfletuesi në çdo pajisje.
  \hololensDiagnostics\NextButton:
    Candidate Language=SQ-AL: Mblidh informacionet
  \hololensDiagnostics\Instruction4:
    Candidate Language=SQ-AL: 4. Pasi të kesh ruajtur skedarët, kthehu përsëri këtu dhe përzgjidh U krye. Kjo do t'i heqë skedarët nga HoloLens.
  \hololensDiagnostics\Instruction3:
    Candidate Language=SQ-AL: 3. Kopjo skedarët e diagnostikimit të HoloLens në kompjuterin tënd.
  \hololensDiagnostics\Instruction2:
    Candidate Language=SQ-AL: 2. Në kompjuterin tënd, prano shenjat e gatishmërisë për të hapur Eksploruesin e skedarëve.
  \hololensDiagnostics\Instruction1:
    Candidate Language=SQ-AL: 1. Lidh pajisjen HoloLens me kompjuterin tënd.
  \hololensDiagnostics\Instruction0:
    Candidate Language=SQ-AL: Për të ruajtur informacionet e diagnostikimit në kompjuterin tënd:
  \hololensDiagnostics\ContinueButton:
    Candidate Language=SQ-AL: U krye
  \hololensDiagnostics\CancelButton:
    Candidate Language=SQ-AL: Anulo
  \hololensDiagnostics\BodyTroubleshooting:
    Candidate Language=SQ-AL: Informacionet e diagnostikimit mund të ndihmojnë për të zgjidhur këtë problem me hyrjen. Pasi të mblidhen, ato do të jenë në dispozicion për çdo person që ka qasje në këtë pajisje. Do të kesh po ashtu mundësinë për t'i ruajtur në kompjuterin tënd që të mund t'ia dërgosh administratorit tënd ose Microsoft.
  \hololensDiagnostics\BodySuccess:
    Candidate Language=SQ-AL: Pasi të kesh ruajtur informacionet në kompjuterin tënd, dërgoja ato administratorit tënd ose përfshiji kur të kontaktosh me ekipin e mbështetjes.
  \hololensDiagnostics\BodyError:
    Candidate Language=SQ-AL: Nuk arritëm të përgatitnim dhe të mblidhnim evidencat e diagnostikimit. Provo një llogari tjetër.
  \hololensDiagnostics\Body:
    Candidate Language=SQ-AL: Provo përsëri ose përzgjidh Anulo për ta parametrizuar më vonë pajisjen.
  \hololensDiagnostics\BackButton:
    Candidate Language=SQ-AL: Prapa
  \hololensAccount\UserPlaceholder:
    Candidate Language=SQ-AL: dikush@example.com
  \hololensAccount\Title:
    Candidate Language=SQ-AL: Hyr me llogarinë tënde të punës
  \hololensAccount\PasswordTitle:
    Candidate Language=SQ-AL: Fut fjalëkalimin
  \hololensAccount\PasswordPlaceholder:
    Candidate Language=SQ-AL: Fjalëkalimi
  \hololensAccount\NextButton:
    Candidate Language=SQ-AL: Tjetër
  \hololensAccount\LeadText:
    Candidate Language=SQ-AL: Hyr me të njëjtën llogari që përdor për Office 365 ose shërbimet e tjera të biznesit nga Microsoft. Organizata jote mund të grumbullojë informacion rreth teje, të instalojë ose të heqë aplikacione, të ndryshojë parametra ose të çaktivizojë tipare, të fshijë përmbajtje ose të rivendosë pajisjen tënde.
  \hololensAccount\Error_UsernameFormat:
    Candidate Language=SQ-AL: Kjo nuk duket si adresë emaili pune ose shkolle. Përdor një adresë tjetër emaili.
  \hololensAccount\Error_UserExists:
    Candidate Language=SQ-AL: Ekziston tashmë një përdorues me këtë adresë emaili
  \hololensAccount\Error_NoUsername:
    Candidate Language=SQ-AL: Fut emrin e përdoruesit
  \hololensAccount\Error_Creating_Account_Warning:
    Candidate Language=SQ-AL: Diçka nuk shkoi mirë.
  \hololensAccount\BackButton:
    Candidate Language=SQ-AL: Prapa
  \hello\WindowsHelloAnimationAltText:
    Candidate Language=SQ-AL: Animimi i Windows Hello
  \hello\TitleFingerprint:
    Candidate Language=SQ-AL: Përdor gjurmën e gishtit për të hyrë më shpejt dhe në mënyrë më të sigurt
  \hello\TitleFaceFingerprint:
    Candidate Language=SQ-AL: Hyr më shpejt dhe në mënyrë më të sigurt
  \hello\TitleFace:
    Candidate Language=SQ-AL: Përdor fytyrën tënde për të hyrë më shpejt dhe në mënyrë më të sigurt
  \hello\SkipLink:
    Candidate Language=SQ-AL: Kapërceje për momentin
  \hello\LeadTextFingerprint:
    Candidate Language=SQ-AL: Përzgjidhe ose thuaj <strong>Vazhdo</strong> për të konfiguruar Windows Hello.
  \hello\LeadTextFaceFingerprint:
    Candidate Language=SQ-AL: Zgjidh se cilin opsion dëshiron të përdorësh për të hyrë në Windows. Mund të thuash <strong>Fytyra</strong> ose <strong>Gjurma e gishtit</strong> për të nisur Windows Hello.
  \hello\LeadTextFace:
    Candidate Language=SQ-AL: Përzgjidhe ose thuaj <strong>Vazhdo</strong> për të konfiguruar Windows Hello.
  \hello\FingerprintButton:
    Candidate Language=SQ-AL: Përdor një gjurmë g&ishti
  \hello\FaceButton:
    Candidate Language=SQ-AL: Përdor f&ytyrën time
  \hello\ContinueButton:
    Candidate Language=SQ-AL: &Vazhdo
  \hello\BodyTextFingerprint:
    Candidate Language=SQ-AL: Pajisja jote ka një sensor të gjurmës së gishtit që funksionon me Windows Hello, duke të dhënë një mënyrë të thjeshtë dhe pa fjalëkalim për vërtetimin e identitetit tënd.
  \hello\BodyTextFace:
    Candidate Language=SQ-AL: Kamera jote funksionon me Windows Hello për të të njohur ty, duke të dhënë një mënyrë vërtetimi të identitetit tënd të thjeshtë dhe pa fjalëkalim.
  \hello\BodyFingerprintOptionCaption:
    Candidate Language=SQ-AL: Gjurma e gishtit
  \hello\BodyFaceOptionCaption:
    Candidate Language=SQ-AL: Njohja e fytyrës
