  \errors\NoNetworkVoiceOver:
    Candidate Language=SQ-AL: You will need the Internet for this. It does not look like you are connected to the Internet. Check your connection and try again.
  \errors\NoNetworkMsaTitle:
    Candidate Language=SQ-AL: Do të të duhet interneti për këtë.
  \errors\NoNetworkMsaText:
    Candidate Language=SQ-AL: Me sa duket nuk je i lidhur me internetin. Kontrollo lidhjen tënde dhe provo përsëri.
  \errors\NavigationBlockedVoiceOver:
    Candidate Language=SQ-AL: We cannot open that page right now. For security reasons, you will need to visit the page from a browser or a different device.
  \errors\NavigationBlockedTitle:
    Candidate Language=SQ-AL: Nuk mund ta hapim atë faqe tani.
  \errors\NavigationBlockedText:
    Candidate Language=SQ-AL: Për çështje sigurie, do të duhet të vizitosh faqen nga një shfletues ose pajisje tjetër. Nëse mendon se ke arritur këtë faqe për shkak të një gabimi, tregoji mbështetjes së organizatës tënde për TI-në se nuk mund të qasesh në {0}
  \errors\LocalAccount:
    Candidate Language=SQ-AL: Kapërce
  \errors\GenericVoiceOver:
    Candidate Language=SQ-AL: Something went wrong. Please try again later.
