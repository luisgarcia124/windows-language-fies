  \oobeCortana\cortanaSubHeading_newUwp:
    Candidate Language=SQ-AL: Për ta bërë këtë, Cortana ka nevojë për qasje në disa prej informacioneve të tua personale
  \oobeCortana\cortanaSubHeading_A:
    Candidate Language=SQ-AL: Të gjithë e meritojnë e një asistente personale. Cortana rastis të jetë digjitale.
  \oobeCortana\cortanaSubHeadingVoiceOver:
    Candidate Language=SQ-AL: Hej shiko, jam unë, Cortana! A më jep leje ta përdor informacionin që më nevojitet për ta bërë punën sa më mirë?
  \oobeCortana\cortanaSubHeading:
    Candidate Language=SQ-AL: Hej shiko, jam unë, Cortana! <br/>A më jep leje ta përdor informacionin që më nevojitet për ta bërë punën sa më mirë?
  \oobeCortana\cortanaLogoAlt_globalConsent:
    Candidate Language=SQ-AL: Cortana mund të të ndihmojë të menaxhosh kohën, të realizosh gjërat dhe të qëndrosh i lidhur. Përdor Cortana për të kontrolluar kalendarin, vendosur rikujtesat, luajtur muzikë, si dhe për të marrë përgjigjet kur të nevojiten.
