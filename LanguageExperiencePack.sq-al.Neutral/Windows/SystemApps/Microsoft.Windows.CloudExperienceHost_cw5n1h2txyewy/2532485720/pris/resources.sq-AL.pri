  \personalDataExport\PrivacyTitle:
    Candidate Language=SQ-AL: Deklarata e privatësisë e Microsoft
  \personalDataExport\PrivacyStatementUrl:
    Candidate Language=SQ-AL: https://go.microsoft.com/fwlink/?linkid=850749
  \personalDataExport\PrivacyLinkDisplayText:
    Candidate Language=SQ-AL: https://aka.ms/privacy
  \personalDataExport\Paragraph3:
    Candidate Language=SQ-AL: Microsoft do të përpunojë dhe do të transferojë të dhënat e tua në përputhje me Deklaratën e privatësisë të Microsoft.
  \personalDataExport\Paragraph2:
    Candidate Language=SQ-AL: Nëse nuk pajtohesh me këtë transferim të të dhënave, mund të zgjedhësh të mos e përdorësh produktin. Për rimbursueshmërinë, referoju kushteve të përdorimit për produktin tënd.
  \personalDataExport\Paragraph1:
    Candidate Language=SQ-AL: Që ky produkt të funksionojë siç pritej, Microsoft duhet të transferojë të dhënat e tua për përpunim në një qendër të të dhënave të Microsoft, që ndodhet jashtë vendit ose rajonit tënd. Duke vazhduar ta përdorësh këtë produkt, ti pajtohesh me këtë transferim të të dhënave.
  \personalDataExport\PageTitle:
    Candidate Language=SQ-AL: Të dhënat e tua do të përpunohen jashtë vendit apo rajonit tënd
  \personalDataExport\NextButtonText:
    Candidate Language=SQ-AL: Pasardhëse
  \personalDataExport\NavigationError:
    Candidate Language=SQ-AL: Me sa duket kemi disa probleme me lidhshmërinë. Mund të mos jesh i lidhur me internetin ose ka një problem në anën tonë.<ul><li>Për të mësuar më shumë se përse, kur e përdor këtë produkt të Microsoft, të dhënat e tua duhet të transferohen nga Kina në një vend tjetër, shtyp https://aka.ms/productslist në shiritin e adresës të cilitdo shfletues dhe në cilëndo pajisje.</li><br/><li>Për më shumë informacion në lidhje me privatësinë dhe produktet e Microsoft, shih Deklaratën e privatësisë të Microsoft në https://aka.ms/privacy.</li></ul>
  \personalDataExport\LearnMoreLinkText:
    Candidate Language=SQ-AL: Mëso më shumë për opsionet në lidhje me të dhënat
  \personalDataExport\LearnMoreDataTransferUrl:
    Candidate Language=SQ-AL: https://go.microsoft.com/fwlink/?linkid=2214603
  \personalDataExport\LearnMoreButtonText:
    Candidate Language=SQ-AL: Mëso më shumë
  \personalDataExport\ContinueButtonText:
