  \retailDemo\shutdownTextOnline:
    Candidate Language=SQ-AL: Koha e ndalimit të punës për këtë pajisje konfigurohet përmes shërbimit në renë kompjuterike të përvojës së demonstrimit të shitjes me pakicë
  \retailDemo\shutdownText:
