  \resources\SystemSettings_Language_CHSPinyinIME_IsVModeEnabledDescription:
    Candidate Language=SQ-AL: Përdor regjimin V për të futur numrin, datën dhe orën etj. në formatin kinez. Kur je në regjimin Pinyin të dyfishtë, regjimi V mund të aktivizohet nga ": + r"
  \resources\SystemSettings_Language_CHSPinyinIME_IsUModeEnabledDescription:
    Candidate Language=SQ-AL: Përdor regjimin U për të futur karakterin kinez duke u bazuar në vijën ose përbërësin e tij, ose për të futur simbolin. Kur je në regjimin Pinyin të dyfishtë, regjimi U mund të aktivizohet nga Shift+u
  \resources\SystemSettings_Language_CHSPinyinIME_IsSuperAbbreviatedPinyinEnabledDescription:
    Candidate Language=SQ-AL: Pinyin super i shkurtuar
  \resources\SystemSettings_Language_CHSPinyinIME_IsSmartSelfLearningEnabledDescription:
    Candidate Language=SQ-AL: Nxirr automatikisht fraza nga dokumentet që po redakton dhe që ke redaktuar së fundi (Këto fraza përdoren vetëm në hyrjen tënde aktuale për të përmirësuar saktësinë; ato nuk do të dërgohen te Microsoft.)
  \resources\SystemSettings_Language_CHSPinyinIME_IsSelfLearningEnabledDescription:
    Candidate Language=SQ-AL: Aktivizo/çaktivizo funksionin e mësimit autodidakt dhe importo/eksporto frazat e mësuara në mënyrë autodidakte (mbështet vetëm formatet e brendshme të Microsoft)
  \resources\SystemSettings_Language_CHSPinyinIME_IsReadingAutoCorrectionEnabledDescription:
    Candidate Language=SQ-AL: Vetëkorrigjimi i leximit
  \resources\SystemSettings_Language_CHSPinyinIME_IsPeopleNameTipEnabledDescription:
    Candidate Language=SQ-AL: Shfaq automatikisht këshillën e tiparit të hyrjes së emrave të njerëzve
  \resources\SystemSettings_Language_CHSPinyinIME_IsPeopleNameEnabledDescription:
    Candidate Language=SQ-AL: Gjatë shkrimit në "pinyin", përdor "pikëpresjen + r" për të kaluar në modalitet shkrimi të emrave të njerëzve. Kur të jesh në modalitet "pinyin" dyshe, shtyp "Shift + tastin e pikëpresjes" dhe pastaj "r" për të kaluar në modalitet shkrimi të emrave të njerëzve
  \resources\SystemSettings_Language_CHSPinyinIME_IsOutputCharsetSwitchKeyEnabledDescription:
    Candidate Language=SQ-AL: Ndërrimi i hyrjes së kinezishtes tradicionale/të thjeshtuar
  \resources\SystemSettings_Language_CHSPinyinIME_IsOpenEmoticonSymbolViewKeyEnabledDescription:
    Candidate Language=SQ-AL: Hap panelin e ikonave të emocioneve dhe të simboleve
  \resources\SystemSettings_Language_CHSPinyinIME_IsNumPadInputEnabledDescription:
    Candidate Language=SQ-AL: Tastet e numrave: hyrja e drejtpërdrejtë e numrave në vend të përzgjedhjes së kandidatit
  \resources\SystemSettings_Language_CHSPinyinIME_IsLiveStickerEnabledDescription:
    Candidate Language=SQ-AL: Merr ngjitëset nga reja kompjuterike (kjo do të dërgojë te Microsoft hyrjet e tua në tastierë)
  \resources\SystemSettings_Language_CHSPinyinIME_IsIntelligentPunctuationAdjustmentEnabledDescription:
    Candidate Language=SQ-AL: Vetëpërshtat simbolin e presjes, pikës dhe të dy pikave gjatë futjes së tyre brenda një vargu me shifra
  \resources\SystemSettings_Language_CHSPinyinIME_IsHotkeySwitchCharSetEnabledDescription:
