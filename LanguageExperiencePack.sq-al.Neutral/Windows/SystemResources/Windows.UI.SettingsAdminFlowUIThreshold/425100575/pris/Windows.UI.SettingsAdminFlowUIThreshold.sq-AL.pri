  \resources\RDP_ProtectAccountDenied_BodyText:
    Candidate Language=SQ-AL: Duhet të caktosh kërkesat për vërtetimin (si p.sh. Windows Hello, një fjalëkalim ose një kod PIN) për këtë llogari për të aktivizuar Desktopin në largësi.
  \resources\RDP_ProtectAccountAllowed_BodyText:
    Candidate Language=SQ-AL: Llogaria jote nuk kërkon vërtetimin për të hyrë në këtë kompjuter. Nëse aktivizon Desktopin në largësi pa kërkuar vërtetimin, ti e hap kompjuterin për qasjen e paautorizuar në largësi.
  \resources\RDP_Enable_HeaderText:
