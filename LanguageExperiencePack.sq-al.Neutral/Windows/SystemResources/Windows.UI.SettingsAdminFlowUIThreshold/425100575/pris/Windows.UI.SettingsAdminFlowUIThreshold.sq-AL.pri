  \resources\RDP_Enable_Firewall_Complete_BodyText:
    Candidate Language=SQ-AL: Po hap portën e Desktopit në largësi në murin mbrojtës për të gjitha lidhjet e rrjetit në këtë kompjuter. Nëse dëshiron t´i kufizosh lidhjet për rrjete të përzgjedhura, hap Parametrat e përparuar të murit mbrojtës.
  \resources\RDP_Enable_BodyText:
    Candidate Language=SQ-AL: Ti dhe përdoruesit e përzgjedhur në llogaritë e përdoruesit do të mund të lidheni në largësi me këtë kompjuter.
