  \resources\RemoveUser_HeaderText:
    Candidate Language=SQ-AL: Të fshihet llogaria dhe të dhënat?
  \resources\RemoveUser_GeneralErrorText:
    Candidate Language=SQ-AL: Heqja e plotë e përdoruesit të përzgjedhur është e pamundur. Disa prej të dhënave të përdoruesit mund të vazhdojnë të mbeten në disk.
  \resources\RemoveUser_DeleteUserButtonText:
    Candidate Language=SQ-AL: Fshi llogarinë dhe të dhënat
  \resources\RemoveUser_BodyText:
    Candidate Language=SQ-AL: Heqja e llogarisë së këtij personi do të largojë të gjitha të dhënat e tij nga ky kompjuter, përfshirë njësitë në desktopin e tij, shkarkimet, dokumentet, fotografitë, muzikën dhe skedarët e tjerë. Nëse për këto të dhëna nuk është bëre kopje rezervë apo nuk janë ruajtur në një vendndodhje tjetër, si p.sh. në një kompjuter tjetër, ato do të humbasin.
  \resources\RemoveUserLoggedIn_HeaderText:
    Candidate Language=SQ-AL: Fshirja e llogarisë e pamundur
  \resources\RemoveUserLoggedIn_BodyText:
    Candidate Language=SQ-AL: Ky person duhet të dalë para se të mund të fshish llogarinë e tij. Gjithashtu, mund ta rinisësh kompjuterin për të realizuar daljen automatike të tij.
  \resources\RemoveFamilyUser_HeaderText:
    Candidate Language=SQ-AL: Hiq këtë anëtar të familjes nga pajisja
  \resources\RemoveFamilyUser_BodyText:
    Candidate Language=SQ-AL: Nëse e heq këtë anëtar të familjes nga pajisja, ai do të jetë ende në grupin e familjes. Do të heqim vetëm të dhënat e tij nga pajisja, kështu që sigurohu të krijoni një kopje rezervë të artikujve të tyre të desktopit, shkarkimeve, dokumenteve, fotografive dhe muzikës në një vend tjetër. Anëtarët e familjes të shtuar rishtas nuk do të mund të identifikohen më automatikisht në këtë pajisje.
  \resources\RemoveExclusion_HeaderText:
    Candidate Language=SQ-AL: Hiq përjashtimin
  \resources\RemoveExclusion_BodyText:
    Candidate Language=SQ-AL: Je i sigurt që dëshiron ta heqësh këtë përjashtim?
  \resources\RemoveDomainUser_HeaderText:
    Candidate Language=SQ-AL: Hiq llogarinë
  \resources\RemoveDomainUser_DeleteUserButtonText:
    Candidate Language=SQ-AL: Hiq
  \resources\RemoveDomainUser_BodyText:
