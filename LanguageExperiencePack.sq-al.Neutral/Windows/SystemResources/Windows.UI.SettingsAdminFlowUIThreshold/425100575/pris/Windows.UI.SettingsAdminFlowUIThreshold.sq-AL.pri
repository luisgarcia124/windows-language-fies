  \resources\PBR_ErrorRedirectedProfiles_Header:
    Candidate Language=SQ-AL: Kompjuteri nuk mund të rivendoset dhe të mbahen skedarët
  \resources\PBR_ErrorRedirectedProfiles_Desc\Text:
    Candidate Language=SQ-AL: Për ta rivendosur këtë kompjuter dhe për t’i mbajtur skedarët e tu, direktoritë Përdoruesi, Skedarët e programeve dhe Windows duhet të jenë në të njëjtën njësi të diskut. Në vend të kësaj, mund të zgjedhësh që ta rivendosësh këtë kompjuter dhe t’i heqësh të gjitha, por në fillim duhet të rezervosh skedarët e tu personalë.
  \resources\PBR_ErrorPayloadVersionMismatch_Desc\Text:
