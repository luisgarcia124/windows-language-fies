  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Messaging_SystemGlobal_Group\Description:
    Candidate Language=SQ-AL: Nëse lejon qasjen, njerëzit që përdorin këtë pajisje do të mund të zgjedhin nëse aplikacionet e tyre kanë qasje për të lexuar mesazhet me tekst me ndihmën e parametrave në këtë faqe. Refuzimi i qasjes u bllokon aplikacioneve aftësinë për të lexuar mesazhet.
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Messaging_SystemGlobal_Group2\DisplayName:
    Candidate Language=SQ-AL: Akses tek mesazhimi
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Messaging_SystemGlobal_Group2\AdditionalDescription:
    Candidate Language=SQ-AL: Kur ky parametër është aktiv, kushdo që e përdor këtë pajisje mund të zgjedhë nëse aplikacionet e veta kanë qasje për të lexuar mesazhe me tekst me një lidhje celulare
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_Messaging_AppList_Group\DisplayName:
