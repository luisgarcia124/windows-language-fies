  \resources\TroubleshootActivation_OfflineText:
    Candidate Language=AS-IN: আমি আপোনাৰ Windows-ৰ প্ৰতিলিপি সক্ৰিয় কৰিব নোৱাৰোঁ৷ আপুনি ইণ্টাৰনেটলৈ সংযোজিত হোৱাটো নিশ্চিত কৰক আৰু পুনৰাই চেষ্টা কৰক৷
  \resources\TroubleshootActivation_NoSolutionText:
