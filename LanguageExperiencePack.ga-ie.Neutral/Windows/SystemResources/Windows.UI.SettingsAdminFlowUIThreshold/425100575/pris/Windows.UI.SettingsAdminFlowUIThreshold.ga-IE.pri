  \resources\SetSurfaceHubDeviceAccount_activeSyncPoliciesWarning_Text4:
    Candidate Language=GA-IE: Má roghnaíonn tú leanúint ort gan na beartais a athchumrú, déanfar na gnéithe seo a leanas a dhíchumasú:
  \resources\SetSurfaceHubDeviceAccount_activeSyncPoliciesWarning_Text3:
    Candidate Language=GA-IE: Cinntigh, le do thoil, go bhfuil an beartas DevicePasswordEnabled socraithe ag Bréige. Is féidir an beartas a athchumrú agus iarracht eile a dhéanamh a chinntiú go gcumraítear cuntas an ghléis i gceart agus gur féidir leat seirbhísí Exchange a úsáid.
  \resources\SetSurfaceHubDeviceAccount_activeSyncPoliciesWarning_Text2:
    Candidate Language=GA-IE: •  Beartais ActiveSync nach bhfuil tacú ann dóibh sa ghléas seo
  \resources\SetSurfaceHubDeviceAccount_activeSyncPoliciesWarning_Text1:
    Candidate Language=GA-IE: An cuntas a thug tú dúinn, tá sé cumraithe le:
  \resources\SetSurfaceHubDeviceAccount_activeSyncPoliciesWarning_HeaderText:
    Candidate Language=GA-IE: Tá fadhb leis an gcuntas seo
  \resources\SetGeolocationMaster_DescriptionText:
    Candidate Language=GA-IE: Suíomh an ghléis seo
  \resources\SetFindMyDevice_DescriptionText:
    Candidate Language=GA-IE: Sábháil suíomh mo ghléis go tréimhsiúil
  \resources\RetailDemoConfirm_ReconfigNextButtonText:
    Candidate Language=GA-IE: Athchumraigh
  \resources\RetailDemoConfirm_ReconfigHeaderText:
    Candidate Language=GA-IE: Ní féidir ríomhaire samplach a athchumrú
  \resources\RetailDemoConfirm_ReconfigBodyText:
    Candidate Language=GA-IE: Ach an ríomhaire a athchumrú is féidir leat Retail Access Code an ghléis a athrú chun inneachar samplach saincheaptha a fháil.
  \resources\RetailDemoConfirm_NextButtonText:
    Candidate Language=GA-IE: Athraigh
  \resources\RetailDemoConfirm_HeaderText:
    Candidate Language=GA-IE: Athraigh go mód samplach miondíola
  \resources\RetailDemoConfirm_CancelButtonText:
    Candidate Language=GA-IE: Cealaigh
  \resources\RetailDemoConfirm_BodyText2:
    Candidate Language=GA-IE: Ní mór don ríomhaire a bheith nasctha leis an Idirlíon. Agus má athraítear go mód samplach miondíola, scriosfar an t-inneachar pearsanta go léir agus aischuirfear socruithe monarchan ar an ríomhaire.
  \resources\RetailDemoConfirm_BodyText1:
    Candidate Language=GA-IE: Tá tú ar tí eispéireas samplach miondíola a chasadh air, a ceapadh le haghaidh úsáide miondíola amháin.
  \resources\RetailDemoConfirmError_ReconfigHeaderText:
    Candidate Language=GA-IE: Ní féidir ríomhaire samplach a athchumrú
  \resources\RetailDemoConfirmError_ReconfigBodyText1:
    Candidate Language=GA-IE: Ní féidir nascadh leis an Idirlíon, agus tá nasc de dhíth ar do ríomhaire chun mód samplach miondíola a athchumrú.
  \resources\RetailDemoConfirmError_HeaderText:
    Candidate Language=GA-IE: Ní féidir athrú go mód samplach miondíola 
  \resources\RetailDemoConfirmError_CancelButtonText:
    Candidate Language=GA-IE: Dún
  \resources\RetailDemoConfirmError_BodyText2:
    Candidate Language=GA-IE: Seiceáil an nasc agus bain triail eile as.
  \resources\RetailDemoConfirmError_BodyText1:
    Candidate Language=GA-IE: Ní féidir linn ceangal leis an Idirlíon, agus tá nasc de dhíth ar an ríomhaire le hathrú go mód samplach miondíola.
  \resources\RestartNow:
    Candidate Language=GA-IE: Atosaigh anois
  \resources\RestartLater:
    Candidate Language=GA-IE: Atosaigh níos déanaí
  \resources\RenamePC_SAME_COMPUTER_NAME_ErrorText:
    Candidate Language=GA-IE: Tá ainm an ríomhaire seo á úsáid cheana. Iontráil ainm eile.
  \resources\RenamePC_RENAME_FAIL_ErrorText:
    Candidate Language=GA-IE: Ár leithscéal, ní féidir ainm an ríomhaire a athrú.
  \resources\RenamePC_NON_RFC_COMPUTER_NAME_TITLE_ErrorText:
    Candidate Language=GA-IE: Tá ainm an ríomhaire neamhbhailí.
  \resources\RenamePC_NON_RFC_COMPUTER_NAME_SYNTAX_ErrorText:
    Candidate Language=GA-IE: Tá ainm an ríomhaire neamhbhailí.
  \resources\RenamePC_NextButtonText:
