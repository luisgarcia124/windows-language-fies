  \resources\SystemSettings_Activation_NO_PRODUCT_KEY_CONTENT:
    Candidate Language=GA-IE: Cuir isteach d’eochair tháirge chun Windows a ghníomhachtú.
  \resources\SystemSettings_Activation_NO_KEY_FOUND:
    Candidate Language=GA-IE: Thuairiscigh Windows nár aimsíodh aon eochair tháirge ar do ghléas.
  \resources\SystemSettings_Activation_NoPKeyFound:
