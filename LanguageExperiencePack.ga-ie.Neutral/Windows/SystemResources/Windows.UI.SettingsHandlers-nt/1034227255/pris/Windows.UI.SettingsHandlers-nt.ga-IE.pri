  \resources\SystemSettings_Activation_ONLINE_ERROR:
    Candidate Language=GA-IE: Ní féidir Windows a ghníomhachtú. Bain triail eile as ar ball.
  \resources\SystemSettings_Activation_OEM_SLP_CONTENT:
    Candidate Language=GA-IE: Más rud go raibh Windows réamhshuiteáilte, ní mór duit teagmháil a dhéanamh le forbróir nó déantóir an chórais lena ghníomhachtú.
  \resources\SystemSettings_Activation_OEM_OOT_CONTENT:
