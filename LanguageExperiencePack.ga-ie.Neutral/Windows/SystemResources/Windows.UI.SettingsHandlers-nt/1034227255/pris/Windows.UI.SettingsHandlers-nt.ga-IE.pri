  \resources\SystemSettings_Accounts_OtherUsersDescription:
    Candidate Language=GA-IE: Ceadaigh do dhaoine nach bhfuil i do theaghlach síniú isteach lena gcuntais féin. Ní chuirfidh sin iad le do theaghlach.
  \resources\SystemSettings_Accounts_MSAConnectButton2:
    Candidate Language=GA-IE: Sínigh isteach
