  \oobeCortana\cortanaHeading_A:
    Candidate Language=GA-IE: Lig do Cortana cabhrú leat
  \oobeCortana\cortanaHeading:
    Candidate Language=GA-IE: An bhfuil fonn ort Cortana a shocrú mar chúntóir pearsanta duit?
