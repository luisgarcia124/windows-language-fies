    Candidate Language=GA-IE: Faisnéis dhiagnóiseach á fáil...
  \hololensDiagnostics\PrivacyStatementLink:
    Candidate Language=GA-IE: Ráiteas príobháideachais
  \hololensDiagnostics\PrivacyHeadline:
    Candidate Language=GA-IE: Ráiteas Príobháideachais
  \hololensDiagnostics\PrivacyBody:
    Candidate Language=GA-IE: Foghlaim tuilleadh faoin mhéid a bhailímid trí https://aka.ms/privacy a chlóscríobh i mbarra seoltaí aon bhrabhsálaí ar ghléas ar bith.
  \hololensDiagnostics\NextButton:
    Candidate Language=GA-IE: Faisnéis a bhailiú
  \hololensDiagnostics\Instruction4:
    Candidate Language=GA-IE: 4. Tar éis na comhaid a shábháil, fill anseo agus roghnaigh Déanta. Bainfidh sé sin na comhaid ón HoloLens.
  \hololensDiagnostics\Instruction3:
    Candidate Language=GA-IE: 3. Cóipeáil comhaid dhiagnóiseacha HoloLens chuig do ríomhaire.
  \hololensDiagnostics\Instruction2:
    Candidate Language=GA-IE: 2. Ar do ríomhaire, glac leis na leideanna chun Taiscéalaí Comhad a oscailt.
  \hololensDiagnostics\Instruction1:
    Candidate Language=GA-IE: 1. Ceangail do HoloLens le do ríomhaire.
  \hololensDiagnostics\Instruction0:
    Candidate Language=GA-IE: Chun d'fhaisnéis dhiagnóiseach a shábháil chuig do ríomhaire:
  \hololensDiagnostics\ContinueButton:
    Candidate Language=GA-IE: Déanta
  \hololensDiagnostics\CancelButton:
    Candidate Language=GA-IE: Cealaigh
  \hololensDiagnostics\BodyTroubleshooting:
    Candidate Language=GA-IE: Is féidir le faisnéis dhiagnóiseach a bheith ina cabhair chun an fhadhb sínithe seo a fhabhtcheartú. Tar éis í a bhailiú, beidh sí ar fáil do dhuine ar bith a bhfuil rochtain acu ar an ngléas seo. Beidh deis agat, freisin, í a shábháil chuig do ríomhaire ionas gur féidir leat í a sheoladh chuig do riarthóir nó chuig Microsoft.
  \hololensDiagnostics\BodySuccess:
    Candidate Language=GA-IE: Tar éis an fhaisnéis a shábháil chuig do ríomhaire, seol é chuig do riarthóir nó cuir san áireamh é nuair a dhéanann tú teagmháil le Tacaíocht.
  \hololensDiagnostics\BodyError:
    Candidate Language=GA-IE: Níor éirigh linn logaí diagnóisice a ullmhú agus a bhailiú. Bain triail as cuntas eile.
  \hololensDiagnostics\Body:
    Candidate Language=GA-IE: Bain triail eile as, nó roghnaigh ‘Cealaigh’ leis an ngléas a chumrú níos déanaí.
  \hololensDiagnostics\BackButton:
    Candidate Language=GA-IE: Siar
  \hololensAccount\UserPlaceholder:
    Candidate Language=GA-IE: duine@example.com
  \hololensAccount\Title:
    Candidate Language=GA-IE: Sínigh isteach le do chuntas oibre
  \hololensAccount\PasswordTitle:
    Candidate Language=GA-IE: Iontráil do phasfhocal
  \hololensAccount\PasswordPlaceholder:
    Candidate Language=GA-IE: Pasfhocal
  \hololensAccount\NextButton:
    Candidate Language=GA-IE: Ar aghaidh
  \hololensAccount\LeadText:
    Candidate Language=GA-IE: Sínigh isteach leis an gcuntas céanna a úsáideann tú do Office 365 nó seirbhísí eile gnó ó Microsoft. B'fhéidir go mbaileoidh d'eagraíocht faisnéis fút, go suiteálfaidh nó go mbainfidh sí feidhmchláir, go n-athróidh sí nó go ndíchumasóidh sí gnéithe, go scriosfaidh sí inneachar, nó go n-athshocróidh sí do ghléas.
  \hololensAccount\Error_UsernameFormat:
    Candidate Language=GA-IE: Is cosúil nach seoladh ríomhphoist oibre ná scoile é seo. Úsáid seoladh ríomhphoist eile.
  \hololensAccount\Error_UserExists:
    Candidate Language=GA-IE: Tá úsáideoir leis an seoladh ríomhphoist sin ann cheana
  \hololensAccount\Error_NoUsername:
    Candidate Language=GA-IE: Iontráil d’ainm úsáideora
  \hololensAccount\Error_Creating_Account_Warning:
    Candidate Language=GA-IE: Bhí fadhb againn.
  \hololensAccount\BackButton:
    Candidate Language=GA-IE: Siar
  \hello\WindowsHelloAnimationAltText:
    Candidate Language=GA-IE: Beochan Windows Hello
  \hello\TitleFingerprint:
    Candidate Language=GA-IE: Úsáid do mhéarlorg chun síniú isteach níos tapúla agus níos sláine
  \hello\TitleFaceFingerprint:
    Candidate Language=GA-IE: Sínigh isteach ar shlí níos tapa agus níos sláine
  \hello\TitleFace:
    Candidate Language=GA-IE: Úsáid d'aghaidh chun síniú isteach níos tapúla agus níos sláine
