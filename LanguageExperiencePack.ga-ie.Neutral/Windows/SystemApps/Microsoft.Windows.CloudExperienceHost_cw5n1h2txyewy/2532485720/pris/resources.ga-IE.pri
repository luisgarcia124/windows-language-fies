  \oobeRetailDemoEntry\confirmSecondayCommandText:
    Candidate Language=GA-IE: Cealaigh
  \oobeRetailDemoEntry\confirmPrimaryCommandText:
    Candidate Language=GA-IE: Deimhnigh
  \oobeRetailDemoEntry\confirmedTitle:
    Candidate Language=GA-IE: Chas tú an t-eispéireas miondíola samplach air
