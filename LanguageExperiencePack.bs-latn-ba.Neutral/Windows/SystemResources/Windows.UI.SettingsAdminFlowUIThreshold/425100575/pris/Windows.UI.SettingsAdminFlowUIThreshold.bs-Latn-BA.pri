  \resources\RDP_ProtectAccountDenied_BodyText:
    Candidate Language=BS-LATN-BA: Morate postaviti zahtjeve provjere vjerodostojnosti (na primjer funkcija Windows Hello, lozinka ili PIN) za ovaj račun da biste omogućili Udaljenu radnu površinu.
  \resources\RDP_ProtectAccountAllowed_BodyText:
