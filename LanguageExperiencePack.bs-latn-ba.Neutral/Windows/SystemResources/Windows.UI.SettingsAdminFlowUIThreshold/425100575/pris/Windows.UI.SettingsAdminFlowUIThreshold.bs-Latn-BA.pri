  \resources\TroubleshootActivation_OfflineText:
    Candidate Language=BS-LATN-BA: Ne možemo aktivirati vašu kopiju operativnog sistema Windows. Provjerite da li ste povezani s internetom pa pokušajte ponovo.
  \resources\TroubleshootActivation_NoSolutionText:
