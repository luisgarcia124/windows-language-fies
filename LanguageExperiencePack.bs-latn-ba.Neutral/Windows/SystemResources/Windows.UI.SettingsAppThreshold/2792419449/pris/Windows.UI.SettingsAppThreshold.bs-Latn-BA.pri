  \SystemSettings\Resources\SystemSettings_CapabilityAccess_PhoneCall_UserGlobal_Group\DisplayName:
    Candidate Language=BS-LATN-BA: Dozvoli aplikacijama da upućuju ili primaju telefonske pozive
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_PhoneCall_UserGlobal_Group\Description:
    Candidate Language=BS-LATN-BA: Ukoliko dozvolite telefonske pozive, moći ćete odabrati koje aplikacije mogu upućivati ili primati telefonske pozive koristeći postavke na ovoj stranici. Windows koristi telefon koji ste povezali s ovim računarom za te pozive. Zabrana pristupa onemogućava aplikacijama upućivanje ili primanje telefonskih poziva.
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_PhoneCall_UserGlobal_Group2\DisplayName:
    Candidate Language=BS-LATN-BA: Dopustite aplikacijama da upućuju telefonske pozive
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_PhoneCall_UserGlobal_Group2\AdditionalDescription:
