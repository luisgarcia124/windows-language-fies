  \SystemSettings\Resources\SystemSettings_Privacy_Launch_Telemetry_Viewer_Button_Description:
    Candidate Language=BS-LATN-BA: Otvori Preglednik dijagnostičkih podataka
  \SystemSettings\Resources\SystemSettings_Privacy_InsiderProgramMessage\DisplayName:
    Candidate Language=BS-LATN-BA: Ovim opcijama upravlja Windows Insider Program
  \SystemSettings\Resources\SystemSettings_Privacy_ImproveInkType_Toggle_2_Subtitle:
    Candidate Language=BS-LATN-BA: Poboljšajte prepoznavanje jezika i mogućnost davanja prijedloga za aplikacije i usluge koje se pokreću u sistemu Windows slanjem opcionalnih dijagnostičkih podataka o kucanju i upotrebi tablet pisaljke kompaniji Microsoft.
