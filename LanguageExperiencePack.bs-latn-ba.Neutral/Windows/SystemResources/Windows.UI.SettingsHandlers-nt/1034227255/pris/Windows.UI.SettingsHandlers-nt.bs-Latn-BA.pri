  \resources\SystemSettings_Activation_BIOS_KEY:
    Candidate Language=BS-LATN-BA: Windows je prijavio da postoji problem sa OEM šifrom proizvoda.
  \resources\SystemSettings_Activation_BenefitMessageDescription:
    Candidate Language=BS-LATN-BA: Pokretanje primjerka operativnog sistema Windows koji nije izvorni može vas izložiti većem riziku od virusa i drugih sigurnosnih prijetnji.
  \resources\SystemSettings_Activation_AVS_ERROR_CONTENT:
    Candidate Language=BS-LATN-BA: Ne možemo aktivirati Windows na ovom uređaju zato što naši serveri za aktivaciju trenutno nisu dostupni. Provjerite da li ste povezani na Internet i automatski ćemo pokušati aktivirati Windows kada usluga postane dostupna.
