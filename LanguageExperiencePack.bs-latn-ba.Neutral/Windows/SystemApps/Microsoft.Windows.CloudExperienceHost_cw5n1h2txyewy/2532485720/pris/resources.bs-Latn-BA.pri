  \roamingSettings\LeadText:
    Candidate Language=BS-LATN-BA: Koje Postavke računara s Microsoft računa želite sinhronizirati s ovim računarom?
  \retailDemo\useOfflineShutdownToggle:
    Candidate Language=BS-LATN-BA: Zaobiđi mrežne postavke
  \retailDemo\timeZoneText:
    Candidate Language=BS-LATN-BA: Provjerite je li vremenska zona na ovom uređaju ispravna kad dođete na radnu površinu. Morat ćete upotrijebiti administratorski račun za promjenu vremenske zone.
  \retailDemo\timeoutLegend:
