  \shubOobeDeviceType\HuddleHeader:
    Candidate Language=BS-LATN-BA: Saradnja u timu
  \shubOobeDeviceType\HuddleDescription:
    Candidate Language=BS-LATN-BA: Izaberite ovu opciju za zajedničko korištenje, whiteboarding i razmjenu ideja. Uključuje Windows Hello i pohranjuje profile radi brze prijave.
  \shubOobeDeviceType\DeviceTypeTitle:
    Candidate Language=BS-LATN-BA: Kako ćete upotrebljavati ovaj uređaj?
  \shubOobeDeviceType\DeviceTypeDescription:
    Candidate Language=BS-LATN-BA: Postavit ćemo postavke na osnovu vašeg odabira. Promjene možete uvijek izvršiti u Postavkama.
  \shubOobeDeviceType\ConferenceHeader:
    Candidate Language=BS-LATN-BA: Sastanci i prezentacije
  \shubOobeDeviceType\ConferenceDescription:
    Candidate Language=BS-LATN-BA: Izaberite ovu opciju za konferencijske sobe, zakazane sastanke i prezentacije. Funkcija Windows Hello neće biti uključena i podaci će se izbrisati nakon svake sesije.
