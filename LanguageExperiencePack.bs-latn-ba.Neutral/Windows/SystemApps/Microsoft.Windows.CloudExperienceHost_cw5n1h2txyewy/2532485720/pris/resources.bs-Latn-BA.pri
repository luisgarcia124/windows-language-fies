  \oobeRegion\ListAccessibleName:
    Candidate Language=BS-LATN-BA: Odabir zemlje ili regiona
  \oobeRegion\FinalRegionVoiceOver:
    Candidate Language=BS-LATN-BA: Ok, don't let me hold you up. Just pick the one you want from the list.
  \oobeRegion\ConfirmRegionVoiceOver:
    Candidate Language=BS-LATN-BA: I've got that you want to use %1. Is that right?
  \oobeProvisioningStatus\ResetConfirmationDialogTitle:
