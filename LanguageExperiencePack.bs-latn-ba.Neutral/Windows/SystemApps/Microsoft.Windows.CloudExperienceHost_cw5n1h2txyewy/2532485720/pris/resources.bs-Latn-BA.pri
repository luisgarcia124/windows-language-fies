  \retailDemo\signInLink:
    Candidate Language=BS-LATN-BA: Prijavite se na postojeći Microsoft račun
  \retailDemo\shutdownTextOnline:
    Candidate Language=BS-LATN-BA: Vremena isključenja za ovaj uređaj konfiguriraju se putem servisa u oblaku za pokazno iskustvo
  \retailDemo\shutdownText:
    Candidate Language=BS-LATN-BA: Odabir vremena isključenja za ovaj uređaj
  \retailDemo\shutdownsTitle:
    Candidate Language=BS-LATN-BA: Automatsko isključivanje
  \retailDemo\shutdownsInfo:
    Candidate Language=BS-LATN-BA: Postavite vremena automatskog isključenja za ovaj uređaj.
  \retailDemo\securityTitle:
    Candidate Language=BS-LATN-BA: Administratorske postavke za RDX
  \retailDemo\securityText:
    Candidate Language=BS-LATN-BA: Izaberite koliko dugo želite da RDX radi prije uklanjanja pristupa administratorskom računu. Kad se pristup ukloni, više nećete moći pokretati skripte ni obavljati ostale administratorske zadatke. Ako želite trajno zadržati administratorski pristup, možete stvoriti prilagođenu administratorsku lozinku. Pobrinite se da vaša administratorska lozinka bude što sigurnija.
  \retailDemo\retypePassword:
    Candidate Language=BS-LATN-BA: Ponovo unesite lozinku
  \retailDemo\removeRdxTitle:
    Candidate Language=BS-LATN-BA: Ukloni RDX
  \retailDemo\removeRdxText:
    Candidate Language=BS-LATN-BA: Ukloni
  \retailDemo\removeRdxInfo:
    Candidate Language=BS-LATN-BA: Uklanja RDX s ovog uređaja i vraća ga na tvorničke postavke.
  \retailDemo\rdxTitle:
    Candidate Language=BS-LATN-BA: Postavljanje pokaznog uređaja
  \retailDemo\rdamTitle:
    Candidate Language=BS-LATN-BA: Preuzmite najnoviji pokazni sadržaj i aplikacije
  \retailDemo\rdamText:
    Candidate Language=BS-LATN-BA: Unošenjem tih informacija (opcionalno) ćete nam pomoći da vam dostavimo najnoviji sadržaj za prezentiranje tog Windows uređaja.
  \retailDemo\racLegend:
