  \enterpriseNgcEnrollment\OkButton:
    Candidate Language=BS-LATN-BA: U redu
  \enterpriseNgcEnrollment\HelpLink:
    Candidate Language=BS-LATN-BA: Kako PIN može biti sigurniji od dugačke lozinke?
  \enterpriseNgcEnrollment\HelpHeadline:
    Candidate Language=BS-LATN-BA: Zato što PIN radi samo s ovim uređajem
  \enterpriseNgcEnrollment\HelpBody:
    Candidate Language=BS-LATN-BA: Za razliku od lozinki, koje možda koristiti za pristup raznim računima, vaš PIN je jedinstven za ovaj uređaj. PIN je beskoristan udaljenim hakerima.
  \enterpriseNgcEnrollment\ErrorDescription:
    Candidate Language=BS-LATN-BA: Za dodatnu pomoć obratite se podršci ili liniji pomoći za IT sa sljedećim pojedinostima.
  \enterpriseNgcEnrollment\ErrorCode:
    Candidate Language=BS-LATN-BA: Kôd pogreške:
  \enterpriseNgcEnrollment\CorrelationId:
    Candidate Language=BS-LATN-BA: Korelacijski ID:
  \enterpriseNgcEnrollment\CancelButton:
    Candidate Language=BS-LATN-BA: Preskoči zasad
  \enterpriseNgcEnrollment\BodyTpmError:
    Candidate Language=BS-LATN-BA: Trusted Platform Module, koji se koristi za osiguranje vašeg PIN-a na ovom uređaju, trenutačno nije dostupan. Katkad pomaže da pokušate ponovo ili zasad možete preskočiti ovaj korak pa ga obaviti kasnije.
  \enterpriseNgcEnrollment\BodySuccess:
    Candidate Language=BS-LATN-BA: Sad se možete prijaviti sa svojim PIN-om.
  \enterpriseNgcEnrollment\BodyServerError:
    Candidate Language=BS-LATN-BA: Trenutačno se ne možemo povezati sa serverom radi postavljanja vašeg PIN-a. Možete pokušati ponovo ili možete preskočiti ovaj korak i obaviti ga kasnije.
  \enterpriseNgcEnrollment\BodyHelloCancel:
    Candidate Language=BS-LATN-BA: Za korištenje značajke Windows Hello morate postaviti PIN. Bit će brzo gotovo.
  \enterpriseNgcEnrollment\BodyHello:
    Candidate Language=BS-LATN-BA: Postavite PIN koji želite koristiti umjesto značajke Windows Hello. Možda vam nikad neće zatrebati, ali može poslužiti kao rezervno rješenje za svaki slučaj.
  \enterpriseNgcEnrollment\BodyError:
    Candidate Language=BS-LATN-BA: Nismo mogli postaviti vaš PIN. Katkad pomaže da pokušate ponovo ili zasad možete preskočiti ovaj korak pa ga obaviti kasnije.
  \enterpriseNgcEnrollment\BodyCancel:
    Candidate Language=BS-LATN-BA: Za korištenje ovog uređaja morate postaviti PIN. Bit će brzo gotovo.
  \enterpriseNgcEnrollment\Body:
    Candidate Language=BS-LATN-BA: Lozinka se lako može ukrasti. Za prijavu u uređaj, aplikacije i servise, umjesto lozinke, Windows Hello pruža vam kombinaciju dvaju faktora – uređaj i biometrijske značajke ili PIN.
  \deviceUser\UserPlaceholder:
    Candidate Language=BS-LATN-BA: E-pošta
  \deviceUser\Title:
    Candidate Language=BS-LATN-BA: Dodajte račun za uređaj
  \deviceUser\PasswordPlaceholder:
    Candidate Language=BS-LATN-BA: Lozinka
  \deviceUser\NextButton:
    Candidate Language=BS-LATN-BA: &Dalje
  \deviceUser\LeadText:
    Candidate Language=BS-LATN-BA: D li je ovaj uređaj na zajedničkom radnom stolu? Ako jest, unesite račun koji će omogućiti svim korisnicima pristup aplikacijama kao što su Microsoft Teams i Skype.
  \deviceUser\Error_UsernameFormat:
    Candidate Language=BS-LATN-BA: Unesite svoju adresu e-pošte u obliku someone@example.com
  \deviceUser\Error_PasswordExpired:
    Candidate Language=BS-LATN-BA: Istekla je lozinka za ovaj račun.
  \deviceUser\Error_NoUsername:
    Candidate Language=BS-LATN-BA: Unesite svoju adresu e-pošte.
  \deviceUser\Error_LogonFailure:
    Candidate Language=BS-LATN-BA: E-pošte ili lozinka nije ispravna.
