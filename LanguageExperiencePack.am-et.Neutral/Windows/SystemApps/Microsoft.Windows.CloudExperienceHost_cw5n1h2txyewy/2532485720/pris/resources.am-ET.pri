  \personalDataExport\Paragraph1:
    Candidate Language=AM-ET: ይህ ምርት እንደተጠበቀው እንዲሰራ፣ Microsoft የእርስዎን ውሂብ ለማስኬድ ከአገርዎ ወይም ከክልልዎ ውጭ ወደሚገኝ የ Microsoft ውሂብ ማእከል ማስተላለፍ አለበት። ይህን ምርት መጠቀምዎን በመቀጠል፣ በዚህ የውሂብ ማስተላለፍ ተስማምተዋል።
  \personalDataExport\PageTitle:
    Candidate Language=AM-ET: የእርስዎ ውሂብ ከእርስዎ አገር ወይም ከእርስዎ ክልል ውጭ ነው የሚሰራው።
  \personalDataExport\NextButtonText:
    Candidate Language=AM-ET: ቀጣይ
  \personalDataExport\NavigationError:
    Candidate Language=AM-ET: አንዳንድ የግንኙነት ችግሮች ያጋጠሙን ይመስላል - ከበይነመረቡ ጋር ላይገናኙ ይችላሉ፣ ወይም በእኛ በኩል ችግር ይኖራል። <ul><li> ይህን የ Microsoft ምርት ሲጠቀሙ የእርስዎ ውሂብ ለምን ከቻይና ወደ ሌላ ሀገር ማስተላለፍ እንዳለበት የበለጠ ለማወቅ፣በማንኛውም መሳሪያ ላይ በማንኛውም አሳሽ የአድራሻ አሞሌ https://aka.ms/productslist ይተይቡ። </li><br/><li>ስለ ግላዊነት እና ለበለጠ መረጃ የ Microsoft ምርቶች፣ የ Microsoft ግላዊነት መግለጫን https://aka.ms/privacy.</li></ul>
