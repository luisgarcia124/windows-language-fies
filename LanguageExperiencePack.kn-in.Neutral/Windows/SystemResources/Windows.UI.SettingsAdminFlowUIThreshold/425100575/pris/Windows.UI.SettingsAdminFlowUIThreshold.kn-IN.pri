  \resources\SurfaceHubCollectLogsPage_CloseButtonText:
    Candidate Language=KN-IN: ಮುಚ್ಚು
  \resources\Skype_FQDN_Title:
    Candidate Language=KN-IN: ವ್ಯವಹಾರಕ್ಕಾಗಿ Skype ಸರ್ವರ್ FQDN ಸೇರಿಸಿ
  \resources\Skype_FQDN_PlaceholderText:
    Candidate Language=KN-IN: domain.contoso.com
  \resources\Skype_FQDN_LabelText:
    Candidate Language=KN-IN: ಬೇರೆ ಡೊಮೇನ್‌ನಿಂದ Skype for Business ಸರ್ವರ್ ಪ್ರಮಾಣಪತ್ರವನ್ನು ಬಳಸಲಾಗುತ್ತಿದೆಯೇ? ಅದರ FQDN ಇಲ್ಲಿ ನಮೂದಿಸಿ. ನೀವು ಈ ಸೆಟ್ಟಿಂಗ್ ಬದಲಿಸಿದ ನಂತರ Surface Hub ರೀಬೂಟ್ ಮಾಡಬೇಕಾಗುತ್ತದೆ.
