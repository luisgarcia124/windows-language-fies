  \resources\SystemSettings_Continuum_ConsentModeDescription:
    Candidate Language=KN-IN: ಈ PC ಗೆ ಬಿಂಬಿಸಲು ಕೇಳಿ
  \resources\SystemSettings_Connections_Wifi_Wifi7_Alternate:
    Candidate Language=KN-IN: WLAN
  \resources\SystemSettings_Connections_Wifi_Wifi7:
    Candidate Language=KN-IN: Wi-Fi 7
  \resources\SystemSettings_Connections_Wifi_ShowEstimatedDataDescription:
