  \oobeCortana\cortanaSubHeading:
    Candidate Language=KN-IN: ಹೇ ನೋಡಿ, ಅದು ನಾನು, Cortana! <br/>ನನ್ನ ಅತ್ಯುತ್ತಮ ಕಾರ್ಯವನ್ನು ಮಾಡಲು ನಾನು ಬಯಸುವ ಮಾಹಿತಿಯನ್ನು ಬಳಸಲು ನನಗೆ ಅನುಮತಿ ಇದೆಯೇ?
  \oobeCortana\cortanaLogoAlt_globalConsent:
    Candidate Language=KN-IN: ನಿಮ್ಮ ಸಮಯ ನಿರ್ವಹಿಸಲು, ಸಂಗತಿಗಳನ್ನು ನಡೆಸಲು ಮತ್ತು ಸಂಪರ್ಕಿತವಾಗಿರಲು Cortana ನೆರವಾಗುತ್ತದೆ. ಕ್ಯಾಲೆಂಡರ್ ಪರಿಶೀಲಿಸಲು, ರಿಮೈಂಡರ್‌ಗಳನ್ನು ನಿಗದಿಸಲು, ಸಂಗೀತ ಪ್ಲೇ ಮಾಡಲು ಮತ್ತು ಅಗತ್ಯವಿದ್ದಾಗ ಉತ್ತರಗಳನ್ನು ಪಡೆಯಲು Cortana ಬಳಸಿ.
