  \resources\Lockdown_SignOutWarningText:
    Candidate Language=KOK-IN: जर निवड केल्ल्या खात्याचेर साइन इन केलें तर, बदलांक लागू करपाक तुमी साइन आउट आनी परत साइन इन करपाची गरज आसा. नेमून दिल्ले ऍक्सेस खातें जें साइन इन केल्ले आसा तें साइन आउट करतलें.
  \resources\LockdownUser_HeaderText:
    Candidate Language=KOK-IN: खातें निवडचें
  \resources\LockdownUser_EmptyListText:
    Candidate Language=KOK-IN: डिव्हायसाचेर फक्त प्रशासक खातीं आसात. स्टॅंडर्ड उपेगकर्तो खात्याचें संयोजन करचें आनी परतून यत्न करचो
  \resources\LockdownApp_HeaderText:
