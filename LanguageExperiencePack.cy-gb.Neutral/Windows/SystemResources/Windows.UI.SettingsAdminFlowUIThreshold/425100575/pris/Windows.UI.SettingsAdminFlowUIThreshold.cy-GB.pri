  \resources\RDP_Enable_Firewall_Complete_BodyText:
    Candidate Language=CY-GB: Rydych chi'n agor porth Bwrdd Gwaith Pell yn eich mur cadarn ar gyfer pob cysylltiad rhwydwaith ar y cyfrifiadur hwn. Os ydych chi eisiau cyfyngu cysylltiadau i rwydweithiau dethol, agorwch Gosodiadau Mur Cadarn Uwch.
  \resources\RDP_Enable_BodyText:
