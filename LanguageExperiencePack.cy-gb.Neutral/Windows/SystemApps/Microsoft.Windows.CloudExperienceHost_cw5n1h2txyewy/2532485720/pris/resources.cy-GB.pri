  \hello\ContinueButton:
    Candidate Language=CY-GB: &Parhau
  \hello\BodyTextFingerprint:
    Candidate Language=CY-GB: Mae gan eich dyfais synhwyrydd ôl-bys sy'n gweithio gyda Windows Hello, gan roi ffordd syml, heb gyfrinair i chi wirio eich hunaniaeth.
  \hello\BodyTextFace:
    Candidate Language=CY-GB: Mae eich camera yn gweithio gyda Windows Hello i'ch adnabod, gan roi ffordd syml, heb gyfrinair i chi wirio eich hunaniaeth.
