  \hololensAccount\LeadText:
    Candidate Language=CY-GB: Mewngofnodwch gyda'r un cyfrif rydych chi'n ei ddefnyddio ar gyfer Office 365 a gwasanaethau busnes eraill gan Microsoft. Efallai y bydd eich sefydliad yn casglu gwybodaeth amdanoch chi, yn gosod neu'n tynnu apiau, newid gosodiadau neu'n analluogi nodweddion, dileu cynnwys, neu'n ailosod eich dyfais.
  \hololensAccount\Error_UsernameFormat:
    Candidate Language=CY-GB: Dydy hwn ddim yn edrych fel cyfeiriad e-bost gwaith neu ysgol. Defnyddiwch gyfeiriad e-bost arall.
  \hololensAccount\Error_UserExists:
    Candidate Language=CY-GB: Mae defnyddiwr gyda'r cyfeiriad e-bost hwn yn bodoli'n barod
  \hololensAccount\Error_NoUsername:
    Candidate Language=CY-GB: Rhowch eich enw defnyddiwr
