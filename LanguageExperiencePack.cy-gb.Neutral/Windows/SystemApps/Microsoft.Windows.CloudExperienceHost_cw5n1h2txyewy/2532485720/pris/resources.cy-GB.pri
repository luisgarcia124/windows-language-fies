    Candidate Language=CY-GB: Animeiddiad Windows Hello
  \hello\TitleFingerprint:
    Candidate Language=CY-GB: Defnyddiwch eich ôl bys i fewngofnodi'n gyflymach ac yn fwy diogel
  \hello\TitleFaceFingerprint:
    Candidate Language=CY-GB: Mewngofnodi'n gyflymach ac yn fwy diogel
  \hello\TitleFace:
    Candidate Language=CY-GB: Defnyddiwch eich wyneb i fewngofnodi'n gyflymach ac yn fwy diogel
