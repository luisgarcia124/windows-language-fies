  \resources\Uninstall_GoBack_Default:
    Candidate Language=BE-BY: Вярнуцца на папярэднюю версію Windows
  \resources\Uninstall_Expired_Desc\Text:
    Candidate Language=BE-BY: Вярнуцца да папярэдняй версіі Windows не атрымаецца, таму што з моманту абнаўлення мінула больш за 10 дзён.
  \resources\Uninstall_Error_Header:
    Candidate Language=BE-BY: На жаль, вярнуцца нельга
  \resources\Uninstall_Error_Desc\Text:
    Candidate Language=BE-BY: Змены не ўнесеныя.
  \resources\Uninstall_Confirmation_Header:
    Candidate Language=BE-BY: Thanks for trying Windows 11
  \resources\Uninstall_Confirmation_Desc\Text:
    Candidate Language=BE-BY: If you end up missing improved search, security, and startup, come back to Windows 11 anytime.
  \resources\Uninstall_ConfirmationBuild_Header:
    Candidate Language=BE-BY: Дзякуем за карыстанне гэтай зборкай
  \resources\Uninstall_ConfirmationBuild_Desc\Text:
    Candidate Language=BE-BY: Калі з’явіцца новая перадфінальная зборка, мы ўсталюем яе.
  \resources\Uninstall_CheckUpdates_Yes\Content:
    Candidate Language=BE-BY: Праверыць наяўнасць абнаўленняў
  \resources\Uninstall_CheckUpdates_No\Content:
