  \resources\JoinDomain_AuthBodyText:
    Candidate Language=BE-BY: Увядзіце даныя ўліковага запісу дамена для праверкі наяўнасці дазволу на далучэнне да дамену.
  \resources\JoinDomain_ADD_LOCAL_USER_FAILED:
