  \oobeCortana\cortanaSubHeading_A:
    Candidate Language=AZ-LATN-AZ: Hər kəs şəxsi köməkçiyə layiqdir. Cortana get-gedə rəqəmsallaşır.
  \oobeCortana\cortanaSubHeadingVoiceOver:
