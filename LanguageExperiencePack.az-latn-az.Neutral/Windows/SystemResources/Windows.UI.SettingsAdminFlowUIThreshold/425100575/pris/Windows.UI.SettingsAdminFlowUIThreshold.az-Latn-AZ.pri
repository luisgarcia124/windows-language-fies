  \resources\EnterProductKey_EulaErrorText:
    Candidate Language=AZ-LATN-AZ: Microsoft Proqram Təminatının Lisenziya Şərtlərini indi yükləmək olmur. Az sonra yenidən cəhd edin. (0x%08x)
  \resources\EnterProductKey_Error_WrongSku:
    Candidate Language=AZ-LATN-AZ: %WINDOWS_LONG%. işlədirsiniz. Daxil etdiyiniz məhsulun açarından bu buraxılışı aktivləşdirmək üçün istifadə oluna bilməz. (0x%08x)
  \resources\EnterProductKey_Error_UsedProductKey:
    Candidate Language=AZ-LATN-AZ: Windows-u bu cihazda aktivləşdirmək olmur, çünki daxil etdiyiniz məhsulun açarından başqa cihazda istifadə olunub. Başqa məhsulun açarını daxil edin. (0x%08x)
  \resources\EnterProductKey_Error_ServiceDown:
    Candidate Language=AZ-LATN-AZ: Bu çox çaşdırıcıdır. Aktivləşdirmə xidmətimiz işləmir. Problemi həll etmək üzərində işləyirik. (0x%08x)
  \resources\EnterProductKey_Error_ServerInvalidKey:
    Candidate Language=AZ-LATN-AZ: Daxil etdiyiniz məhsulun açarı işləmədi. Məhsulun açarını yoxlayın və yenidən cəhd edin, yaxud başqa birini daxil edin. (0x%08x)
  \resources\EnterProductKey_Error_ServerBlockedKey:
    Candidate Language=AZ-LATN-AZ: Windows-u bu məhsulun açarı ilə aktivləşdirmək olmur. Başqa açarı sınaqdan keçirin. (0x%08x)
  \resources\EnterProductKey_Error_NotActivated:
    Candidate Language=AZ-LATN-AZ: Windows-u bu məhsulun açarı ilə aktivləşdirmək olmur. Ətraflı məlumat üçün Parametrlərə keçin. (0x%08x)
  \resources\EnterProductKey_Error_NoInternet:
    Candidate Language=AZ-LATN-AZ: Windows-u aktivləşdirmək olmur, çünki aktivləşdirmə serverlərimizdən indi istifadə mümkün deyil. İnternetə qoşulu olduğunuza əmin olun və xidmətdən istifadə mümkün olduqda avtomatik olaraq Windows-u aktivləşdirməyə cəhd edəcəyik. (0x%08x)
  \resources\EnterProductKey_Error_NoFreeUpgrade:
    Candidate Language=AZ-LATN-AZ: Windows-u bu cihazda aktivləşdirmək olmur, çünki daxil etdiyiniz məhsulun açarı daha etibarlı deyil. Başqa məhsulun açarını daxil edin. (0x%08x)
  \resources\EnterProductKey_Error_InvalidUpgrade:
    Candidate Language=AZ-LATN-AZ: Cihaz aktivləşdirilməyib. Yeniləşdirmə üçün məhsulun açarının yoxlanması alınmadı. (0x%08x)
