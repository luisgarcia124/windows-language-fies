  \resources\TroubleshootActivation_Error_StoreErrors:
    Candidate Language=AZ-LATN-AZ: Aktivləşdirmə serverlərimizlə əlaqə saxlamağa nə isə mane oldu. Bir neçə dəqiqə gözləyin və sonra yenidən cəhd edin. (0x%08x)
  \resources\TroubleshootActivation_Error_ServiceDisabled:
    Candidate Language=AZ-LATN-AZ: Biz mühüm Windows xidmətinə daxil ola bilmədik. Şəbəkəyə qoşulu olduğunuzu yoxlayın, bir neçə dəqiqə gözləyin və daha sonra yenidən aktivləşdirməyə çalışın. (0x%08x)
  \resources\TroubleshootActivation_Error_HardwareChanged:
    Candidate Language=AZ-LATN-AZ: Bu cihaza qoşulmuş avadanlıq dəyişdirilmiş ola bilər. İnternetə qoşulu olduğunuza əmin olun, sonra yenidən cəhd edin. (0x%08x)
  \resources\TroubleshootActivation_EditionUpgradeText:
    Candidate Language=AZ-LATN-AZ: Bu cihaz üçün %2 icra olunan %1 rəqəmsal lisenziya tapdıq. Bu rəqəmsal lisenziyadan istifadə etməklə aktivləşdirmək üçün Windows buraxılışınızın yeniləşdirilməsini seçin.
