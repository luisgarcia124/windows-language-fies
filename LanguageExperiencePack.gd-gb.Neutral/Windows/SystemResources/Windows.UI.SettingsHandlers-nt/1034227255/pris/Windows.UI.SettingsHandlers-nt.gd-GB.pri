  \resources\SystemSettings_SurfaceHub_Skype_FQDNDescription:
    Candidate Language=GD-GB: Rèitich ainm na h-àrainne
  \resources\SystemSettings_SurfaceHub_Skype_FQDNActionDescription:
    Candidate Language=GD-GB: Ma tha thu a’ ceangal ri frithealaiche Skype for Business o àrainn nach eil co-ionnan ri cunntas an uidheim, bidh agad ri ainm àrainne an fhrithealaiche-amais a chur a-steach.
  \resources\SystemSettings_SurfaceHub_SetLocalAdministratorDescription:
    Candidate Language=GD-GB: Deasaich an cunntas rianaire
  \resources\SystemSettings_SurfaceHub_SetLocalAdministratorActionDescription:
    Candidate Language=GD-GB: A chionn ’s gu bheil cothrom aig diofar chleachdaichean air an uidheam seo, tha na roghainnean glaiste airson ’s nach urrainnear an atharrachadh o sheisean gu seisean. Chan fhaod ach rianairean roghainnean an uidheim seo a rèiteachadh.
  \resources\SystemSettings_SurfaceHub_SessionTimeoutDescription:
    Candidate Language=GD-GB: Mur eil duine sam bith an làthair, till gun sgrìn-fhàilteachaidh às dèidh
  \resources\SystemSettings_SurfaceHub_RotatePassword_Error_Generic:
    Candidate Language=GD-GB: Mearachd: %1
  \resources\SystemSettings_SurfaceHub_RotatePassword_Error_DirSync:
    Candidate Language=GD-GB: Cha chuirear taic ri cuairteachadh nam faclan-faire airson an t-seòrsa de chunntas seo. Cuir a-steach ainm a' chunntais san fhòrmat Àrainn\Ainm-cleachdaiche is feuch ris a-rithist
  \resources\SystemSettings_SurfaceHub_RotatePasswordDescription:
    Candidate Language=GD-GB: Ma tha dragh ort mun tèarainteachd, cuir air seo airson ’s gun cuairtich an t-uidheam seo am facal-faire aig cunntas an uidheim seo gu fèin-obrachail. ’S urrainn dhut am facal-faire ath-shuidheachadh uair sam bith slighe Active Directory (no Azure AD).
  \resources\SystemSettings_SurfaceHub_ResetDeviceDescription:
    Candidate Language=GD-GB: Dèan toiseach-tòiseachaidh
  \resources\SystemSettings_SurfaceHub_ResetDeviceActionDescription:
    Candidate Language=GD-GB: Mur eil an t-uidheam seo a' ruith mar bu chòir, dh'fhaoidte gun cuir ath-shuidheachadh ceart seo. Bheir seo air falbh na faidhlichean agad is nì e ath-stàladh air Windows an uairsin. Feumaidh tu an t-uidheam a shuidheachadh a-rithist nuair a bhios Windows deiseil leis an stàladh.
  \resources\SystemSettings_SurfaceHub_ProxySessionAuthSave:
    Candidate Language=GD-GB: Cleachd na teisteasan aig cunntas an uidheim
  \resources\SystemSettings_SurfaceHub_ProxySessionAuthPrompt:
    Candidate Language=GD-GB: Faighnich airson teisteasan a’ cleachdaiche
  \resources\SystemSettings_SurfaceHub_PowerMgmt_SleepMode_Hiberate:
    Candidate Language=GD-GB: Geamhrachadh (feumaidh seo nas lugha de chumhachd)
  \resources\SystemSettings_SurfaceHub_PowerMgmt_SleepMode_ConnectedStandby:
    Candidate Language=GD-GB: Fuireachas ceangailte (nì seo dùsgadh nas luaithe)
