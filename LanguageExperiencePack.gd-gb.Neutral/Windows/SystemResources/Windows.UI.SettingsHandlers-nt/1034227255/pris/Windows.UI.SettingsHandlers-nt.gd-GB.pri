  \resources\SystemSettings_SurfaceHub_LaunchEventViewerDescription:
    Candidate Language=GD-GB: Fosgail
  \resources\SystemSettings_SurfaceHub_LaunchEventViewerActionDescription:
    Candidate Language=GD-GB: Airson faicinn tachartasan a tha seachad air an Surface Hub agad, tagh an tùs, loga, no nòd sealladh gnàthaichte anns a’ chraobh chonsoil. Tha sealladh Taisbeanaidh Rianachd a’ gabhail a-steach a h-uile tachartas, as bith dè an tùs aca.
  \resources\SystemSettings_SurfaceHub_GetDomainAdministratorsGroup_Label_DomainJoined:
