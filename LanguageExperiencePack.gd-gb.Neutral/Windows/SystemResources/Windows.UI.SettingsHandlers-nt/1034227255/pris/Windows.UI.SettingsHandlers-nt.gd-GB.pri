  \resources\SystemSettings_Language_CHSPinyinIME_IsVModeEnabledDescription:
    Candidate Language=GD-GB: Cleachd am modh-V airson àireamhan, cinn-là, àm is msaa. na Sìnise a chur a-steach. Nuair a bhios tu sa mhodh Pinyin dùbailte, is urrainn dhut am modh-V a chur gu dol le “Shift+v”
  \resources\SystemSettings_Language_CHSPinyinIME_IsUModeEnabledDescription:
    Candidate Language=GD-GB: Cleachd am modh-U airson caractaran na Sìnise a chur a-steach a-rèir àireamh nan stràcan aca no ceann-cèille no airson comharra a chur a-steach. Nuair a bhios tu sa mhodh Pinyin dùbailte, is urrainn dhut am modh-U a chur gu dol le “Shift+u”
  \resources\SystemSettings_Language_CHSPinyinIME_IsSuperAbbreviatedPinyinEnabledDescription:
    Candidate Language=GD-GB: Pinyin làn-ghiorraichte
  \resources\SystemSettings_Language_CHSPinyinIME_IsSmartSelfLearningEnabledDescription:
    Candidate Language=GD-GB: Tarraing abairtean às na sgrìobhainnean a tha thu a’ deasachadh no a dheasaich thu o chionn goirid gu fèin-obrachail (cha tèid na h-abairtean seo a chleachdadh ach san ion-chur làithreach agad; cha tèid an cur gu Microsoft.)
  \resources\SystemSettings_Language_CHSPinyinIME_IsSelfLearningEnabledDescription:
    Candidate Language=GD-GB: Cuir an/à comas gleus an fhèin-ionnsachaidh agus ion-/às-phortadh de dh’abairtean a chaidh ionnsachadh leis fhèin (taic ri fòrmat Microsoft inntearnail a-mhàin)
  \resources\SystemSettings_Language_CHSPinyinIME_IsReadingAutoCorrectionEnabledDescription:
    Candidate Language=GD-GB: Reading auto correction
  \resources\SystemSettings_Language_CHSPinyinIME_IsPeopleNameTipEnabledDescription:
    Candidate Language=GD-GB: Seall gliocasan mu ghleusan ion-chur ainmean dhaoine gu fèin-obrachail
  \resources\SystemSettings_Language_CHSPinyinIME_IsPeopleNameEnabledDescription:
    Candidate Language=GD-GB: Rè ion-chur Pinyin, cleachd “leth-chòilean + r” airson modh ion-chur ainmean dhaoine a chur gu dol Nuair a bhios tu sa mhodh Pinyin dùbailte, brùth “Shift + leth-chòilean” agus an uairsin “r” airson modh ion-chur ainmean dhaoine a chur gu dol le.
  \resources\SystemSettings_Language_CHSPinyinIME_IsOutputCharsetSwitchKeyEnabledDescription:
