    Candidate Language=GD-GB: Ùraich an-dràsta
  \resources\SystemSettings_SurfaceHub_PenUpdateActionDescription:
    Candidate Language=GD-GB: Gus pinn an uidheim ùrachadh, brùth am putan gu h-ìosal gus an t-inneal-ùrachaidh a thòiseachadh.
  \resources\SystemSettings_SurfaceHub_OpenStoreDescription:
    Candidate Language=GD-GB: Fosgail an Store
  \resources\SystemSettings_SurfaceHub_OpenStoreActionDescription:
    Candidate Language=GD-GB: Tadhail air a’ Microsoft Store ma tha thu ag iarraidh barrachd aplacaidean dhan uidheam seo
