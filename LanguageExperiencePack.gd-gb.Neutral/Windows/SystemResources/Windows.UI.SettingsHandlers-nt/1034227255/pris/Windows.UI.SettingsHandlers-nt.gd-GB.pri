  \resources\SystemSettings_SurfaceHub_GetDomainAdministratorsGroup_Description_DomainJoined:
    Candidate Language=GD-GB: Tha an t-uidheam seo ceangailte ri Azure Active Directory (Azure AD) agus ga stiùireadh le buidheann tèarainteachd.
  \resources\SystemSettings_SurfaceHub_GetDomainAdministratorsGroup_Description_CloudDomainJoined:
    Candidate Language=GD-GB: Tha an t-uidheam seo ceangailte ri Azure Active Directory (Azure AD) agus ga stiùireadh le rianairean a' bhuidhinn agad.
  \resources\SystemSettings_SurfaceHub_ExportRecoveryKeyDescription:
