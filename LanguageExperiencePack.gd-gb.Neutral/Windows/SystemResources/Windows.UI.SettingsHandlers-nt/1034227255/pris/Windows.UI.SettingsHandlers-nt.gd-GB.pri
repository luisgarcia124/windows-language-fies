  \resources\SystemSettings_SurfaceHub_CortanaSettingsActionDescription:
    Candidate Language=GD-GB: ’S urrainn dha Cortana cuideachadh gus coinneamh a thòiseachadh gu luath agus fiosrachadh buntainneach a lorg airson duine sam bith a dh’fhaighnicheas os àrd rè na coinneimh.
  \resources\SystemSettings_SurfaceHub_ConfigureMOMAgentDescription:
    Candidate Language=GD-GB: Rèitich na roghainnean OMS
  \resources\SystemSettings_SurfaceHub_ConfigureMOMAgentActionDescription:
    Candidate Language=GD-GB: 
      Cuidichidh an Operations Management Suite (OMS) o Microsoft thu gun tracaich thu slàinte nan uidheaman agad ’s ach an tuig thu mar a thathar gan cleachdadh.
    
  \resources\SystemSettings_SurfaceHub_CollectLogsDescription:
    Candidate Language=GD-GB: Cruinnich na logaichean
  \resources\SystemSettings_SurfaceHub_CollectLogsActionDescription:
    Candidate Language=GD-GB: Cuir a-steach draibh USB agus tagh "Cruinnich na logaichean" an uairsin. Dh'fhaoidte gum bi fiosrachadh mar sheòlaidhean puist-d nan daoine a chleachd an t-uidheam seo am broinn nan logaichean seo no fiosrachadh mun uidheam agus mar a cheanglas e ris an lìonra agad.
  \resources\SystemSettings_SurfaceHub_Cert_Import_Wizard_Title:
    Candidate Language=GD-GB: Draoidh ion-phortadh theisteanasan
  \resources\SystemSettings_SurfaceHub_AlwaysEndSessionOption:
    Candidate Language=GD-GB: Cuir crìoch air an t-seisean an-còmhnaidh
  \resources\SystemSettings_SurfaceHub_AllowResumeOption:
    Candidate Language=GD-GB: Thoir cead do chleachdaichean leantainn air an t-seisean
  \resources\SystemSettings_SurfaceHub_AdvancedResetOptionsDescription:
    Candidate Language=GD-GB: Ath-thòisich an-dràsta
  \resources\SystemSettings_SurfaceHub_AdvancedResetOptionsActionDescription:
    Candidate Language=GD-GB: Ath-thòisich an t-uidheam gus dol a-steach dhan t-suidheachadh adhartach. Tagh “Aisig on neul” an uairsin gus Windows ath-stàladh on dèanadair.
  \resources\SystemSettings_SurfaceHub_AddCert_ActionDescription:
    Candidate Language=GD-GB: Ion-phortaich teisteanasan airson a’ chleachdaiche làithrich. Cleachd pacaidean solarachaidh no fuasgladh stiùireadh uidheim mobile (MDM) gus teisteanasan ion-phortadh airson an uidheim ionadail.
