  \resources\SystemSettings_Audio_Codec_ActionDescription:
    Candidate Language=GD-GB: Cha deach na codecs a stàladh air an t-siostam.
  \resources\SystemSettings_Audio_BluetoothLauncher_Output_ActionDescription:
    Candidate Language=GD-GB: Paidhrich uidheam às-chuir ùr
  \resources\SystemSettings_Audio_BluetoothLauncher_Input_ActionDescription:
    Candidate Language=GD-GB: Paidhrich uidheam ion-chuir ùr
  \resources\SystemSettings_AppControl_Preference_StoreOnly:
    Candidate Language=GD-GB: Am Microsoft Store a-mhàin (mholamaid seo)
  \resources\SystemSettings_AppControl_Preference_Recommendations:
    Candidate Language=GD-GB: Àite sam bith ach innis dhomh ma tha a leithid a dh’aplacaid sa Microsoft Store
  \resources\SystemSettings_AppControl_Preference_PreferStore:
    Candidate Language=GD-GB: Àite sam bith ach thoir rabhadh dhomh mus stàlaich mi aplacaid nach tàinig às a’ Microsoft Store
  \resources\SystemSettings_AppControl_Preference_Anywhere:
    Candidate Language=GD-GB: Àite sam bith
  \resources\SystemSettings_AppControl_Policy_Restriction:
    Candidate Language=GD-GB: Tha an roghainn seo fo stiùireadh a’ bhuidhinn agad. Cuir fios gun rianaire agad airson barrachd fiosrachaidh.
  \resources\SystemSettings_AirplaneMode_Description:
    Candidate Language=GD-GB: Modh Itealain
  \resources\SystemSettings_AdvancedGraphics_WindowsDefault:
    Candidate Language=GD-GB: Leig le Windows co-dhùnadh
  \resources\SystemSettings_AdvancedGraphics_SpecificGpuPreferenceFormatString:
    Candidate Language=GD-GB: GPU sònraichte %1$d: %2$ws
  \resources\SystemSettings_AdvancedGraphics_PowerSavingGpuPreference:
    Candidate Language=GD-GB: Caomhnadh cumhachd
  \resources\SystemSettings_AdvancedGraphics_HighPerformanceGpuPreference:
    Candidate Language=GD-GB: Dèanadas àrd
  \resources\SystemSettings_AddAnother:
    Candidate Language=GD-GB: Add another
  \resources\SystemSettings_Add:
    Candidate Language=GD-GB: Cuir ris
  \resources\SystemSettings_Activation_VOLUME_SLP_CONTENT:
    Candidate Language=GD-GB: Feumaidh tu Multiple Activation Key (MAK) no iuchair bathair àbhaisteach a chur a-steach airson Windows a ghnìomhachadh.
  \resources\SystemSettings_Activation_VOLUME_EXPIRATION:
    Candidate Language=GD-GB: Falbhaidh an ùine air a' cheadachas agad airson Windows a dh'aithghearr.
  \resources\SystemSettings_Activation_VOLUME_BINDING_CONTENT:
    Candidate Language=GD-GB: Chan urrainn do Windows gnìomhachadh an-dràsta. Feuch ris a' ghnìomhachadh a-rithist an ceann greis. Mur obraich sin, cuir fios gu rianaire an t-siostaim agad.
  \resources\SystemSettings_Activation_Volume_Activation:
    Candidate Language=GD-GB: Chaidh Windows a chur an gnìomh slighe seirbheis gnìomhachadh a’ chompanaidh agad.
  \resources\SystemSettings_Activation_USED_PRODUCT_KEY_CONTENT:
    Candidate Language=GD-GB: Cha urrainn dhuinn Windows a ghnìomhachadh air an uidheam seo a chionn ’s gun deach iuchair a’ bhathair a chleachdadh air uidheam eile mar-thà. Ma tha thu dhen bheachd nach deach a cleachdadh air uidheam eile, tagh “Fuasgladh dhuilgheadasan”.
  \resources\SystemSettings_Activation_URL_WHY_REQUIRED:
    Candidate Language=GD-GB: Carson a tha gnìomhachadh a dhìth?
  \resources\SystemSettings_Activation_URL_MANUFACTURER:
    Candidate Language=GD-GB: Seall fiosrachadh conaltradh an t-saothraiche air loidhne
  \resources\SystemSettings_Activation_URL_LIST_ONLINE:
    Candidate Language=GD-GB: Sell air an liosta bathair air loidhne airson mion-fhiosrachadh
  \resources\SystemSettings_Activation_URL_LEARN_MORE:
    Candidate Language=GD-GB: Barrachd fiosrachaidh
  \resources\SystemSettings_Activation_URL_LEARN_INVALID_PK:
    Candidate Language=GD-GB: Barrachd fiosrachaidh mu iuchraichean bathair mì-dhligheach
  \resources\SystemSettings_Activation_URL_LATEST:
    Candidate Language=GD-GB: Stàlaich an tionndadh as ùire de Windows
  \resources\SystemSettings_Activation_URL_IA_HELP:
    Candidate Language=GD-GB: Seall fiosrachadh air loidhne air mar a ghnìomhaicheas tu inneal biortail
  \resources\SystemSettings_Activation_URL_GET_WINDOWS:
    Candidate Language=GD-GB: Faigh Windows
  \resources\SystemSettings_Activation_URL_CSS_ONLINE:
    Candidate Language=GD-GB: Seall fiosrachadh taice air loidhne
  \resources\SystemSettings_Activation_URL_ADMIN_INFO:
    Candidate Language=GD-GB: Faigh fiosrachadh o rianaire an t-siostaim agad air loidhne
  \resources\SystemSettings_Activation_Upgrade_Title:
    Candidate Language=GD-GB: Àrdaich an tionndadh de Windows
  \resources\SystemSettings_Activation_Upgrade_Message2:
    Candidate Language=GD-GB: Bidh sinn greis agus thèid am PC agad ath-thòiseachadh an uairsin. Chan urrainn dhut am PC a chleachdadh gus an coilean e.
  \resources\SystemSettings_Activation_Upgrade_Message1:
    Candidate Language=GD-GB: Ma nì thu àrdachadh, gheibh thu gleusan ùra ann an Windows. Mus tòisich thu air a sin, dèan cinnteach gun do shàbhail thu d’ obair is gun do dhùin thu aplacaid sam bith.
  \resources\SystemSettings_Activation_Upgrade_Button_Text:
    Candidate Language=GD-GB: Tòisich air an àrdachadh
  \resources\SystemSettings_Activation_UNKNOWN_ERROR_CONTENT:
    Candidate Language=GD-GB: Chan urrainn dhuinn Windows a ghnìomhachadh air an uidheam seo an-dràsta fhèin. Feuch is cuir an gnìomh e an ceann greis no tadhail air an Store is ceannaich Windows fìor.
  \resources\SystemSettings_Activation_UNACTIVATED_DOWNLEVEL_CONTENT:
    Candidate Language=GD-GB: Chaidh an deasachadh seo de Windows àrdachadh o thionndadh de Windows gun ghnìomhachadh. Cuir a-steach iuchair bathair dhligheach no tadhail air an Store gus fìor Windows a cheannach.
  \resources\SystemSettings_Activation_Troubleshooter_ActionDescription:
    Candidate Language=GD-GB: Ma tha duilgheadasan agad leis a’ ghnìomhachadh, feuch fuasglaiche air trioblaidean gus a chàradh. 
  \resources\SystemSettings_Activation_TroubleshooterDescription:
    Candidate Language=GD-GB: Fuasgladh dhuilgheadasan
  \resources\SystemSettings_Activation_TOKEN_ERROR:
    Candidate Language=GD-GB: Cha deach le Windows teisteanas airson a ghnìomhachaidh a lorg. Feumaidh rianaire an t-siostaim agad teisteanas dligheach a stàladh gus Windows a ghnìomhachadh. 
  \resources\SystemSettings_Activation_TokenErrorDescription:
    Candidate Language=GD-GB: Cha deach le Windows teisteanas airson a ghnìomhachaidh a lorg. Stàlaich teisteanas dligheach air a' PC seo no cuir fios gu rianaire an t-siostaim agad.
  \resources\SystemSettings_Activation_TOKEN:
    Candidate Language=GD-GB: Chan urrainn do Windows gnìomhachadh an-dràsta. Feuch ris a' ghnìomhachadh a-rithist an ceann greis. Mur obraich sin, cuir fios gu rianaire an t-siostaim agad.
  \resources\SystemSettings_Activation_TIMEBOMB_EXPIRING_CONTENT:
    Candidate Language=GD-GB: Falbhaidh an ùine air a' cheadachas airson an tionndadh deuchainn seo de Windows a dh'aithghearr. Bidh agad ris an tionndadh as ùire de Windows a stàladh 's a ghnìomhachadh. Mus dèan thu gnìomhachadh, cuiridh Windows dheth an coimpiutair seo gach dà uair a thìde is mar sin, bu chòir dhut lethbhreac-glèidhidh dhen dàta agad a dhèanamh.
  \resources\SystemSettings_Activation_TIMEBASED_EXPIRED_CONTENT:
    Candidate Language=GD-GB: Dh'fhalbh an ùine air a' cheadachas airson an tionndadh seo de Windows. Stàlaich an tionndadh as ùire gus a ghnìomhachadh.
  \resources\SystemSettings_Activation_SupportActivateInstructions_Description:
    Candidate Language=GD-GB: Gnìomhaich slighe "Faigh cobhair" no air an fhòn
  \resources\SystemSettings_Activation_SubscriptionExpiredRejuv:
    Candidate Language=GD-GB: Dh’fhalbh an ùine air an fho-sgrìobhadh agad de %1 – cuir fios gu rianachd a’ bhuidhinn agad airson cobhair.
  \resources\SystemSettings_Activation_SubscriptionExpired:
    Candidate Language=GD-GB: Chan e fo-sgrìobhadh dligheach a tha ann %1.
  \resources\SystemSettings_Activation_SubscriptionActive:
    Candidate Language=GD-GB: Tha am fo-sgrìobhadh agad air %1 gnìomhach
  \resources\SystemSettings_Activation_Store_Entitlement:
    Candidate Language=GD-GB: Chaidh Windows a ghnìomhachadh le ceadachas digiteach.
  \resources\SystemSettings_Activation_SOFTMOD_CONTENT:
    Candidate Language=GD-GB: Tha faidhlichean air a' PC agad a tha a' cur stad air a' ghnìomhachadh. Feumaidh tu tionndadh ùr de Windows a cheannach 's a stàladh.
  \resources\SystemSettings_Activation_SAFE_MODE_CONTENT:
    Candidate Language=GD-GB: Tha thu a' ruith Windows sa mhodh shàbhailte. Ath-thòisich Windows gu h-àbhaisteach airson a h-uile càil a dh'fheumas tu gus a ghnìomhachadh.
  \resources\SystemSettings_Activation_REBOOT_CONTENT:
    Candidate Language=GD-GB: Mhothaich Windows do dh'atharraichean ann am faidhlichean siostaim 's tha sin a' cur bacadh air a' ghnìomhachadh. Ath-thòisich Windows gus a ghnìomhachadh.
  \resources\SystemSettings_Activation_PhoneActivate_ActionDescription:
    Candidate Language=GD-GB: Cuir fòn thugainn gus Windows a ghnìomhachadh.
  \resources\SystemSettings_Activation_PhoneActivateDescription:
    Candidate Language=GD-GB: Gnìomhaich air an fhòn
  \resources\SystemSettings_Activation_OpenResolutionURLDescription:
    Candidate Language=GD-GB: Cuir fios gun sgioba taice
  \resources\SystemSettings_Activation_ONLINE_ERROR:
    Candidate Language=GD-GB: Cha ghabh Windows a ghnìomhachadh. Feuch ris a-rithist an ceann greis.
  \resources\SystemSettings_Activation_OEM_SLP_CONTENT:
    Candidate Language=GD-GB: Ma bha Windows stàlaichte mar-thà nuair a fhuair thu an coimpiutair, feumaidh tu fios a chur dhan chompanaidh a rinn no a chuir ri chèile an coimpiutair gus a ghnìomhachadh.
  \resources\SystemSettings_Activation_OEM_OOT_CONTENT:
    Candidate Language=GD-GB: Tha duilgheadas ann leis a' ghnìomhachadh. Cuir fios gu saothraiche a' PC agad.
  \resources\SystemSettings_Activation_NO_PRODUCT_KEY_CONTENT:
    Candidate Language=GD-GB: Cuir a-steach an iuchair bathair agad gus Windows a ghnìomhachadh.
  \resources\SystemSettings_Activation_NO_KEY_FOUND:
    Candidate Language=GD-GB: Thuirt Windows nach deach iuchair bathair a lorg air an uidheam agad.
  \resources\SystemSettings_Activation_NoPKeyFound:
    Candidate Language=GD-GB: Cha deachd iuchair bathair a lorg
  \resources\SystemSettings_Activation_NEVER_ACTIVATED_CONTENT:
    Candidate Language=GD-GB: Cuir a-steach an iuchair bathair agad gus Windows a ghnìomhachadh.
  \resources\SystemSettings_Activation_NETWORK_UNAVAILABLE_CONTENT:
    Candidate Language=GD-GB: Chan urrainn dhuinn Windows a ghnìomhachadh air an uidheam seo a chionn ’s nach eil na frithealaichean gnìomhachaidh againn ag obair an-dràsta fhèin. Dèan cinnteach gu bheil ceangal agad ris an eadar-lìon agus gnìomhaichidh sinn Windows cho luath ’s a bhios an t-seirbheis air ais.
  \resources\SystemSettings_Activation_LICENSE_EXPIRING_CONTENT:
    Candidate Language=GD-GB: Falbhaidh an ùine air a' cheadachas Windows agad a dh'aithghearr.
  \resources\SystemSettings_Activation_LEARN_MORE:
    Candidate Language=GD-GB: Faigh barrachd fiosrachaidh
  \resources\SystemSettings_Activation_LearnMore_AccessibleName:
    Candidate Language=GD-GB: Faigh barrachd fiosrachaidh mu ghnìomhachadh Windows
  \resources\SystemSettings_Activation_LaunchAltClient_NotDefined_ErrorMessage:
    Candidate Language=GD-GB: Cha deach cliant a’ ghnìomhachaidh a mhìneachadh. Cuir fios gu rianaire an t-siostaim agad.
  \resources\SystemSettings_Activation_LaunchAltClient_LaunchFailed_ErrorMessage:
    Candidate Language=GD-GB: Cha b’ urrainn dhuinn cliant a’ ghnìomhachaidh a chur gu dol. Cuir fios gu rianaire an t-siostaim agad.
  \resources\SystemSettings_Activation_LaunchAltClient_ErrorMessage:
    Candidate Language=GD-GB: Chaidh rudeigin ceàrr. Feuch ris a-rithist an ceann greis.
  \resources\SystemSettings_Activation_LaunchAltClient_Description:
    Candidate Language=GD-GB: Cuir cliant a' ghnìomhachaidh gu dol
  \resources\SystemSettings_Activation_LastKeyError:
    Candidate Language=GD-GB: Cha ghabh an iuchair bathair mu dheireadh a chuir thu a-steach (ID: %1) a chleachdadh san lethbhreac seo de Windows. (0x%2!X!)
  \resources\SystemSettings_Activation_KMS_NOT_FOUND:
    Candidate Language=GD-GB: Chan urrainn dhuinn Windows a ghnìomhachadh air an uidheam seo a chionn ’s nach urrainn dhuinn ceangal ri frithealaichean gnìomhachaidh a’ bhuidhinn agad. Dèan cinnteach gu bheil thu ceangailte ri lìonra a’ bhuidhinn agad is feuch ris a-rithist. Ma mhaireas an duilgheadas seo leis a’ ghnìomhachadh, cuir fios gu sgioba-taice a’ bhuidhinn agad.
  \resources\SystemSettings_Activation_INVALID_PRODUCT_KEY_CONTENT:
    Candidate Language=GD-GB: Cha urrainn dhuinn Windows a ghnìomhachadh air an uidheam seo a chionn ’s nach eil e dligheach. Tadhail air an Store is ceannaich Windows fìor.
  \resources\SystemSettings_Activation_IDS_TIMEBOMB_CONTENT:
    Candidate Language=GD-GB: Dh'fhalbh an ùine air a' cheadachas airson an tionndadh deuchainn seo de Windows. Bidh agad ris an tionndadh as ùire a stàladh 's a ghnìomhachadh. Mus dèan thu sin, cuiridh Windows dheth an coimpiutair seo gach dà uair a thìde is mar sin, bu chòir dhut lethbhreac-glèidhidh dhen dàta agad a dhèanamh.
  \resources\SystemSettings_Activation_IDS_HARDWARE_OOT_CONTENT:
    Candidate Language=GD-GB: Cha urrainn dhuinn Windows a ghnìomhachadh air an uidheam seo a chionn ’s nach eil e a’ freagairt ri pròifil a’ bathair-chruaidh. Ma chàraich thu Windows o chionn goirid no ma rinn thu atharrachadh mòr air a’ bhathar-chruaidh, tagh fuasglaiche air trioblaidean gus an duilgheadas a chàradh no tadhail air an Store a cheannach Windows fìor.
  \resources\SystemSettings_Activation_IA_HOST_NOT_ACTIVATED_CONTENT:
    Candidate Language=GD-GB: Chan urrainn dha Windows an t-inneal biortail seo a ghnìomhachadh. Dèan cinnteach gu bheil an t-òstair air gnìomhachadh is feuch ris a-rithist.
  \resources\SystemSettings_Activation_IA_GENERIC_CONTENT:
    Candidate Language=GD-GB: Chan urrainn do Windows an t-inneal biortail seo a ghnìomhachadh. Feuch ri iuchair bathair eile a chleachdadh. Mur obraich seo, dh'fhaoidte gum feum thu an t-inneal òstair àrdachadh.
  \resources\SystemSettings_Activation_HARDWARE_ID_CHANGED:
    Candidate Language=GD-GB: Thuirt Windows gun deach bathar-cruaidh an uidheam agad atharrachadh.
  \resources\SystemSettings_Activation_GetHelpActivate_Description:
    Candidate Language=GD-GB: Faigh cobhair
  \resources\SystemSettings_Activation_GEO_BLOCKED_CONTENT:
    Candidate Language=GD-GB: Cha urrainn dhuinn Windows a ghnìomhachadh air an uidheam seo a chionn ’s nach eil iuchair a’ bhathair a chuir thu a-steach a’ freagair ris an dùthaich no roinn-dùthcha far a bheil thu. Tadhail air an Store is ceannaich Windows fìor.
  \resources\SystemSettings_Activation_EXPIRING_VOLUME:
    Candidate Language=GD-GB: . Cuir fios gu rianaire an t-siostaim agad gus iuchair bathair fhaighinn.
  \resources\SystemSettings_Activation_EXPIRING_TBL:
    Candidate Language=GD-GB: . Às dèidh a' chinn-là seo, chan urrainn dhut dreach pearsanta a chur air Windows tuilleadh.
  \resources\SystemSettings_Activation_EXPIRING_START:
    Candidate Language=GD-GB: Falbhaidh an ùine air a' cheadachas Windows agad air
  \resources\SystemSettings_Activation_EXPIRING_PRERELEASE:
    Candidate Language=GD-GB: . Feumaidh tu an tionndadh as ùire de Windows a stàladh gus ceadachas ùr fhaighinn. Mur dèan thu seo, nì am PC agad ath-thòiseachadh gach dà uair a thìde nuair a bhios an ùine air falbh air a' cheadachas seo.
  \resources\SystemSettings_Activation_ErrorDescription:
    Candidate Language=GD-GB: Tuairisgeul na mearachd:
  \resources\SystemSettings_Activation_ErrorCode:
    Candidate Language=GD-GB: Còd na mearachd:
  \resources\SystemSettings_Activation_DOWNLEVEL_SETUPKEY:
    Candidate Language=GD-GB: Thuirt Windows gun robh duilgheadas ann le iuchair a’ bhathair aig an tionndadh roimhe de Windows.
  \resources\SystemSettings_Activation_DEFAULT_PRODUCT_KEY_CONTENT:
    Candidate Language=GD-GB: Chan urrainn dhuinn Windows a ghnìomhachadh air an uidheam seo a chionn ’s nach eil ceadachas digiteach no iuchair bathair dligheach agad. Ma tha thu dhen bheachd gu bheil ceadachas no iuchair dhligheach agad, tagh “Fuasgladh dhuilgheadasan”.
  \resources\SystemSettings_Activation_CSS_TEXT:
    Candidate Language=GD-GB: Ma tha thu air Windows a stàladh as ùr no air atharrachadh a dhèanamh air a' bhathar-chruaidh agad o chionn greis, 's dòcha gur urrainn dhut an iuchair làithreach agad a chleachdadh.
  \resources\SystemSettings_Activation_COA_CONTENT:
    Candidate Language=GD-GB: Chan urrainn dhut an iuchair seo a chleachdadh ach gus Windows aiseag air siostam aig an robh Windows ro-stàlaichte. 'S urrainn dhut Windows a ghnìomhachadh air an fhòn.
  \resources\SystemSettings_Activation_ChangePK_Volume_ActionDescription:
    Candidate Language=GD-GB: Cuir a-steach iuchair bathair eile a dh’fhaighinn Windows fìor. Mur eil fear agad, cuir fios gu rianaire an t-siostaim agad.
  \resources\SystemSettings_Activation_ChangePK_ActionDescription:
    Candidate Language=GD-GB: Tadhail air an Store is ceannaich Windows fìor no cuir a-steach iuchair bathair.
  \resources\SystemSettings_Activation_ChangePKProfessionalSModeDescription:
    Candidate Language=GD-GB: Tadhail air an Store airson %1 a chleachdadh.
  \resources\SystemSettings_Activation_ChangePKMessage:
    Candidate Language=GD-GB: Airson iuchair bathair eile a chleachdadh air an uidheam seo, tagh “Atharraich iuchair a’ bhathair”.
  \resources\SystemSettings_Activation_ChangePKInstructions:
    Candidate Language=GD-GB: Airson iuchair bathair eile a chleachdadh air an uidheam seo, tagh “Atharraich iuchair a’ bhathair”.
  \resources\SystemSettings_Activation_ChangePKDescription:
    Candidate Language=GD-GB: Atharraich an iuchair bathair
  \resources\SystemSettings_Activation_ChangePKCoreClientDescription:
    Candidate Language=GD-GB: Tadhail air an Store is a cheannach an àrdachaidh no cuir a-steach iuchair bathair.
  \resources\SystemSettings_Activation_CallSupport_ActionDescription:
    Candidate Language=GD-GB: Cuir fòn gun sgioba taice ma tha thu air Windows a stàladh às ùr no air atharrachadh a dhèanamh air a' bhathair-chruthaidh agad 
  \resources\SystemSettings_Activation_CallSupportDescription:
    Candidate Language=GD-GB: Cuir fòn gun sgioba taice
  \resources\SystemSettings_Activation_BuyWindows_ActionDescription:
    Candidate Language=GD-GB: 
  \resources\SystemSettings_Activation_BuyWindowsDescription:
    Candidate Language=GD-GB: Rach dhan Store
  \resources\SystemSettings_Activation_BuyUpgrade_ActionDescription:
    Candidate Language=GD-GB: Tadhail air an Store gus an tionndadh de Windows agad àrdachadh
  \resources\SystemSettings_Activation_BuyKey_ActionDescription:
    Candidate Language=GD-GB: 
  \resources\SystemSettings_Activation_BuyKeyDescription:
    Candidate Language=GD-GB: Rach dhan Store
  \resources\SystemSettings_Activation_BLOCKED_PRODUCT_KEY_CONTENT:
    Candidate Language=GD-GB: Cha do dh’obraich iuchair a’ bhathair a tha ga cleachdadh air a’ PC seo leis an deasachadh seo de Windows. Dh’fhaoidte gum feum thu bruidhinn ris a’ bhùth no chompanaidh on a cheannaich thu Windows, iuchair bathair eile a chur a-steach no tadhal air an Store gus fìor Windows a cheannach.
  \resources\SystemSettings_Activation_BIOS_KEY:
    Candidate Language=GD-GB: Thuirt Windows gun robh duilgheadas ann le iuchair a’ bhathair OEM agad.
  \resources\SystemSettings_Activation_BenefitMessageDescription:
    Candidate Language=GD-GB: Mura ruith thu fìor-lethbhreac dhe Windows, dh’fhaoidte gum bi thu fo bharrachd cunnairt o bhìorasan is bagairtean tèarainteachd eile.
  \resources\SystemSettings_Activation_AVS_ERROR_CONTENT:
    Candidate Language=GD-GB: Chan urrainn dhuinn Windows a ghnìomhachadh air an uidheam seo a chionn ’s nach eil na frithealaichean gnìomhachaidh againn ag obair an-dràsta fhèin. Dèan cinnteach gu bheil ceangal agad ris an eadar-lìon agus gnìomhaichidh sinn Windows cho luath ’s a bhios an t-seirbheis air ais.
  \resources\SystemSettings_Activation_AltInstructions_Description:
    Candidate Language=GD-GB: Airson fiosrachadh mu ghnìomhachadh an uidheim Windows agad, briog air a' cheangal gu h-ìosal.
  \resources\SystemSettings_Activation_ACTIVATED_CONTENT:
    Candidate Language=GD-GB: 
  \resources\SystemSettings_Activate_WORKSTATION_REQUIRED:
    Candidate Language=GD-GB: Cha ruith an tionndadh seo de Windows air rèiteachadh a’ bhathair-chruaidh air an uidheam agad. Tadhail air an Store airson tionndadh de Windows a cheannach ris a bheil taic.
  \resources\SystemSettings_Activate_NEVER_ACTIVATED_CONTENT:
    Candidate Language=GD-GB: Gnìomhaich ach an urrainn dhut dreach pearsanta a chur air Windows.
  \resources\SystemSettings_Activate_INFO_TITLE:
    Candidate Language=GD-GB: Fiosrachadh na h-iuchrach bathair agad
  \resources\SystemSettings_Activate_DOWNLEVEL_NOT_ACTIVATED:
    Candidate Language=GD-GB: Cha urrainn dhuinn Windows a ghnìomhachadh air an uidheam seo a chionn ’s nach deach an tionndadh roimhe de Windows a ghnìomhachadh mus rinneadh àrdachadh gu Windows 11. Tadhail air an Store is ceannaich Windows fìor.
