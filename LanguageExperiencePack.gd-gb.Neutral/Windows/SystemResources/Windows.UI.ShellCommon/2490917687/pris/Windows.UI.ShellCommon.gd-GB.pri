  \NetworkUX\SystemSettings_Connections_MobileBroadband_ESim_AddProfileErrorTextProfileProcessingError:
    Candidate Language=GD-GB: Chan urrainn dhuinn a’ phròifil seo a chur ris ri linn duilgheadas leis an stàladh. Cuir fios gun ghiùlanair mobile agad.
  \NetworkUX\SystemSettings_Connections_MobileBroadband_ESim_AddProfileErrorTextProfileNotReleasedByOperator:
    Candidate Language=GD-GB: Chan urrainn dhuinn a’ phròifil a luchdadh a-nuas fhathast. Feuch ris a-rithist an ceann greis no cuir fios gun chompanaidh fhònaichean-làimhe agad.
  \NetworkUX\SystemSettings_Connections_MobileBroadband_ESim_AddProfileErrorTextProfileNotAvailableForNewBinding:
    Candidate Language=GD-GB: Chaidh a’ phròifil seo iomruineadh do dh’uidheam eile mar-thà. Dèan cinnteach gu bheil an còd gnìomhachaidh dligheach no cuir fios gun chompanaidh fhònaichean-làimhe agad.
  \NetworkUX\SystemSettings_Connections_MobileBroadband_ESim_AddProfileErrorTextProfileDownloadMaxRetriesExceeded:
    Candidate Language=GD-GB: Chan urrainn dhuinn a’ phròifil seo a chur ris a chionn ’s gun deach a luchdadh a-nuas ro thric. Cuir fios gun ghiùlanair mobile agad.
  \NetworkUX\SystemSettings_Connections_MobileBroadband_ESim_AddProfileErrorTextNoEligibleProfile:
