  \resources\SurfaceHub_ResetDevice_Error_Text:
    Candidate Language=GD-GB: Cha ghabh an ath-shuidheachadh a thòiseachadh. Cruinnich dàta airson fuasgladh dhuilgheadasan is cuir fios gun sgioba taice.
