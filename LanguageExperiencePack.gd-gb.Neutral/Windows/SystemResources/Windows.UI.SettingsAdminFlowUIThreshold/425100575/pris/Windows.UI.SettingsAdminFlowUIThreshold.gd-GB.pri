  \resources\EditUser_AdminUserText:
    Candidate Language=GD-GB: Rianaire
  \resources\DisableUser_OkButtonText:
    Candidate Language=GD-GB: Bac
  \resources\DisableUser_HeaderText:
    Candidate Language=GD-GB: A bheil thu airson an neach seo a bhacadh o chlàradh a-steach?
  \resources\DisableUser_GeneralErrorText:
    Candidate Language=GD-GB: Thachair mearachd.
  \resources\DisableUser_BodyText:
    Candidate Language=GD-GB: Chan urrainn dhaibh tuilleadh clàradh a-steach is am PC seo a chleachdadh. ’S urrainn dhut an ceadachadh a-rithist uair sam bith.
  \resources\DevicePortalSetAuthentication_PromptText:
    Candidate Language=GD-GB: A bheil thu cinnteach gu bheil thu airson an t-ainm-cleachdaiche is am facal-faire agad airson portal nan uidheam atharrachadh?
  \resources\DevicePortalSetAuthentication_HeaderText:
    Candidate Language=GD-GB: Dearbhaich an t-atharrachadh
  \resources\DevicePortalAuthentication_WarningText:
    Candidate Language=GD-GB: Ma chuireas tu dheth an dearbhadh, gheibh duine sam bith faisg ort cothrom air an uidheam agad is chì iad na tha air.
  \resources\DevicePortalAuthentication_PromptText:
    Candidate Language=GD-GB: A bheil thu airson an dearbhadh a chur dheth?
  \resources\DevicePortalAuthentication_HeaderText:
    Candidate Language=GD-GB: Dearbhadh portal nan uidheam
  \resources\DeviceEncryption_TurnOffButtonText:
    Candidate Language=GD-GB: Cuir dheth
  \resources\DeviceEncryption_HeaderText:
    Candidate Language=GD-GB: A bheil thu airson crioptachadh uidheim a chur dheth?
  \resources\DeviceEncryption_CancelButtonText:
    Candidate Language=GD-GB: Sguir dheth
  \resources\DeviceEncryption_BodyText:
    Candidate Language=GD-GB: Ma nì thu seo, cha bhi na faidhlichean agad dìonta tuilleadh is dh’fhaoidte gun toir an dì-chrioptachadh ùine fhada.
  \resources\DeviceDiscoveryUnpairAllDevices_WarningText:
    Candidate Language=GD-GB: Dì-phaidhrichidh seo gach uidheam a tha paidhrichte ris an amas seo an-dràsta.  Thoir an aire gum mair ceangal uidheim làithreach sam bith air SSH gus an tèid an siostam ath-thòiseachadh.
  \resources\DeviceDiscoveryUnpairAllDevices_PromptText:
    Candidate Language=GD-GB: A bheil thu cinnteach gu bheil thu airson a dhì-phaidhreachadh?
  \resources\DeviceDiscoveryUnpairAllDevices_HeaderText:
    Candidate Language=GD-GB: Dì-phaidhrich na h-uidheaman uile
  \resources\DeveloperMode_Unlock_PromptText:
    Candidate Language=GD-GB: A bheil thu airson modh an luchd-leasachaidh a chur air?
  \resources\DeveloperMode_UnlockWarningText:
    Candidate Language=GD-GB: Ma chuireas tu air gleusan an luchd-leasachaidh, a’ gabhail a-steach stàladh is ruith de dh’aplacaidean o àitichean eile seach Microsoft Store, dh’fhaoidte gun èireadh cunnartan tèarainteachd dhan uidheam is dàta phearsanta agad no gun dochainn seo an t-uidheam agad.
  \resources\DeveloperMode_SurfaceHub_UnlockWarningText:
    Candidate Language=GD-GB: Ma chuireas tu air gleusan an luchd-leasachaidh, a’ gabhail a-steach stàladh is ruith de dh’aplacaidean o àitichean eile seach Microsoft Store, dh’fhaoidte gun èireadh cunnartan tèarainteachd dhan uidheam is dàta phearsanta agad no gun dochainn seo an t-uidheam agad. Cha sgioblaich an t-uidheam susbaint no ainmean-cleachdaichean is faclan-faire ann am modh an luchd-leasachaidh.
  \resources\DeveloperMode_SurfaceHub_ResetText:
    Candidate Language=GD-GB: Chan eil e furasta modh an luchd-leasachaidh fhàgail – feumaidh tu an t-uidheam seo ath-shuidheachadh gu tur.
  \resources\DeveloperMode_LinkText:
    Candidate Language=GD-GB: Barrachd fiosrachaidh.
  \resources\DeveloperMode_HeaderText:
    Candidate Language=GD-GB: Cleachd gleusan luchd-leasachaidh
