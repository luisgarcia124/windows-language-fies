  \resources\Uninstall_PasswordWarning_SignIn\Text:
    Candidate Language=GD-GB: Chan urrainn dhut clàradh a-steach as aonais.
  \resources\Uninstall_PasswordWarning_Header:
    Candidate Language=GD-GB: Na glais thu fhèin às
  \resources\Uninstall_PasswordWarning_Desc_WindowsBlue:
    Candidate Language=GD-GB: Ma chleachd thu facal-faire airson clàradh a-steach air Windows 8.1, dèan cinnteach gu bheil cuimhne agad air.
  \resources\Uninstall_PasswordWarning_Desc_Windows8:
    Candidate Language=GD-GB: Ma chleachd thu facal-faire airson clàradh a-steach air Windows 8, dèan cinnteach gu bheil cuimhne agad air.
  \resources\Uninstall_PasswordWarning_Desc_Windows7:
    Candidate Language=GD-GB: Ma chleachd thu facal-faire airson clàradh a-steach air Windows 7, dèan cinnteach gu bheil cuimhne agad air.
  \resources\Uninstall_PasswordWarning_Desc_Windows10:
    Candidate Language=GD-GB: Ma chleachd thu facal-faire airson clàradh a-steach air Windows 10, dèan cinnteach gu bheil cuimhne agad air.
  \resources\Uninstall_PasswordWarning_Desc_Default:
    Candidate Language=GD-GB: Ma chleachd thu facal-faire air an t-seann-tionndadh de Windows agad, dèan cinnteach gu bheil cuimhne agad air.
  \resources\Uninstall_PasswordWarning_Desc_Build:
    Candidate Language=GD-GB: Ma chleachd thu facal-faire airson clàradh a-steach air a’ build roimhe sin, dèan cinnteach gu bheil cuimhne agad air.
  \resources\Uninstall_NewProfile_One:
    Candidate Language=GD-GB: Chruthaich thu cunntas:
  \resources\Uninstall_NewProfile_HowTo\Text:
    Candidate Language=GD-GB: Rach gu “Roghainnean” > “Cunntasan” > “Daoine eile” gus na cunntasan seo a thoirt air falbh is feuch ris a-rithist an uairsin.
  \resources\Uninstall_NewProfile_Header:
    Candidate Language=GD-GB: Thoir air falbh na cunntasan ùra
  \resources\Uninstall_NewProfile_FormatMany:
    Candidate Language=GD-GB: Chruthaich thu %d cunntas(an):
  \resources\Uninstall_NewProfile_Desc\Text:
    Candidate Language=GD-GB: Mus urrainn dhut tilleadh gu seann-tionndadh de Windows, feumaidh tu cunntas cleachdaiche sam bith a chuir thu ris an dèidh an àrdachaidh mu dheireadh a thoirt air falbh. Feumaidh sinn na cunntasan seo a thoirt air falbh gu tur, a’ gabhail a-steach nam pròifilean aca.
  \resources\Uninstall_MovedProfile_One:
    Candidate Language=GD-GB: Ghluais thu cunntas:
  \resources\Uninstall_MovedProfile_Header:
    Candidate Language=GD-GB: Till na cunntasan
  \resources\Uninstall_MovedProfile_FormatMany:
    Candidate Language=GD-GB: Ghluais thu %d cunntas(an):
  \resources\Uninstall_MovedProfile_Desc\Text:
    Candidate Language=GD-GB: Mus urrainn dhut tilleadh gu seann-tionndadh de Windows, feumaidh tu cunntas cleachdaiche sam bith a ghluais thu an dèidh an àrdachaidh mu dheireadh dhan àite tùsail aca.
  \resources\Uninstall_MissingExternal_Desc\Text:
    Candidate Language=GD-GB: Chan urrainn dhuinn do thilleadh gu seann-tionndadh de Windows a chionn ’s gu bheil an draibh flash USB no draibh so-ghiùlain eile a chleachd thu rè an àrdachaidh mu dheireadh a dhìth. Cuir a-steach an diosg is feuch ris a-rithist.
  \resources\Uninstall_InsufficientSpace_Format:
    Candidate Language=GD-GB: Airson tilleadh, feumaidh tu %ws a dh’àite saor air an draibh far a bheil Windows stàlaichte.
  \resources\Uninstall_InsufficientSpace_Desc\Text:
    Candidate Language=GD-GB: Saoraich rum is feuch ris a-rithist.
  \resources\Uninstall_Information_Programs_Window7:
    Candidate Language=GD-GB: • Bidh agad ri cuid a phrògraman a stàladh às ùr.
  \resources\Uninstall_Information_LoseChanges_Windows10:
    Candidate Language=GD-GB: • Caillidh tu atharrachadh sam bith a rinn thu sna roghainnean an dèidh dhut am build as ùire a stàladh.
  \resources\Uninstall_Information_LoseChanges_Build:
    Candidate Language=GD-GB: • Caillidh tu atharrachadh sam bith a rinn thu sna roghainnean an dèidh dhut am build as ùire a stàladh.
  \resources\Uninstall_Information_LoseChanges:
    Candidate Language=GD-GB: •  Caillidh tu atharrachadh sam bith a rinn thu sna roghainnean an dèidh dhut àrdachadh gu Windows 11.
  \resources\Uninstall_Information_ListDesc\Text:
    Candidate Language=GD-GB: An dèidh dhut tilleadh:
  \resources\Uninstall_Information_Header:
    Candidate Language=GD-GB: Fiosrachadh feumail
  \resources\Uninstall_Information_Desc\Text:
    Candidate Language=GD-GB: Dh’fhaoidte gun toir seo greis agus chan urrainn dhut am PC agad a chleachdadh gus am bi e deiseil leis. Cum am PC agad air is ceangailte ri bun-dealain.
  \resources\Uninstall_Information_BackupWarning\Text:
    Candidate Language=GD-GB: Na chruthaich thu lethbhreac-ghlèidhidh dhe na faidhlichean agad? Cha bu chòir buaidh a bhith orra ach ’s fhearr a bhith cinnteach.
  \resources\Uninstall_Information_AppsAndPrograms:
    Candidate Language=GD-GB: • Bidh agad ri cuid a phrògraman is aplacaidean a stàladh às ùr.
  \resources\Uninstall_GoBack_WindowsBlue:
    Candidate Language=GD-GB: Till gu Windows 8.1
  \resources\Uninstall_GoBack_Windows8:
    Candidate Language=GD-GB: Till gu Windows 8
  \resources\Uninstall_GoBack_Windows7:
    Candidate Language=GD-GB: Till gu Windows 7
  \resources\Uninstall_GoBack_Windows10:
    Candidate Language=GD-GB: Till gu Windows 10
  \resources\Uninstall_GoBack_Other:
    Candidate Language=GD-GB: Till gu build roimhe seo
  \resources\Uninstall_GoBack_Default:
    Candidate Language=GD-GB: Till gun tionndadh roimhe de Windows
  \resources\Uninstall_Expired_Desc\Text:
    Candidate Language=GD-GB: Chan urrainn dhuinn do thilleadh gun tionndadh roimhe de Windows a chionn ’s gu bheil an t-àrdachadh barrachd air 10 làithean air ais.
  \resources\Uninstall_Error_Header:
    Candidate Language=GD-GB: Tha sinn duilich ach chan urrainn dhut tilleadh
  \resources\Uninstall_Error_Desc\Text:
    Candidate Language=GD-GB: Cha deach atharrachadh sam bith a dhèanamh.
  \resources\Uninstall_Confirmation_Header:
    Candidate Language=GD-GB: Tapadh leat airson Windows 11 fheuchainn
  \resources\Uninstall_Confirmation_Desc\Text:
    Candidate Language=GD-GB: Ma bhios tu ag ionndrainn gleusan nas fheàrr airson lorg, tèarainteachd is tòiseachadh, ’s urrainn dhut tilleadh gu Windows 11 uair sam bith.
  \resources\Uninstall_ConfirmationBuild_Header:
    Candidate Language=GD-GB: Tapadh leat airson am build seo fheuchainn
  \resources\Uninstall_ConfirmationBuild_Desc\Text:
    Candidate Language=GD-GB: Stàlaichidh sinn an ath build ro-sheallaidh dhut nuair a bhios e ri fhaighinn.
  \resources\Uninstall_CheckUpdates_Yes\Content:
    Candidate Language=GD-GB: Thoir sùil airson ùrachaidhean
  \resources\Uninstall_CheckUpdates_No\Content:
    Candidate Language=GD-GB: Cha stàlaich, mòran taing
  \resources\Uninstall_CheckUpdates_Header:
    Candidate Language=GD-GB: A bheil thu airson sùil a thoirt airson ùrachaidhean?
  \resources\Uninstall_CheckUpdates_Desc\Text:
    Candidate Language=GD-GB: Mus dèan thu tilleadh, feuch is stàlaich na h-ùrachaidhean. Dh’fhaoidte gun cuir sin ceart na duilgheadasan a th’ agad.
  \resources\Uninstall_CheckUpdatesError_Header:
    Candidate Language=GD-GB: Cha deach leinn fiosrachadh air ùrachaidhean fhaighinn
  \resources\Uninstall_CheckUpdatesError_Desc\Text:
    Candidate Language=GD-GB: Airson ùrachaidhean fhaighinn, rach gu “Roghainnean” > “Windows Update” is tagh “Thoir sùil airson ùrachaidhean”.
  \resources\Uninstall_BitLockerOffToOn_Header:
    Candidate Language=GD-GB: Cuir dheth BitLocker
  \resources\Uninstall_BitLockerOffToOn_Desc\Text:
    Candidate Language=GD-GB: Chaidh BitLocker a chur air an cois àrdachaidh. Feumaidh tu BitLocker a chur dheth mus urrainn dhut tilleadh.
  \resources\Uninstall_BatteryError_Desc\Text:
    Candidate Language=GD-GB: Chan urrainn dhut tilleadh air cumhachd bataraidh a-mhàin. Ceangail am PC agad ri bun-dealain is feuch ris a-rithist.
  \resources\TroubleshootActivation_ReactivationLinkText:
    Candidate Language=GD-GB: Rinn mi atharrachadh air a’ bhathar-chruaidh air an uidheam seo o chionn goirid
  \resources\TroubleshootActivation_OfflineText:
    Candidate Language=GD-GB: Chan urrainn dhuinn an lethbhreac de Windows agad a ghnìomhachadh. Dèan cinnteach gu bheil ceangal agad ris an eadar-lìon is feuch ris a-rithist.
  \resources\TroubleshootActivation_NoSolutionText:
    Candidate Language=GD-GB: Cha b’ urrainn dhuinn Windows a ghnìomhachadh air an uidheam seo.
  \resources\TroubleshootActivation_NoSolutionNoStoreText:
    Candidate Language=GD-GB: Chan urrainn dhuinn an lethbhreac de Windows agad a ghnìomhachadh. Dèan cinnteach gu bheil ceangal agad ris an eadar-lìon is feuch ris a-rithist. Ma tha thu ceangailte ris an eadar-lìon agus ma chì thu an duilgheadas seo a-rithist ’s a-rithist, cuir fios gu rianaire an t-siostaim agad airson barrachd fiosrachaidh.
  \resources\TroubleshootActivation_MediaCreationText:
    Candidate Language=GD-GB: Lorg sinn ceadachas digiteach %1 airson an uidheim seo a tha a’ ruith %2. Feumaidh tu %1 a stàladh mus urrainn dhut an ceadachas digiteach seo a ghnìomhachadh.
  \resources\TroubleshootActivation_LearnMoreText:
    Candidate Language=GD-GB: Faigh barrachd fiosrachaidh mu ghnìomhachadh Windows
  \resources\TroubleshootActivation_LaunchReactivationErrorText:
    Candidate Language=GD-GB: Chan urrainn dhuinn Windows ath-ghnìomhachadh an-dràsta fhèin. Feuch ris a-rithist an ceann greis.
  \resources\TroubleshootActivation_GoToStoreText:
    Candidate Language=GD-GB: ’S urrainn dhut an t-uidheam seo a ghnìomhachadh air dòigh eile ’s tu a’ tadhal air an Store gus fìor-lethbhreac dhe Windows a cheannach.
  \resources\TroubleshootActivation_GetHelpText:
    Candidate Language=GD-GB: Cuir fios gu sgioba na taice airson cobhair
  \resources\TroubleshootActivation_FinishedHeaderText:
    Candidate Language=GD-GB: Choilean fuasglaiche nan trioblaidean
  \resources\TroubleshootActivation_Error_StoreErrors:
    Candidate Language=GD-GB: Cha b’ urrainn dhuinn conaltradh leis na frithealaichean gnìomhachaidh againn air adhbhar air choireigin. Fuirich ort beagan mhionaidean is feuch ris a-rithist. (0x%08x)
  \resources\TroubleshootActivation_Error_ServiceDisabled:
    Candidate Language=GD-GB: Tha seirbheis Windows èiginneach ann nach ruig sinn. Dèan cinnteach gu bheil ceangal agad ris an eadar-lìon, fuirich corra mionaid is feuch ris a’ ghnìomhachadh a-rithist uaireigin eile. (0x%08x)
  \resources\TroubleshootActivation_Error_HardwareChanged:
    Candidate Language=GD-GB: Tha coltas gun do dh’atharraich am bathar-cruaidh air an uidheam seo. Dèan cinnteach gu bheil ceangal agad ris an eadar-lìon is feuch ris a-rithist uaireigin eile. (0x%08x)
  \resources\TroubleshootActivation_EditionUpgradeText:
    Candidate Language=GD-GB: Lorg sinn ceadachas digiteach %1 airson an uidheim seo a tha a’ ruith %2. Tagh “Àrdaich an tionndadh de Windows agad” airson an ceadachas digiteach seo a ghnìomhachadh.
  \resources\TroubleshootActivation_EditionUpgradeButtonText:
    Candidate Language=GD-GB: Àrdaich an tionndadh de Windows agad
  \resources\TroubleshootActivation_DiagnosisText:
    Candidate Language=GD-GB: A’ lorg duilgheadasan gnìomhachaidh...
  \resources\TroubleshootActivation_DiagnosisHeaderText:
    Candidate Language=GD-GB: Gnìomhachadh Windows
  \resources\TroubleshootActivation_DiagnosisErrorText_Volume:
    Candidate Language=GD-GB: Bhris rudeigin a-steach air fuasgladh an duilgheadais. Dèan cinnteach gu bheil ceangal agad ris an eadar-lìon, fuirich corra mionaid is feuch ris a-rithist. Cuir fios gu rianaire an t-siostaim agad airson barrachd fiosrachaidh. (0x%08x)
  \resources\TroubleshootActivation_DiagnosisErrorText:
    Candidate Language=GD-GB: Bhris rudeigin a-steach air fuasgladh an duilgheadais. Dèan cinnteach gu bheil ceangal agad ris an eadar-lìon, fuirich corra mionaid is feuch ris a-rithist. (0x%08x)
  \resources\TroubleshootActivation_ChannelChangeText:
    Candidate Language=GD-GB: Lorg sinn ceadachas digiteach airson %1. Tagh “Cuir an gnìomh Windows” airson an t-uidheam seo a ghnìomhachadh.
  \resources\TroubleshootActivation_ChannelChangeButtonText:
    Candidate Language=GD-GB: Gnìomhaich Windows
  \resources\TroubleshootActivation_ActivatedText:
    Candidate Language=GD-GB: Tha sinn air an lethbhreac seo dhe Windows a ghnìomhachadh.
  \resources\SystemSettings_ViewWifiPassword_WindowHeaderTitle_Format:
    Candidate Language=GD-GB: Iuchair tèarainteachd %1
  \resources\SystemSettings_SurfaceHub_BitLocker_ExportRecoveryKey_Title:
    Candidate Language=GD-GB: Sàbhail iuchair aiseag BitLocker
  \resources\SystemSettings_SurfaceHub_BitLocker_ExportRecoveryKey_Succeeded:
    Candidate Language=GD-GB: Chaidh an iuchair aisig agad a shàbhaladh air %ws gu soirbheachail.
  \resources\SystemSettings_SurfaceHub_BitLocker_ExportRecoveryKey_Saving:
    Candidate Language=GD-GB: Ga shàbhaladh dhan draibh USB
  \resources\SystemSettings_SurfaceHub_BitLocker_ExportRecoveryKey_Error_NoDrive:
    Candidate Language=GD-GB: Gus iuchair aiseag BitLocker a shàbhaladh, cuir draibh USB a-steach dhan uidheam an toiseach.
  \resources\SystemSettings_SurfaceHub_BitLocker_ExportRecoveryKey_Error_Header:
    Candidate Language=GD-GB: Cha b' urrainn dhuinn iuchair aiseag BitLocker a shàbhaladh
  \resources\SystemSettings_SurfaceHub_BitLocker_ExportRecoveryKey_Error_Generic:
    Candidate Language=GD-GB: Dh'fheuch sinn ris an iuchair aiseag BitLocker agad a shàbhaladh ach bha mearachd ann (còd na mearachd 0x%08X). Am feuch thu ris a-rithist?
  \resources\SystemSettings_CapabilityAccess_webcam_SystemGlobal:
