    Candidate Language=GD-GB: Ainm an às-dùnaidh: 
  \resources\EulaContent\[using:Windows.UI.Xaml.Automation]AutomationProperties\Name:
    Candidate Language=GD-GB: Teirmichean a’ cheadachais airson bathar-bog Microsoft
  \resources\EnterProductKey_UpgradeProgressText:
    Candidate Language=GD-GB: %d%% coileanta
  \resources\EnterProductKey_UpgradeProgressInstructionsText:
    Candidate Language=GD-GB: Faodaidh gun toir seo greiseag. Na cuir dheth am PC agad.
  \resources\EnterProductKey_UpgradeProgressHeaderText:
    Candidate Language=GD-GB: Ag ullachadh an àrdachaidh
  \resources\EnterProductKey_UpgradePageHeaderText:
    Candidate Language=GD-GB: Àrdaich an tionndadh de Windows agad
  \resources\EnterProductKey_UpgradeInstructions2Text:
    Candidate Language=GD-GB: Bidh an t-àrdachadh greis agus thèid an t-uidheam seo ath-thòiseachadh. Chan urrainn dhut an t-uidheam seo a chleachdadh gus an coilean e.
  \resources\EnterProductKey_UpgradeInstructions1Text:
    Candidate Language=GD-GB: Ma nì thu àrdachadh, gheibh thu gleusan ùra ann an Windows. Mus tòisich thu air a sin, dèan cinnteach gun do shàbhail thu d’ obair is gun do dhùin thu aplacaid sam bith.
  \resources\EnterProductKey_UpgradeGvlkWarningText:
    Candidate Language=GD-GB: Airson gnìomhachadh a dhèanamh le iuchair a’ bhathair seo an dèidh dhut an tionndadh de Windows àrdachadh, feumaidh an t-uidheam seo ceangal ri seirbheis gnìomhachadh a’ bhuidhinn agad.
  \resources\EnterProductKey_UpgradeErrorText:
    Candidate Language=GD-GB: Chan urrainn dhuinn an tionndadh de Windows agad àrdachadh. Feuch is àrdaich an tionndadh de Windows agad a-rithist. (0x%08x)
  \resources\EnterProductKey_UpgradeErrorHeaderText:
    Candidate Language=GD-GB: Chan urrainn dhuinn an tionndadh a tha agad àrdachadh
  \resources\EnterProductKey_UpgradeButtonText:
    Candidate Language=GD-GB: Tòisich
  \resources\EnterProductKey_PlaceholderText:
    Candidate Language=GD-GB: XXXXX-XXXXX-XXXXX-XXXXX-XXXXX
  \resources\EnterProductKey_LabelText:
    Candidate Language=GD-GB: Iuchair a’ bhathair
  \resources\EnterProductKey_InvalidKey:
    Candidate Language=GD-GB: Cha do dh’obraich iuchair a’ bhathair a chuir thu a-steach. Thoir sùil air iuchair a’ bhathair is feuch ris a-rithist no cuir a-steach tè eile. (0x%08x)
  \resources\EnterProductKey_InvalidCharacters:
    Candidate Language=GD-GB: Cha nochd cuid dhe na caractaran seo ann an iuchair a’ bhathair.
  \resources\EnterProductKey_InstructionsText:
    Candidate Language=GD-GB: Bu chòir gun d’fhuair thu iuchair a’ bhathair agad ann am post-d on bhuidheann a reic no sgaoil Windows dhut no air a’ bhogsa san robh an DVD no USB Windows.
  \resources\EnterProductKey_HeaderText:
    Candidate Language=GD-GB: Cuir a-steach iuchair bathair
  \resources\EnterProductKey_GvlkWarningText:
    Candidate Language=GD-GB: Airson gnìomhachadh a dhèanamh le iuchair a’ bhathair seo, feumaidh an t-uidheam seo ceangal ri seirbheis gnìomhachadh a’ bhuidhinn agad.
  \resources\EnterProductKey_GoToStoreErrorText:
    Candidate Language=GD-GB: Chan urrainn dhuinn an Store fhosgladh an-dràsta. Feuch ris a-rithist an ceann greis.
  \resources\EnterProductKey_GoToStoreDescriptionText:
    Candidate Language=GD-GB: ’S urrainn dhut an t-uidheam seo a ghnìomhachadh air dòigh eile cuideachd ’s tu a’ tadhal air an Store gus fìor-lethbhreac dhe Windows a cheannach.
  \resources\EnterProductKey_GoToStoreButtonText:
    Candidate Language=GD-GB: Tadhail air an Store
  \resources\EnterProductKey_EulaLinkText:
    Candidate Language=GD-GB: Leugh teirmichean ceadachas bathar-bog Microsoft
  \resources\EnterProductKey_EulaErrorText:
    Candidate Language=GD-GB: Chan urrainn dhuinn teirmichean ceadachas bathar-bog Microsoft a luchdadh an-dràsta fhèin. Feuch ris a-rithist an ceann greis. (0x%08x)
  \resources\EnterProductKey_Error_WrongSku:
    Candidate Language=GD-GB: Tha thu a’ ruith %WINDOWS_LONG%. Chuir thu a-steach iuchair bathair nach eil iomchaidh airson gnìomhachadh an tionndaidh seo. (0x%08x)
  \resources\EnterProductKey_Error_UsedProductKey:
    Candidate Language=GD-GB: Cha urrainn dhuinn Windows a ghnìomhachadh air an uidheam seo a chionn ’s gun deach iuchair a’ bhathair a chleachdadh air uidheam eile mu thràth. Cuir a-steach iuchair bathair eile. (0x%08x)
  \resources\EnterProductKey_Error_ServiceDown:
    Candidate Language=GD-GB: Tha seo a’ cur nàire mhòr oirnn. Tha an t-seirbheis ghnìomhachadh sìos. Tha sinn ag obair air an duilgheadas. (0x%08x)
  \resources\EnterProductKey_Error_ServerInvalidKey:
    Candidate Language=GD-GB: Cha do dh’obraich iuchair a’ bhathair a chuir thu a-steach. Thoir sùil air iuchair a’ bhathair is feuch ris a-rithist no cuir a-steach tè eile. (0x%08x)
  \resources\EnterProductKey_Error_ServerBlockedKey:
    Candidate Language=GD-GB: Chan urrainnear Windows a ghnìomhachadh le iuchair a’ bhathair seo. Feuch iuchair eile. (0x%08x)
  \resources\EnterProductKey_Error_NotActivated:
    Candidate Language=GD-GB: Chan urrainnear Windows a ghnìomhachadh le iuchair a’ bhathair seo. Tadhail air na roghainnean airson barrachd fiosrachaidh. (0x%08x)
  \resources\EnterProductKey_Error_NoInternet:
    Candidate Language=GD-GB: Chan urrainn dhuinn Windows a ghnìomhachadh a chionn ’s nach eil na frithealaichean gnìomhachaidh againn ag obair an-dràsta fhèin. Dèan cinnteach gu bheil ceangal agad ris an eadar-lìon agus gnìomhaichidh sinn Windows cho luath ’s a bhios an t-seirbheis air ais. (0x%08x)
  \resources\EnterProductKey_Error_NoFreeUpgrade:
    Candidate Language=GD-GB: Cha urrainn dhuinn Windows a ghnìomhachadh air an uidheam seo a chionn ’s nach eil e dligheach tuilleadh. Cuir a-steach iuchair bathair eile. (0x%08x)
  \resources\EnterProductKey_Error_InvalidUpgrade:
    Candidate Language=GD-GB: Cha deach an t-uidheam seo a ghnìomhachadh. Dh’fhàillig dearbhadh iuchair a’ bhathair mu choinneamh an àrdachaidh. (0x%08x)
  \resources\EnterProductKey_Error_CloudErrorFormat:
    Candidate Language=GD-GB: %s (0x%08x)
  \resources\EnterProductKey_CloseButtonText:
    Candidate Language=GD-GB: Dùin
  \resources\EnterProductKey_ActivationErrorHeaderText:
    Candidate Language=GD-GB: Chan urrainn dhuinn Windows a ghnìomhachadh
  \resources\EnterProductKey_ActivatePageHeaderText:
    Candidate Language=GD-GB: Gnìomhaich Windows
  \resources\EnterProductKey_ActivatedText:
    Candidate Language=GD-GB: Tha sinn air an lethbhreac seo dhe Windows a ghnìomhachadh.
  \resources\EnterProductKey_ActivatedHeaderText:
    Candidate Language=GD-GB: Chaidh Windows a ghnìomhachadh
  \resources\EnterProductKey_ActivateButtonText:
