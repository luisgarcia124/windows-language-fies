  \resources\SetSurfaceHubDeviceAccount_COULDNT_FIND_EXCHANGE_ADDRESS:
    Candidate Language=GD-GB: Dh'fheuch sinn ris an fhrithealaiche Exchange a lorg sinn fhìn ach dh'fhairtlich oirnn. Cuir a-steach am frithealaiche Exchange ach an urrainn dhan uidheam post-d 's am mìosachan a chleachdadh
  \resources\SetSurfaceHubDeviceAccount_CompleteHeaderText:
    Candidate Language=GD-GB: Chaidh cunntas an uidheim atharrachadh
  \resources\SetSurfaceHubDeviceAccount_CompleteDoneButtonText:
    Candidate Language=GD-GB: Deiseil
  \resources\SetSurfaceHubDeviceAccount_COMMON_GENERIC_ERROR_STAGE_UNKNOWN:
    Candidate Language=GD-GB: Chaidh rudeigin cearr
  \resources\SetSurfaceHubDeviceAccount_COMMON_GENERIC_ERROR_STAGE_EXCHANGE_VALIDATION:
    Candidate Language=GD-GB: Cha b' urrainn dhuinn an seòladh Exchange a dhearbhadh
  \resources\SetSurfaceHubDeviceAccount_COMMON_GENERIC_ERROR_STAGE_EXCHANGE_POLICIES:
    Candidate Language=GD-GB: Cha b' urrainn dhuinn poileasaidhean Exchange Active Sync a dhearbhadh
  \resources\SetSurfaceHubDeviceAccount_COMMON_GENERIC_ERROR_STAGE_EXCHANGE_DISCOVERY:
    Candidate Language=GD-GB: Cha do lorg sinn an seòladh Exchange
  \resources\SetSurfaceHubDeviceAccount_COMMON_GENERIC_ERROR_STAGE_ACCOUNT_POPULATION:
    Candidate Language=GD-GB: Cha b' urrainn dhuinn Active Directory a leughadh
  \resources\SetSurfaceHubDeviceAccount_COMMON_GENERIC_ERROR_STAGE_ACCOUNT_PERSISTING:
    Candidate Language=GD-GB: Cha b' urrainn dhuinn fiosrachadh a' chunntais a shàbhaladh
  \resources\SetSurfaceHubDeviceAccount_COMMON_GENERIC_ERROR_PERSIST_ACCOUNT_INFORMATION:
    Candidate Language=GD-GB: Cha ghabh fiosrachadh a' chunntais a stòradh
  \resources\SetSurfaceHubDeviceAccount_COMMON_GENERIC_ERROR:
    Candidate Language=GD-GB: %1. Thachair sinn ris a' mhearachd a leanas: %2.
  \resources\SetSurfaceHubDeviceAccount_CalendarSyncEnabledText:
    Candidate Language=GD-GB: Cuir an comas seirbheisean Exchange
  \resources\SetSurfaceHubDeviceAccount_activeSyncPoliciesWarning_Text8:
    Candidate Language=GD-GB: •  A' cur clàran-geala o OneNote slighe puist-d
  \resources\SetSurfaceHubDeviceAccount_activeSyncPoliciesWarning_Text7:
    Candidate Language=GD-GB: •  A'cur choinneamhan gu dol le Cortana
  \resources\SetSurfaceHubDeviceAccount_activeSyncPoliciesWarning_Text6:
    Candidate Language=GD-GB: •  Coinneamhan a ghabhas an cur gu dol on sgrìn-fhàilteachaidh
  \resources\SetSurfaceHubDeviceAccount_activeSyncPoliciesWarning_Text5:
    Candidate Language=GD-GB: •  Mìosachan air an sgrìn-fhàilteachaidh
  \resources\SetSurfaceHubDeviceAccount_activeSyncPoliciesWarning_Text4:
    Candidate Language=GD-GB: Ma leanas tu air adhart gun a bhith ag ath-rèiteachadh nam poileasaidhean, bidh na gleusan a leanas à comas:
  \resources\SetSurfaceHubDeviceAccount_activeSyncPoliciesWarning_Text3:
    Candidate Language=GD-GB: Dèan cinnteach gun deach False a thaghadh airson a' phoileasaidh DevicePasswordEnabled. 'S urrainn dhut am poileasaidh ath-rèiteachadh agus feuchainn ris a-rithist gus dèanamh cinnteach gun deach cunntas an uidheim a shuidheachadh mar bu chòir agus airson 's gum faigh thu cothrom air seirbheisean Exchange.
  \resources\SetSurfaceHubDeviceAccount_activeSyncPoliciesWarning_Text2:
    Candidate Language=GD-GB: •  poileasaidhean ActiveSync policies nach eil an t-uidheam seo a' cur taic riutha
  \resources\SetSurfaceHubDeviceAccount_activeSyncPoliciesWarning_Text1:
    Candidate Language=GD-GB: Thug thu seachad cunntas a chaidh a rèiteachadh le:
  \resources\SetSurfaceHubDeviceAccount_activeSyncPoliciesWarning_HeaderText:
    Candidate Language=GD-GB: Tha duilgheadas ann leis a' chunntas seo
  \resources\SetGeolocationMaster_DescriptionText:
    Candidate Language=GD-GB: Tha seirbheisean ionaid airson an uidheim seo
  \resources\SetFindMyDevice_DescriptionText:
    Candidate Language=GD-GB: Sàbhail far a bheil an t-uidheam agam o àm gu àm
  \resources\RetailDemoConfirm_ReconfigNextButtonText:
    Candidate Language=GD-GB: Ath-rèitich
  \resources\RetailDemoConfirm_ReconfigHeaderText:
    Candidate Language=GD-GB: Ath-rèitich am PC demo
  \resources\RetailDemoConfirm_ReconfigBodyText:
    Candidate Language=GD-GB: Ma nì thu ath-rèiteachadh air a’ PC, ’s urrainn dhut Retail Access Code (RAC) an uidheim atharrachadh airson greim fhaighinn air susbaint demo ghnàthaichte.
  \resources\RetailDemoConfirm_NextButtonText:
    Candidate Language=GD-GB: Tòisich
  \resources\RetailDemoConfirm_HeaderText:
    Candidate Language=GD-GB: Tòisich an demo meanbh-reic
  \resources\RetailDemoConfirm_CancelButtonText:
    Candidate Language=GD-GB: Sguir dheth
  \resources\RetailDemoConfirm_BodyText2:
    Candidate Language=GD-GB: Feumaidh ceangal ris an eadar-lìon a bhith aig a’ PC. Agus ma thòisicheas tu an demo meanbh-reic, thèid susbaint phearsanta sam bith a sguabadh às agus am PC aiseag mar a thàinig e às an fhactaraidh.
  \resources\RetailDemoConfirm_BodyText1:
    Candidate Language=GD-GB: Tha thu an impis demo meanbh-reic a thòiseachadh, rud a chaidh a dhealbhadh do chleachdadh ann am meanbh-reic a-mhàin.
  \resources\RetailDemoConfirmError_ReconfigHeaderText:
    Candidate Language=GD-GB: Cha ghabh am PC demo agad ath-rèiteachadh
  \resources\RetailDemoConfirmError_ReconfigBodyText1:
    Candidate Language=GD-GB: Chan urrainn dhuinn ceangal ris an eadar-lìon is feumaidh am PC agad ceangal mus urrainn dha modh an demo meanbh-reic ath-rèiteachadh.
  \resources\RetailDemoConfirmError_HeaderText:
    Candidate Language=GD-GB: Cha ghabh an demo meanbh-reic a thòiseachadh
  \resources\RetailDemoConfirmError_CancelButtonText:
    Candidate Language=GD-GB: Dùin
  \resources\RetailDemoConfirmError_BodyText2:
    Candidate Language=GD-GB: Thoir sùil air a’ cheangal is feuch ris a-rithist.
  \resources\RetailDemoConfirmError_BodyText1:
    Candidate Language=GD-GB: Chan urrainn dhuinn ceangal ris an eadar-lìon is feumaidh am PC agad ceangal mus urrainn dha modh an demo meanbh-reic a thòiseachadh.
  \resources\RestartNow:
    Candidate Language=GD-GB: Ath-thòisich an-dràsta
  \resources\RestartLater:
    Candidate Language=GD-GB: Ath-thòisich uaireigin eile
  \resources\RenamePC_SAME_COMPUTER_NAME_ErrorText:
    Candidate Language=GD-GB: Tha ainm a' PC seo ga chleachdadh mu thràth. Cuir a-steach ainm eile.
  \resources\RenamePC_RENAME_FAIL_ErrorText:
    Candidate Language=GD-GB: Tha sinn duilich ach cha ghabh ainm a' PC agad atharrachadh.
  \resources\RenamePC_NON_RFC_COMPUTER_NAME_TITLE_ErrorText:
    Candidate Language=GD-GB: Chan eil ainm a' PC dligheach.
  \resources\RenamePC_NON_RFC_COMPUTER_NAME_SYNTAX_ErrorText:
    Candidate Language=GD-GB: Chan eil ainm a' PC dligheach.
  \resources\RenamePC_NextButtonText:
    Candidate Language=GD-GB: Sàbhail
  \resources\RenamePC_NewComputerNamePlaceholderText:
    Candidate Language=GD-GB: Thoir ainm air an uidheam agad
  \resources\RenamePC_HeaderText:
    Candidate Language=GD-GB: Thoir ainm ùr air a' PC agad
  \resources\RenamePC_ERROR_BAD_CREDENTIALS:
    Candidate Language=GD-GB: Cha do dh'obraich am fiosrachadh sin. Thoir sùil air ainm is facal-faire a' chunntais agad is feuch ris a-rithist.
  \resources\RenamePC_EMPTY_NAME_ErrorText:
    Candidate Language=GD-GB: Cuir a-steach ainm airson a' PC agad.
  \resources\RenamePC_DUPLICATE_NAME_ErrorText:
    Candidate Language=GD-GB: Tha ainm a' PC seo ga chleachdadh mu thràth. Cuir a-steach ainm eile.
  \resources\RenamePC_DIFFERENT_CANONICAL_NAME_ErrorText:
    Candidate Language=GD-GB: Chan obraich an t-ainm sin airson a' PC. Tagh fear nach eil a' tòiseachadh le àireamh is feuch ris a-rithist.
  \resources\RenamePC_CurrentPCNameText:
    Candidate Language=GD-GB: Ainm a’ PC an-dràsta: %1
  \resources\RenamePC_ConfirmNextButtonText:
    Candidate Language=GD-GB: Ath-thòisich an-dràsta
  \resources\RenamePC_ConfirmHeaderText:
    Candidate Language=GD-GB: Thoir ainm ùr air a' PC agad
  \resources\RenamePC_ConfirmCancelButtonText:
    Candidate Language=GD-GB: Ath-thòisich uaireigin eile
  \resources\RenamePC_ConfirmBodyText:
    Candidate Language=GD-GB: Nuair a nì thu ath-thòiseachadh, thèid ainm a' PC atharrachadh gu: 
  \resources\RenamePC_COMPUTER_NAME_TOO_LONG_ErrorText:
    Candidate Language=GD-GB: Tha ainm a' PC a chuir thu a-steach ro fhada.
  \resources\RenamePC_COMPUTER_NAME_SAME_AS_PC_NAME_ErrorText:
    Candidate Language=GD-GB: Seo an t-ainm a tha air a' PC an-dràsta. Cuir a-steach ainm eile.
  \resources\RenamePC_COMPUTER_NAME_NUMERIC_ErrorText:
    Candidate Language=GD-GB: Feumaidh litir a bhith ann an ainm a' PC.
  \resources\RenamePC_COMPUTER_NAME_HAS_BAD_CHARS_ErrorText:
    Candidate Language=GD-GB: Chuir thu a-steach caractar no dhà nach obraich. Am feuch thu ri rudeigin eile?
  \resources\RenamePC_COMPUTER_NAME_ALL_NUMBERS_ErrorText:
    Candidate Language=GD-GB: Feumaidh co-dhiù aon litir a bhith ann an ainm a' PC agad.
  \resources\RenamePC_CancelButtonText:
    Candidate Language=GD-GB: Sguir dheth
  \resources\RenamePC_BodyText:
    Candidate Language=GD-GB: 'S urrainn dhut measgachadh de litrichean, tàthanan is àireamhan a chleachdadh.
  \resources\RenamePC_BAD_COMPUTER_NAME_SYNTAX_ErrorText:
    Candidate Language=GD-GB: Chan eil ainm a' PC dligheach.
  \resources\RenamePC_AuthBodyText:
    Candidate Language=GD-GB: Cuir a-steach fiosrachadh a' chunntais agad gus dèanamh cinnteach gu bheil cead agad an t-ainm atharrachadh.
  \resources\RenamePC_ACCESS_DENIED_ErrorText:
    Candidate Language=GD-GB: Cha ghabh ainm a' PC atharrachadh leis a' chunntas seo.
  \resources\RenamePC_AAD_UPDATE_FAIL_ErrorText:
    Candidate Language=GD-GB: Cha ghabh ainm a’ PC ùrachadh ann an Azure Active Directory.
  \resources\RemoveUser_HeaderText:
    Candidate Language=GD-GB: A bheil thu airson an cunntas is dàta a sguabadh às?
  \resources\RemoveUser_GeneralErrorText:
    Candidate Language=GD-GB: Cha b' urrainn dhuinn an cleachdaiche a thagh thu a sguabadh às gu tur. Tha cuid a dhàta aig a' chleachdaiche seo air an diosg fhathast, ma dh'fhaoidte.
  \resources\RemoveUser_DeleteUserButtonText:
    Candidate Language=GD-GB: Sguab an cunntas is dàta às
  \resources\RemoveUser_BodyText:
    Candidate Language=GD-GB: Ma sguabas tu cunntas an neach seo às, bheir seo air falbh na h-uile dàta aige/aice air a' PC seo, a' gabhail a-steach nithean air an deasg, luchdaidhean a-nuas, sgrìobhainnean, dealbhan, ceòl is faidhlichean eile. Mur deach lethbhreac-glèidhidh a dhèanamh dhen dàta seo no a shàbhaladh àiteigin eile a leithid PC eile, thèid e air chall.
  \resources\RemoveUserLoggedIn_HeaderText:
    Candidate Language=GD-GB: Cha ghabh an cunntas sguabadh às
  \resources\RemoveUserLoggedIn_BodyText:
    Candidate Language=GD-GB: Feumaidh an neach seo clàradh a-mach mus urrainn dhut an cunntas aige/aice a sguabadh às. 'S urrainn dhut cuideachd am PC agad ath-thòiseachadh gus a c(h)làradh a-mach gu fèin-obrachail.
  \resources\RemoveFamilyUser_HeaderText:
    Candidate Language=GD-GB: Bheir am ball seo dhen teaghlach air falbh on uidheam agad
  \resources\RemoveFamilyUser_BodyText:
    Candidate Language=GD-GB: Ma bheir thu air falbh am ball seo dhen teaghlach on uidheam seo, bidh iad nad bhuidheann-teaghlaich fhathast. Cha toir sinn air falbh ach an dàta aca on uidheam seo 's leis a sin, dèan cinnteach gu bheil lethbhreac-glèidhidh aca dhe na rudan aca air an desktop, na luchdaich iad a-nuas, na sgrìobhainnean, dealbhan is an ceòl aca. Cha bhi comas aig buill ùra dhen teaghlach clàradh a-steach dhan uidheam seo gu fèin-obrachail tuilleadh.
  \resources\RemoveExclusion_HeaderText:
    Candidate Language=GD-GB: Thoir air falbh an t-às-dùnadh
  \resources\RemoveExclusion_BodyText:
    Candidate Language=GD-GB: A bheil thu cinnteach gu bheil thu airson an t-às-dùnadh seo a thoirt air falbh?
  \resources\RemoveDomainUser_HeaderText:
    Candidate Language=GD-GB: Thoir an cunntas air falbh
  \resources\RemoveDomainUser_DeleteUserButtonText:
    Candidate Language=GD-GB: Thoir air falbh
  \resources\RemoveDomainUser_BodyText:
    Candidate Language=GD-GB: Ma bheir thu air falbh cead inntrigeadh a' chunntais seo, dh'fhaoidte nach gabh a chleachdadh tuilleadh airson clàradh a-steach air a' PC seo.
  \resources\RemoteDesktop_WindowTitle:
    Candidate Language=GD-GB: Roghainnean an desktop chèin
  \resources\RemoteDesktop_RegistryError_HeaderText:
    Candidate Language=GD-GB: Thoir sùil air roghainnean na clàr-lainn
  \resources\RemoteDesktop_RegistryError_BodyText:
    Candidate Language=GD-GB: Chaidh rudeigin cearr nuair a dh’fheuch sinn ris a’ chlàr-lann agad ùrachadh.
  \resources\RemoteDesktop_ProceedButtonText:
    Candidate Language=GD-GB: Lean air adhart co-dhiù
  \resources\RemoteDesktop_NextButtonText:
    Candidate Language=GD-GB: Dearbh
  \resources\RemoteDesktop_GenericError_HeaderText:
    Candidate Language=GD-GB: Chaidh rudeigin cearr
  \resources\RemoteDesktop_GenericError_BodyText:
    Candidate Language=GD-GB: Dùin na roghainnean ’s feuch ris a-rithist.
  \resources\RemoteDesktop_EnableFirewallError_HeaderText:
    Candidate Language=GD-GB: Chaidh an desktop cèin a bhacadh leis a’ chachaileith-theine agad
  \resources\RemoteDesktop_EnableFirewallError_BodyText:
    Candidate Language=GD-GB: Fosgail port 3389 airson an desktop cèin a leigeil tron chachaileith-theine agad.
  \resources\RemoteDesktop_DisableFirewallError_HeaderText:
    Candidate Language=GD-GB: Chaidh rudeigin cearr nuair a dh’fheuch sinn ri port cachaileith-theine an desktop chèin a dhùnadh
  \resources\RemoteDesktop_DisableFirewallError_BodyText:
    Candidate Language=GD-GB: Airson an desktop cèin a chur à comas, dùin port 3389 sa chachaileith-theine agad.
  \resources\RemoteDesktop_CloseButtonText:
    Candidate Language=GD-GB: Dùin
  \resources\RemoteDesktop_CancelButtonText:
    Candidate Language=GD-GB: Sguir dheth
  \resources\RDP_ProtectAccount_SignInButtonText:
    Candidate Language=GD-GB: Tadhail air na roghainnean clàraidh a-steach
  \resources\RDP_ProtectAccount_HeaderText:
    Candidate Language=GD-GB: Dìon an cunntas agad
  \resources\RDP_ProtectAccountDenied_BodyText:
    Candidate Language=GD-GB: Feumaidh tu dearbhadh a chur an sàs (mar Windows Hello, facal-faire no PIN) dhan chunntas seo mus urrainn dhut an desktop cèin a chur an comas.
  \resources\RDP_ProtectAccountAllowed_BodyText:
    Candidate Language=GD-GB: Chan fheum an cunntas agad dearbhadh airson clàradh a-steach dhan PC seo. Ma chuireas tu an comas an desktop cèin gun a bhith ag iarraidh dearbhadh, fàgaidh sin an coimpiutair agad fosgailte do dhaoine a nì inntrigeadh cèin gun chead.
  \resources\RDP_Enable_HeaderText:
    Candidate Language=GD-GB: A bheil thu airson an desktop cèin a chur an comas?
  \resources\RDP_Enable_Firewall_Part2_BodyText:
    Candidate Language=GD-GB: roghainnean adhartach na cachaileith-theine
  \resources\RDP_Enable_Firewall_Part1_BodyText:
    Candidate Language=GD-GB: Tha thu a’ fosgladh port an desktop chèin sa chachaileith-theine agad airson gach ceangal lìonraidh air a’ PC seo. Ma tha thu airson ceanglaichean a cheadachadh do lìonraidh sònraichte a-mhàin, fosgail  
  \resources\RDP_Enable_Firewall_Complete_BodyText:
    Candidate Language=GD-GB: Tha thu a’ fosgladh port an desktop chèin sa chachaileith-theine agad airson gach ceangal lìonraidh air a’ PC seo. Ma tha thu airson ceanglaichean a cheadachadh do lìonraidh sònraichte a-mhàin, fosgail roghainnean adhartach na cachaileith-theine.
  \resources\RDP_Enable_BodyText:
    Candidate Language=GD-GB: Bidh comas agad-sa agus aig na daoine a thagh thu fo “Chunntasan chleachdaichean” gus ceangal ris a’ PC seo o chèin.
  \resources\RDP_Disable_HeaderText:
    Candidate Language=GD-GB: A bheil thu airson an desktop cèin a chur à comas?
  \resources\PBR_WipeData_DriveListLink\Content:
    Candidate Language=GD-GB: Seall dhomh liosta nan draibhean air an toir e buaidh
  \resources\PBR_UninstallWarning_Header:
    Candidate Language=GD-GB: Ùrachadh o chionn goirid
  \resources\PBR_UninstallWarning_Desc\Text:
    Candidate Language=GD-GB: Chaidh am PC seo ùrachadh o chionn goirid. Ma leanas tu air adhart le ath-shuidheachadh a’ PC seo, chan urrainn dhut an t-ùrachadh a neo-dhèanamh.
  \resources\PBR_Title:
    Candidate Language=GD-GB: Ath-shuidhich am PC seo
  \resources\PBR_SessionPreparation_Header:
    Candidate Language=GD-GB: Ag ullachadh rudan
  \resources\PBR_SessionPreparation_Desc\Text:
    Candidate Language=GD-GB: Cha toir seo fada
  \resources\PBR_ResetTypeSelection_ResetOption_Desc:
    Candidate Language=GD-GB: Bheir seo air falbh na faidhlichean, aplacaidean is roghainnean pearsanta uile agad.
  \resources\PBR_ResetTypeSelection_ResetOption:
    Candidate Language=GD-GB: Thoir a h-uile rud air falbh
  \resources\PBR_ResetTypeSelection_RefreshOption_Desc:
    Candidate Language=GD-GB: Bheir seo air falbh na h-aplacaidean is roghainnean ach cumaidh e na faidhlichean pearsanta agad.
  \resources\PBR_ResetTypeSelection_RefreshOption:
    Candidate Language=GD-GB: Cum na faidhlichean agam
  \resources\PBR_ResetTypeSelection_Header:
    Candidate Language=GD-GB: Tagh roghainn
  \resources\PBR_ResetOptions_SummaryLine\Text:
    Candidate Language=GD-GB: Na roghainnean làithreach:
  \resources\PBR_ResetOptions_Header:
    Candidate Language=GD-GB: Roghainnean a bharrachd
  \resources\PBR_ResetOptions_AdvancedOptions:
    Candidate Language=GD-GB: Atharraich na roghainnean
  \resources\PBR_ResetCancellation_Header:
    Candidate Language=GD-GB: A' sgur dheth
  \resources\PBR_ResetCancellation_Desc\Text:
    Candidate Language=GD-GB: Cha toir seo fada
  \resources\PBR_Reset:
    Candidate Language=GD-GB: Ath-shuidhich
  \resources\PBR_RemovedAppsList_Header:
    Candidate Language=GD-GB: Liosta nan aplacaidean a tha ri thoirt air falbh
  \resources\PBR_RemovedAppsList_Desc\Text:
    Candidate Language=GD-GB: ’S urrainn dhut iomadh aplacaid ath-stàladh on Store ach feumaidh tu na h-aplacaidean a leanas a stàladh on lìon no o dhiosgaichean stàlaidh. Thèid an liosta de dh’aplacaidean seo a sàbhaladh air an deasg an dèidh an ath-shuidheachaidh.
  \resources\PBR_Note\Text:
    Candidate Language=GD-GB: An aire:
  \resources\PBR_MultipleUsersWarning_Header:
    Candidate Language=GD-GB: Tha daoine eile clàraichte a-steach dhan PC seo
  \resources\PBR_MultipleUsersWarning_Desc\Text:
    Candidate Language=GD-GB: A bheil thu airson leantainn air adhart? Chailleadh iad dàta sam bith nach deach a shàbhaladh.
  \resources\PBR_MeteredDataWarning_Format:
    Candidate Language=GD-GB: Dh'fhaoidte gun cleachd luchdadh a-nuas on neul barrachd air 4GB de dhàta. 'S e ceangal meadaraichte a tha agad agus dh'fhaoidte gun èirich cosgaisean dhut.
  \resources\PBR_LearnMore_Text\Text:
    Candidate Language=GD-GB: Barrachd fiosrachaidh mu ath-shuidheachadh a’ PC seo
  \resources\PBR_HelpToChoose\Content:
    Candidate Language=GD-GB: Cuidich leam a' dèanamh taghadh
  \resources\PBR_FinalPreparation_Header:
    Candidate Language=GD-GB: Ag ullachadh an ath-shuidheachaidh
  \resources\PBR_FinalPreparation_Format:
    Candidate Language=GD-GB: Staid: Ga ullachadh – %d%%
  \resources\PBR_FinalPreparation_Finalize:
    Candidate Language=GD-GB: Ga ullachadh gus ath-thòiseachadh
  \resources\PBR_FinalPreparation_Desc\Text:
    Candidate Language=GD-GB: Nì an t-uidheam ath-thòiseachadh gu fèin-obrachail
  \resources\PBR_FinalPreparation_CloudFormat:
    Candidate Language=GD-GB: Staid: Ga luchdadh a-nuas – %d%%
  \resources\PBR_Error_Header:
    Candidate Language=GD-GB: Cha b’ urrainn dhuinn am PC agad ath-shuidheachadh
  \resources\PBR_Error_Desc\Text:
    Candidate Language=GD-GB: Cha deach atharrachadh sam bith a dhèanamh.
  \resources\PBR_ErrorWindowsToGo_Desc\Text:
    Candidate Language=GD-GB: Cha ghabh am PC agad ath-shuidheachadh a chionn ’s gu bheil e air Windows To Go.
  \resources\PBR_ErrorSafeMode_Header:
    Candidate Language=GD-GB: Chan eil an gleus seo ri làimh sa mhodh sàbhailte
  \resources\PBR_ErrorSafeMode_Desc\Text:
    Candidate Language=GD-GB: Airson am PC seo ath-shuidheachadh, tòisich Windows mar as àbhaist is feuch ris a-rithist no dèan tòiseachadh adhartach is tagh “Fuasgail duilgheadasan”.
  \resources\PBR_ErrorRedirectedProfiles_Header:
    Candidate Language=GD-GB: Cha ghabh am PC seo ath-shuidheachadh gun a bhith a’ cur às dha na faidhlichean agad
  \resources\PBR_ErrorRedirectedProfiles_Desc\Text:
    Candidate Language=GD-GB: Gus am PC seo ath-shuidheachadh is na faidhlichean agad a chumail, feumaidh na pasganan “Cleachdaichean”, “Faidhlichean phrògraman” agus “Windows” a bhith air an aon draibh. ’S urrainn dhut am PC seo ath-shuidheachadh is gach rud a thoirt air falbh cuideachd ach bu chòir dhut lethbhreac a dhèanamh dhe na faidhlichean pearsanta agad an toiseach.
  \resources\PBR_ErrorPayloadVersionMismatch_Desc\Text:
    Candidate Language=GD-GB: Tha an luchdadh a-nuas mì-dhligheach. Feuch a-rithist agus tagh an roghainn ionadail airson stàlaicheadh as ùr.
  \resources\PBR_ErrorPayloadDownload_Desc\Text:
    Candidate Language=GD-GB: Bhris rud a-steach air an luchdadh a-nuas. Thoir sùil air a’ cheangal agad is feuch ris a-rithist, no tagh an roghainn ionadal airson a’ stàlaicheadh as ùr.
  \resources\PBR_ErrorPayloadConnection_Desc\Text:
    Candidate Language=GD-GB: Chan urrainn dhuinn ceangal ris an fhrithealaiche. Thoir sùil air a’ cheangal agad is feuch ris a-rithist, no tagh an roghainn ionadal airson a’ stàlaicheadh as ùr.
  \resources\PBR_ErrorNotSupportedInEdition_Desc\Text:
    Candidate Language=GD-GB: Chan eil an eagran seo a’ cur taic ris an roghainn aisig a chaidh a thaghadh. Feuch a-rithist le roghainn diofraichte.
  \resources\PBR_ErrorNoRecoveryEnv_Header:
    Candidate Language=GD-GB: Cha deach an àrainneachd aiseig a lorg
  \resources\PBR_ErrorNoRecoveryEnv_Desc\Text:
    Candidate Language=GD-GB: Cuir a-steach am meadhan stàlaidh no aiseig Windows agad is ath-thòisich am PC agad leis a’ mheadhan.
  \resources\PBR_ErrorNoPayload_Desc\Text:
    Candidate Language=GD-GB: Chan eil luchdadh a-nuas ri fhaighinn. Feuch a-rithist agus tagh an roghainn ionadail airson stàlaicheadh as ùr.
  \resources\PBR_ErrorNoPayloadSupport_Desc\Text:
    Candidate Language=GD-GB: Chan eil an suidheachadh aisig seo a’ cur taic ris an roghainn airson luchdadh a-nuas on neul. Feuch a-rithist agus tagh an roghainn ionadail gus stàladh as ùr.
  \resources\PBR_ErrorNoDeownlevelEnv_Desc\Text:
    Candidate Language=GD-GB: Ma tha meadhan stàlaidh no aiseig Windows agad, cuir a-steach e agus ath-thòisich am PC on meadhan.
  \resources\PBR_ErrorInsufficientSpace_Line3\Text:
    Candidate Language=GD-GB: • Thèid prògraman a dhì-stàladh
  \resources\PBR_ErrorInsufficientSpace_Line2\Text:
    Candidate Language=GD-GB: • Thèid lethbhreac dhe na faidhlichean agad a chur gu uidheam air an taobh a-muigh ’s an sguabadh às a’ PC seo
  \resources\PBR_ErrorInsufficientSpace_Line1\Text:
    Candidate Language=GD-GB: • Thèid sgioblachadh diosga a ruith
  \resources\PBR_ErrorInsufficientSpace_Line0\Text:
    Candidate Language=GD-GB: Gus àite air an diosg a shaoradh, faodaidh tu:
  \resources\PBR_ErrorInsufficientSpace_Header:
    Candidate Language=GD-GB: Tha tuilleadh àite air an diosg a dhìth
  \resources\PBR_ErrorInsufficientSpace_Desc:
    Candidate Language=GD-GB: Tha %1!ws! de dh’àite a bharrachd a dhìth air an diosga (%2!ws!).
  \resources\PBR_ErrorFileNotTrust_Desc\Text:
    Candidate Language=GD-GB: Tha faidhlichean ann a tha riatanach ach anns nach eil earbsa. Dh’fhaoidte gun do dh’fhalbh an ùine air teisteanas nam faidhlichean no gun deach an atharrachadh le daoine eile.
  \resources\PBR_ErrorDisabled_Desc\Text:
    Candidate Language=GD-GB: Cha cheadaich poileasaidh a’ bhuidhinn agad seo. Airson barrachd fiosrachaidh, bruidhinn ris an neach taic no an roinn ICT agad.
  \resources\PBR_ErrorCloud_Header:
    Candidate Language=GD-GB: Bha duilgheadas ann leis an luchdadh a-nuas
  \resources\PBR_ErrorCant_Header:
    Candidate Language=GD-GB: Cha ghabh am PC seo ath-shuidheachadh
  \resources\PBR_DataWarning_Format:
    Candidate Language=GD-GB: Dh'fhaoidte gun cleachd luchdadh a-nuas on neul barrachd air 4GB de dhàta.
  \resources\PBR_DataDriveList_Header:
    Candidate Language=GD-GB: Draibhean air an toir seo buaidh
  \resources\PBR_DataDriveList_Desc\Text:
    Candidate Language=GD-GB: Ma roghnaicheas tu faidhlichean a thoirt air falbh o gach draibh, bheir seo buaidh air na draibhean seo:
  \resources\PBR_ConfirmReset_NoApps\Text:
    Candidate Language=GD-GB: • Thèid a h-uile aplacaid is prògram a thoirt air falbh
  \resources\PBR_ConfirmReset_Line3\Text:
    Candidate Language=GD-GB: • Thèid atharrachadh sam bith a chaidh a dhèanamh sna roghainnean a thoirt air falbh
  \resources\PBR_ConfirmReset_Line2\Text:
    Candidate Language=GD-GB: • Thèid a h-uile aplacaid is prògram nach tàinig leis a’ PC seo o thùs a thoirt air falbh
  \resources\PBR_ConfirmReset_Line1\Text:
    Candidate Language=GD-GB: • Thèid na faidhlichean pearsanta is cunntasan chleachdaichean air fad a thoirt air falbh on PC seo
  \resources\PBR_ConfirmReset_Line0\Text:
    Candidate Language=GD-GB: Ma nì thu ath-shuidheachadh:
  \resources\PBR_ConfirmRefresh_RemovedAppsList\Content:
    Candidate Language=GD-GB: Seall na h-aplacaidean a thèid a thoirt air falbh
  \resources\PBR_ConfirmRefresh_NoApps\Text:
    Candidate Language=GD-GB: • Thèid a h-uile aplacaid is prògram a thoirt air falbh
  \resources\PBR_ConfirmRefresh_Line3_Featured\Text:
    Candidate Language=GD-GB: • Thèid na faidhlichean pearsanta a chumail
  \resources\PBR_ConfirmRefresh_Line2\Text:
    Candidate Language=GD-GB: • Thèid na bun-roghainnean a thilleadh
  \resources\PBR_ConfirmRefresh_Line1\Text:
    Candidate Language=GD-GB: • Thèid a h-uile aplacaid is prògram nach tàinig leis a’ PC seo o thùs a thoirt air falbh
  \resources\PBR_ConfirmRefresh_Line0\Text:
    Candidate Language=GD-GB: Ma nì thu ath-shuidheachadh:
  \resources\PBR_ConfirmPage_MeteredDataWarning_Format:
    Candidate Language=GD-GB: •  Dh'fhaoidte gun cleachd luchdadh a-nuas on neul barrachd air %ws a dhàta. 'S e ceangal meadaraichte a tha agad agus dh'fhaoidte gun èirich cosgaisean dhut.
  \resources\PBR_ConfirmPage_Header:
    Candidate Language=GD-GB: Deiseil gus am PC seo ath-shuidheachadh
  \resources\PBR_ConfirmPage_Desc\Text:
    Candidate Language=GD-GB: •  Bidh sinn greis agus thèid am PC agad ath-thòiseachadh an uairsin.
  \resources\PBR_ConfirmPage_DataWarning_Format:
    Candidate Language=GD-GB: •  Dh'fhaoidte gun cleachd luchdadh a-nuas on neul barrachd air %ws a dhàta.
  \resources\PBR_ConfirmPage_BitlockerSuspended\Text:
    Candidate Language=GD-GB: •  Bidh crioptachadh dhraibhean le BitLocker à comas greiseag gus am bi seo deiseil.
  \resources\PBR_ConfirmPage_BitlockerOff\Text:
    Candidate Language=GD-GB: •  Thèid crioptachadh draibhean le BitLocker a chur dheth.
  \resources\PBR_BatteryError_Header:
    Candidate Language=GD-GB: Ceangail am PC agad ri bun-dealain
  \resources\PBR_BatteryError_Desc\Text:
    Candidate Language=GD-GB: Chan urrainn dhuinn am PC agad ath-shuidheachadh fhad ’s a tha e air bataraidh.
  \resources\PBR_Advanced_Workplace_Text:
    Candidate Language=GD-GB: A bheil thu airson goireasan an àite-obrach a sguabadh às?
  \resources\PBR_Advanced_Workplace_SelectionOn:
    Candidate Language=GD-GB: •  Sguab às na pacaidean solarachaidh on àite-obrach agad
  \resources\PBR_Advanced_Workplace_SelectionOff:
    Candidate Language=GD-GB: •  Cùm na pacaidean solarachaidh on àite-obrach agad
  \resources\PBR_Advanced_Workplace_OnDesc:
    Candidate Language=GD-GB: Sguab às na pacaidean solarachaidh on àite-obrach agad
  \resources\PBR_Advanced_Workplace_OffDesc:
    Candidate Language=GD-GB: Cùm na pacaidean solarachaidh on àite-obrach agad
  \resources\PBR_Advanced_WipeData_ToggleOn:
    Candidate Language=GD-GB: Tha, gach draibh
  \resources\PBR_Advanced_WipeData_ToggleOff:
    Candidate Language=GD-GB: Chan eil, dìreach draibh Windows
  \resources\PBR_Advanced_WipeData_Text:
    Candidate Language=GD-GB: A bheil thu airson na faidhlichean air gach draibh a sguabadh às?
  \resources\PBR_Advanced_WipeData_SelectionOn:
    Candidate Language=GD-GB: •  Sguab às gach faidhle air gach draibh
  \resources\PBR_Advanced_WipeData_SelectionOff:
    Candidate Language=GD-GB: •  Na sguab às faidhlichean ach o dhraibh Windows
  \resources\PBR_Advanced_WipeData_OnDesc:
    Candidate Language=GD-GB: Sguab às gach faidhle air gach draibh. Bidh buaidh aig roghainn glanadh an dàta air gach draibh
  \resources\PBR_Advanced_WipeData_OffDesc:
    Candidate Language=GD-GB: Na sguab às faidhlichean ach o dhraibh Windows
  \resources\PBR_Advanced_PreinstalledApps_Text:
    Candidate Language=GD-GB: A bheil thu airson na h-aplacaidean ro-stàlaichte aiseag?
  \resources\PBR_Advanced_PreinstalledApps_SelectionOn:
    Candidate Language=GD-GB: • Aisig aplacaidean is roghainnean a thàinig leis a’ PC seo
  \resources\PBR_Advanced_PreinstalledApps_SelectionOff:
    Candidate Language=GD-GB: • Na aisig aplacaidean is roghainnean a thàinig leis a’ PC seo
  \resources\PBR_Advanced_PreinstalledApps_OnDesc:
    Candidate Language=GD-GB: Aisig aplacaidean is roghainnean a thàinig leis a’ PC seo
  \resources\PBR_Advanced_PreinstalledApps_OffDesc:
    Candidate Language=GD-GB: Na aisig aplacaidean is roghainnean a thàinig leis a’ PC seo
  \resources\PBR_Advanced_Header:
    Candidate Language=GD-GB: Tagh roghainnean
  \resources\PBR_Advanced_Esim_Text:
    Candidate Language=GD-GB: A bheil thu airson na pròifilean eSIM a sguabadh às?
  \resources\PBR_Advanced_Esim_SelectionOn:
    Candidate Language=GD-GB: • Sguab às gach pròifil eSIM airson dàta mobile
  \resources\PBR_Advanced_Esim_SelectionOff:
    Candidate Language=GD-GB: • Cùm gach pròifil eSIM airson dàta mobile
  \resources\PBR_Advanced_Esim_OnDesc:
    Candidate Language=GD-GB: Sguab às gach pròifil eSIM airson dàta mobile
  \resources\PBR_Advanced_Esim_OffDesc:
    Candidate Language=GD-GB: Cùm gach pròifil eSIM airson dàta mobile
  \resources\PBR_Advanced_Erase_Text:
    Candidate Language=GD-GB: A bheil thu airson an dàta a ghlanadh?
  \resources\PBR_Advanced_Erase_SelectionOn:
    Candidate Language=GD-GB: •  Thoir air falbh aplacaidean is faidhlichean. Sgioblaich an draibh
  \resources\PBR_Advanced_Erase_SelectionOff:
    Candidate Language=GD-GB: •  Thoir air falbh aplacaidean is faidhlichean. Na sgioblaich an draibh
  \resources\PBR_Advanced_Erase_OnDesc:
    Candidate Language=GD-GB: Sgioblaich an draibh. Faodaidh gun toir seo uairean a thìde ach bidh e nas dorra faidhlichean aiseag
  \resources\PBR_Advanced_Erase_OffDesc:
    Candidate Language=GD-GB: Na dèan ach toirt air falbh nam faidhlichean agad. Tha seo nas luaithe ach chan eil e cho tèarainte
  \resources\PBR_Advanced_Confirm\Content:
    Candidate Language=GD-GB: Dearbh
  \resources\PBR_Advanced_CloudRecovery_Text:
    Candidate Language=GD-GB: A bheil thu airson Windows a luchdadh a-nuas?
  \resources\PBR_Advanced_CloudRecovery_SelectionOn:
    Candidate Language=GD-GB: •  Luchdaich a-nuas is ath-stàlaich Windows
  \resources\PBR_Advanced_CloudRecovery_SelectionOff:
    Candidate Language=GD-GB: •  Ath-stàlaich Windows on uidheam seo
  \resources\PBR_Advanced_CloudRecovery_OnText:
    Candidate Language=GD-GB: Luchdadh a-nuas on neul
  \resources\PBR_Advanced_CloudRecovery_OnDesc:
    Candidate Language=GD-GB: Luchdaich a-nuas is ath-stàlaich Windows
  \resources\PBR_Advanced_CloudRecovery_OffText:
    Candidate Language=GD-GB: Ath-stàladh ionadail
  \resources\PBR_Advanced_CloudRecovery_OffDesc:
    Candidate Language=GD-GB: Ath-stàlaich Windows on uidheam seo
  \resources\PBR_Advanced_CloudRecovery_Header:
    Candidate Language=GD-GB: Ciamar a bu mhath leat Windows ath-stàladh?
  \resources\PBR_Advanced_CloudRecovery_DisabledDesc:
    Candidate Language=GD-GB: Dèan cinnteach gu bheil ceangal agad ris an eadar-lìon is feuch ris a-rithist
  \resources\Password:
    Candidate Language=GD-GB: Facal-faire
  \resources\Ok:
    Candidate Language=GD-GB: Ceart ma-thà
  \resources\No_GoBack:
    Candidate Language=GD-GB: Chan eil, air ais leam
  \resources\No:
    Candidate Language=GD-GB: Chan eil
  \resources\NLA_Enable_HeaderText:
    Candidate Language=GD-GB: Ceadaich ceanglaichean le dearbhadh aig ìre an lìonraidh a-mhàin
  \resources\NLA_Enable_BodyText:
    Candidate Language=GD-GB: Mholamaid seo.
  \resources\NLA_Disable_HeaderText:
    Candidate Language=GD-GB: A bheil thu airson ceanglaichean gun dearbhadh aig ìre an lìonraidh a cheadachadh?
  \resources\NLA_Disable_BodyText:
    Candidate Language=GD-GB: Ma cheadaicheas tu ceanglaichean gun NLA, fàgaidh tu an coimpiutair agad fosgailte do chunnartan tèarainteachd.
  \resources\Next:
    Candidate Language=GD-GB: Air adhart
  \resources\ManageExclusion_SAVE_FAIL_ErrorText:
    Candidate Language=GD-GB: Tha sinn duilich ach cha ghabh an t-às-dùnadh a shàbhaladh.
  \resources\ManageExclusion_Process_ADD_FAIL_ErrorText:
    Candidate Language=GD-GB: Chan fhaod na caractaran a leanas a bhith ann an ainm pròiseis: /"<>|?*
  \resources\ManageExclusion_Extension_ADD_FAIL_ErrorText:
    Candidate Language=GD-GB: Chan fhaod na caractaran a leanas a bhith ann an ainm leudachain: \ /:"<>|?*
  \resources\ManageExclusion_BodyText:
    Candidate Language=GD-GB: Cuir a-steach ainm an às-dùnaidh.
  \resources\ManageExclusion_AuthBodyText:
    Candidate Language=GD-GB: Cuir a-steach fiosrachadh a’ chunntais agad gus dèanamh cinnteach gu bheil cead agad às-dùnaidhean a stiùireadh.
  \resources\ManageExclusion_ADD_FAIL_EmptyText:
    Candidate Language=GD-GB: Chan fhaod leudachan faidhle a bhith falamh no na gheal-spàsan a-mhàin.
  \resources\Lockdown_SignOutWarningText:
    Candidate Language=GD-GB: Ma tha an cunntas a thagh thu clàraichte a-staigh, feumaidh tu clàradh a-mach is a-steach a-rithist mus bi na h-atharraichean an sàs. Ma tha cunntas le cead-inntrigidh air clàradh a-staigh, thèid a chlàradh a-mach.
  \resources\LockdownUser_HeaderText:
    Candidate Language=GD-GB: Tagh cunntas
  \resources\LockdownUser_EmptyListText:
    Candidate Language=GD-GB: Rinn an aon chunntas gnìomhach air an uidheam seo clàradh a-steach mu thràth. Cuir ris no cruthaich cunntas ùr is feuch ris a-rithist
  \resources\LockdownApp_HeaderText:
    Candidate Language=GD-GB: Tagh aplacaid
  \resources\LockdownApp_EmptyListText:
    Candidate Language=GD-GB: Chan eil aplacaidean aig a' chunntas seo. Stàlaich co-dhiù aon aplacaid air a' chunntas a thagh thu 's feuch ris a-rithist.
  \resources\LeaveDomain_RestartHeaderText:
    Candidate Language=GD-GB: Ath-thòisich am PC agad
  \resources\LeaveDomain_RestartBody_DomainUser_Text:
    Candidate Language=GD-GB: Às dèidh dhut ath-thòiseachadh, cha bhi am PC agad ceangailte ri %1. Bidh agad ri clàradh a-steach air cunntas cleachdaiche eile, mar am fear a dh’ainmich thu air an duilleag roimhe.
  \resources\LeaveDomain_RestartBodyText:
    Candidate Language=GD-GB: Às dèidh dhut ath-thòiseachadh, cha bhi am PC agad ceangailte ri %1.
  \resources\LeaveDomain_NonAdmin_Credentials:
    Candidate Language=GD-GB: Cha do dh'obraich am fiosrachadh sin. Dèan cinnteach gu bheil thu a' cur a-steach ainm is facal-faire cunntas rianaire ionadail is feuch ris a-rithist.
  \resources\LeaveDomain_NERR_SetupNotJoined:
    Candidate Language=GD-GB: Chan eil am PC seo ceangailte ri àrainn.
  \resources\LeaveDomain_Leave_Domain_Failed:
    Candidate Language=GD-GB: Chaidh rudeigin cearr. Feuch ris a-rithist an ceann greis.
  \resources\LeaveDomain_Incorrect_Password:
    Candidate Language=GD-GB: Cha do dh'obraich am facal-faire sin. Thoir sùil air agus feuch ris a-rithist.
  \resources\LeaveDomain_ConfirmNextButtonText:
    Candidate Language=GD-GB: Dì-cheangail
  \resources\LeaveDomain_ConfirmHeaderText:
    Candidate Language=GD-GB: Dì-cheangail on bhuidheann
  \resources\LeaveDomain_ConfirmBody_DomainUser_Text:
    Candidate Language=GD-GB: 
      Mus dì-cheangail thu, feumaidh tu clàradh a-steach le cunntas rianaire nach ann leis a’ bhuidheann agad, can an cunntas Microsoft agad fhèin.

      Turas a dh’fhàgas tu am buidheann, chan urrainn dhut clàradh a-steach air cunntasan buidhinn tuilleadh air a’ PC seo.
    
  \resources\LeaveDomain_ConfirmBodyText:
    Candidate Language=GD-GB: Chan urrainn dhut clàradh a-steach tuilleadh air a’ PC seo air cunntas a’ bhuidhinn agad an dèidh dhut dì-cheangal.

Ma chaidh BitLocker a stàladh air a’ PC seo ’s ma tha e ga ruith, dèan cinnteach gu bheil lethbhreac dhe iuchair aisig BitLocker agad àite eile air choireigin seach air a’ PC seo.
  \resources\LeaveDomain_AuthBodyTitle:
    Candidate Language=GD-GB: Cuir a-steach am fiosrachadh aig cunntas eile
  \resources\LeaveDomain_AuthBodyText:
    Candidate Language=GD-GB: Gus dèanamh cinnteach gun urrainn dhut clàradh a-steach air a’ PC seo an dèidh dhut dì-cheangal on bhuidheann, cuir a-steach ainm is facal-faire de chunntas rianaire ionadail. Faodaidh seo a bhith na chunntas Microsoft no na chunntas ionadail. Mur eil gin agad, bi agad ri fear a chruthachadh.
  \resources\JoinDomain_RPC_S_SERVER_UNAVAILABLE:
    Candidate Language=GD-GB: Chan urrainn dhuinn ceangal ris an àrainn an-dràsta fhèin. Dèan cinnteach gu bheil thu ceangailte ris an lìonra obrach agad is feuch ris a-rithist.
  \resources\JoinDomain_RPC_S_CALL_IN_PROGRESS:
    Candidate Language=GD-GB: Tha am PC seo gu bhith ceangailte ri àrainn mu thràth. Ath-thòisich am PC agad agus feuch ris a-rithist.
  \resources\JoinDomain_RestartPCHeaderText:
    Candidate Language=GD-GB: Ath-thòisich am PC agad
  \resources\JoinDomain_NERR_SetupAlreadyJoined:
    Candidate Language=GD-GB: Tha am PC seo ceangailte ris an àrainn mu thràth.
  \resources\JoinDomain_HeaderText:
    Candidate Language=GD-GB: Rach an sàs àrainne
  \resources\JoinDomain_ERROR_NO_SUCH_MEMBER:
    Candidate Language=GD-GB: Cha b' urrainn dhuinn an cunntas àrainne seo a lorg. Thoir sùil air ainm a' chunntais is feuch ris a-rithist.
  \resources\JoinDomain_ERROR_MEMBER_IN_ALIAS:
    Candidate Language=GD-GB: Chaidh an cunntas seo a shuidheachadh air a' PC seo mu thràth.
  \resources\JoinDomain_ERROR_INVALID_DOMAIN:
    Candidate Language=GD-GB: Cha b' urrainn dhuinn an àrainn seo a lorg. Thoir sùil air ainm na h-àrainne is feuch ris a-rithist.
  \resources\JoinDomain_ERROR_DUP_NAME:
    Candidate Language=GD-GB: Tha ainm a' PC seo ga chleachdadh mu thràth. Tagh ainm eile airson a' PC agad is feuch ris a-rithist.
  \resources\JoinDomain_ERROR_ACCESS_DENIED:
    Candidate Language=GD-GB: Chan urrainn dhut a dhol an sàs na h-àrainne. Dèan cinnteach gu bheil cead agad a dhol an sàs na h-àrainn, tagh ainm eile airson a' PC agad is feuch ris a-rithist.
  \resources\JoinDomain_DomainNameDescriptionText:
    Candidate Language=GD-GB: Ainm na h-àrainne
  \resources\JoinDomain_ConfirmBodyText:
    Candidate Language=GD-GB: Bidh am PC agad ceangailte ris an àrainn seo às dèidh dhut ath-thòiseachadh: 
  \resources\JoinDomain_CANNOT_JOIN_ERROR:
    Candidate Language=GD-GB: Chan urrainn dhut a dhol an sàs na h-àrainne seo. Cuir fios gun rianaire IT agad airson barrachd fiosrachaidh.
  \resources\JoinDomain_AuthHeaderText:
    Candidate Language=GD-GB: Clàraich a-steach dhan àrainn
  \resources\JoinDomain_AuthBodyText:
    Candidate Language=GD-GB: Cuir a-steach fiosrachadh a' chunntais agad gus dearbhadh gu bheil cead agad ceangal ris an àrainn.
  \resources\JoinDomain_ADD_LOCAL_USER_FAILED:
    Candidate Language=GD-GB: Chaidh rudeigin cearr. Feuch ris a-rithist an ceann greis.
  \resources\JoinDomain_AddDomainUserHeaderText:
    Candidate Language=GD-GB: Cuir cunntas ris
  \resources\JoinDomain_AddDomainUserGroupText:
    Candidate Language=GD-GB: Seòrsa a' chunntais
  \resources\JoinDomain_AddDomainUserBodyText:
    Candidate Language=GD-GB: Cuir a-steach fiosrachadh cunntas an neach a chleachdas am PC seo. Ma ghearras tu leum thairis air a' cheum seo, bidh na ceadan bunaiteach aig an neach seo air an àrainn.
  \resources\JoinDomain_AddDomainUserAccountText:
    Candidate Language=GD-GB: Cunntas cleachdaiche
  \resources\InPlaceUpgrade_Title:
    Candidate Language=GD-GB: Càirich duilgheadasan le Windows Update
  \resources\InPlaceUpgrade_Header:
    Candidate Language=GD-GB: Càirichidh sinn na co-phàirtean agus faidhlichean an t-siostaim
  \resources\InPlaceUpgrade_ExpeditedSessionCheckBox:
    Candidate Language=GD-GB: Ath-thòisich am PC agam gu fèin-obrachail cairteal na h-uarach an dèidh stàlaidh
  \resources\InPlaceUpgrade_BodyText2\Text:
    Candidate Language=GD-GB: Dèan cinnteach gu bheil am PC agad air agus ceangailte ris an lìonra agus bun-dealain. An dèidh dhuinn a stàladh, innsidh sinn dhut nuair a dh’fheumas tu am PC agad ath-thòiseachadh gus an càradh a choileanadh.
  \resources\InPlaceUpgrade_BodyText1\Text:
    Candidate Language=GD-GB: Ma tha fuasgladh ann air a shon, feuchaidh sinn ri coirbteachd co-phàirt an t-siostaim a chur ceart le bhith ath-stàladh an tionndaidh làithrich de Windows. Glèidhidh sinn na h-aplacaidean, sgrìobhainnean is roghainnean agad.
  \resources\HolographicUninstall_SucceededHeaderText:
    Candidate Language=GD-GB: Chaidh a dhì-stàladh
  \resources\HolographicUninstall_SucceededBodyText:
    Candidate Language=GD-GB: Chaidh Windows Mixed Reality a thoirt air falbh.
  \resources\HolographicUninstall_RestartHeaderText:
    Candidate Language=GD-GB: Feumaidh tu ath-thòiseachadh
  \resources\HolographicUninstall_RestartBodyText:
    Candidate Language=GD-GB: Ath-thòisich an coimpiutair agad a choileanadh dì-stàladh Windows Mixed Reality.
  \resources\HolographicUninstall_LearnMoreText:
    Candidate Language=GD-GB: Barrachd fiosrachaidh
  \resources\HolographicUninstall_HeaderText:
    Candidate Language=GD-GB: Dì-stàlaich Windows Mixed Reality
  \resources\HolographicUninstall_ErrorText:
    Candidate Language=GD-GB: Cha b’ urrainn dhuinn Windows Mixed Reality a thoirt air falbh buileach. Dh’fhaoidte gu bheil cuid a dh’fhaidhlichean is fiosrachadh co-cheangailte ris air a’ choimpiutair agad fhathast.
  \resources\HolographicUninstall_BodyText:
    Candidate Language=GD-GB: Bheir seo air falbh Windows Mixed Reality.
