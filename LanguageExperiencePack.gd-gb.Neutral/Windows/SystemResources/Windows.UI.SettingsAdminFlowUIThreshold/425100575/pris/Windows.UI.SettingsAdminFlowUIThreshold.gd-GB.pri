  \resources\EnterProductKey_ActivateBenefitsText:
    Candidate Language=GD-GB: Ma chuireas tu an gnìomh Windows, obraichidh a h-uile rud mar bu chòir is cha bhris rudan a-steach ort.
  \resources\EnableUser_OkButtonText:
    Candidate Language=GD-GB: Ceadaich
  \resources\EnableUser_HeaderText:
    Candidate Language=GD-GB: A bheil thu airson cead clàraidh a-steach a thoirt dhan neach seo?
  \resources\EnableUser_GeneralErrorText:
    Candidate Language=GD-GB: Thachair mearachd.
  \resources\EnableUser_BodyText:
    Candidate Language=GD-GB: Bidh comas aca clàradh a-steach is am PC seo a chleachdadh.
  \resources\EditUser_UserTypeDescriptionText:
    Candidate Language=GD-GB: Seòrsa a' chunntais
  \resources\EditUser_StandardUserText:
    Candidate Language=GD-GB: Cleachdaiche coitcheann
  \resources\EditUser_HeaderText:
    Candidate Language=GD-GB: Atharraich seòrsa a’ chunntais
  \resources\EditUser_GeneralErrorText:
    Candidate Language=GD-GB: Thachair mearachd.
  \resources\EditUser_ConnectivityErrorText:
    Candidate Language=GD-GB: Chan urrainn dhuinn làrach-lìn na Sàbhailteachd teaghlaich a ruigsinn gus cunntas a' phàiste seo a shuidheachadh. Am feuch thu ris a-rithist?
  \resources\EditUser_ChildUserText:
