  \resources\SurfaceHub_ResetDevice_Reseting_Text:
    Candidate Language=GD-GB: Tha an t-uidheam ga ath-shuidheachadh. Thèid ath-thòiseachadh ann am beagan mhionaidean.
  \resources\SurfaceHub_ResetDevice_Reseting_Header_Text:
