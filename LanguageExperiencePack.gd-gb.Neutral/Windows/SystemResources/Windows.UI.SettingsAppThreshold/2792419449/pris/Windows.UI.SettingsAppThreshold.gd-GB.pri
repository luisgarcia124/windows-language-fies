  \SystemSettings\Resources\SystemSettings_Privacy_Telemetry_Viewer_Toggle_2_Enterprise_Status:
    Candidate Language=GD-GB: Fo stiùireadh a’ bhuidhinn agad
  \SystemSettings\Resources\SystemSettings_Privacy_Telemetry_Viewer_Toggle_2\DisplayName:
    Candidate Language=GD-GB: Cuir sealladair an dàta diagnosachd air (cleachdaidh seo suas ri 1GB dhen chlàr-chruaidh agad)
  \SystemSettings\Resources\SystemSettings_Privacy_Telemetry_Viewer_Toggle_2\AdditionalDescription:
    Candidate Language=GD-GB: 
  \SystemSettings\Resources\SystemSettings_Privacy_Telemetry_Viewer_Toggle\DisplayName:
    Candidate Language=GD-GB: Cuir an roghainn seo air a dh’fhaicinn an dàta agad ann an sealladair an dàta diagnosachd. (Feumaidh an roghainn seo suas ri 1GB a dh’àite air a’ chlàr-chruaidh.)
  \SystemSettings\Resources\SystemSettings_Privacy_Telemetry_Viewer_InfoBar\AdditionalDescription:
    Candidate Language=GD-GB: Chan eil am buidheann agad a’ leigeil leat coimhead air an dàta diagnosachd. Cuir fios gu neach-taice a’ bhuidhinn agad airson barrachd fiosrachaidh.
  \SystemSettings\Resources\SystemSettings_Privacy_Telemetry_Viewer_Header_Title:
    Candidate Language=GD-GB: Thoir sùil air an dàta diagnosachd
  \SystemSettings\Resources\SystemSettings_Privacy_Telemetry_Viewer_Header_Subtitle:
    Candidate Language=GD-GB: Chì thu an dàta agad ann an sealladair an dàta diagnosachd
  \SystemSettings\Resources\SystemSettings_Privacy_Telemetry_Viewer_Button_2_AdditionalDescription:
    Candidate Language=GD-GB: Seall an dàta agam ann an sealladair an dàta diagnosachd
  \SystemSettings\Resources\SystemSettings_Privacy_Telemetry_Viewer_Button_2\AdditionalDescription:
    Candidate Language=GD-GB: Briog air a’ phutan seo a dh’fhosgladh sealladair an dàta diagnosachd
  \SystemSettings\Resources\SystemSettings_Privacy_TailoredExperiences_Toggle_Subtitle:
    Candidate Language=GD-GB: Leig le Microsoft an dàta diagnosachd agad a chleachdadh, as aonais fiosrachaidh mu làraichean-lìn air an do thadhail thu, airson gliocasan, sanasachd is molaidhean pearsantaichte a thoirt dhut
  \SystemSettings\Resources\SystemSettings_Privacy_TailoredExperiences_Toggle_Policy_Msg:
    Candidate Language=GD-GB: Chan eil am buidheann agad a’ leigeil leat dàta diagnosachd a chleachdadh airson àrainneachd phearsantaichte a chruthachadh. Cuir fios gu neach-taice a’ bhuidhinn agad airson barrachd fiosrachaidh.
  \SystemSettings\Resources\SystemSettings_Privacy_TailoredExperiences_Toggle_On_Status:
    Candidate Language=GD-GB: Air
  \SystemSettings\Resources\SystemSettings_Privacy_TailoredExperiences_Toggle_Off_Status:
    Candidate Language=GD-GB: Dheth
  \SystemSettings\Resources\SystemSettings_Privacy_TailoredExperiences_Toggle_Header_Title:
    Candidate Language=GD-GB: Coltasan gnàthaichte
  \SystemSettings\Resources\SystemSettings_Privacy_TailoredExperiences_Toggle_Header_Subtitle:
    Candidate Language=GD-GB: Leig le Microsoft an dàta diagnosachd a chleachdadh airson gliocasan, sanasachd is molaidhean pearsantaichte a thoirt dhut
  \SystemSettings\Resources\SystemSettings_Privacy_TailoredExperiences_Toggle_Enterprise_Status:
    Candidate Language=GD-GB: Fo stiùireadh a’ bhuidhinn agad
  \SystemSettings\Resources\SystemSettings_Privacy_TailoredExperiencesWithDiagnosticsEnabled_Toggle_Policy_Msg:
    Candidate Language=GD-GB: Tha am buidheann agad a' bacadh cleachdadh an dàta diagnosachd airson fèin-fhiosrachadh gnàthaichte. Cuir fios gun neach-taice aig a' bhuidheann agad airson barrachd fiosrachaidh.
  \SystemSettings\Resources\SystemSettings_Privacy_TailoredExperiencesWithDiagnosticsEnabled\DisplayName:
    Candidate Language=GD-GB: Leig le Microsoft an dàta diagnosachd agad, as aonais fiosrachaidh mu dhèidhinn làraichean-lìn a choimhead thu orra, airson gliocasan, sanasachd is molaidhean pearsantaichte a thoirt dhut a leasaicheas àrainneachd Microsoft dhut.
  \SystemSettings\Resources\SystemSettings_Privacy_StoreAppUsage\DisplayName:
    Candidate Language=GD-GB: Leig le Windows an clàr-taice “Tòisich” agus toraidhean luirg a leasachadh le bhith a’ tracadh dè na h-aplacaidean a thèid a chur gu dol
  \SystemSettings\Resources\SystemSettings_Privacy_Speech_Logging_ProtectionSold\Text:
    Candidate Language=GD-GB: Cha tèid na cliopaichean gutha agad a chleachdadh ach le luchd-cosnaidh is reiceadairean Microsoft airson piseach a thoirt air an teicneolas chainnte againn.
  \SystemSettings\Resources\SystemSettings_Privacy_Speech_Logging_ProtectionIdentity\Text:
    Candidate Language=GD-GB: Cliopaichean gutha nach eil co-cheangailte riut fhèin.   Ma lorgas sinn cliop sa bheil fiosrachadh pearsanta, sguabaidh sinn às e.
  \SystemSettings\Resources\SystemSettings_Privacy_Speech_Logging_LearnMore\Text:
    Candidate Language=GD-GB: Barrachd fiosrachaidh air na nithear le cliopaichean gutha a bheirear seachad
  \SystemSettings\Resources\SystemSettings_Privacy_Speech_Logging_ExplanationText\Text:
    Candidate Language=GD-GB: B' urrainn dhuinn piseach a thoirt air pongalachd teicneolas cainnt Microsoft air loidhne dhan a h-uile duine aig a bheil do chànan is tu a' cleachdadh aplacaidean a chleachdas aithneachadh cainnte air loidhne.

Ma chuireas tu romhad na cliopaichean gutha agad a chur thugainn, bidh luchd-cosnaidh is reiceadairean Microsoft a' toirt sùil air na cliopaichean seo.
  \SystemSettings\Resources\SystemSettings_Privacy_Speech_LearnMore\Text:
    Candidate Language=GD-GB: Barrachd fiosrachaidh
  \SystemSettings\Resources\SystemSettings_Privacy_Speech_ExplanationText\DisplayName:
    Candidate Language=GD-GB: Cleachd do ghuth ann an aplacaidean a chleachdas teicneolas aithneachadh cainnt Microsoft air loidhne.
  \SystemSettings\Resources\SystemSettings_Privacy_Speech_Contribution_Thanks\Text:
    Candidate Language=GD-GB: Gun robh math agad!
  \SystemSettings\Resources\SystemSettings_Privacy_Speech_Contribution_SoldText\Text:
    Candidate Language=GD-GB: Cha chleachd ach Microsoft na cliopaichean gutha agad
  \SystemSettings\Resources\SystemSettings_Privacy_Speech_Contribution_ProtectedText\Text:
    Candidate Language=GD-GB: Tha do dhearbh-aithne fo dhìon
  \SystemSettings\Resources\SystemSettings_Privacy_Speech_Contribution_Optional\Text:
    Candidate Language=GD-GB: Mur eil thu airson na cliopaichean gutha agad a thoirt dhuinn, is urrainn dhut na gleusan gutha a chleachdadh co-dhiù.  'S urrainn dhut a chaochladh a chur romhad a thaobh nan cliopaichean gutha agad uair sam bith.
  \SystemSettings\Resources\SystemSettings_Privacy_Speech_Contribution_Agreed\Text:
    Candidate Language=GD-GB: Dh'aontaich thu na cliopaichean gutha agad a cho-roinneadh leinn.
'S urrainn dhut a chaochladh a chur romhad uair sam bith.
  \SystemSettings\Resources\SystemSettings_Privacy_Speech_BlockSpeechLogging:
    Candidate Language=GD-GB: Chan eil mi airson na cliopaichean gutha agam a cho-roinneadh leibh tuilleadh
  \SystemSettings\Resources\SystemSettings_Privacy_Speech_AllowSpeechServices\DisplayName:
    Candidate Language=GD-GB: Ma chuireas tu dheth aithneachadh cainnte air loidhne, chan urrainn dhut aplacaidean a chleachdadh a chleachdas teicneolas aithneachadh cainnte aig Microsoft air loidhne.  Ge-tà, 's urrainn dhut aplacaid aithneachadh cainnte Windows agus seirbheisean cainnte eile a chleachdadh fhathast fhad 's nach cleachd iad teicneolas aithneachadh cainnt Microsoft air loidhne.
  \SystemSettings\Resources\SystemSettings_Privacy_Speech_AllowSpeechLogging:
    Candidate Language=GD-GB: Tòisich air na cliopaichean gutha agam a cho-roinneadh leibh
  \SystemSettings\Resources\SystemSettings_Privacy_Speech_AllowSpeechCommands_LearnMore\DisplayName:
    Candidate Language=GD-GB: Mar a chleachdas tu cainnt ann an HoloLens
  \SystemSettings\Resources\SystemSettings_Privacy_Speech_AllowSpeechCommands_ExplanationText\DisplayName:
    Candidate Language=GD-GB: Cleachd do ghuth a bhruidhinn ris an HoloLens agad. Cumaidh an HoloLens agad cluas ri claisneachd an-còmhnaidh ach an cluinn e ion-chur gutha uat fhad 's a bhios an t-uidheam seo air agus is urrainn dhut an t-uidheam a stiùireadh le àitheantan gutha.
  \SystemSettings\Resources\SystemSettings_Privacy_Speech_AllowSpeechCommands\DisplayName:
    Candidate Language=GD-GB: Ma chuireas tu dheth aithneachadh na cainnte, chan urrainn dhut deachdadh a dhèanamh le do ghuth no bruidhinn ri Cortana agus aplacaidean eile agus cha fhreagair an HoloLens agad ri àithne gutha sam bith.
  \SystemSettings\Resources\SystemSettings_Privacy_Send_Required_Diagnostic_Data\Text:
    Candidate Language=GD-GB: Tha an dàta diagnosachd riatanach
  \SystemSettings\Resources\SystemSettings_Privacy_Send_Optional_Diagnostic_Data\Text:
    Candidate Language=GD-GB: Dàta diagnosachd roghainneil
  \SystemSettings\Resources\SystemSettings_Privacy_Sending_Required_Diagnostic_Data\Title:
    Candidate Language=GD-GB: Tha thu a’ cur thugainn an dàta diagnosachd riatanaich
  \SystemSettings\Resources\SystemSettings_Privacy_Sending_Required_Diagnostic_Data\Subtitle:
    Candidate Language=GD-GB: Cuiridh an t-uidheam agad badan beag de dhàta gu Microsoft ’s tu a’ cleachdadh Windows oir feumaidh sinn sin airson t-uidheam agus an siostam-obrachaidh agad a chumail tèarainte, ùraichte agus ag obair mar bu chòir.
  \SystemSettings\Resources\SystemSettings_Privacy_Sending_Optional_Diagnostic_Data\Title:
    Candidate Language=GD-GB: Cuir an dàta diagnosachd roghainneil
  \SystemSettings\Resources\SystemSettings_Privacy_Sending_Optional_Diagnostic_Data\Subtitle:
    Candidate Language=GD-GB: Cuidich Microsoft le bhith a’ leasachadh àrainneachd Windows dhut is faigh càradh air duilgheadasan nas luaithe le bhith a’ cur thugainn dàta diagnosachd a bharrachd. Tha seo a’ gabhail a-staigh dàta mu làraichean-lìn air an tadhail thu, mar a chleachdas tu aplacaidean is gleusan agus aithriseadh mhearachdan leasaichte.

Bidh an t-uidheam agad a cheart cho tèarainte agus obraichidh e mar is àbhaist fiù ma chuireas tu romhad gun a bhith a’ chur an dàta diagnosachd roghainneil.
  \SystemSettings\Resources\SystemSettings_Privacy_Required_Diagnostic_Data_Description\Text:
    Candidate Language=GD-GB: Cruinnichidh Microsoft dàta diagnosachd mun uidheam agad, na roghainnean is comasan aige agus a bheil e ag obair mar bu chòir.
  \SystemSettings\Resources\SystemSettings_Privacy_PrivacyLink\DisplayName:
    Candidate Language=GD-GB: Eachdraidh na gnìomhachd san aithris prìobhaideachd
  \SystemSettings\Resources\SystemSettings_Privacy_PersonalizeInkType_Toggle\DisplayName:
    Candidate Language=GD-GB: Cleachd eachdraidh dhe na sgrìobh mi agus na pàtranan làmh-sgrìobhaidh airson faclair gnàthaichte a chruthachadh
  \SystemSettings\Resources\SystemSettings_Privacy_PersonalizeInkType_Hololens_Toggle\DisplayName:
    Candidate Language=GD-GB: Cleachd eachdraidh dhe na sgrìobh mi agus na pàtranan làmh-sgrìobhaidh airson faclair gnàthaichte a chruthachadh
  \SystemSettings\Resources\SystemSettings_Privacy_PersonalizeInkType_Description\DisplayName:
    Candidate Language=GD-GB: Faigh molaidhean nas fheàrr ’s tu a’ cruthachadh faclair gnàthaichte stèidhichte air na sgrìobh thu roimhe. Ma chuireas tu dheth an roghainn seo, thèid am faclair agad fhalamhachadh agus chan fhaigh thu molaidhean pearsantaichte tuilleadh.
  \SystemSettings\Resources\SystemSettings_Privacy_Personalization_ViewDictionary\DisplayName:
    Candidate Language=GD-GB: Faclair gnàthaichte
  \SystemSettings\Resources\SystemSettings_Privacy_Personalization_Personalization_On_GenericError:
    Candidate Language=GD-GB: Chaidh rudeigin cearr. Feuch ris a-rithist an ceann greis.
  \SystemSettings\Resources\SystemSettings_Privacy_Personalization_Personalization_On_Description:
    Candidate Language=GD-GB: Cuir dheth na seirbheisean cainnte agus molaidhean sgrìobhaidh
  \SystemSettings\Resources\SystemSettings_Privacy_Personalization_Personalization_On_ConfirmationFlyoutButtonText:
    Candidate Language=GD-GB: Cuir dheth
  \SystemSettings\Resources\SystemSettings_Privacy_Personalization_Personalization_On_Confirmation:
    Candidate Language=GD-GB: Ma chuireas tu dheth seo, chan urrainn dhut bruidhinn ri Cortana tuilleadh agus thèid gach rud a sguabadh às an fhaclair a chleachdas Windows airson na molaidhean incidh agus sgrìobhaidh a leasachadh dhut.
  \SystemSettings\Resources\SystemSettings_Privacy_Personalization_Personalization_On_ActionDescription:
    Candidate Language=GD-GB: Nuair a bhios seo dheth, ’s urrainn dhut bruidhinn ri Cortana agus thèid am faclair sgrìobhaidh agus incidh pearsanta agad fhalamhachadh. Obraichidh seirbheisean cainnte nach eil feumach air an neul fhathast, can aithneachadh cainnte Windows. Obraichidh molaidhean sgrìobhaidh agus aithneachadh an làmh-sgrìobhaidh fhathast slighe faclair an t-siostaim.
  \SystemSettings\Resources\SystemSettings_Privacy_Personalization_Personalization_Off_GenericError:
    Candidate Language=GD-GB: Chaidh rudeigin cearr. Feuch ris a-rithist an ceann greis.
  \SystemSettings\Resources\SystemSettings_Privacy_Personalization_Personalization_Off_Description:
    Candidate Language=GD-GB: Cuir air na seirbheisean cainnte agus molaidhean sgrìobhaidh
  \SystemSettings\Resources\SystemSettings_Privacy_Personalization_Personalization_Off_ConfirmationFlyoutButtonText:
    Candidate Language=GD-GB: Cuir air
  \SystemSettings\Resources\SystemSettings_Privacy_Personalization_Personalization_Off_Confirmation:
    Candidate Language=GD-GB: Cleachdaidh sinn fiosrachadh mar phàtranan cainnte ’s làmh-sgrìobhaidh is an eachdraidh sgrìobhaidh gus eòlas nas fhearr a chur ort agus bathar is seirbheisean Microsoft a leasachadh.
  \SystemSettings\Resources\SystemSettings_Privacy_Personalization_Personalization_Off_ActionDescription:
    Candidate Language=GD-GB: Nuair a bhios seo dheth, ’s urrainn dhut bruidhinn ri Cortana agus thèid am faclair sgrìobhaidh agus incidh pearsanta agad fhalamhachadh. Obraichidh seirbheisean cainnte nach eil feumach air an neul fhathast, can aithneachadh cainnte Windows. Obraichidh molaidhean sgrìobhaidh agus aithneachadh an làmh-sgrìobhaidh fhathast slighe faclair an t-siostaim.
  \SystemSettings\Resources\SystemSettings_Privacy_Personalization_DataUsageExplanationText\DisplayName:
    Candidate Language=GD-GB: Stiùirich Cortana no aplacaidean an Store le do ghuth agus cleachd eachdraidh dhe na sgrìobh thu is pàtranan do làmh-sgrìobhaidh airson faclair cleachdaiche ionadail a chruthachadh a mholas rudan dhut. Cleachdaidh Microsoft na chuireas tu a-steach dhe do ghuth airson seirbheisean cainnte an neòil a dhèanamh fiù nas fhearr.
  \SystemSettings\Resources\SystemSettings_Privacy_Personalization_DataUsageExplanationTextHololens\DisplayName:
    Candidate Language=GD-GB: Cleachd aithneachadh cainnte air loidhne airson rudan a dhèanamh mar dheachdadh meur-chlàir no a bhruidhinn ri Cortana no aplacaidean an Store le do ghuth agus cleachd eachdraidh dhe na sgrìobh thu airson faclair cleachdaiche ionadail a chruthachadh a mholas rudan dhut. Cleachdaidh Microsoft na chuireas tu a-steach dhe do ghuth airson seirbheisean cainnte an neòil a dhèanamh fiù nas fhearr.

Nuair a bhios HoloLens air, bidh sinn a’ cumail cluas fad na h-ùine airson ion-chur gutha agus cuiridh sinn rud sam bith a chanas tu gun t-seirbheis aithneachadh cainnte san neul aig Microsoft.
  \SystemSettings\Resources\SystemSettings_Privacy_Optional_Diagnostic_Data_Description:
    Candidate Language=GD-GB: Cuir an dàta diagnosachd roghainneil mu làraichean-lìn air an tadhail thu agus mar a chleachdas tu aplacaidean is gleusan, agus fiosrachadh a bharrachd mu shlàinte an uidheim, cleachdadh an uidheim agus aithriseadh mhearachdan leasaichte.

Bidh an t-uidheam agad a cheart cho tèarainte agus obraichidh e mar is àbhaist fiù ma chuireas tu romhad gun a bhith a’ chur an dàta diagnosachd roghainneil.
  \SystemSettings\Resources\SystemSettings_Privacy_Motion_AdditionalInfoText\DisplayName:
    Candidate Language=GD-GB: Bidh feum aig cuid a dh’aplacaidean air an dàta ghluasaid agad mus obraich iad mar bu chòir. Ma chuireas tu dheth aplacaid an-seo, dh’fhaoidte gun cuingich seo nas urrainn dha dèanamh.
  \SystemSettings\Resources\SystemSettings_Privacy_LocationShowOnTimeline\DisplayName:
    Candidate Language=GD-GB: ’S urrainn dhan loidhne-ama agad sealltainn càit an robh thu ri gnìomhachd àraidh.
  \SystemSettings\Resources\SystemSettings_Privacy_LocationHistoryClear_Completed:
    Candidate Language=GD-GB: Chaidh eachdraidh nan ionadan fhalamhachadh.
  \SystemSettings\Resources\SystemSettings_Privacy_LocationHistoryClear2\DisplayName:
    Candidate Language=GD-GB: Eachdraidh nan ionadan
  \SystemSettings\Resources\SystemSettings_Privacy_LocationHistoryClear2\AdditionalDescription:
    Candidate Language=GD-GB: Nuair a bhios ionad an uidheim air, thèid d’ ionad a stòradh agus bidh e ri làimh air an uidheam seo fad greis
  \SystemSettings\Resources\SystemSettings_Privacy_Launch_Telemetry_Viewer_Button_Description:
    Candidate Language=GD-GB: Fosgail sealladair an dàta diagnosachd
  \SystemSettings\Resources\SystemSettings_Privacy_InsiderProgramMessage\DisplayName:
    Candidate Language=GD-GB: Tha Windows Insider Program a’ stiùireadh nan roghainnean seo
  \SystemSettings\Resources\SystemSettings_Privacy_ImproveInkType_Toggle_2_Subtitle:
    Candidate Language=GD-GB: Thoir piseach air comasan aithneachadh cànain is molaidhean cànain air aplacaidean is seirbheisean Microsoft le bhith a’ cur dàta diagnosachd roghainneil mu sgrìobhadh is inceadh gu Microsoft
  \SystemSettings\Resources\SystemSettings_Privacy_ImproveInkType_Toggle_2_On_Status:
    Candidate Language=GD-GB: Air
  \SystemSettings\Resources\SystemSettings_Privacy_ImproveInkType_Toggle_2_Off_Status:
    Candidate Language=GD-GB: Dheth
  \SystemSettings\Resources\SystemSettings_Privacy_ImproveInkType_Toggle_2_Header_Title:
    Candidate Language=GD-GB: Thoir piseach air inceadh is sgrìobhadh
  \SystemSettings\Resources\SystemSettings_Privacy_ImproveInkType_Toggle_2_Header_Subtitle:
    Candidate Language=GD-GB: Cuir dàta diagnosachd roghainneil mu sgrìobhadh is inceadh gu Microsoft
  \SystemSettings\Resources\SystemSettings_Privacy_ImproveInkType_Toggle_2_ErrorText:
    Candidate Language=GD-GB: Chan urrainn dhuinn an dàta mu inceadh is sgrìobhadh a chur gu Microsoft ri linn nan roghainnean làithreach agad a thaobh dàta diagnosachd.
  \SystemSettings\Resources\SystemSettings_Privacy_ImproveInkType_Toggle\DisplayName:
    Candidate Language=GD-GB: Cuir dàta diagnosachd incidh is sgrìobhaidh roghainneil gu Microsoft airson ’s gun urrainn dhuinn comasan aithneachaidh a’ chànain agus na molaidhean aig aplacaidean is seirbheisean Microsoft a leasachadh.
  \SystemSettings\Resources\SystemSettings_Privacy_ImproveInkType_ErrorText\DisplayName:
    Candidate Language=GD-GB: Chan urrainn dhuinn dàta mu inceadh is sgrìobhadh a chur gu Microsoft ri linn nan roghainnean làithreach agad a thaobh dàta diagnosachd.
  \SystemSettings\Resources\SystemSettings_Privacy_Header_Link_Run\Text:
    Candidate Language=GD-GB: Faigh barrachd fiosrachaidh mu roghainnean seo
  \SystemSettings\Resources\SystemSettings_Privacy_Header\Text:
    Candidate Language=GD-GB: Tagh an ìre de dhàta diagnosachd a tha thu airson cur gu Microsoft agus stiùirich roghainnean eile a thaobh na dàta diagnosachd agus dè cho tric ’s a dh’iarras sinn do bheachdan. Cleachdaidh sinn dàta diagnosachd airson Windows a chumail tèarainte ’s ùraichte, duilgheadasan fhuasgladh agus am bathar a leasachadh.
  \SystemSettings\Resources\SystemSettings_Privacy_Feedback_Privacy_Link\DisplayName:
    Candidate Language=GD-GB: An aithris prìobhaideachd
  \SystemSettings\Resources\SystemSettings_Privacy_Feedback_Learn_More_Link\DisplayName:
    Candidate Language=GD-GB: Barrachd fiosrachaidh mu roghainnean na diagnosachd ⁊ nam beachdan
  \SystemSettings\Resources\SystemSettings_Privacy_Feedback_ErrorText\DisplayName:
    Candidate Language=GD-GB: Tha Windows Insider Program a’ stiùireadh na roghainn seo
  \SystemSettings\Resources\SystemSettings_Privacy_EnableSuggestionsInSettings\DisplayName:
    Candidate Language=GD-GB: Seall molaidhean susbaint dhomh ann an aplacaid nan roghainnean
  \SystemSettings\Resources\SystemSettings_Privacy_Diagnostic_Data_Toggle_Msg_Required:
    Candidate Language=GD-GB: An cois poileasaidh a shuidhich am buidheann agad, cha tèid ach dàta diagnosachd riatanach a chur gu Microsoft.
  \SystemSettings\Resources\SystemSettings_Privacy_Diagnostic_Data_Toggle_Msg_Optional_UX_Disabled:
    Candidate Language=GD-GB: An cois poileasaidh a shuidhich am buidheann agad, tha an dàta diagnosachd riatanach agus roghainneil ga chur gu Microsoft.
  \SystemSettings\Resources\SystemSettings_Privacy_Diagnostic_Data_Toggle_Msg_Optional:
    Candidate Language=GD-GB: Tha poileasaidh a shuidhich am buidheann agad a’ cuingeachadh an dàta diagnosachd roghainneil a tha ga chur gu Microsoft.
  \SystemSettings\Resources\SystemSettings_Privacy_Diagnostic_Data_Toggle_Msg_Disabled:
    Candidate Language=GD-GB: Chan urrainn dhuinn dàta diagnosachd roghainneil a chur gu Microsoft ri linn nan roghainnean làithreach agad a thaobh dàta diagnosachd.
  \SystemSettings\Resources\SystemSettings_Privacy_Diagnostic_Data_Title\Text:
    Candidate Language=GD-GB: Dàta na diagnosachd
  \SystemSettings\Resources\SystemSettings_Privacy_Diagnostic_Data_Subtitle\Text:
    Candidate Language=GD-GB: Cuidichidh seo airson piseach a thoirt air Windows agus a chumail tèarainte agus ùraichte.
  \SystemSettings\Resources\SystemSettings_Privacy_Diagnostic_Data_Required_Status:
