  \SystemSettings\Resources\HolographicVisuals_NotAvailableInHeadset\Text:
    Candidate Language=GD-GB: Gus seo atharrachadh, feumaidh tadhal air an duilleag seo air an desktop agad.
  \SystemSettings\Resources\HolographicVisuals_Framerate_Setting\DisplayName:
