  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_ProfileListEnableConfirmationText:
    Candidate Language=GD-GB: Cuiridh seo gu feum dàta mobile dhen phlana agad agus dh'fhaoidte gun èirich cosgaisean riut. A bheil thu airson leantainn air adhart?
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_ProfileListEditNicknameConfirmationText:
    Candidate Language=GD-GB: A bheil thu cinnteach gu bheil thu airson an t-ainm atharrachadh?
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_ProfileListDisableErrorText:
    Candidate Language=GD-GB: Cha b’ urrainn dhuinn sgur de chleachdadh na pròifil seo an-dràsta fhèin. Feuch ris a-rithist an ceann greis.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_ProfileListDisableEnableConfirmationText:
    Candidate Language=GD-GB: Sguiridh sinn dhen phròifil ghnìomhach is caillidh tu an ceangal mobile greiseag. A bheil thu airson leantainn air adhart?
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_ProfileListDisableConfirmationText:
    Candidate Language=GD-GB: Thèid do dhì-cheangal on lìonra mobile seo. A bheil thu airson leantainn air adhart?
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_ProfileListDeleteErrorText:
    Candidate Language=GD-GB: Cha b’ urrainn dhuinn a’ phròifil a sguabadh às
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_ProfileListDeleteConfirmationText:
    Candidate Language=GD-GB: Thèid a’ phròifil seo a sguabadh às gu buan agus bidh agad ri bruidhinn ris a’ ghiùlanair mobile agad airson a chur ris a-rithist. A bheil thu airson leantainn air adhart?
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_ProfileListDeactivateAndDeleteConfirmationText:
    Candidate Language=GD-GB: Thèid do dhì-cheangal on lìonra mobile seo agus thèid a’ phròifil a sguabadh às gu buan. Bidh agad ri bruidhinn ris a’ ghiùlanair mobile agad airson a chur ris a-rithist. A bheil thu airson leantainn air adhart? 
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_ProfileListBadProfileText:
    Candidate Language=GD-GB: Droch-phròifil
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_MemoryResetYesButton:
    Candidate Language=GD-GB: Tha
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_MemoryResetNoButton:
    Candidate Language=GD-GB: Chan eil
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_MemoryResetErrorText:
    Candidate Language=GD-GB: Cha b’ urrainn dhuinn na pròifilean a sguabadh às. Feuch ris a-rithist an ceann greis.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_MemoryResetDescription:
    Candidate Language=GD-GB: Sguab às gach pròifil air an eSIM agad
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_MemoryResetConfirmationText:
    Candidate Language=GD-GB: Sguabaidh seo às gach pròifil agad air an eSIM gu buan. A bheil thu cinnteach gu bheil thu airson leantainn air adhart?
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AuthPreferenceManageOnDescription:
    Candidate Language=GD-GB: Feumaidh tu clàradh a-steach mus fhaigh thu cothrom air na roghainnean seo
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AuthPreferenceManageOffDescription:
    Candidate Language=GD-GB: Cha leig thu leas clàradh a-steach airson na pròifilean eSIM agad a chur ris, a sguabadh às no a stiùireadh.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AuthPreferenceManageDescription:
    Candidate Language=GD-GB: Iarr clàradh a-steach mus urrainnear na roghainnean eSIM seo a stiùireadh
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AuthPreferenceAccessOnDescription:
    Candidate Language=GD-GB: Cha leig thu leas clàradh a-steach airson na pròifilean eSIM agad a chur ris, a sguabadh às no a stiùireadh.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AuthPreferenceAccessOffDescription:
    Candidate Language=GD-GB: Bidh agad ri clàradh a-steach airson na pròifilean eSIM agad a chur ris, a sguabadh às no a stiùireadh.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AuthPreferenceAccessDescription:
    Candidate Language=GD-GB: Iarr clàradh a-steach mus fhaighear cothrom air na roghainnean seo
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileYesButton:
    Candidate Language=GD-GB: Tha
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileWrongAuthTitle:
    Candidate Language=GD-GB: Chan urrainn dhomh clàradh a-steach
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileWrongAuthText:
    Candidate Language=GD-GB: Tha an t-ainm-cleachdaiche no facal-faire cearr. Bidh agad ri clàradh a-steach air cunntas aig a bheil còraichean rianaire mus urrainn dhut dad atharrachadh.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileSucceedText:
    Candidate Language=GD-GB: Tha a’ phròifil ùr deiseil ri chleachdadh. ’S urrainn dhut a ghnìomhachadh uair sam bith is a chleachdadh an uairsin.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileRetrievingTitle:
    Candidate Language=GD-GB: A’ lorg pròifilean
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileRetrievingErrorText:
    Candidate Language=GD-GB: Cha b’ urrainn dhuinn co-dhiù aon dhe na pròifilean a luchdadh a-nuas. Feuch ris a-rithist an ceann greis no cuir fios gun ghiùlanair mobile agad.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileNoProfileText:
    Candidate Language=GD-GB: Cha do lorg sinn pròifil sam bith an-dràsta fhèin. Feuch ris a-rithist an ceann greis no cuir fios gun ghiùlanair mobile agad.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileNoButton:
    Candidate Language=GD-GB: Chan ann an-dràsta
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileNextButton:
    Candidate Language=GD-GB: Air adhart
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileLearnMore:
    Candidate Language=GD-GB: Barrachd fiosrachaidh
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileInvalidActivationCode:
    Candidate Language=GD-GB: Còd gnìomhachaidh mì-dhligheach.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileInstallingProfileStateText:
    Candidate Language=GD-GB: Ga stàladh
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileESimUIDisabledByPolicy:
    Candidate Language=GD-GB: Chaidh eadar-aghaidh an eSIM a chur à comas le poileasaidh.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileESimNotSupportedOnSelectedSlot:
    Candidate Language=GD-GB: Cha chuir an slot SIM a thagh thu taic ri eSIM.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileESimNotSupportedOnAnySlot:
    Candidate Language=GD-GB: Cha chuir an t-adaptar mobile taic ri eSIM.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileErrorTitle:
    Candidate Language=GD-GB: Chaidh rudeigin cearr
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileErrorTextTimeout:
    Candidate Language=GD-GB: Dh’fhalbh an ùine air. Feuch gun cuir thu a’ phròifil ris a-rithist.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileErrorTextServerUnreachable:
    Candidate Language=GD-GB: Cha b’ urrainn dhuinn am frithealaiche a ruigsinn airson na companaidh fhònaichean-làimhe agad. Thoir sùil air a' cheangal agad ris an eadar-lìon is feuch ris a-rithist.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileErrorTextServerNotTrusted:
    Candidate Language=GD-GB: Chan urrainn dhuinn a’ phròifil seo a chur ris a chionn ’s nach eil am frithealaiche na thùs earbsach. Cuir fios gun ghiùlanair mobile agad.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileErrorTextServerGenericFailure:
    Candidate Language=GD-GB: Cha b’ urrainn dhuinn na pròifilean a luchdadh a-nuas ri linn duilgheadas leis an fhrithealaiche. Feuch ris a-rithist an ceann greis no cuir fios gun chompanaidh fhònaichean-làimhe agad.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileErrorTextProfileProcessingError:
    Candidate Language=GD-GB: Chan urrainn dhuinn a’ phròifil seo a chur ris ri linn duilgheadas leis an stàladh. Cuir fios gun ghiùlanair mobile agad.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileErrorTextProfileNotReleasedByOperator:
    Candidate Language=GD-GB: Chan urrainn dhuinn a’ phròifil a luchdadh a-nuas fhathast. Feuch ris a-rithist an ceann greis no cuir fios gun chompanaidh fhònaichean-làimhe agad.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileErrorTextProfileNotAvailableForNewBinding:
    Candidate Language=GD-GB: Chaidh a’ phròifil seo iomruineadh do dh’uidheam eile mar-thà. Dèan cinnteach gu bheil an còd gnìomhachaidh dligheach no cuir fios gun chompanaidh fhònaichean-làimhe agad.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileErrorTextProfileDownloadMaxRetriesExceeded:
    Candidate Language=GD-GB: Chan urrainn dhuinn a’ phròifil seo a chur ris a chionn ’s gun deach a luchdadh a-nuas ro thric. Cuir fios gun ghiùlanair mobile agad.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileErrorTextNoEligibleProfile:
    Candidate Language=GD-GB: Cha do lorg sinn pròifil a tha co-chòrdail ris an uidheam agad. Cuir fios gun chompanaidh fhònaichean-làimhe agad.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileErrorTextInvalidMatchingId:
    Candidate Language=GD-GB: Cha b’ urrainn dhuinn an ID aig a’ chòd gnìomhachaidh a mhaidseadh. Dèan cinnteach gu bheil an còd gnìomhachaidh dligheach no cuir fios gun chompanaidh fhònaichean-làimhe agad.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileErrorTextIccidAlreadyExists:
    Candidate Language=GD-GB: Chan urrainn dhuinn a’ phròifil seo a chur ris a chionn ’s gu bheil tè eile leis an aon ID air an eSIM agad mu thràth. Cuir fios gun ghiùlanair mobile agad.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileErrorTextEidMismatched:
    Candidate Language=GD-GB: Chan eil eSIM EID a’ maidseadh an fhear aig a’ pròifil agad. Cuir fios gun ghiùlanair mobile agad.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileErrorTextConfirmationCodeMaxRetriesExceeded:
    Candidate Language=GD-GB: Chaidh còd dearbhaidh cearr a chur a-steach ro thric. Cuir fios gun ghiùlanair mobile agad.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileErrorTextConfirmationCodeIncorrect:
    Candidate Language=GD-GB: Chan eil an còd dearbhaidh mar bu chòir. Feuch ris a-rithist.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileErrorTextCardNoSpace:
    Candidate Language=GD-GB: Chan urrainn dhuinn a’ phròifil seo a chur ris air sgàth ’s nach eil àite gu leòr air a’ chairt.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileErrorTextCardGenericFailure:
    Candidate Language=GD-GB: Cha b’ urrainn dhuinn na pròifilean a luchdadh a-nuas ’s a stàladh air an eSim agad. Feuch ris a-rithist an ceann greis no cuir fios gun ghiùlanair mobile agad.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileDownloadingTitle:
    Candidate Language=GD-GB: A’ luchdadh a-nuas is a’ stàladh na pròifil
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileDownloadingProfileStateText:
    Candidate Language=GD-GB: Ga luchdadh a-nuas
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileDownloadErrorText:
    Candidate Language=GD-GB: Cha b’ urrainn dhuinn a’ phròifil seo a chur ris an-dràsta fhèin. Feuch ris a-rithist an ceann greis.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileDownloadConfirmationTitle:
    Candidate Language=GD-GB: A bheil thu airson a’ phròifil seo a luchdadh a-nuas?
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileDownloadConfirmationCodeText:
    Candidate Language=GD-GB: Cuir a-steach an còd dearbhaidh a fhuair thu on ghiùlanair mobile agad
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileDownloadCompleteTitle:
    Candidate Language=GD-GB: Tha a’ phròifil ùr deiseil
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileDownloadButton:
    Candidate Language=GD-GB: Luchdaich a-nuas
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileDisableCurrentProfileMessage:
    Candidate Language=GD-GB: Tha an ceangal agad ris an eadar-lìon cuingichte an-dràsta fhèin. Nì sinn ceangal ri lìonra eile an-dràsta fhèin airson ’s gun urrainn dhut pròifil ùr a luchdadh a-nuas agus ceangail ris an eadar-lìon.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileContinueButton:
    Candidate Language=GD-GB: Lean air adhart
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileContactingServersStateText:
    Candidate Language=GD-GB: A’ bruidhinn ris na frithealaichean
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileConfirmationText:
    Candidate Language=GD-GB: Cuir a-steach an còd dearbhaidh a fhuair thu on ghiùlanair mobile agad
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileCloseButton:
    Candidate Language=GD-GB: Dùin
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileCancelButton:
    Candidate Language=GD-GB: Sguir dheth
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileAuthRequired:
    Candidate Language=GD-GB: Tha feum air dearbhadh. Bidh agad ri tadhal air duilleag roghainnean nam pròifilean eSIM agus clàradh a-steach air cunntas aig a bheil còraichean rianaire mus urrainn dhut dad atharrachadh.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileAddModeTitle:
    Candidate Language=GD-GB: Ciamar a bu toigh leat pròifilean ùra a chur ris?
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_ESim_AddProfileActivationTitle:
    Candidate Language=GD-GB: Sganaich an còd QR
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_EnableSimPin1Title:
    Candidate Language=GD-GB: Cleachd PIN an t-SIM
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_EnableSimPin1Description:
    Candidate Language=GD-GB: Cleachd PIN an t-SIM
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_EnableSimPin1ActionDescription:
    Candidate Language=GD-GB: Cleachd PIN gus an SIM agad a dhìon
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_EditSimPin1Title:
    Candidate Language=GD-GB: Atharraich PIN an t-SIM
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_EditSimPin1Description:
    Candidate Language=GD-GB: Atharraich PIN an t-SIM
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_EditSimPin1ActionDescription:
    Candidate Language=GD-GB: Tha thu a’ cleachdadh PIN gus an SIM agad a dhìon
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_DisableSubsidyLockDescription:
    Candidate Language=GD-GB: Thoir a’ ghlais far an uidheim
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_DisableSubsidyLockActionDescription:
    Candidate Language=GD-GB: Thoir a’ ghlas far an uidheim seo gus a chleachdadh air giùlanair mobile eile.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_DisableSimPin1Description:
    Candidate Language=GD-GB: Thoir air falbh PIN an t-SIM
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_DisableSimPin1ActionDescription:
    Candidate Language=GD-GB: Thoir am PIN air falbh mur eil thu airson an SIM agad a dhìon le PIN.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_DefaultAPNSelectionManualMessage:
    Candidate Language=GD-GB: Cleachdaidh sinn an APN eadar-lìn a thagh thu a ghnàth.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_DefaultAPNSelectionDescription:
    Candidate Language=GD-GB: Tagh APN eadar-lìn bunaiteach
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_DefaultAPNSelectionAutomaticMessage:
    Candidate Language=GD-GB: Cleachdaidh sinn an APN eadar-lìn as fhearr a lorg sinn gu fèin-obrachail. Cha chleachd sinn APN ma tha teans gun do chruthaich thusa no am buidheann agad e.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_DefaultAPNSelectionAutomatic:
    Candidate Language=GD-GB: Gu fèin-obrachail
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_DataSpeedSelectionDescription:
    Candidate Language=GD-GB: Astar a’ cheangail
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_DataSpeedSelection4GLTEPreferred:
    Candidate Language=GD-GB: B’ fhearr leam 4G LTE
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_DataSpeedSelection3GPreferred:
    Candidate Language=GD-GB: B’ fhearr leam 3G
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_DataSpeedSelection3GOnly:
    Candidate Language=GD-GB: 3G a-mhàin
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_DataSpeedSelection2GOnly:
    Candidate Language=GD-GB: 2G a-mhàin
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_DataRoamingWarning:
    Candidate Language=GD-GB: A-rèir aonta na seirbheise agad, dh’fhaoidte gum pàigh thu a bharrachd nuair a chleachdas tu dàta nuair a bhios an t-uidheam agad air fàrsan airson cuid a rudan mar phost-d, grad-theachdaireachd no faidhlichean am broinn teacsa a chur no gus an lìon a bhrabhsadh.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_DataRoamingEnabledLabelDescription:
    Candidate Language=GD-GB: Nuair a ruigeas tu sgìre air fàrsan, thèid an ceangal dàta agad a chur dheth.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_DataRoamingEnabledLabelATTSpecificedDescription:
    Candidate Language=GD-GB: Èiridh cosgaisean a bharrachd ma chleachdas tu dàta air fàrsan taobh a-muigh nan Stàitean Aonaichte, Porto Rìceo agus Eileanan na Maighdinn aig na Stàitean Aonaichte. Na ceadaich dàta air fàrsan mur eil thu leagte ri cosgaisean dàta air fàrsan.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_DataRoamingEnabledDescription:
    Candidate Language=GD-GB: Dàta air fàrsan
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_DataRoamingDescription:
    Candidate Language=GD-GB: Roghainnean dàta air fàrsan
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_DataRoamingActionDescription_NotAllowed:
    Candidate Language=GD-GB: Nuair a ruigeas tu sgìre air fàrsan, thèid an ceangal dàta agad a chur dheth.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_DataRoamingActionDescription_DomesticAndInternational:
    Candidate Language=GD-GB: A-rèir aonta na seirbheise agad, dh’fhaoidte gum pàigh thu a bharrachd nuair a chleachdas tu dàta air fàrsan nàiseanta no eadar-nàiseanta.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_DataRoamingActionDescription_Domestic:
    Candidate Language=GD-GB: A-rèir aonta na seirbheise agad, dh’fhaoidte gum pàigh thu a bharrachd nuair a chleachdas tu dàta air fàrsan nàiseanta.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_DataRoamingActionDescription_Disabled:
    Candidate Language=GD-GB: Cuir fios gun chompanaidh fhònaichean-làimhe agad gus dàta air fàrsan a chur an comas.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_DataRoamingActionDescription_ATTSpecificedDescription:
    Candidate Language=GD-GB: Èiridh cosgaisean a bharrachd ma chleachdas tu dàta air fàrsan taobh a-muigh nan Stàitean Aonaichte, Porto Rìceo agus Eileanan na Maighdinn aig na Stàitean Aonaichte. Na ceadaich dàta air fàrsan airson cosgaisean dàta air fàrsan a sheachnadh.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_DataRoamingActionDescription_Allowed:
    Candidate Language=GD-GB: A-rèir aonta na seirbheise agad, dh’fhaoidte gum pàigh thu a bharrachd nuair a chleachdas tu dàta air fàrsan.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_DataEnabledLabelDescription:
    Candidate Language=GD-GB: Tachraidh gun tèid ceangal dàta mobile a chleachdadh sa chùlaibh agus gun èirich cosgaisean riut. Cuir dheth e ma tha thu airson cosgaisean a bharrachd a sheachnadh.
  \SystemSettings\Resources\SystemSettings_Connections_MobileBroadband_DataEnabledDescription:
    Candidate Language=GD-GB: Ceangal dàta
