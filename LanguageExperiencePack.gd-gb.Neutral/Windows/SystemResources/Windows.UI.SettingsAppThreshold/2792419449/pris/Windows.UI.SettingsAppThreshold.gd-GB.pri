    Candidate Language=GD-GB: Chan eil aplacaid sam bith ann aig an àm seo a chleachdas gnìomhachadh labhairte.
  \SystemSettings\Resources\SystemSettings_Privacy_UserLocationOverride\DisplayName:
    Candidate Language=GD-GB: Ceadaich tar-àithneadh an ionaid
  \SystemSettings\Resources\SystemSettings_Privacy_UserLocationOverride\AdditionalDescription:
    Candidate Language=GD-GB: Faodaidh Windows, aplacaidean is seirbheisean an t-ionad a chleachdadh air ceangal cèin seach ionad an uidheim seo
  \SystemSettings\Resources\SystemSettings_Privacy_Telemetry_Viewer_Toggle_Policy_Msg:
    Candidate Language=GD-GB: Air sgàth poileasaidh a shuidhich am buidheann agad, chan urrainn dhut coimhead air an dàta diagnosachd. Cuir fios gun rianaire TF no gun bhuidheann agad airson barrachd fiosrachaidh.
  \SystemSettings\Resources\SystemSettings_Privacy_Telemetry_Viewer_Toggle_2_On_Status:
