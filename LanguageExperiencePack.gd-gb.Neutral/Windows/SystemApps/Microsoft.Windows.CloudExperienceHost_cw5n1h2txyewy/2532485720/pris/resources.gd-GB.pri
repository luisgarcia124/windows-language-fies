  \oobeHello\KeepBioDataTitle:
    Candidate Language=GD-GB: Tha, clàraichidh mi a-steach le m’ aodann no lorg mo mheòir
  \oobeHello\KeepBioDataSubtitle:
    Candidate Language=GD-GB: Cumaibh a’ dol a’ glèidheadh an dàta agam ach an urrainn dhomh clàradh a-steach dhan PC seo le Windows Hello slighe aithneachadh m’ aodainn no lorg mo mheòir.
  \oobeHello\HelloTitleMulti:
    Candidate Language=GD-GB: A bheil thu airson Windows Hello a shuidheachadh airson clàradh a-steach nas luaithe ’s air dòigh nas tèarainte?
  \oobeHello\HelloTitleFingerprint:
    Candidate Language=GD-GB: A bheil thu airson lorg do mheòir a chleachdadh airson clàradh a-steach nas luaithe ’s air dòigh nas tèarainte?
  \oobeHello\HelloTitleFace:
    Candidate Language=GD-GB: A bheil thu airson d’ aodann a chleachdadh airson clàradh a-steach nas luaithe ’s air dòigh nas tèarainte?
  \oobeHello\HelloSwitchFingerprintToFace:
    Candidate Language=GD-GB: Cleachd aithneachadh aodainn na àite
  \oobeHello\HelloSwitchFaceToFingerprint:
    Candidate Language=GD-GB: Cleachd lorg do mheòir na àite
  \oobeHello\HelloSkipLink:
    Candidate Language=GD-GB: Gearr leum thairis air an-dràsta
  \oobeHello\HelloSkip2SpeechConstraint:
    Candidate Language=GD-GB: Skip for now
  \oobeHello\HelloSkip1SpeechConstraint:
    Candidate Language=GD-GB: Skip
  \oobeHello\HelloSetUpSpeechConstraint:
    Candidate Language=GD-GB: Set up
  \oobeHello\HelloOptionTitleFingerprint:
    Candidate Language=GD-GB: Cleachd lorg do mheòir
  \oobeHello\HelloOptionTitleFace:
    Candidate Language=GD-GB: Cleachd aithneachadh aodainnean
  \oobeHello\HelloOptionBodyFingerprint:
    Candidate Language=GD-GB: Tha mothaichear airson lorg-meòir aig an uidheam agad cuideachd a dh’obraicheas le Windows Hello agus leis a sin, ’s urrainn dhut clàradh a-steach tèarainte a dhèanamh le do mheur fhèin.
  \oobeHello\HelloMultiVoiceOver:
    Candidate Language=GD-GB: Windows Hello gives you a couple of options for signing in speedily and securely. Would you prefer to use your fingerprint or your face?
  \oobeHello\HelloMultiListAccessibleName:
    Candidate Language=GD-GB: Liosta nam mothaichearan a tha co-chòrdail le Windows Hello
  \oobeHello\HelloMultiFingerprint7SpeechConstraint:
    Candidate Language=GD-GB: Use your fingerprint
  \oobeHello\HelloMultiFingerprint6SpeechConstraint:
    Candidate Language=GD-GB: Use my fingerprint
