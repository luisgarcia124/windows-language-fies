  \hololensDiagnostics\ProgressDescription:
    Candidate Language=GD-GB: A’ faighinn an fhiosrachaidh diagnosachd...
  \hololensDiagnostics\PrivacyStatementLink:
    Candidate Language=GD-GB: An aithris prìobhaideachd
  \hololensDiagnostics\PrivacyHeadline:
    Candidate Language=GD-GB: An aithris prìobhaideachd
  \hololensDiagnostics\PrivacyBody:
    Candidate Language=GD-GB: Cuir https://aka.ms/privacy ann am bàr an t-seòlaidh aig brabhsair sam bith air uidheam sam bith airson barrachd fiosrachaidh mu na chruinnicheas sinn.
  \hololensDiagnostics\NextButton:
    Candidate Language=GD-GB: Cruinnich am fiosrachadh
  \hololensDiagnostics\Instruction4:
    Candidate Language=GD-GB: 4. An dèidh dhut na faidhlichean a shàbhaladh, till an-seo is tagh “Dèanta”. Bheir seo air falbh na faidhlichean on HoloLens agad.
  \hololensDiagnostics\Instruction3:
    Candidate Language=GD-GB: 3. Cuir lethbhreac de fhaidhlichean diagnosachd HoloLens dhan PC agad.
  \hololensDiagnostics\Instruction2:
    Candidate Language=GD-GB: 2. Gabh ri stiùireadh sam bith a dh’iarras ort taisgealaiche nam faidhle fhosgladh air a’ PC agad.
  \hololensDiagnostics\Instruction1:
    Candidate Language=GD-GB: 1. Ceangail an HoloLens ris a’ PC agad.
  \hololensDiagnostics\Instruction0:
    Candidate Language=GD-GB: A shàbhaladh am fiosrachadh diagnosachd dhan PC agad:
  \hololensDiagnostics\ContinueButton:
    Candidate Language=GD-GB: Deiseil
  \hololensDiagnostics\CancelButton:
    Candidate Language=GD-GB: Sguir dheth
  \hololensDiagnostics\BodyTroubleshooting:
    Candidate Language=GD-GB: Cuidichidh fiosrachadh diagnosachd mar seo le càradh an duilgheadais seo. Turas a chaidh a chruinneachadh, bidh e ri làimh duine sam bith a gheibh cothrom air an uidheam seo. Bidh cothrom agad cuideachd a shàbhaladh air a’ PC agad ach an urrainn dhut a chur gun rianaire agad no Microsoft.
  \hololensDiagnostics\BodySuccess:
    Candidate Language=GD-GB: Turas a shàbhail thu am fiosrachadh air a’ PC agad, cuir gun rianaire agad e no gabh a-staigh e ma chuireas tu fios gu sgioba na taice.
  \hololensDiagnostics\BodyError:
    Candidate Language=GD-GB: Cha b’ urrainn dhuinn na logaichean diagnosachd ullachadh is a chruinneachadh. Feuch cunntas eile.
  \hololensDiagnostics\Body:
    Candidate Language=GD-GB: Feuch ris a-rithist no tagh “Sguir dheth” gus an t-uidheam agad a shuidheachadh uaireigin eile.
  \hololensDiagnostics\BackButton:
    Candidate Language=GD-GB: Air ais
  \hololensAccount\UserPlaceholder:
    Candidate Language=GD-GB: cuideigin@example.com
  \hololensAccount\Title:
    Candidate Language=GD-GB: Clàraich a-steach leis a’ chunntas obrach agad
  \hololensAccount\PasswordTitle:
    Candidate Language=GD-GB: Cuir a-steach am facal-faire agad
  \hololensAccount\PasswordPlaceholder:
    Candidate Language=GD-GB: Facal-faire
  \hololensAccount\NextButton:
    Candidate Language=GD-GB: Air adhart
  \hololensAccount\LeadText:
    Candidate Language=GD-GB: Clàraich a-steach leis an aon chunntas a chleachdas tu airson Office 365 no seirbheisean gnìomhachais eile o Microsoft. Faodaidh am buidheann agad fiosrachadh mu do dhèidhinn a chruinneachadh, aplacaidean a stàladh no a thoirt air falbh, roghainnean atharrachadh, gleusan a chur à comas, susbaint a sguabadh às no an t-uidheam agad ath-shuidheachadh.
  \hololensAccount\Error_UsernameFormat:
    Candidate Language=GD-GB: Chan eil coltas seòladh puist-d na h-obrach no na sgoile air. Cleachd seòladh puist-d eile.
  \hololensAccount\Error_UserExists:
    Candidate Language=GD-GB: Tha cleachdaiche ann aig a bheil an seòladh puist-d seo mu thràth
  \hololensAccount\Error_NoUsername:
    Candidate Language=GD-GB: Cuir a-steach an t-ainm-cleachdaiche agad
  \hololensAccount\Error_Creating_Account_Warning:
    Candidate Language=GD-GB: Chaidh rudeigin cearr.
  \hololensAccount\BackButton:
    Candidate Language=GD-GB: Air ais
  \hello\WindowsHelloAnimationAltText:
    Candidate Language=GD-GB: Beòthachadh Windows Hello
  \hello\TitleFingerprint:
    Candidate Language=GD-GB: Cleachd lorg do mheòir a chlàradh a-steach nas luaithe air dòigh nas tèarainte
  \hello\TitleFaceFingerprint:
    Candidate Language=GD-GB: Clàraich a-steach nas luaithe air dòigh nas tèarainte
  \hello\TitleFace:
    Candidate Language=GD-GB: Cleachd d’ aodann a chlàradh a-steach nas luaithe air dòigh nas tèarainte
  \hello\SkipLink:
    Candidate Language=GD-GB: Gearr leum thairis air an-dràsta
  \hello\LeadTextFingerprint:
    Candidate Language=GD-GB: Dèan taghadh no can <strong>Air adhart</strong> a shuidheachadh Windows Hello.
  \hello\LeadTextFaceFingerprint:
    Candidate Language=GD-GB: Tagh an dòigh air am bu chaomh leat clàradh a-steach gu Windows. ’S urrainn dhut <strong>Face</strong> no <strong>Fingerprint</strong> a ràdh airson suidheachadh Windows Hello a thòiseachadh.
  \hello\LeadTextFace:
    Candidate Language=GD-GB: Dèan taghadh no can <strong>Air adhart</strong> a shuidheachadh Windows Hello.
  \hello\FingerprintButton:
    Candidate Language=GD-GB: Cleachd lorg-meò&ir
  \hello\FaceButton:
    Candidate Language=GD-GB: Cleachd m’ &aodann
  \hello\ContinueButton:
    Candidate Language=GD-GB: &Air adhart
  \hello\BodyTextFingerprint:
    Candidate Language=GD-GB: Tha mothaichear airson lorg-meòir aig an uidheam agad a dh’obraicheas le Windows Hello agus leis a sin, tha dòigh shimplidh ri do làimh airson dearbhadh cò thusa gun fheum air facal-faire.
  \hello\BodyTextFace:
    Candidate Language=GD-GB: Aithnichidh Windows Hello thu slighe a’ chamara agad agus leis a sin, tha dòigh shimplidh ri do làimh airson dearbhadh cò thusa gun fheum air facal-faire.
  \hello\BodyFingerprintOptionCaption:
    Candidate Language=GD-GB: Lorg-meòir
  \hello\BodyFaceOptionCaption:
    Candidate Language=GD-GB: Aithnicheadh aodainnean
