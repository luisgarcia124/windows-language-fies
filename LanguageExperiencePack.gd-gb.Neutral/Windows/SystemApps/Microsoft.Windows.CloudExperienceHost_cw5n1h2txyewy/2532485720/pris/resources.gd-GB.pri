  \roamingSettings\nextButton:
    Candidate Language=GD-GB: Coilean
  \roamingSettings\LeadText:
    Candidate Language=GD-GB: Dè na roghainnean PC a tha sa chunntas Microsoft agad a bu toigh leat sioncronachadh ris a’ PC seo?
  \retailDemo\useOfflineShutdownToggle:
    Candidate Language=GD-GB: Tar-àithn na roghainnean air loidhne
  \retailDemo\timeZoneText:
    Candidate Language=GD-GB: Dèan cinnteach gu bheil an roinn-tìde air an uidheam seo ceart nuair a ruigeas tu an desktop. Feumaidh tu clàradh a-steach air cunntas rianaire mus urrainn dhut an roinn-tìde atharrachadh.
  \retailDemo\timeoutLegend:
    Candidate Language=GD-GB: Thoir air falbh inntrigeadh rianaire às dèidh
  \retailDemo\storeIdLegend:
    Candidate Language=GD-GB: ID bùth reiceadair
  \retailDemo\skuLegend:
    Candidate Language=GD-GB: SKU an reiceadair no # an nì
  \retailDemo\signInLink:
    Candidate Language=GD-GB: Clàraich a-steach le cunntas Microsoft a tha agad mu thràth
  \retailDemo\shutdownTextOnline:
    Candidate Language=GD-GB: Tha na h-amannan aig an dèan an t-uidheam seo dùnadh sìos ga rèiteachadh slighe seirbheis neòil Retail Demo Experience
  \retailDemo\shutdownText:
    Candidate Language=GD-GB: Tagh na h-amannan aig an dèan an t-uidheam seo dùnadh sìos
  \retailDemo\shutdownsTitle:
    Candidate Language=GD-GB: Dùnadh sìos fèin-obrachail
  \retailDemo\shutdownsInfo:
    Candidate Language=GD-GB: Suidhich na h-amannan aig an dèan an t-uidheam seo dùnadh sìos gu fèin-obrachail.
  \retailDemo\securityTitle:
    Candidate Language=GD-GB: Roghainnean rianaire RDX
  \retailDemo\securityText:
    Candidate Language=GD-GB: Tagh an dòigh san tèid RDX a ruith mus tèid an t-inntrigeadh dhan chunntas rianaire a thoirt air falbh. Nuair a bhios an t-inntrigeadh air a thoirt air falbh, chan urrainn dhut sgriobtaichean a ruith no saothraichean rianaire sam bith eile a dhèanamh tuilleadh. Ma tha thu airson inntrigeadh rianaire a chumail gun chrìoch, ’s urrainn dhut facal-faire rianaire gnàthaichte a chruthachadh. Dèan cinnteach gum bi am facal-faire gnàthaichte agad cho tèarainte ’s a ghabhas.
  \retailDemo\retypePassword:
    Candidate Language=GD-GB: Cuir a-steach am facal-faire a-rithist
  \retailDemo\removeRdxTitle:
    Candidate Language=GD-GB: Thoir RDX air falbh
  \retailDemo\removeRdxText:
    Candidate Language=GD-GB: Thoir air falbh
  \retailDemo\removeRdxInfo:
    Candidate Language=GD-GB: Thoir air falbh RDX on uidheam seo agus till gu roghainnean an fhactaraidh e.
  \retailDemo\rdxTitle:
    Candidate Language=GD-GB: Suidheachadh demo
  \retailDemo\rdamTitle:
    Candidate Language=GD-GB: Faigh an t-susbaint is na h-aplacaidean demo as ùire
  \retailDemo\rdamText:
    Candidate Language=GD-GB: Ma chuireas tu am fiosrachadh (roghainneil) seo a-steach, bidh sin na chuideachadh dhuinn ach an urrainn dhut an t-susbaint as ùire a shealltainn dhut air an uidheam Windows seo.
  \retailDemo\racLegend:
    Candidate Language=GD-GB: Retail Access Code (RAC)
  \retailDemo\passwordSuggestion:
    Candidate Language=GD-GB: Facal-faire
  \retailDemo\passwordManagmentLegend:
    Candidate Language=GD-GB: Thoir air falbh inntrigeadh an rianaire gu fèin-obrachail às dèidh an ama a chaidh a shònrachadh
  \retailDemo\passwordLegend:
    Candidate Language=GD-GB: Facal-faire rianaire (cha mholamaid seo)
  \retailDemo\passwordError:
    Candidate Language=GD-GB: Chan eil an dà fhacal-faire co-ionann
  \retailDemo\nextButton:
    Candidate Language=GD-GB: Air adhart
  \retailDemo\msaTitle:
    Candidate Language=GD-GB: ’S mithich dhut cunntas Microsoft demo a chruthachadh
  \retailDemo\msaText:
    Candidate Language=GD-GB: Feumaidh tu cunntas Microsoft demo mus urrainn dhut demothan a chur an comas leithid Microsoft Store. Briog air “Coilean” gus cunntas Microsoft a chruthachadh gu fèin-obrachail.
  \retailDemo\immediatelyText:
    Candidate Language=GD-GB: Sa bhad
  \retailDemo\finishButton:
    Candidate Language=GD-GB: Coilean
  \retailDemo\extraConfigText:
    Candidate Language=GD-GB: Rèiteachadh adhartach
  \retailDemo\errorRequestTimeout:
    Candidate Language=GD-GB: Dh’fhalbh an ùine air an iarrtas lìonraidh, feuch ris a-rithist
  \retailDemo\errorInvalidRac:
    Candidate Language=GD-GB: Chan eil an Retail Access Code dligheach, feuch ris a-rithist le còd dligheach
  \retailDemo\enterPassword:
    Candidate Language=GD-GB: Cuir a-steach am facal-faire
  \retailDemo\dayText:
    Candidate Language=GD-GB: {0} latha
