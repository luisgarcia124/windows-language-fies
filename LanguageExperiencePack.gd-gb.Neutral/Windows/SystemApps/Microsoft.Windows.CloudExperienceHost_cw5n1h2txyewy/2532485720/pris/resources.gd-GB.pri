  \oobeRegion\ListAccessibleName:
    Candidate Language=GD-GB: Taghadh na dùthcha no na roinn-dùthcha
  \oobeRegion\FinalRegionVoiceOver:
    Candidate Language=GD-GB: Ok, don't let me hold you up. Just pick the one you want from the list.
  \oobeRegion\ConfirmRegionVoiceOver:
    Candidate Language=GD-GB: I've got that you want to use %1. Is that right?
  \oobeProvisioningStatus\ResetConfirmationDialogTitle:
    Candidate Language=GD-GB: A bheil thu airson pròiseas an t-suidheachaidh ath-shuidheachadh?
