  \localAccount\Username_Error:
    Candidate Language=GD-GB: Chan fhaod na caractaran a leanas a bhith ann an ainm-cleachdaiche:/ \ [ ] : | < > + = ; , ? * %
  \localAccount\UserNameLegend:
