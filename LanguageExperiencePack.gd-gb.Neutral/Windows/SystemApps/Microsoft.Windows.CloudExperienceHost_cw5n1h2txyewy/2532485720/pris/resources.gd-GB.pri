  \shubOobeDeviceType\HuddleDescription:
    Candidate Language=GD-GB: Tagh seo airson co-chleachdadh, whiteboarding agus brainstorming. Cuir air Windows Hello is sàbhail na pròifilean airson clàradh a-steach luath.
  \shubOobeDeviceType\DeviceTypeTitle:
    Candidate Language=GD-GB: Ciamar a chleachdas tu an t-uidheam seo?
  \shubOobeDeviceType\DeviceTypeDescription:
    Candidate Language=GD-GB: Suidhichidh sinn rudan a-rèir do roghainn. ’S urrainn dhut rudan atharrachadh sna roghainnean uair sam bith.
  \shubOobeDeviceType\ConferenceHeader:
    Candidate Language=GD-GB: Coinneamhan is taisbeanaidhean
  \shubOobeDeviceType\ConferenceDescription:
    Candidate Language=GD-GB: Tagh seo airson seòmraichean cho-labhairtean, coinneamhan sgeidealaichte agus taisbeanaidhean. Cha tèid Windows Hello a chur air agus thèid an dàta a thoirt air falbh an dèidh gach seisein.
  \roamingSettings\Title:
