    Candidate Language=GD-GB: &Sguir dheth
  \localAccount\BackButton:
    Candidate Language=GD-GB: &Air ais
  \hololensDiagnostics\TroubleshootingLink:
    Candidate Language=GD-GB: Fuasgladh dhuilgheadasan
  \hololensDiagnostics\TitleTroubleshooting:
    Candidate Language=GD-GB: Faigh am fiosrachadh diagnosachd
  \hololensDiagnostics\TitleSuccess:
    Candidate Language=GD-GB: Sàbhail am fiosrachadh diagnosachd dhan PC agad
  \hololensDiagnostics\TitleError:
