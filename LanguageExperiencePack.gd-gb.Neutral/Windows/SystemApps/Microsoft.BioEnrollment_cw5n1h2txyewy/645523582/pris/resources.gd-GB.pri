  \BioEnrollmentUI\FaceTooManyFacesText:
    Candidate Language=GD-GB: Mhothaich sinn do barrachd air aon aodann. Chan urrainn ach dha dh'aonar a dhol tron t-suidheachadh aig an aon àm.
  \BioEnrollmentUI\FaceNotDetectedText:
    Candidate Language=GD-GB: Dèan cinnteach gu bheil d’ aodann am meadhan an fhrèama.
  \BioEnrollmentUI\FaceMoveForwardText:
    Candidate Language=GD-GB: Gluais nas fhaisge air a’ chamara.
  \BioEnrollmentUI\FaceMoveBackwardText:
    Candidate Language=GD-GB: Gluais nas fhaide air falbh on chamara.
  \BioEnrollmentUI\FaceGuidanceStartText:
    Candidate Language=GD-GB: Cum a’ dol a’ coimhead air adhart ris a’ chamara.
  \BioEnrollmentUI\FaceErrorTooFarText:
    Candidate Language=GD-GB: Ro fhad air falbh! Gluais beagan nas dlùithe.
  \BioEnrollmentUI\FaceErrorTooDarkText:
    Candidate Language=GD-GB: Ro dhorcha! Cuir air solais no rach a dh’àite nas soilleire.
  \BioEnrollmentUI\FaceErrorTooCloseText:
    Candidate Language=GD-GB: Ro dhlùth! Gluais beagan nas fhaide air falbh.
  \BioEnrollmentUI\FaceErrorTooBrightText:
    Candidate Language=GD-GB: Ro shoilleir! Mùch an solas no rach a-steach.
  \BioEnrollmentUI\FaceErrorPoorQualityText:
    Candidate Language=GD-GB: Cha b' urrainn dhan uidheam agad do lorg. Dèan cinnteach gu bheil lionsa a’ mhothaicheir agad glan.
  \BioEnrollmentUI\FaceErrorFaceOccludedText:
