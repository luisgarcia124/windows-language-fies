  \BioEnrollmentUI\Face\RetailDemoWelcomePageHeader\Text:
    Candidate Language=GD-GB: Dìochuimhnich cur a-steach facail-fhaire
  \BioEnrollmentUI\Face\RetailDemoWelcomePageFootage\Text:
    Candidate Language=GD-GB: Thèid gach dàta beò-meatrach a chleachdas sinn san demo seo a chrioptachadh agus thèid a sguabadh às às dèidh dà mhionaid gun ghnìomh.
  \BioEnrollmentUI\Face\RetailDemoWelcomePageBody\Text:
    Candidate Language=GD-GB: Aithnichidh an t-uidheam agad thu cha mhòr sa bhad le d' aodann no do lorg-meòir.
  \BioEnrollmentUI\Face\RetailDemoNamePageHeader\Text:
    Candidate Language=GD-GB: Dè chuireas sinn ort?
  \BioEnrollmentUI\Face\RetailCleanupPageHeader\Text:
    Candidate Language=GD-GB: Sin thu deiseil! Feuch e a-nis.
  \BioEnrollmentUI\Face\PinRequiredPageBody\Text:
