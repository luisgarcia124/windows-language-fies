  \resources\HolographicUninstall_RestartHeaderText:
    Candidate Language=MR-IN: पुनःप्रारंभ आवश्यक
  \resources\HolographicUninstall_RestartBodyText:
    Candidate Language=MR-IN: Windows Mixed Reality विस्थापना समाप्त करण्यासाठी आपल्या कॉम्प्यूटरचा पुनःप्रारंभ करा.
  \resources\HolographicUninstall_LearnMoreText:
