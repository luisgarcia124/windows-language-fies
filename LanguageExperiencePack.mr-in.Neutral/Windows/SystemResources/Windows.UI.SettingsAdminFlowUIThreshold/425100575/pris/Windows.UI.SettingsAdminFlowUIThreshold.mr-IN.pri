  \resources\Uninstall_MovedProfile_Header:
    Candidate Language=MR-IN: खाती परत हलवा
  \resources\Uninstall_MovedProfile_FormatMany:
    Candidate Language=MR-IN: आपण %d खाती हलवली:
  \resources\Uninstall_MovedProfile_Desc\Text:
    Candidate Language=MR-IN: आपण Windows च्या मागील आवृत्तीवर परत जाण्यापूर्वी आपल्याला, आपल्या सर्वात अलीकडील उन्नतीकरणानंतर आपण हलविलेली कोणतीही प्रयोक्ता खाती त्यांच्या मूळ ठिकाणी राहू देण्याची आवश्यकता असेल.
  \resources\Uninstall_MissingExternal_Desc\Text:
    Candidate Language=MR-IN: आम्ही आपल्याला Windows च्या मागील आवृत्तीवर नेऊ शकत नाही कारण आपल्या सर्वात अलीकडे उन्नतीकरणादरम्यान वापरलेला USB फ्लॅश ड्राइव्ह किंवा अन्य बाह्य ड्राइव्ह गहाळ आहे. कृपया डिस्क समाविष्ट करा आणि पुन्हा प्रयत्न करा.
  \resources\Uninstall_InsufficientSpace_Format:
    Candidate Language=MR-IN: परत जाण्यासाठी, आपल्याला जिथे Windows स्थापित केलेले आहे त्या ड्राइव्हवर %ws मोकळी जागा आवश्यक आहे.
  \resources\Uninstall_InsufficientSpace_Desc\Text:
