  \resources\Uninstall_Information_ListDesc\Text:
    Candidate Language=MR-IN: परत गेल्यानंतर:
  \resources\Uninstall_Information_Header:
    Candidate Language=MR-IN: आपण काय जाणून घेणे आवश्यक आहे
  \resources\Uninstall_Information_Desc\Text:
    Candidate Language=MR-IN: यासाठी थोडा वेळ लागू शकतो आणि हे पूर्ण होईपर्यंत आपण आपला PC वापरण्यात सक्षम असणार नाही. आपला PC प्लग इन केलेला आणि चालू केलेला राहू द्या.
  \resources\Uninstall_Information_BackupWarning\Text:
    Candidate Language=MR-IN: आपल्या फाइल्सचा बॅक अप घेतला? याचा त्यांच्यावर प्रभाव पडणार नाही, परंतु पर्यायी व्यवस्था केलेले केव्हाही चांगले.
  \resources\Uninstall_Information_AppsAndPrograms:
