  \SystemSettings\Resources\HolographicVisualQuality_VisualQuality_Quality2\DisplayName:
    Candidate Language=MR-IN: मिश्रीत वास्तविकतेमधील तपशील आणि गुणवत्ता
  \SystemSettings\Resources\HolographicVisualQuality_VisualQuality_LearnMoreLink\Content:
    Candidate Language=MR-IN: Windows Mixed Reality FAQ वापरणे
  \SystemSettings\Resources\HolographicVisualQuality_VisualQuality_DescriptionLabel\Text:
    Candidate Language=MR-IN: या सेटिंग्ज बदलण्यामुळे या PC वरील कार्यप्रदर्शन प्रभावित होऊ शकते. सेटिंग्ज प्रभावी होण्यासाठी, मिश्रित वास्तविक पोर्टल रीस्टार्ट करा.
