  \resources\SystemSettings_Activation_USED_PRODUCT_KEY_CONTENT:
    Candidate Language=MR-IN: आम्ही ह्या डिव्हाइसवर Windows सक्रिय करू शकत नाही कारण उत्पाद कळ आधीपासूनच दुसऱ्या डिव्हाइसवर वापरली गेली होती. ती दुसऱ्या डिव्हाइसवर वापरली गेली नव्हती असे आपल्याला वाटत असल्यास, समस्यानिवारण निवडा.
  \resources\SystemSettings_Activation_URL_WHY_REQUIRED:
