  \oobeCortana\cortanaSubHeading_A:
    Candidate Language=TT-RU: Һәркем шәхси ярдәмчегә лаек. Cortana - шәхси ярдәмчеләрнең санлысы.
  \oobeCortana\cortanaSubHeadingVoiceOver:
