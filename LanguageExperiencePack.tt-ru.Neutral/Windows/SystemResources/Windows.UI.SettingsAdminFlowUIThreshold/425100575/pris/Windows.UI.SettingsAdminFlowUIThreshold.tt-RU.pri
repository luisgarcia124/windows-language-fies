  \resources\PBR_RemovedAppsList_Header:
    Candidate Language=TT-RU: Бетереләсе кушымталар исемлеге
  \resources\PBR_RemovedAppsList_Desc\Text:
    Candidate Language=TT-RU: Күп кенә кушымталарны Store аша яңадан урнаштырып була, ләкин түбәндәге кушымталарны Интернеттан яки урнаштыру дискларыннан яңадан урнаштырырга кирәк булачак. Ташлатудан соң кушымталарның шушы исемлеге эш өстәлендә сакланачак.
  \resources\PBR_Note\Text:
