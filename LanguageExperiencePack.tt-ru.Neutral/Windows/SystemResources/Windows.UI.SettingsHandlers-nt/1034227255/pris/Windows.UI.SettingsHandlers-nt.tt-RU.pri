  \resources\SystemSettings_Accounts_PeopleOnDeviceDescription:
    Candidate Language=TT-RU: Бу җайланмага керә алучы кешеләрне өстәү. Алар сезнең гаилә төркеменә өстәлмәячәк.
  \resources\SystemSettings_Accounts_OtherUsersDescription:
    Candidate Language=TT-RU: Гаиләгезгә кермәгән кешеләргә үзләренең хисап язмалары белән керергә рөхсәт итегез. Бу гамәл аларны гаиләгезгә өстәмәячәк.
  \resources\SystemSettings_Accounts_MSAConnectButton2:
