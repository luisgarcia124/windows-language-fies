  \resources\Uninstall_CheckUpdatesError_Desc\Text:
    Candidate Language=NE-NP: अद्यावधिकहरू जाँच गर्न, सेटिङहरू > Windows Update मा जानुहोस् र अद्यावधिक जाँच गर्नुहोस् चयन गर्नुहोस्।
  \resources\Uninstall_BitLockerOffToOn_Header:
    Candidate Language=NE-NP: BitLocker अफ गर्नुहोस्
  \resources\Uninstall_BitLockerOffToOn_Desc\Text:
