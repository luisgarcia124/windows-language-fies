  \resources\Uninstall_CheckUpdates_Header:
    Candidate Language=NE-NP: अद्यावधिकहरूका लागि जाँच्नुहोस्?
  \resources\Uninstall_CheckUpdates_Desc\Text:
    Candidate Language=NE-NP: तपाईं पछाडि जानुभन्दा पहिले, नवीनतम अद्यावधिकहरू स्थापना गरी हेर्नुहोस्। यसले तपाईंले भोगी रहनुभएका समस्याहरू समाधान गर्न सक्छ।
