  \retailDemo\shutdownTextOnline:
    Candidate Language=MS-MY: Masa penutupan untuk peranti ini dikonfigurasi melalui perkhidmatan awan pengalaman demo runcit
  \retailDemo\shutdownText:
    Candidate Language=MS-MY: Pilih masa penutupan untuk peranti ini
  \retailDemo\shutdownsTitle:
    Candidate Language=MS-MY: Penutupan automatik
  \retailDemo\shutdownsInfo:
    Candidate Language=MS-MY: Tetapkan masa penutupan automatik untuk peranti ini.
  \retailDemo\securityTitle:
    Candidate Language=MS-MY: Tetapan pentadbir RDX
  \retailDemo\securityText:
    Candidate Language=MS-MY: Pilih tempoh masa untuk menjalankan RDX sebelum capaian kepada akaun pentadbir dialih keluar. Setelah capaian dialih keluar, anda tidak akan lagi boleh menjalankan skrip atau membuat apa-apa kerja pentadbiran lain. Jika anda mahu mengekalkan capaian pentadbir, anda boleh mencipta kata laluan pentadbir tersuai. Sila pastikan bahawa kata laluan tersuai seselamat yang mungkin.
  \retailDemo\retypePassword:
    Candidate Language=MS-MY: Taip semula kata laluan
  \retailDemo\removeRdxTitle:
    Candidate Language=MS-MY: Alih keluar RDX
  \retailDemo\removeRdxText:
    Candidate Language=MS-MY: Alih keluar
  \retailDemo\removeRdxInfo:
    Candidate Language=MS-MY: Mengalih keluar RDX daripada peranti ini dan mengembalikannya ke tetapan kilang.
  \retailDemo\rdxTitle:
    Candidate Language=MS-MY: Persediaan tunjuk cara
  \retailDemo\rdamTitle:
    Candidate Language=MS-MY: Dapatkan kandungan demo dan aplikasi yang terkini
  \retailDemo\rdamText:
    Candidate Language=MS-MY: Memasukkan maklumat ini (pilihan) akan membantu kami mendapatkan kandungan terkini untuk mempamerkan peranti Windows ini.
  \retailDemo\racLegend:
