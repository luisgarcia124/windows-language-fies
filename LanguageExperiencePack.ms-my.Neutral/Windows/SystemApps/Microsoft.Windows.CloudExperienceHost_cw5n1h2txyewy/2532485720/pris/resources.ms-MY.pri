  \retailDemo\passwordSuggestion:
    Candidate Language=MS-MY: Kata laluan
  \retailDemo\passwordManagmentLegend:
    Candidate Language=MS-MY: Mengalih keluar capaian pentadbir secara kekal selepas masa yang ditentukan secara automatik
