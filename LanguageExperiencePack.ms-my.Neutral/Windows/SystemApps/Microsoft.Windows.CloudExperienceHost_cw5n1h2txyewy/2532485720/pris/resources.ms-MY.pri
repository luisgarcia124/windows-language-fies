  \shubOobeDeviceType\HuddleDescription:
    Candidate Language=MS-MY: Pilih ini untuk penggunaan yang dikongsi, perbincangan, percambahan fikiran. Menghidupkan Windows Hello dan menyimpan profil untuk daftar masuk cepat.
  \shubOobeDeviceType\DeviceTypeTitle:
    Candidate Language=MS-MY: Bagaimana anda akan menggunakan peranti ini?
  \shubOobeDeviceType\DeviceTypeDescription:
    Candidate Language=MS-MY: Kami akan menetapkan perkara berdasarkan pilihan anda. Anda sentiasa boleh membuat perubahan kemudian dalam Tetapan.
  \shubOobeDeviceType\ConferenceHeader:
    Candidate Language=MS-MY: Mesyuarat dan persembahan
  \shubOobeDeviceType\ConferenceDescription:
    Candidate Language=MS-MY: Pilih ini untuk bilik persidangan, mesyuarat yang dijadualkan dan persembahan. Windows Hello tidak akan dihidupkan dan data akan dialih keluar selepas setiap sesi.
  \roamingSettings\Title:
    Candidate Language=MS-MY: Segerakkan tetapan anda
  \roamingSettings\nextButton:
