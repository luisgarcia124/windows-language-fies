  \hololensDiagnostics\PrivacyBody:
    Candidate Language=MS-MY: Ketahui lebih lanjut tentang perkara yang kami kumpulkan dengan menaip https://aka.ms/privacy ke dalam bar alamat pada mana-mana pelayar pada mana-mana peranti.
  \hololensDiagnostics\NextButton:
    Candidate Language=MS-MY: Kumpulkan maklumat
  \hololensDiagnostics\Instruction4:
    Candidate Language=MS-MY: 4. Selepas anda menyimpan fail, datang kembali ke sini dan pilih Selesai. Ini akan mengalih keluar fail daripada HoloLens anda.
  \hololensDiagnostics\Instruction3:
    Candidate Language=MS-MY: 3. Salin fail diagnostik HoloLens kepada PC anda.
  \hololensDiagnostics\Instruction2:
    Candidate Language=MS-MY: 2. Pada PC anda, sila terima prom untuk membuka Penjelajah Fail.
  \hololensDiagnostics\Instruction1:
    Candidate Language=MS-MY: 1. Sambungkan HoloLens anda kepada PC anda.
  \hololensDiagnostics\Instruction0:
    Candidate Language=MS-MY: Untuk menyimpan maklumat diagnostik anda kepada PC anda:
  \hololensDiagnostics\ContinueButton:
    Candidate Language=MS-MY: Selesai
  \hololensDiagnostics\CancelButton:
    Candidate Language=MS-MY: Batal
  \hololensDiagnostics\BodyTroubleshooting:
    Candidate Language=MS-MY: Maklumat diagnostik boleh membantu anda menyelesaikan masalah daftar masuk ini. Selepas dikumpul, ia akan tersedia kepada sesiapa yang mempunyai capaian kepada peranti ini. Anda juga akan boleh menyimpan kepada PC anda supaya anda boleh menghantar kepada pentadbir anda atau kepada Microsoft.
  \hololensDiagnostics\BodySuccess:
    Candidate Language=MS-MY: Sebaik sahaja anda menyimpan maklumat kepada PC anda, hantarkannya kepada pentadbir anda atau menyertakannya apabila anda menghubungi Sokongan.
  \hololensDiagnostics\BodyError:
    Candidate Language=MS-MY: Kami gagal menyediakan dan mengumpulkan log diagnostik. Sila cuba akaun lain.
  \hololensDiagnostics\Body:
    Candidate Language=MS-MY: Cuba lagi, atau pilih Batal untuk menyediakan peranti anda kemudian.
  \hololensDiagnostics\BackButton:
    Candidate Language=MS-MY: Ke Belakang
  \hololensAccount\UserPlaceholder:
    Candidate Language=MS-MY: someone@example.com
  \hololensAccount\Title:
    Candidate Language=MS-MY: Daftar masuk dengan akaun kerja anda
  \hololensAccount\PasswordTitle:
    Candidate Language=MS-MY: Masukkan kata laluan anda
  \hololensAccount\PasswordPlaceholder:
    Candidate Language=MS-MY: Kata laluan
