  \SystemSettings\Resources\SystemSettings_CapabilityAccess_BackgroundSpatialPerception_UserGlobal_Group\DisplayName:
    Candidate Language=UZ-LATN-UZ: Xatti-harakatlaringizga fondan kirishga ruxsat berish
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_BackgroundSpatialPerception_UserGlobal_Group\Description:
    Candidate Language=UZ-LATN-UZ: Agar ruxsat bersangiz, ilovalaringiz fonda ishlayotganida ushbu sahifadagi sozlamalardan foydalanib bosh, qoʻllaringiz, harakat nazoratchilari va boshqa kuzatilayotgan obyektlarning xatti-harakati haqidagi maʼlumotlarni oladi. Ruxsat berilmasa, ilovalarga fonda ishlayotganida xatti-harakatlaringiz haqidagi maʼlumotlarni olish taqiqlanadi.
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_BackgroundSpatialPerception_SystemGlobal_Group\DisplayName:
    Candidate Language=UZ-LATN-UZ: Foydalanuvchi xatti-harakatlariga fondan kirishga ruxsat berish
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_BackgroundSpatialPerception_SystemGlobal_Group\Description:
    Candidate Language=UZ-LATN-UZ: Agar ruxsat bersangiz, ushbu qurilma foydalanuvchilari ilovalarning foydalanuvchi boshi, qoʻllari, harakat nazoratchilari hamda boshqa kuzatiladigan obyektlarning xatti-harakatlari haqidagi maʼlumotlarni ushbu ilovalar fonda ishlayotganida mazkur sahifadagi sozlamalardan foydalanib olishi yoki olmasligini tanlay oladi. Kirishni taqiqlash ushbu ilovalar fonda ishlayotganida foydalanuvchilarning xatti-harakatlari haqidagi maʼlumotlarni olishiga ruxsat bermaydi.
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_BackgroundSpatialPerception_AppList_Group\DisplayName:
    Candidate Language=UZ-LATN-UZ: Qaysi ilovalar fonda ishlayotganida xatti-harakatlaringizga kira olishini tanlang
  \SystemSettings\Resources\SystemSettings_CapabilityAccess_BackgroundSpatialPerception_AppList_Group\Description:
