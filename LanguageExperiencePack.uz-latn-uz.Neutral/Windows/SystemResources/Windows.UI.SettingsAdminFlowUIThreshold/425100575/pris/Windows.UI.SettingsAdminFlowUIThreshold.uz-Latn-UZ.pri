  \resources\DisableUser_BodyText:
    Candidate Language=UZ-LATN-UZ: Ular tizimga kirish va ushbu ShKdan foydalanish imkoniga ega bo‘lmaydilar. Istalgan vaqtda ularni blokdan chiqarishingiz mumkin.
  \resources\DevicePortalSetAuthentication_PromptText:
    Candidate Language=UZ-LATN-UZ: Haqiqatan ham Qurilma portalidagi foydalanuvchi nomi va parolingizni almashtirmoqchimisiz?
  \resources\DevicePortalSetAuthentication_HeaderText:
    Candidate Language=UZ-LATN-UZ: O‘zgarishlarni tasdiqlang
  \resources\DevicePortalAuthentication_WarningText:
    Candidate Language=UZ-LATN-UZ: Haqiqiylik tekshiruvi o‘chirib qo‘yilsa, yaqin-atrofdagi har kim qurilmangizni boshqarishi va undagi ma’lumotlarni ko‘rishi mumkin bo‘ladi.
  \resources\DevicePortalAuthentication_PromptText:
    Candidate Language=UZ-LATN-UZ: Haqiqiylik tekshiruvi o‘chirib qo‘yilsinmi?
