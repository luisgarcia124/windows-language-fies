  \resources\HolographicUninstall_ErrorText:
    Candidate Language=UZ-LATN-UZ: Windows Mixed Reality olib tashlanmadi. Kompyuteringizda unga oid ayrim fayllar yoki ma’lumotlar qolgan bo‘lishi mumkin.
  \resources\HolographicUninstall_BodyText:
    Candidate Language=UZ-LATN-UZ: Buning natijasida Windows Mixed Reality olib tashlanadi.
