  \resources\RemoteDesktop_EnableFirewallError_HeaderText:
    Candidate Language=UZ-LATN-UZ: Masofaviy ish stoli himoya devoringiz tomonidan bloklangan
  \resources\RemoteDesktop_EnableFirewallError_BodyText:
    Candidate Language=UZ-LATN-UZ: Masofaviy ish stoliga himoya devori orqali kirishga ruxsat berish uchun 3389 portini oching.
  \resources\RemoteDesktop_DisableFirewallError_HeaderText:
