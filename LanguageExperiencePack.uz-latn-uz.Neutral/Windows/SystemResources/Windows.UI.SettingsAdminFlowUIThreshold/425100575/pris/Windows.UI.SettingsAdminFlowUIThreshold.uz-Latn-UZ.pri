  \resources\TroubleshootActivation_ReactivationLinkText:
    Candidate Language=UZ-LATN-UZ: Bu qurilmada yaqinda apparat qismlari almashtirilgan
  \resources\TroubleshootActivation_OfflineText:
    Candidate Language=UZ-LATN-UZ: Sizdagi Windows nusxasini aktivatsiya qilib bo‘lmadi. Internetga ulanganingizga ishonch hosil qiling va qayta urinib ko‘ring.
  \resources\TroubleshootActivation_NoSolutionText:
    Candidate Language=UZ-LATN-UZ: Bu qurilmadini Windows’ni aktivatsiya qilib bo‘lmadi.
  \resources\TroubleshootActivation_NoSolutionNoStoreText:
    Candidate Language=UZ-LATN-UZ: Sizdagi Windows nusxasini aktivatsiya qilib bo‘lmadi. Internetga ulanganingizni tekshirib, keyin qaytadan urining. Agar Internetga ulangan bo‘lsangiz va bu muammo davom etaversa, yordam olish uchun tizim administratoriga murojaat qiling.
  \resources\TroubleshootActivation_MediaCreationText:
    Candidate Language=UZ-LATN-UZ: %2 asosida ishlayotgan ushbu qurilma uchun %1 raqamli litsenziyasi aniqlandi. Ushbu raqamli litsenziya yordamida aktivatsiya qilish uchun %1 o‘rnatilishi zarur.
