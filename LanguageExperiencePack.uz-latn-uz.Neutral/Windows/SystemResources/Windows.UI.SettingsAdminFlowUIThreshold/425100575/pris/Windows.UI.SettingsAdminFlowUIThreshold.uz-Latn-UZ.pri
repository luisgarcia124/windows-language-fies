  \resources\ManageExclusion_SAVE_FAIL_ErrorText:
    Candidate Language=UZ-LATN-UZ: Kechirasiz, Istisnoni saqlab bo`lmayapti.
  \resources\ManageExclusion_Process_ADD_FAIL_ErrorText:
    Candidate Language=UZ-LATN-UZ: Jarayon nomi tarkibida quyidagi belgilar bo‘lishi mumkin emas: /"<>|?*
  \resources\ManageExclusion_Extension_ADD_FAIL_ErrorText:
