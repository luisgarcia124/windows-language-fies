  \resources\NLA_Enable_HeaderText:
    Candidate Language=UZ-LATN-UZ: Faqat tarmoq darajasidagi haqiqiylik tekshiruvi bilan ulanishga ruxsat berilsinmi?
  \resources\NLA_Enable_BodyText:
