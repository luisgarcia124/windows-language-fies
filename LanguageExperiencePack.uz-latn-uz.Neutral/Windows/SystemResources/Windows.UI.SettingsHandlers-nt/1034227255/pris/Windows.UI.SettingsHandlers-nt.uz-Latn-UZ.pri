  \resources\SystemSettings_Activate_WORKSTATION_REQUIRED:
    Candidate Language=UZ-LATN-UZ: Windowsning ushbu versiyasi qurilmangizda sozlangan uskunada ishlamaydi. Store orqali mos versiyadagi Windows sotib oling.
  \resources\SystemSettings_Activate_NEVER_ACTIVATED_CONTENT:
    Candidate Language=UZ-LATN-UZ: Windowsni sozlash uchun, uni faollashtirish lozim.
  \resources\SystemSettings_Activate_INFO_TITLE:
