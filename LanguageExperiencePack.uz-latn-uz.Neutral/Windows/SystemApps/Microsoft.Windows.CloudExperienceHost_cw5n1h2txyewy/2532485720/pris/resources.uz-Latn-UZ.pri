  \enterpriseNgcEnrollment\HelpLink:
    Candidate Language=UZ-LATN-UZ: Qanday PIN kod uzun parolga qaraganda xavfsizroq bo‘lishi mumkin?
  \enterpriseNgcEnrollment\HelpHeadline:
    Candidate Language=UZ-LATN-UZ: Chunki PIN kod faqat shu qurilmada ishlaydi
  \enterpriseNgcEnrollment\HelpBody:
    Candidate Language=UZ-LATN-UZ: Barcha turdagi hisoblar bilan ishlaydigan paroldan farqli ravishda PIN kod faqat shu qurilmaga oid bo‘ladi. Xakerlar masofadan turib PIN kodni ishlata olmaydi.
  \enterpriseNgcEnrollment\ErrorDescription:
    Candidate Language=UZ-LATN-UZ: Qo‘shimcha yordam olish uchun foydalanuvchilarga ko‘mak xizmati yoki texnik ko‘mak xizmatiga murojaat qiling va quyidagi tafsilotlarni bildiring.
  \enterpriseNgcEnrollment\ErrorCode:
    Candidate Language=UZ-LATN-UZ: Xatolik kodi:
  \enterpriseNgcEnrollment\CorrelationId:
    Candidate Language=UZ-LATN-UZ: Korrelyatsiya identifikatori:
  \enterpriseNgcEnrollment\CancelButton:
    Candidate Language=UZ-LATN-UZ: Tashlab ketish
  \enterpriseNgcEnrollment\BodyTpmError:
    Candidate Language=UZ-LATN-UZ: PIN kodni ushbu qurilmada xavfsiz saqlashda ishlatiladigan Ishonchli platforma moduli hozir ish faoliyatida emas. Qaytadan urinib ko‘ring yoki bu bosqichni tashlab ketib, uni keyinroq bajaring.
  \enterpriseNgcEnrollment\BodySuccess:
    Candidate Language=UZ-LATN-UZ: Endi PIN kod bilan kira olasiz.
  \enterpriseNgcEnrollment\BodyServerError:
    Candidate Language=UZ-LATN-UZ: Ayni vaqtda PIN kodni sozlash uchun serverga ulana olmayapmiz. Qaytadan urining yoki bu qadamni tashlab ketib, keyinroq bajaring.
  \enterpriseNgcEnrollment\BodyHelloCancel:
    Candidate Language=UZ-LATN-UZ: Windows Hello xizmatidan foydalanish uchun PIN kod o‘rnatishingiz lozim. Bu biroz vaqt oladi.
  \enterpriseNgcEnrollment\BodyHello:
    Candidate Language=UZ-LATN-UZ: Windows Hello o‘rnida foydalanish mumkin bo‘lgan PIN kodni o‘rnating. U umuman kerak bo‘lmasligi mumkin, lekin u muqobil usul sifatida saqlanadi.
  \enterpriseNgcEnrollment\BodyError:
    Candidate Language=UZ-LATN-UZ: Ayni vaqtda PIN kodni sozlab bo‘lmadi. Qaytadan urining yoki bu qadamni tashlab ketib, keyinroq bajaring.
  \enterpriseNgcEnrollment\BodyCancel:
    Candidate Language=UZ-LATN-UZ: Bu qurilmadan foydalanish uchun PIN kod o‘rnatishingiz lozim. Bu biroz vaqt oladi.
  \enterpriseNgcEnrollment\Body:
    Candidate Language=UZ-LATN-UZ: Parol osongina o‘g‘irlanishi mumkin. Windows Hello esa qurilmangiz, ilovalar va xizmatlarga kirishda qurilmangizning ikkita omilini birlashtirib, parol o‘rniga biometriya yoki PIN koddan foydalanadi.
